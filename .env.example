# Optional overrides. Copy to .env (production build) or .env.development (astro dev) and uncomment
# a line only when a build needs a value other than the one in src/person/config.ts.
# Public values only: every PUBLIC_ var is shipped to the browser. Never put secrets here.

# Where the shared contact form (src/components/shared/ContactForm.astro) POSTs its FormData.
# Unset: falls back to contactEndpoint in src/person/config.ts.
# PUBLIC_CONTACT_ENDPOINT=https://www.example.dev/api/contact

# Address used by the form's mailto fallback when the endpoint cannot be reached.
# Unset: falls back to contactFallbackEmail in src/person/config.ts.
# PUBLIC_CONTACT_EMAIL=hello@example.dev
