/**
 * THE SITE OWNER. The one file to edit for a new person's identity and contact details.
 * Generated by `npm run init:person` on {{generatedOn}}; edit it by hand from here on.
 *
 * Every niche reads these values through src/person/person.ts (Node-safe helpers) and
 * src/person/profile.ts (adds the portrait). The portrait itself is src/person/assets/faraz.jpg:
 * replace that file with your own photo, keeping the file name (src/person/profile.ts imports it).
 * Check your edit with `npm run check:person`; `astro build` runs the same validation.
 *
 * Node loads this file directly (src/niches.ts imports it, scripts run it with native type
 * stripping), so keep it import-free apart from `import type`, with no enums/namespaces.
 * Only state facts the owner has confirmed: never invent a value to fill a field.
 */
import type { PersonConfig } from './schema.ts';

export const PERSON_CONFIG = {
  /** Feeds JSON-LD Person.name, page/OG title suffixes, bylines, nav marks and footers. */
  name: {{name}},
  /** As the copy introduces you: "I’m <firstName>, …", "Me (<firstName>)". */
  firstName: {{firstName}},
  // shortName: '…',  (optional; a shorter form for tight spots, defaults to firstName)
  /** Third-person copy ("runs <possessive> own funnel"). Leave out for they/them/their. */
{{pronounsLine}}
  /** Feeds every niche's CONTACT_EMAIL: mailto links, contact sections, JSON-LD email. */
  email: {{email}},
  /** Base booking link. Each niche's bookingUrl() adds utm_source=<slug> (+ utm_content). */
  bookingUrl: {{bookingUrl}},
  /** Feeds BRAND_COMPANY, PROFILE.company and JSON-LD worksFor. */
  company: {{company}},
  /** Feeds PROFILE.companyRole. */
  companyRole: {{companyRole}},
  /** Owner-stated start year. Feeds PROFILE.sinceYear and yearsBuilding(). */
  sinceYear: {{sinceYear}},
  /** Your own wording, shown by apps instead of a start year (PROFILE.experience). */
  experience: {{experience}},
  /** Feeds PROFILE.city and JSON-LD address. */
  city: {{city}},
{{countryLine}}
  /** ISO code. Feeds JSON-LD addressCountry. */
  countryCode: {{countryCode}},
  /** Feeds PROFILE.location. */
  location: {{location}},
  /** Feeds PROFILE.timeZone. */
  timeZone: {{timeZone}},
  /** Feeds PROFILE.github and JSON-LD sameAs. */
  github: {{github}},
{{linkedinLine}}
  /** Every niche lives at https://<slug>.<rootDomain>. Feeds src/niches.ts ROOT_DOMAIN. */
  rootDomain: {{rootDomain}},
  /** Main site, no trailing slash. Feeds MAIN_SITE_URL and footer links. */
  mainSiteUrl: {{mainSiteUrl}},
  /** Contact form POST target when PUBLIC_CONTACT_ENDPOINT is not set (see .env.example). */
  contactEndpoint: {{contactEndpoint}},
  /** Contact form mailto fallback when PUBLIC_CONTACT_EMAIL is not set (see .env.example). */
  contactFallbackEmail: {{contactFallbackEmail}},
  /*
   * footerSignature (optional, left out on purpose): the name text of the big display
   * signature in the footers. When absent it is `name` (src/person/person.ts ›
   * FOOTER_SIGNATURE). Set it only when the signature must differ from `name`, e.g. a shorter
   * form of a long name that reads better at display size:
   *   footerSignature: '<short form of your name>',
   */
  /** Short title wording. Feeds PROFILE.roleLine (ai). */
  roleLine: {{roleLine}},
  /** Default job title. Feeds PROFILE.jobTitle and JSON-LD jobTitle. */
  jobTitle: {{jobTitle}},
  /**
   * Per-niche job titles (niche slug -> title). Niches not listed use `jobTitle`. An empty
   * object, or leaving it out, is fine (src/person/person.ts treats a missing one as {}).
   *   jobTitleByNiche: { apps: 'Full-Stack Engineer', seo: 'Technical SEO Engineer' },
   */
  jobTitleByNiche: {},
  /** Alt text of the portrait (src/person/assets/). Describe the actual photo. */
  portraitAlt: {{portraitAlt}},

  /* ---- First-person claims. Leave a field out when it is not true for you: the copy then
   * drops that clause, uses neutral wording or shows a TODO chip. `npm run review:copy` lists
   * the claims that are still literal in the niche copy. ---- */

  /**
   * Every tool you really use. Each niche shows only the items of its own list that are also here
   * (About "Works with"/"Builds in", stack marks, JSON-LD knowsAbout, tool-naming sentences).
   * [] = no tool claims: the tool lists turn into TODO chips and tool-naming sentences drop out.
   * The names must match the niches' own lists exactly (see STACK / TOOLS in src/data/<niche>/site.ts).
   */
  stack: {{stack}},

  /*
   * The fields below are optional and left out. Uncomment one only when it is true for you.
   *
   * profession: lowercase noun phrase used mid-sentence ("I’m a full-stack engineer, so …").
   *   Unset: those clauses are left out.
   *     profession: 'full-stack engineer',
   *
   * seniority: lowercase adjective ("I’m a senior full-stack engineer"). Unset: no adjective.
   *     seniority: 'senior',
   *
   * careerLine: one sentence of career history (apps About). Unset: the sentence is left out.
   *     careerLine: 'I’ve worked in … across … roles.',
   *
   * experienceShort: the apps proof strip's experience cell. Unset: the cell is a TODO chip.
   *     experienceShort: { value: '5+ yrs', label: 'Of …' },
   *
   * credentials: partner / certification status per programme a niche mentions.
   *   true = you hold it ("Yes" wording), false = you do not ("No, I hold no …" wording),
   *   left out = unknown: the FAQ entry (and its FAQPage JSON-LD entry) is dropped.
   *   Never set true without proof.
   *     credentials: { googleAdsPartner: false, metaPartner: false, webflowCertifiedPartner: false },
   *
   * originStories: how you came to a niche's work, one sentence per niche slug (About copy).
   *   Niches left out drop the sentence and use neutral title wording. The object form also
   *   replaces the About title where that niche's title tells the same story (ghl).
   *     originStories: {
   *       seo: 'I came to SEO from the code side.',
   *       ghl: { title: 'A developer who found automation through GoHighLevel.', text: '…' },
   *     },
   *
   * contactFeedsCrm: true only when the contact form posts into your own CRM (funnels success
   *   message "it’s on its way into my CRM"). Unset: a plain "on its way" message.
   *     contactFeedsCrm: true,
   *
   * supportHours: hours you offer support in, as the copy prints them (cloud: nav, footer, About,
   *   contact form reply, care-plan offer, on-call FAQ, JSON-LD). Unset: the hours lines are left
   *   out and the copy says "business hours" without a time.
   *     supportHours: '9AM–5PM CET',
   */
} satisfies PersonConfig;
