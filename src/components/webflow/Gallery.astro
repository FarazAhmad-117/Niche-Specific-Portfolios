---
/**
 * Interaction gallery (decided: 3–4 small motion demos with honest performance notes). Demos
 * of craft, not results. Each card says what it animates, what happens off screen and what
 * reduced motion gets.
 *
 *  1. Hover: the site's own button, "selected" on hover (fill rises, handles snap on).
 *  2. Scroll: three lines uncover as the card crosses the screen, scrubbed by GSAP
 *     ScrollTrigger through the shared <Motion /> (desktop); elsewhere a one-time reveal.
 *     Never pins, never hijacks the scroll.
 *  3. Page transition: a mini "artboard zoom" (clip-path + transform, FLIP-measured) that
 *     mirrors the real cross-document transition between this site's pages.
 *  4. Cursor: a card that leans toward the pointer with a light that follows it. Transform
 *     only, rAF-throttled, listeners attached only while on screen, fine pointers only.
 *
 * Desktop: a 2 × 2 grid. Phones: a swipe carousel (scroll-snap).
 */
import { GALLERY } from '../../data/webflow/content';

const byId = Object.fromEntries(GALLERY.map((g) => [g.id, g])) as Record<(typeof GALLERY)[number]['id'], (typeof GALLERY)[number]>;
const order = ['hover', 'scroll', 'page', 'cursor'] as const;
const lines = ['Motion that', 'earns its', 'place.'];
---

<section class="section gal" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div class="head head--split">
      <p class="eyebrow">Interaction gallery</p>
      <h2 id="gallery-title">Motion, with the receipts.</h2>
      <p class="lede">
        Four small demos of the craft I bring to Webflow interactions. Each one says what it animates, what it does off
        screen and what you get with reduced motion turned on.
      </p>
    </div>

    <ul class="gal__track" role="list" aria-label="Motion demos">
      {
        order.map((id, i) => {
          const g = byId[id];
          return (
            <li class={`demo demo--${id}`}>
              <div class="demo__head">
                <span class="demo__idx mono" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="tag">{g.kind}</span>
              </div>
              <h3 class="demo__title">{g.title}</h3>

              <div class="demo__stage">
                {id === 'hover' && (
                  <div class="hv">
                    <button class="btn hv__btn" type="button">
                      <span class="btn__dot" aria-hidden="true" />
                      <span>Hover or focus me</span>
                    </button>
                    <span class="hv__hint mono" aria-hidden="true">
                      fill · 1000ms out-quint · label +140ms
                    </span>
                  </div>
                )}

                {id === 'scroll' && (
                  <div class="sc" data-scrub>
                    <p class="sc__lines">
                      <span class="visually-hidden">{lines.join(' ')}</span>
                      {lines.map((l, k) => (
                        <span class="sc__line" style={`--k:${k}`} aria-hidden="true">
                          <span class="sc__ink">{l}</span>
                        </span>
                      ))}
                    </p>
                    <span class="sc__meter" aria-hidden="true">
                      <span class="sc__meter-fill" />
                    </span>
                    <span class="sc__label mono" aria-hidden="true">
                      scroll progress
                    </span>
                  </div>
                )}

                {id === 'page' && (
                  <div class="pt" data-pt>
                    <div class="pt__grid">
                      <span class="pt__card pt__card--a" data-pt-card>
                        <span class="pt__thumb" />
                        <span class="pt__name">Case study</span>
                      </span>
                      <span class="pt__card pt__card--b">
                        <span class="pt__thumb" />
                        <span class="pt__name">Another</span>
                      </span>
                    </div>
                    <div class="pt__page" data-pt-page aria-hidden="true">
                      <span class="pt__thumb pt__thumb--hero" />
                      <span class="pt__pname">Case study</span>
                      <span class="pt__bars">
                        <span />
                        <span />
                        <span />
                      </span>
                    </div>
                    <button class="pt__go" type="button" data-pt-go aria-expanded="false" disabled>
                      Open the page
                    </button>
                  </div>
                )}

                {id === 'cursor' && (
                  <div class="tilt-wrap" data-tilt-wrap>
                    <div class="tilt" data-tilt>
                      <span class="tilt__glare" aria-hidden="true" />
                      <span class="tilt__grid" aria-hidden="true" />
                      <span class="tilt__chip cls" aria-hidden="true">
                        card_component
                      </span>
                      <span class="tilt__title">Lean in.</span>
                      <span class="tilt__sub mono">rotateX / rotateY</span>
                    </div>
                    <span class="tilt__touch mono" data-tilt-note>
                      Static here: needs a mouse or trackpad
                    </span>
                  </div>
                )}
              </div>

              <p class="demo__text">{g.text}</p>
              <dl class="demo__notes">
                <div>
                  <dt class="mono">Animates</dt>
                  <dd>{g.notes.animates}</dd>
                </div>
                <div>
                  <dt class="mono">Off screen</dt>
                  <dd>{g.notes.offscreen}</dd>
                </div>
                <div>
                  <dt class="mono">Reduced motion</dt>
                  <dd>{g.notes.reduced}</dd>
                </div>
              </dl>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  /* The scrub progress is a registered number, so the one-time reveal can transition it. */
  @property --gal-p {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  .gal__track {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  @media (min-width: 900px) {
    .gal__track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Phones: a swipe carousel. The next card peeks in, so it reads as one. */
  @media (max-width: 899px) {
    .gal__track {
      grid-auto-flow: column;
      grid-auto-columns: min(86%, 26rem);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--margin);
      margin-inline: calc(-1 * var(--margin));
      padding: 4px var(--margin) 14px;
      scrollbar-width: thin;
    }
    .demo {
      scroll-snap-align: start;
    }
  }
  .demo {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: var(--space-3);
    min-width: 0;
    padding: clamp(1rem, 0.8rem + 0.8vw, 1.5rem);
    border-radius: var(--radius-l);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
  }
  .demo__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .demo__idx {
    color: var(--text-3);
  }
  .demo__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    letter-spacing: -0.03em;
  }
  .demo__stage {
    position: relative;
    display: grid;
    place-items: center;
    height: 13.5rem;
    border-radius: var(--radius-m);
    background:
      radial-gradient(circle, var(--dot) 1.1px, transparent 1.5px) 0 0 / 18px 18px,
      var(--canvas);
    overflow: hidden;
  }
  .demo__text {
    color: var(--text-2);
    font-size: var(--fs-small);
  }
  .demo__notes {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .demo__notes div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: 7px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .demo__notes dt {
    color: var(--text-3);
    font-size: 0.75rem;
    text-transform: uppercase;
    padding-top: 2px;
  }
  .demo__notes dd {
    margin: 0;
    color: var(--text);
  }

  /* ---------- 1. hover ---------- */
  .hv {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }
  .hv__hint {
    color: var(--text-3);
    font-size: 0.75rem;
  }

  /* ---------- 2. scroll ---------- */
  .sc {
    --gal-p: 1;
    display: grid;
    justify-items: start;
    gap: 10px;
    width: min(100% - 2.5rem, 22rem);
  }
  .sc.is-armed {
    --gal-p: 0;
  }
  .sc.is-armed.is-in {
    --gal-p: 1;
    transition: --gal-p 1400ms var(--ease-out-quint);
  }
  .sc__lines {
    display: grid;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.125rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  .sc__line {
    /* Each line has its own third of the progress: 0..1 → this line's 0..1. */
    --lp: clamp(0, var(--gal-p) * 3 - var(--k), 1);
    display: block;
    overflow: clip;
  }
  .sc__ink {
    display: block;
    clip-path: inset(0 calc((1 - var(--lp)) * 100%) 0 0);
    transform: translate3d(calc((1 - var(--lp)) * -14px), 0, 0);
  }
  .sc__line:last-child .sc__ink {
    color: var(--accent-text);
  }
  .sc__meter {
    width: 100%;
    height: 3px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .sc__meter-fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(var(--gal-p));
  }
  .sc__label {
    color: var(--text-3);
    font-size: 0.75rem;
  }

  /* ---------- 3. page transition ---------- */
  .pt {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .pt__grid {
    display: grid;
    grid-template-columns: repeat(2, 7.5rem);
    gap: 12px;
    margin-bottom: 44px;
    transition:
      transform 700ms var(--ease-in-out-quart),
      opacity 500ms var(--ease-out-quint);
  }
  .pt.is-open .pt__grid {
    transform: scale(0.9);
    opacity: 0;
  }
  .pt__card {
    display: grid;
    gap: 6px;
    padding: 8px;
    border-radius: 10px;
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
  }
  .pt__card--a {
    box-shadow:
      inset 0 0 0 1.5px var(--accent),
      var(--shadow-soft);
  }
  .pt__thumb {
    display: block;
    height: 3.5rem;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--accent) 0 45%, color-mix(in srgb, var(--accent) 35%, var(--surface-2)) 45%);
  }
  .pt__card--b .pt__thumb {
    background: var(--line);
  }
  .pt__name {
    font-size: 0.75rem;
    font-weight: 600;
  }
  .pt__page {
    position: absolute;
    inset: 10px 10px 54px;
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 12px;
    border-radius: 12px;
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1.5px var(--accent),
      var(--shadow-lift);
    visibility: hidden;
    clip-path: var(--from, inset(0 round 12px));
  }
  .pt__page > * {
    transform-origin: left top;
  }
  .pt.is-open .pt__page {
    visibility: visible;
  }
  .pt__thumb--hero {
    height: 4.25rem;
  }
  .pt__pname {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.03em;
  }
  .pt__bars {
    display: grid;
    gap: 5px;
  }
  .pt__bars span {
    height: 5px;
    border-radius: 3px;
    background: var(--line);
  }
  .pt__bars span:nth-child(2) {
    width: 80%;
  }
  .pt__bars span:nth-child(3) {
    width: 55%;
  }
  .pt__go {
    position: absolute;
    left: 50%;
    bottom: 10px;
    translate: -50% 0;
    min-height: 36px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--radius-s);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .pt__go:disabled {
    cursor: not-allowed;
    background: var(--surface-1);
    color: var(--text-2);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  /* ---------- 4. cursor ---------- */
  .tilt-wrap {
    display: grid;
    justify-items: center;
    gap: 10px;
    perspective: 700px;
  }
  .tilt {
    --rx: 0deg;
    --ry: 0deg;
    --gx: 50%;
    --gy: 30%;
    position: relative;
    display: grid;
    align-content: end;
    gap: 2px;
    width: 12.5rem;
    height: 8.5rem;
    padding: 14px;
    border-radius: 14px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    overflow: hidden;
    transform: rotateX(var(--ry)) rotateY(var(--rx));
    transform-style: preserve-3d;
    transition: transform 700ms var(--ease-out-expo);
    box-shadow: var(--shadow-lift);
  }
  .tilt.is-tracking {
    transition: transform 140ms linear;
  }
  .tilt__glare {
    position: absolute;
    left: -60%;
    top: -60%;
    width: 220%;
    height: 220%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent-inv) 45%, transparent), transparent 70%);
    transform: translate3d(calc(var(--gx) - 50%), calc(var(--gy) - 50%), 0);
    opacity: 0.6;
    pointer-events: none;
  }
  .tilt__grid {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, color-mix(in srgb, var(--btn-fg) 22%, transparent) 1px, transparent 1.4px) 0 0 / 14px 14px;
    pointer-events: none;
  }
  .tilt__chip {
    position: absolute;
    left: 12px;
    top: 12px;
  }
  .tilt__title {
    position: relative;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
  }
  /* On its own plate, so the glare passing behind can never drop it under 4.5:1. */
  .tilt__sub {
    position: relative;
    justify-self: start;
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--btn-bg);
    color: var(--accent-inv);
    font-size: 0.75rem;
  }
  .tilt__touch {
    color: var(--text-3);
    font-size: 0.75rem;
  }
  .tilt-wrap.is-live .tilt__touch {
    visibility: hidden;
  }
</style>

<script>
  import { onMotion } from '../../lib/motion-registry';
  import { finePointer, prefersReduced } from '../../lib/webflow/base';

  const reduced = prefersReduced();

  // ---------- 2. scroll: GSAP scrub on desktop (shared Motion), else a one-time reveal ----------
  const scrub = document.querySelector<HTMLElement>('[data-scrub]');
  if (scrub && !reduced && 'IntersectionObserver' in window) {
    // Arm only if it starts below the fold: never hide what is already on screen.
    if (scrub.getBoundingClientRect().top > window.innerHeight) {
      scrub.classList.add('is-armed');
      let scrubbing = false;
      const io = new IntersectionObserver(
        ([e]) => {
          if (!e?.isIntersecting || scrubbing) return;
          scrub.classList.add('is-in');
          io.disconnect();
        },
        { threshold: 0.6 },
      );
      io.observe(scrub);
      onMotion(({ ScrollTrigger }) => {
        scrubbing = true;
        io.disconnect();
        scrub.classList.remove('is-in');
        const st = ScrollTrigger.create({
          trigger: scrub,
          start: 'top 92%',
          end: 'top 38%',
          scrub: 0.6,
          onUpdate: (self) => scrub.style.setProperty('--gal-p', self.progress.toFixed(3)),
        });
        return () => {
          st.kill();
          scrubbing = false;
          scrub.style.removeProperty('--gal-p');
          scrub.classList.add('is-in');
        };
      });
    }
  }

  // ---------- 3. the mini page transition ----------
  const pt = document.querySelector<HTMLElement>('[data-pt]');
  const go = pt?.querySelector<HTMLButtonElement>('[data-pt-go]');
  const card = pt?.querySelector<HTMLElement>('[data-pt-card]');
  const page = pt?.querySelector<HTMLElement>('[data-pt-page]');
  if (pt && go && card && page) {
    go.disabled = false;
    let open = false;
    let busy = false;
    const EASE = 'cubic-bezier(0.76, 0, 0.24, 1)';
    const DUR = 700;
    /** The card's box as an inset() on the page, so the page "grows out of" the card. */
    const fromInset = () => {
      const p = page.getBoundingClientRect();
      const c = card.getBoundingClientRect();
      const t = c.top - p.top;
      const l = c.left - p.left;
      const r = p.right - c.right;
      const b = p.bottom - c.bottom;
      return `inset(${t}px ${r}px ${b}px ${l}px round 10px)`;
    };
    const kids = () => [...page.children] as HTMLElement[];
    go.addEventListener('click', () => {
      if (busy) return;
      const opening = !open;
      open = opening;
      go.setAttribute('aria-expanded', String(opening));
      go.textContent = opening ? 'Back to the cards' : 'Open the page';
      if (opening) pt.classList.add('is-open');
      if (reduced || typeof page.animate !== 'function') {
        if (!opening) pt.classList.remove('is-open');
        return;
      }
      busy = true;
      const full = 'inset(0px 0px 0px 0px round 12px)';
      const frames = opening ? [fromInset(), full] : [full, fromInset()];
      const a = page.animate({ clipPath: frames }, { duration: DUR, easing: EASE, fill: 'forwards' });
      kids().forEach((k, i) =>
        k.animate(
          opening
            ? [{ opacity: 0, transform: 'translate3d(0, 10px, 0) scale(0.96)' }, { opacity: 1, transform: 'none' }]
            : [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translate3d(0, 6px, 0) scale(0.98)' }],
          { duration: opening ? 520 : 260, delay: opening ? 260 + i * 60 : 0, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both' },
        ),
      );
      a.finished
        .catch(() => {})
        .finally(() => {
          busy = false;
          if (!opening) pt.classList.remove('is-open');
          a.cancel();
          kids().forEach((k) => k.getAnimations().forEach((x) => x.cancel()));
        });
    });
  }

  // ---------- 4. cursor tilt: fine pointers only, listeners only while on screen ----------
  const wrap = document.querySelector<HTMLElement>('[data-tilt-wrap]');
  const tilt = wrap?.querySelector<HTMLElement>('[data-tilt]');
  if (wrap && tilt && finePointer() && !reduced) {
    wrap.classList.add('is-live');
    let queued = false;
    let rx = 0;
    let ry = 0;
    let gx = 50;
    let gy = 30;
    const paint = () => {
      queued = false;
      tilt.style.setProperty('--rx', `${rx.toFixed(2)}deg`);
      tilt.style.setProperty('--ry', `${ry.toFixed(2)}deg`);
      tilt.style.setProperty('--gx', `${gx.toFixed(1)}%`);
      tilt.style.setProperty('--gy', `${gy.toFixed(1)}%`);
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };
    const stage = wrap.closest<HTMLElement>('.demo__stage') ?? wrap;
    const onMove = (e: PointerEvent) => {
      if (e.pointerType === 'touch') return;
      const r = tilt.getBoundingClientRect();
      const x = Math.max(-1, Math.min(1, (e.clientX - (r.left + r.width / 2)) / (r.width / 2)));
      const y = Math.max(-1, Math.min(1, (e.clientY - (r.top + r.height / 2)) / (r.height / 2)));
      rx = x * 12;
      ry = -y * 10;
      gx = 50 + x * 30;
      gy = 50 + y * 30;
      tilt.classList.add('is-tracking');
      queue();
    };
    const onLeave = () => {
      rx = 0;
      ry = 0;
      gx = 50;
      gy = 30;
      tilt.classList.remove('is-tracking');
      queue();
    };
    let attached = false;
    const attach = (on: boolean) => {
      if (on === attached) return;
      attached = on;
      if (on) {
        stage.addEventListener('pointermove', onMove, { passive: true });
        stage.addEventListener('pointerleave', onLeave);
      } else {
        stage.removeEventListener('pointermove', onMove);
        stage.removeEventListener('pointerleave', onLeave);
        onLeave();
      }
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => attach(Boolean(e?.isIntersecting))).observe(stage);
    } else attach(true);
  }
</script>
