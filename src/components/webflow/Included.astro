---
/**
 * What every site includes (brief §4 item 8): six specs in a 3 × 2 grid (2 × 3, then 1
 * column). Each tile is an artboard with a mono label and a line icon.
 */
import { INCLUDED } from '../../data/webflow/content';

const ICONS: Record<(typeof INCLUDED)[number]['icon'], string> = {
  class: 'M4 7h9M4 12h16M4 17h12M17 4l3 3-3 3',
  cms: 'M12 4c4.4 0 8 1.3 8 3s-3.6 3-8 3-8-1.3-8-3 3.6-3 8-3zM4 7v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
  seo: 'M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zM15.5 15.5 20 20',
  redirect: 'M4 7h11a4 4 0 0 1 0 8H8M11 12l-3 3 3 3',
  video: 'M3.5 6.5h12v11h-12zM15.5 10.5l5-3v9l-5-3',
  motion: 'M4 18c3-9 6-12 8-12s3 4 4 6 2 4 4 4',
};
---

<section class="section inc" id="included" aria-labelledby="included-title">
  <div class="container">
    <div class="head">
      <p class="eyebrow">In every site</p>
      <h2 id="included-title">The handover is part of the build.</h2>
    </div>
    <ul class="inc__grid" role="list" data-reveal-stagger>
      {
        INCLUDED.map((it, i) => (
          <li class="inc__item">
            <span class="inc__label mono" aria-hidden="true">
              spec_{String(i + 1).padStart(2, '0')}
            </span>
            <svg class="inc__icon" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
              <path d={ICONS[it.icon]} />
            </svg>
            <h3 class="inc__title">{it.title}</h3>
            <p class="inc__text">{it.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .inc__grid {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 1px;
    border-radius: var(--radius-l);
    background: var(--line);
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .inc__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .inc__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .inc__item {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    background: var(--surface-2);
  }
  .inc__label {
    position: absolute;
    right: 16px;
    top: 14px;
    color: var(--text-3);
    font-size: 0.75rem;
  }
  .inc__icon {
    color: var(--accent-text);
  }
  .inc__icon path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .inc__title {
    font-size: 1.125rem;
  }
  .inc__text {
    color: var(--text-2);
    font-size: var(--fs-small);
  }
</style>
