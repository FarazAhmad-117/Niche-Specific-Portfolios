---
/**
 * About. The real portrait (black and white on black) placed on the canvas as a selected
 * image element: an artboard label, a frame with corner handles and its class chip. Facts
 * come from src/data/webflow/profile.ts only.
 */
import { Image } from 'astro:assets';
import { ABOUT } from '../../data/webflow/content';
import { PROFILE } from '../../data/webflow/profile';
import { yearsSuffix } from '../../person/person';
import { STACK } from '../../data/webflow/site';

const facts = [
  { k: 'Based in', v: PROFILE.location },
  { k: 'Time zone', v: PROFILE.timeZone },
  { k: 'Building since', v: `${PROFILE.sinceYear}${yearsSuffix()}` },
  { k: 'Company', v: `${PROFILE.companyRole}, ${PROFILE.company}` },
];
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <figure class="about__photo" data-reveal>
      <p class="about__label mono" aria-hidden="true">portrait_image · 4:5</p>
      <div class="about__frame">
        <Image
          src={PROFILE.portrait.src}
          alt={PROFILE.portrait.alt}
          widths={[320, 480, 640, 960]}
          sizes="(min-width: 1024px) 420px, 80vw"
          loading="lazy"
          decoding="async"
        />
        <span class="about__sel" aria-hidden="true"></span>
      </div>
      <figcaption class="about__cap mono">{PROFILE.name} · {PROFILE.location}</figcaption>
    </figure>

    <div class="about__copy">
      <p class="eyebrow">About</p>
      <h2 id="about-title">{ABOUT.title}</h2>
      {ABOUT.paragraphs.map((p, i) => <p class:list={[i === 0 ? 'lede' : 'about__p']}>{p}</p>)}
      <dl class="about__facts">
        {
          facts.map((f) => (
            <div>
              <dt class="mono">{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
      <div class="about__stack">
        <p class="mono about__stack-label">Works with</p>
        <ul role="list">
          {STACK.map((s) => <li class="cls cls--plain">{s}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
  .about__photo {
    width: min(100%, 400px);
    margin: 0 auto;
    padding: 10px;
  }
  .about__label {
    margin-bottom: 8px;
    color: var(--text-3);
    font-size: 0.75rem;
  }
  .about__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-s);
    background: #000;
  }
  .about__frame :global(img) {
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .about__sel {
    position: absolute;
    inset: -7px;
    border: 1.5px solid var(--accent);
    background:
      linear-gradient(var(--accent), var(--accent)) left top / 9px 9px no-repeat,
      linear-gradient(var(--accent), var(--accent)) right top / 9px 9px no-repeat,
      linear-gradient(var(--accent), var(--accent)) left bottom / 9px 9px no-repeat,
      linear-gradient(var(--accent), var(--accent)) right bottom / 9px 9px no-repeat;
    pointer-events: none;
  }
  .about__cap {
    margin-top: 14px;
    color: var(--text-3);
  }
  .about__copy {
    display: grid;
    gap: var(--space-5);
  }
  .about__copy h2 {
    max-width: 16ch;
  }
  .about__p {
    color: var(--text-2);
    max-width: var(--measure);
  }
  .about__facts {
    display: grid;
    gap: var(--space-3) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    margin: var(--space-3) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .about__facts dt {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .about__facts dd {
    margin: 2px 0 0;
    font-weight: 600;
  }
  .about__stack {
    display: grid;
    gap: var(--space-2);
  }
  .about__stack-label {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .about__stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
  }
</style>
