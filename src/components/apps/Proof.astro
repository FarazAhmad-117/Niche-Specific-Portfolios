---
/**
 * Proof strip: a ruled measurement table. Four figures, each measured and dated or the
 * owner's own statement, then the stack marks (text, not logos) from the owner's repos.
 */
import { PROOF, PROOF_NOTE } from '../../data/apps/content';
import { STACK } from '../../data/apps/site';
---

<section class="proof" id="proof" aria-labelledby="proof-title">
  <div class="container">
    <h2 id="proof-title" class="visually-hidden">Proof</h2>
    <dl class="proof__table">
      {
        PROOF.map((p) => (
          <div class="proof__cell">
            <dt class="proof__label">{p.label}</dt>
            <dd class="proof__value num">{p.value}</dd>
          </div>
        ))
      }
    </dl>
    <div class="proof__foot">
      <p class="mono proof__note">{PROOF_NOTE}</p>
      <ul class="proof__stack" role="list" aria-label="Stack I build with">
        {STACK.map((s) => <li class="mono">{s}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .proof {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }
  .proof__table {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1.5px solid var(--text);
    border-left: 1px solid var(--line-strong);
  }
  @media (min-width: 900px) {
    .proof__table {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .proof__cell {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-4) var(--space-5);
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }
  .proof__value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 112%;
    font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--text);
  }
  .proof__label {
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.45;
    max-width: 30ch;
  }
  .proof__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-4);
  }
  .proof__note {
    color: var(--text-3);
  }
  .proof__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
  }
  .proof__stack li {
    padding: 4px 10px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    border-radius: var(--radius-xs);
    color: var(--text-2);
  }
</style>
