---
/**
 * Comparison (brief §4 item 9): me vs an agency vs a low-cost freelancer vs hiring. A real
 * table on wide screens; on phones each criterion becomes its own small block, with every
 * cell labelled by its column, so nothing scrolls sideways. Qualitative and typical only;
 * the note under it says so.
 */
import { COMPARE } from '../../data/apps/content';
---

<section class="section compare" id="compare" aria-labelledby="compare-title">
  <div class="container">
    <div class="head head--split">
      <p class="eyebrow"><span class="eyebrow__no">07</span>Comparison</p>
      <h2 id="compare-title">Four ways to get it built.</h2>
      <p class="lede">Each has its place. This is where a senior engineer working in your repo fits.</p>
    </div>

    {/* Explicit roles: on phones the table is restyled as blocks (display: block), which would
        otherwise drop its table semantics in some browsers. */}
    <table class="cmp" role="table">
      <caption class="visually-hidden">How working with me compares with an agency, a low-cost freelancer and hiring in-house</caption>
      <thead role="rowgroup">
        <tr role="row">
          <td class="cmp__corner" role="cell"></td>
          {
            COMPARE.cols.map((c, i) => (
              <th scope="col" role="columnheader" class:list={['label', { 'is-me': i === 0 }]}>
                {c}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody role="rowgroup">
        {
          COMPARE.rows.map((r) => (
            <tr role="row">
              <th scope="row" role="rowheader">{r.label}</th>
              {r.cells.map((cell, i) => (
                <td role="cell" class:list={{ 'is-me': i === 0 }} data-col={COMPARE.cols[i]}>
                  {cell}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="cmp__note text-3">{COMPARE.note}</p>
  </div>
</section>

<style>
  .cmp {
    width: 100%;
    border-collapse: collapse;
    border-top: 1.5px solid var(--text);
    font-size: var(--fs-small);
  }
  .cmp th,
  .cmp td {
    padding: var(--space-4) var(--space-4);
    border-bottom: 1px solid var(--line-strong);
    text-align: left;
    vertical-align: top;
  }
  .cmp thead th {
    color: var(--text-3);
    padding-block: var(--space-3);
  }
  .cmp tbody th {
    font-family: var(--font-display);
    font-weight: 680;
    font-stretch: 104%;
    font-size: 1rem;
    width: 20%;
  }
  .cmp td {
    color: var(--text-2);
  }
  .cmp .is-me {
    background: var(--accent-soft);
    color: var(--text);
    font-weight: 500;
  }
  .cmp thead .is-me {
    color: var(--accent-text);
    box-shadow: inset 0 3px 0 var(--accent);
  }
  .cmp__note {
    margin-top: var(--space-4);
    font-size: 0.8125rem;
    max-width: 70ch;
  }

  /* Phones: each row becomes a block; cells carry their column name. */
  @media (max-width: 759px) {
    .cmp thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .cmp,
    .cmp tbody,
    .cmp tr,
    .cmp th,
    .cmp td {
      display: block;
      width: 100%;
    }
    .cmp tr {
      padding: var(--space-4) 0;
      border-bottom: 1px solid var(--line-strong);
    }
    .cmp tbody th {
      width: 100%;
      padding: 0 0 var(--space-2);
      border: 0;
    }
    .cmp td {
      display: grid;
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: var(--space-3);
      padding: 6px 8px;
      border: 0;
    }
    .cmp td::before {
      content: attr(data-col);
      font-family: var(--font-display);
      font-stretch: 125%;
      font-weight: 620;
      font-size: 0.6875rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-3);
      padding-top: 0.2em;
    }
    .cmp td.is-me::before {
      color: var(--accent-text);
    }
  }
</style>
