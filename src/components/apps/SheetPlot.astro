---
/**
 * A case card's drawing: the case's own architecture (data/apps/cases.ts) reduced to line
 * work on a fixed 320×150 sheet, so every card in a row has the same frame whatever the
 * diagram's grid. Column references (A, B, C…) and row numbers sit in the margin like a
 * drawing's grid references; a dimension line along the foot gives the stage count.
 *
 * Nodes are drafted boxes with a skeleton stroke for a label (the hero's "drafted" voice);
 * tones follow the full diagram: io heavier, gate in ink blue, ext dashed.
 *
 * Hover (driven by the card, see Cases.astro): the main path is traced in ink blue along
 * each wire in order (stroke-dashoffset, in-out-quart), and the dimension line is redrawn
 * from its left tick (out-quint). At rest, with no JS or under reduced motion, the drawing
 * is complete and neutral: nothing depends on the hover.
 */
import type { Diagram } from '../../data/apps/cases';

interface Props {
  diagram: Diagram;
}
const { diagram: d } = Astro.props;

const VW = 320;
const VH = 150;
const PX = 20; // left margin: row numbers
const PR = 10;
const PT = 20; // top margin: column letters
const PB = 30; // foot: dimension line
const cw = (VW - PX - PR) / d.cols;
const ch = (VH - PT - PB) / d.rows;
const nw = cw * 0.7;
const nh = Math.min(ch * 0.58, 24);
const r = (n: number) => Math.round(n * 10) / 10;
const cx = (col: number) => PX + (col + 0.5) * cw;
const cy = (row: number) => PT + (row + 0.5) * ch;
const byId = new Map(d.nodes.map((n) => [n.id, n]));

const wires = d.edges.map((e, i) => {
  const a = byId.get(e.from);
  const b = byId.get(e.to);
  if (!a || !b) throw new Error(`[apps] sheet plot edge ${e.from} → ${e.to}: unknown node`);
  const [x1, y1, x2, y2] = [cx(a.col), cy(a.row), cx(b.col), cy(b.row)];
  let path: string;
  if (a.row === b.row) path = `M${r(x1)} ${r(y1)}H${r(x2)}`;
  else if (a.col === b.col) path = `M${r(x1)} ${r(y1)}V${r(y2)}`;
  else if (e.via === 'gap') {
    // Into the gap between the rows, along it, then into the target from above/below.
    const ym = PT + (b.row > a.row ? a.row + 1 : a.row) * ch;
    path = `M${r(x1)} ${r(y1)}V${r(ym)}H${r(x2)}V${r(y2)}`;
  } else if (a.col > b.col) {
    // A branch back to an earlier column leaves its own node vertically, so it never seems to
    // start on the wire coming into that node.
    path = `M${r(x1)} ${r(y1)}V${r(y2)}H${r(x2)}`;
  } else {
    const xm = PX + (a.col + 1) * cw;
    path = `M${r(x1)} ${r(y1)}H${r(xm)}V${r(y2)}H${r(x2)}`;
  }
  return { path, dashed: !!e.dashed, i };
});
const solid = wires.filter((w) => !w.dashed);

const footY = VH - 13;
const label = `${d.stages.length} STAGES`;
const labelW = label.length * 5.4 + 12;
---

<svg class="sp" viewBox={`0 0 ${VW} ${VH}`} aria-hidden="true" focusable="false">
  {/* grid references */}
  <path class="sp__ref-rule" d={`M${PX} ${PT - 4}H${VW - PR}`}></path>
  {
    Array.from({ length: d.cols + 1 }, (_, i) => (
      <path class="sp__ref-rule" d={`M${r(PX + i * cw)} ${PT - 7}V${PT - 1}`} />
    ))
  }
  {
    d.stages.map((_, i) => (
      <text class="sp__ref" x={r(cx(i))} y={PT - 9} text-anchor="middle">
        {String.fromCharCode(65 + i)}
      </text>
    ))
  }
  {
    Array.from({ length: d.rows }, (_, i) => (
      <text class="sp__ref" x={PX - 9} y={r(cy(i) + 2.6)} text-anchor="middle">
        {i + 1}
      </text>
    ))
  }

  {/* wires at rest, then the trace that hover draws over the main path */}
  {wires.map((w) => <path class:list={['sp__wire', { 'is-dashed': w.dashed }]} d={w.path} />)}
  {solid.map((w, k) => <path class="sp__trace" d={w.path} pathLength="1" style={`--k:${k}`} />)}

  {
    d.nodes.map((n) => {
      const x = cx(n.col) - nw / 2;
      const y = cy(n.row) - nh / 2;
      return (
        <g class:list={['sp__node', `sp__node--${n.tone ?? 'core'}`]}>
          <rect x={r(x)} y={r(y)} width={r(nw)} height={r(nh)} rx="1.5" />
          <path class="sp__sk" d={`M${r(x + 5)} ${r(cy(n.row))}h${r(Math.min(nw * 0.55, nw - 10))}`} />
        </g>
      );
    })
  }

  {/* dimension line: the number of stages */}
  <g class="sp__dim">
    <path class="sp__dim-line" d={`M${PX} ${footY}H${VW - PR}`}></path>
    <path class="sp__dim-tick" d={`M${PX} ${footY - 4}V${footY + 4}M${VW - PR} ${footY - 4}V${footY + 4}`}></path>
    <rect class="sp__dim-bg" x={r((PX + VW - PR) / 2 - labelW / 2)} y={footY - 6} width={r(labelW)} height="12"></rect>
    <text class="sp__dim-text" x={(PX + VW - PR) / 2} y={footY + 2.6} text-anchor="middle">{label}</text>
  </g>
</svg>

<style>
  .sp {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 320 / 150;
    overflow: visible;
  }
  .sp__ref {
    fill: var(--text-3);
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.04em;
  }
  .sp__ref-rule {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 0.75;
  }
  .sp__wire {
    fill: none;
    stroke: var(--text-3);
    stroke-width: 1;
  }
  .sp__wire.is-dashed {
    stroke-dasharray: 3 2.5;
    opacity: 0.8;
  }
  .sp__trace {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 420ms var(--ease-out-quint);
  }
  .sp__node rect {
    fill: var(--plot-bg, var(--bg));
    stroke: var(--text-2);
    stroke-width: 1;
    transition: stroke 600ms var(--ease-out-quint);
  }
  .sp__node--io rect {
    stroke: var(--text);
    stroke-width: 1.4;
  }
  .sp__node--gate rect {
    stroke: var(--accent);
    stroke-width: 1.4;
  }
  .sp__node--ext rect {
    stroke: var(--text-3);
    stroke-dasharray: 2.5 1.8;
  }
  .sp__sk {
    fill: none;
    stroke: var(--text-3);
    stroke-width: 1.2;
  }
  .sp__dim-line,
  .sp__dim-tick {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.9;
  }
  .sp__dim-line {
    transform-box: fill-box;
    transform-origin: 0 50%;
  }
  .sp__dim-bg {
    fill: var(--plot-bg, var(--bg));
  }
  .sp__dim-text {
    fill: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.08em;
  }

  /* ---------- hover / keyboard focus on the card that holds this drawing (Cases.astro .case-sheet) ---------- */
  :global(.case-sheet:focus-within) .sp__trace {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1100ms var(--ease-in-out-quart);
    transition-delay: calc(var(--k) * 180ms);
  }
  :global(.case-sheet:focus-within) .sp__node--core rect {
    stroke: var(--text);
  }
  @media (hover: hover) {
    :global(.case-sheet:hover) .sp__trace {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1100ms var(--ease-in-out-quart);
      transition-delay: calc(var(--k) * 180ms);
    }
    :global(.case-sheet:hover) .sp__node--core rect {
      stroke: var(--text);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(.case-sheet:hover) .sp__dim-line {
      animation: sp-dim 1200ms var(--ease-out-quint) both;
    }
  }
  @keyframes sp-dim {
    from {
      transform: scaleX(0);
    }
  }
  /* Below 320px of drawing (the 1:1 width) the 7.5-unit references shrink under 7.5px: drop the letters and
     numbers, keep the ruled ticks. */
  @container (max-width: 320px) {
    .sp__ref {
      display: none;
    }
  }
</style>
