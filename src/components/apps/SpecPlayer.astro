    font-weight: 500;
  }
  @media (prefers-reduced-motion: no-preference) {
    .is-live .panel--schema.is-active .tbl {
      animation: pop 620ms var(--ease-spring) both;
      animation-delay: calc(var(--i) * 180ms);
    }
    .is-live .panel--schema.is-active .schema__wires {
      animation: wipe-x 1100ms var(--ease-in-out-quart) 700ms both;
    }
    .is-live .panel--schema.is-active .schema__rel {
