    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 6px;
    background: var(--text);
    color: var(--bg);
    font-weight: 500;
    box-shadow: var(--shadow-lift);
  }
  .ui__tick {
    flex: none;
    width: 14px;
    height: 8px;
    margin-top: -4px;
    border-left: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
  }
  .ui__body {
    padding-bottom: 64px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .is-live .panel--ui.is-active .ui__slot.is-on,
    .is-live .panel--ui.is-active .ui__day.is-on {
      animation: select 700ms var(--ease-spring) 500ms both;
    }
    .is-live .panel--ui.is-active .ui__toast {
      animation: toast 700ms var(--ease-spring) 1500ms both;
    }
  }
  @keyframes select {
    from {
      transform: scale(0.9);
      box-shadow: inset 0 0 0 1px var(--line-strong);
      background: transparent;
      color: var(--text);
    }
  }
  @keyframes toast {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  /* ---------- 5. deploy log ---------- */
  .term {
    width: min(100%, 560px);
    border-radius: var(--radius-m);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }
  .term__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--line);
    color: var(--text-3);
    font-size: 0.6875rem;
  }
  .term__bar span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .term__bar span:last-of-type {
    margin-right: 8px;
  }
  .term__log {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 16px 16px 6px;
    font-size: clamp(0.6875rem, 0.64rem + 0.2vw, 0.8125rem);
  }
  .term__line {
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--text-2);
  }
  .term__k {
    white-space: nowrap;
  }
  .term__line:first-child .term__k {
    color: var(--text);
  }
  .term__lead {
    flex: 1;
    min-width: 12px;
    border-bottom: 1px dotted var(--line-strong);
    transform: translateY(-3px);
  }
  .term__v {
    color: var(--success);
  }
  .term__live {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px 16px;
    color: var(--text-2);
    font-size: 0.8125rem;
  }
  .term__stamp {
    padding: 4px 10px 3px;
    border: 2px solid var(--accent);
    border-radius: 3px;
    color: var(--accent-text);
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: rotate(-4deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .is-live .panel--deploy.is-active .term__line,
    .is-live .panel--deploy.is-active .term__live {
      animation: type 360ms steps(4, end) both;
      animation-delay: calc(250ms + var(--i) * 420ms);
    }
    .is-live .panel--deploy.is-active .term__stamp {
      animation: stamp 640ms var(--ease-spring) both;
      animation-delay: calc(400ms + var(--i) * 420ms);
    }
  }
  @keyframes type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes stamp {
    from {
      opacity: 0;
      transform: rotate(-4deg) scale(1.5);
    }
    to {
      opacity: 1;
      transform: rotate(-4deg);
    }
  }

  /* ---------- phones: the sheet first, then only the current step and a dot row ---------- */
  @media (max-width: 959px) {
    .player__side {
      order: 2;
    }
    .sheet {
      order: 1;
    }
    .sheet__stage {
      height: 340px;
      margin: 10px;
    }
    .sketch {
      width: min(100%, calc((340px - 24px) * 600 / 360));
    }
    .is-live .step:not([aria-current='step']) {
      display: none;
    }
    .is-live .steps {
      border-top-width: 1px;
    }
    .is-live .step[aria-current='step'] {
      min-height: 9.5rem;
    }
    .controls__dots {
      display: flex;
      gap: 6px;
      margin-left: auto;
    }
    .controls__dot {
      width: 7px;
      height: 7px;
      background: var(--line-strong);
      transition:
        background-color 300ms var(--ease-out-quint),
        width 420ms var(--ease-out-quint);
    }
    .controls__dot.is-on {
      background: var(--accent);
    }
    .controls__dot.is-current {
      width: 20px;
    }
  }
  @media (max-width: 560px) {
    .ui__body {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
      padding: 12px 12px 58px;
    }
    .ui__sum {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2px 10px;
      padding: 8px 10px;
    }
    .ui__sum-k {
      display: none;
    }
    .ui__sum-t {
      grid-row: 2;
    }
    .ui__cta {
      grid-row: 1 / span 2;
      grid-column: 2;
      margin: 0;
    }
    .ui__slots {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 4px;
    }
    .ui__slot {
      font-size: 0.75em;
    }
    .schema {
      gap: 26px 22px;
    }
    .tbl__row {
      padding: 2px 7px;
    }
    /* The gap between columns is too narrow for a label on a phone. */
    .schema__rel--h {
      display: none;
    }
    .tbl__name {
      padding: 4px 7px;
    }
  }
  /* No JS on a phone: the sheet only repeats the list. */
  @media (max-width: 959px) {
    .player:not(.is-live) .sheet {
      display: none;
    }
  }
</style>

<script>
  import { prefersReduced } from '../../lib/apps/base';

  const player = document.querySelector<HTMLElement>('[data-player]');
  if (player) {
    const steps = [...player.querySelectorAll<HTMLElement>('[data-step]')];
    const panels = [...player.querySelectorAll<HTMLElement>('[data-panel]')];
    const dots = [...player.querySelectorAll<HTMLElement>('[data-dot]')];
    const controls = player.querySelector<HTMLElement>('[data-controls]')!;
    const playBtn = player.querySelector<HTMLButtonElement>('[data-play]')!;
    const count = player.querySelector<HTMLElement>('[data-count]');
    const sheetNo = player.querySelector<HTMLElement>('[data-sheet-no]');
    const sheetPhase = player.querySelector<HTMLElement>('[data-sheet-phase]');
    const n = steps.length;
    const reduced = prefersReduced();

    let active = 0;
    let playing = false;
    let wantsPlay = !reduced; // the visitor's intent; visibility only gates it
    let started = false;
    let visible = false;
    let focusInside = false;
    /** Playback runs only when wanted, a third is on screen and focus is not inside. */
    const sync = () => setPlaying(visible && wantsPlay && !focusInside);

    /** Restart the current bar's CSS animation from zero. */
    const restartBar = () => {
      const bar = steps[active]?.querySelector<HTMLElement>('[data-bar]');
      if (!bar) return;
      bar.style.animation = 'none';
      void bar.offsetWidth; // flush, so the next rule starts a fresh animation
      bar.style.animation = '';
    };

    const render = (i: number) => {
      active = (i + n) % n;
      steps.forEach((s, k) => {
        if (k === active) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
        s.classList.toggle('is-past', k < active);
      });
      // Re-adding .is-active restarts the panel's own CSS animations (the ink draws again).
      panels.forEach((p, k) => p.classList.toggle('is-active', k === active));
      dots.forEach((d, k) => {
        d.classList.toggle('is-on', k <= active);
        d.classList.toggle('is-current', k === active);
      });
      if (count) count.textContent = String(active + 1);
      if (sheetNo) sheetNo.textContent = String(active + 1).padStart(2, '0');
      if (sheetPhase) sheetPhase.textContent = steps[active]?.dataset.phase ?? '';
      // The deploy log rests longer so "Live" lands before the loop restarts.
      player.style.setProperty('--dur', active === n - 1 ? 'calc(var(--step-ms) * 1.5)' : 'var(--step-ms)');
      restartBar();
    };

    const setPlaying = (on: boolean) => {
      playing = on;
      player.classList.toggle('is-playing', on);
      playBtn.dataset.state = wantsPlay ? 'playing' : 'paused';
      playBtn.setAttribute('aria-label', wantsPlay ? 'Pause the walkthrough' : 'Play the walkthrough');
    };

    // The bar finishing is the clock: advance, loop after the last step.
    player.addEventListener('animationend', (e) => {
      if (!playing || reduced) return;
      if (!(e.target instanceof HTMLElement) || !e.target.matches('[data-bar]')) return;
      render(active + 1);
    });

    const takeControl = (i: number) => {
      wantsPlay = false;
      setPlaying(false);
      render(i);
    };
    steps.forEach((s, i) => s.querySelector('[data-step-btn]')?.addEventListener('click', () => takeControl(i)));
    player.querySelector('[data-prev]')?.addEventListener('click', () => takeControl(active - 1));
    player.querySelector('[data-next]')?.addEventListener('click', () => takeControl(active + 1));
    playBtn.addEventListener('click', () => {
      wantsPlay = !wantsPlay;
      if (wantsPlay && active === n - 1) render(0);
      sync();
    });
    if (reduced) playBtn.hidden = true;

    player.querySelectorAll<HTMLButtonElement>('button[disabled]').forEach((b) => (b.disabled = false));
    player.classList.add('is-live');
    controls.hidden = false;
    render(0);
    setPlaying(false);

    // Play only while a third of the player is visible; the visitor's pause always wins.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => {
          if (!e) return;
          visible = e.isIntersecting && e.intersectionRatio >= 0.33;
          if (visible && !started) {
            started = true;
            render(0);
          }
          sync();
        },
        { threshold: [0, 0.34] },
      ).observe(player);
    }
    // Keyboard focus inside pauses the story (on phones autoplay would hide the focused step).
    player.addEventListener('focusin', (e) => {
      // The play button is never hidden, and pressing it means "play".
      focusInside = !(e.target instanceof Element && e.target.matches('[data-play]'));
      sync();
    });
    player.addEventListener('focusout', (e) => {
      if (e.relatedTarget instanceof Node && player.contains(e.relatedTarget)) return;
      focusInside = false;
      sync();
    });
  }
</script>
