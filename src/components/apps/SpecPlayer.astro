  /* ---------- 3. architecture (the shared diagram renderer, assembled on entry) ---------- */
  .panel--arch :global(.arch) {
    width: min(100%, 620px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .is-live .panel--arch.is-active :global(.dg__node),
    .is-live .panel--arch.is-active :global(.dg__chip) {
      animation: pop 640ms var(--ease-spring) both;
      animation-delay: calc(var(--c, 0) * 260ms);
    }
    .is-live .panel--arch.is-active :global(.dg__wires) {
      animation: wipe-x 1300ms var(--ease-in-out-quart) 500ms both;
    }
    .is-live .panel--arch.is-active :global(.dg__head),
    .is-live .panel--arch.is-active :global(.dg__elabel) {
      animation: fade-in 400ms var(--ease-out-quint) both;
