---
/**
 * FAQ. Native <details>, so it works without JS and with find-in-page. Where the browser
 * supports ::details-content and interpolate-size, the answer's height glides open on
 * out-quint; elsewhere it opens instantly. Copy is shared with the FAQPage JSON-LD.
 */
import Arrow from './Arrow.astro';
import { FAQ } from '../../data/apps/content';
import { bookingUrl } from '../../data/apps/site';
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__head">
      <p class="eyebrow"><span class="eyebrow__no">09</span>FAQ</p>
      <h2 id="faq-title">Questions people ask first.</h2>
      <p class="lede">Something else? Ask it on the call; that is what it is for.</p>
      <a class="btn btn--ghost" href={bookingUrl('faq')}>
        <span>Book a scoping call</span>
        <Arrow />
      </a>
    </div>
    <div class="faq__list" data-reveal-stagger>
      {
        FAQ.map((f, i) => (
          <details class="qa">
            <summary class="qa__q">
              <span class="qa__no mono" aria-hidden="true">
                Q{String(i + 1).padStart(2, '0')}
              </span>
              <span class="qa__text">{f.q}</span>
              <span class="qa__icon" aria-hidden="true" />
            </summary>
            <p class="qa__a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 1024px) {
    .faq__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
    .faq__head {
      position: sticky;
      top: calc(var(--nav-h) + 48px);
    }
  }
  .faq__head {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .faq__list {
    border-top: 1.5px solid var(--text);
  }
  .qa {
    border-bottom: 1px solid var(--line-strong);
    transition: background-color 400ms var(--ease-out-quint);
  }
  .qa[open] {
    background: var(--surface-2);
  }
  .qa__q {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 64px;
    padding: var(--space-4) var(--space-3);
    font-family: var(--font-display);
    font-weight: 660;
    font-stretch: 104%;
    font-size: 1.0625rem;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }
  .qa__q::-webkit-details-marker {
    display: none;
  }
  .qa__no {
    color: var(--accent-text);
    font-weight: 400;
  }
  .qa__icon {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    box-shadow: inset 0 0 0 1.5px var(--text);
    border-radius: var(--radius-xs);
    transition:
      transform 520ms var(--ease-out-expo),
      background-color 300ms var(--ease-out-quint),
      box-shadow 300ms var(--ease-out-quint);
  }
  .qa__icon::before,
  .qa__icon::after {
    content: '';
    position: absolute;
    left: 8px;
    top: 13px;
    width: 12px;
    height: 1.75px;
    background: currentColor;
  }
  .qa__icon::after {
    transform: rotate(90deg);
  }
  .qa[open] .qa__icon {
    transform: rotate(45deg);
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: none;
  }
  .qa__a {
    padding: 0 var(--space-5) var(--space-5) calc(3rem + var(--space-3) + var(--space-3));
    color: var(--text-2);
    max-width: 70ch;
  }
  @media (max-width: 559px) {
    .qa__q {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    }
    .qa__a {
      padding-left: calc(2.5rem + var(--space-3) * 2);
      padding-right: var(--space-3);
    }
  }
  @supports selector(::details-content) {
    .qa {
      interpolate-size: allow-keywords;
    }
    .qa::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 520ms var(--ease-out-quint),
        content-visibility 520ms allow-discrete;
    }
    .qa[open]::details-content {
      block-size: auto;
    }
  }
</style>
