---
/**
 * Process (brief §4 item 8): Sprint → Build in 2-week cycles → Launch → Support, drawn as a
 * dimension line with a tick at each stage. The build stage repeats, so its span is marked
 * "× n cycles".
 */
import { PROCESS } from '../../data/apps/content';
---

<section class="section process paper" id="process" aria-labelledby="process-title">
  <div class="container">
    <div class="head head--split">
      <p class="eyebrow"><span class="eyebrow__no">06</span>Process</p>
      <h2 id="process-title">How a build runs.</h2>
      <p class="lede">The same four stages every time, so you always know what happens next and what it leaves you with.</p>
    </div>

    <ol class="proc" role="list" data-reveal-stagger>
      {
        PROCESS.map((p, i) => (
          <li class:list={['proc__step', { 'proc__step--loop': i === 1 }]}>
            <span class="proc__tick" aria-hidden="true" />
            <span class="proc__no mono" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
              {i === 1 && <span class="proc__loop">× n cycles</span>}
            </span>
            <h3 class="proc__title">{p.title}</h3>
            <p class="proc__text">{p.text}</p>
            <p class="proc__leaves">
              <span class="label">Leaves you with</span>
              <span>{p.leaves}</span>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    border-block: 1px solid var(--line);
  }
  .proc {
    position: relative;
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding-left: 28px;
  }
  /* The dimension line. */
  .proc::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 6px;
    bottom: 6px;
    width: 1.5px;
    background: var(--text);
  }
  @media (min-width: 900px) {
    .proc {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6);
      padding: 40px 0 0;
    }
    .proc::before {
      left: 0;
      right: 0;
      top: 12px;
      bottom: auto;
      width: auto;
      height: 1.5px;
    }
  }
  .proc__step {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }
  .proc__tick {
    position: absolute;
    left: -28px;
    top: 2px;
    width: 13px;
    height: 13px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1.5px var(--text);
  }
  .proc__step:last-child .proc__tick {
    background: var(--accent);
    box-shadow: none;
  }
  @media (min-width: 900px) {
    .proc__tick {
      left: 0;
      top: -34px;
    }
  }
  .proc__no {
    display: flex;
    gap: 10px;
    align-items: baseline;
    color: var(--accent-text);
  }
  .proc__loop {
    padding: 1px 6px;
    box-shadow: inset 0 0 0 1px var(--accent);
    border-radius: 2px;
    font-size: 0.6875rem;
  }
  .proc__text {
    color: var(--text-2);
    font-size: var(--fs-small);
    max-width: 38ch;
  }
  .proc__leaves {
    display: grid;
    gap: 2px;
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--line-strong);
    font-weight: 500;
  }
  .proc__leaves .label {
    color: var(--text-3);
    font-size: 0.6875rem;
  }
</style>
