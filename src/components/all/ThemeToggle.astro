---
/**
 * Theme toggle: sun/moon icon button. aria-label "Dark theme" + aria-pressed = dark on.
 * Persists to localStorage('theme'); the no-flash inline script lives in the Layout <head>.
 * The swap opens the new theme as a circle from the button (in-out-quart) through the
 * View Transitions API when present; instant under reduced motion. Hidden without JS.
 */
---

<button type="button" class="tt" aria-label="Dark theme" aria-pressed="false" data-theme-toggle>
  <svg class="tt__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <g class="tt__sun" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
    </g>
    <path
      class="tt__moon"
      fill="currentColor"
      d="M20.2 14.6A8.5 8.5 0 0 1 9.4 3.8a8.5 8.5 0 1 0 10.8 10.8Z"></path>
  </svg>
</button>

<style>
  .tt {
    display: none;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    touch-action: manipulation;
    transition:
      border-color var(--dur-hover) var(--ease-out-expo),
      transform var(--dur-hover) var(--ease-out-expo);
  }
  :global(html.js) .tt {
    display: inline-grid;
  }
  .tt__sun,
  .tt__moon {
    transform-origin: 12px 12px;
    transition:
      opacity 420ms var(--ease-out-expo),
      transform 600ms var(--ease-out-expo);
  }
  .tt__moon {
    opacity: 0;
    transform: rotate(-40deg) scale(0.6);
  }
  .tt[aria-pressed='true'] .tt__sun {
    opacity: 0;
    transform: rotate(60deg) scale(0.6);
  }
  .tt[aria-pressed='true'] .tt__moon {
    opacity: 1;
    transform: none;
  }
  @media (hover: hover) {
    .tt:hover {
      border-color: var(--line-strong);
      transform: translateY(-1px);
    }
  }
</style>

<script>
  const root = document.documentElement;
  const KEY = 'theme';
  type Theme = 'light' | 'dark';
  const COLORS: Record<Theme, string> = { light: '#f5f4f1', dark: '#0f0f12' };

  let dark: MediaQueryList | null = null;
  try {
    dark = window.matchMedia('(prefers-color-scheme: dark)');
  } catch {
    dark = null;
  }
  const reduced = (): boolean => {
    try {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch {
      return false;
    }
  };
  const stored = (): Theme | null => {
    try {
      const t = localStorage.getItem(KEY);
      return t === 'light' || t === 'dark' ? t : null;
    } catch {
      return null;
    }
  };
  const effective = (): Theme => {
    const t = root.dataset.theme;
    if (t === 'light' || t === 'dark') return t;
    return dark?.matches ? 'dark' : 'light';
  };

  function sync() {
    const theme = effective();
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.setAttribute('aria-pressed', String(theme === 'dark'));
    });
    const metas = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
    if (stored()) metas.forEach((m) => (m.content = COLORS[theme]));
    else metas.forEach((m) => (m.content = m.media.includes('dark') ? COLORS.dark : COLORS.light));
  }

  function apply(theme: Theme) {
    root.dataset.theme = theme;
    try {
      localStorage.setItem(KEY, theme);
    } catch {
      /* private mode: the choice lasts for this page only */
    }
    sync();
  }

  let busy = false;
  function toggle(this: HTMLButtonElement) {
    if (busy) return;
    const next: Theme = effective() === 'dark' ? 'light' : 'dark';
    if (reduced() || typeof document.startViewTransition !== 'function') {
      apply(next);
      return;
    }
    const r = this.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    busy = true;
    try {
      const vt = document.startViewTransition(() => apply(next));
      vt.ready
        .then(() => {
          root.animate(
            { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${end}px at ${x}px ${y}px)`] },
            { duration: 640, easing: 'cubic-bezier(0.76, 0, 0.24, 1)', pseudoElement: '::view-transition-new(root)' },
          );
        })
        .catch(() => {});
      vt.finished.finally(() => {
        busy = false;
      });
    } catch {
      busy = false;
      apply(next);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', toggle);
  });
  dark?.addEventListener('change', sync);
  window.addEventListener('storage', (e) => {
    if (e.key !== KEY) return;
    const t = stored();
    if (t) root.dataset.theme = t;
    else delete root.dataset.theme;
    sync();
  });
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    const t = stored();
    if (t) root.dataset.theme = t;
    sync();
  });
  sync();
</script>
