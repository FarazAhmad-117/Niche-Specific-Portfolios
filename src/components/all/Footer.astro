---
/**
 * Minimal footer with the brand thread shared by every niche: the Clash Display
 * name signature (src/person/config.ts › footerSignature), sized in container units so it
 * spans the content width.
 */
import { MAIN_SITE_URL, PERSON_NAME } from '../../data/all/sites';
import { nicheHost } from '../../niches';
import { FOOTER_SIGNATURE } from '../../person/person';

const year = new Date().getFullYear();
const mainHost = new URL(MAIN_SITE_URL).host;

// The CSS below sizes the signature so an 11-character name ("Faraz Ahmad") spans the width. A
// longer name would overflow the nowrap line, so it shrinks in proportion (+10% margin for wide
// letters). Names up to 11 characters emit no inline style, so their output is unchanged.
const SIG_REFERENCE_CHARS = 11;
const sigChars = FOOTER_SIGNATURE.trim().length;
const sigStyle =
  sigChars > SIG_REFERENCE_CHARS
    ? `font-size:calc(100cqi / ${(6.29 * (sigChars / SIG_REFERENCE_CHARS) * 1.1).toFixed(2)})`
    : undefined;
---

<footer class="foot">
  <div class="container">
    <div class="foot__sig-wrap">
      <p class="foot__signature" style={sigStyle} aria-hidden="true">{FOOTER_SIGNATURE}</p>
    </div>
    <div class="foot__legal">
      <p class="foot__copy">© {year} {PERSON_NAME} · {nicheHost('all')}</p>
      <a class="foot__link" href={MAIN_SITE_URL}>{mainHost} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(64px, 10vw, 128px);
    padding-bottom: calc(20px + env(safe-area-inset-bottom));
  }
  .foot__sig-wrap {
    container-type: inline-size;
    color: var(--text);
  }
  .foot__signature {
    font-family: var(--font-display);
    font-weight: 600;
    /* "Faraz Ahmad" in Clash 600 at -0.035em spans 6.315em (measured for the ai footer). */
    font-size: calc(100cqi / 6.29);
    line-height: 0.82;
    letter-spacing: -0.035em;
    white-space: nowrap;
    margin-left: -0.035em;
    user-select: none;
  }
  .foot__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 24px;
    margin-top: 20px;
    padding-top: 6px;
    border-top: 1px solid var(--line);
    color: var(--text-3);
    font-size: 0.875rem;
  }
  .foot__copy {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }
  .foot__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap);
    color: var(--text);
    text-decoration: underline 1px transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--dur-hover) var(--ease-out-expo);
  }
  .foot__link:focus-visible {
    text-decoration-color: var(--accent);
  }
  @media (hover: hover) {
    .foot__link:hover {
      text-decoration-color: var(--accent);
    }
  }
</style>
