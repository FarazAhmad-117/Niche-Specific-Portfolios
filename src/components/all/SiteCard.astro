---
/**
 * One live niche: preview (the niche's own OG image, a plain <img> since it is another site's
 * URL), label, its hero headline, a one-liner, its host in mono, then Open + Copy link.
 * The Open link is stretched over the whole card; Copy sits above it.
 */
import CopyButton from './CopyButton.astro';

interface Props {
  slug: string;
  label: string;
  headline?: string;
  description?: string;
  /** What the card opens: /<slug>/ in dev, https://<slug>.farazahmad.dev/ in production. */
  href: string;
  /** The niche's OG image, same dev/prod split as href. */
  image: string;
  /** Host shown in mono (the production host). */
  host: string;
  /** Position in the grid, for the reveal stagger. */
  index: number;
}

const { slug, label, headline, description, href, image, host, index } = Astro.props;
---

<li class="card" style={`--i:${index}`} id={`site-${slug}`}>
  <div class="card__media">
    <img
      src={image}
      width="1200"
      height="630"
      loading="lazy"
      decoding="async"
      alt={`Preview of the ${label} site${headline ? `: “${headline}”` : ''}`}
    />
  </div>
  <div class="card__body">
    <h3 class="card__label">{label}</h3>
    {headline && <p class="card__headline">“{headline}”</p>}
    {description && <p class="card__desc">{description}</p>}
    <p class="card__host">{host}</p>
  </div>
  <div class="card__actions">
    <a class="card__open" href={href}>
      Open<span class="visually-hidden"> the {label} site</span>
      <span class="card__arrow" aria-hidden="true">→</span>
    </a>
    <CopyButton href={href} name={`the ${label} site`} class="card__copy" />
  </div>
</li>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition:
      transform var(--dur-hover) var(--ease-out-expo),
      box-shadow var(--dur-hover) var(--ease-out-expo),
      border-color var(--dur-hover) var(--ease-out-expo);
  }
  @media (prefers-reduced-motion: no-preference) {
    .card {
      /* backwards, not both: after the reveal the hover transform must own `transform`. */
      animation: card-in 720ms var(--ease-out-quint) backwards;
      animation-delay: calc(80ms + var(--i, 0) * 55ms);
    }
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  .card__media {
    margin: 6px 6px 0;
    border-radius: calc(var(--radius) - 5px);
    overflow: hidden;
    aspect-ratio: 1200 / 630;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out-expo);
  }
  .card__body {
    display: grid;
    gap: 6px;
    padding: 14px 16px 0;
    flex: 1;
    align-content: start;
  }
  .card__label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-2);
  }
  .card__headline {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
    text-wrap: balance;
  }
  .card__desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-3);
  }
  .card__host {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }
  .card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 10px 10px 16px;
  }
  .card__open {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  /* The whole card opens the site. */
  .card__open::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card__open:focus-visible {
    outline: none;
  }
  .card__open:focus-visible::after {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
    border-radius: var(--radius);
  }
  .card__arrow {
    transition: transform var(--dur-hover) var(--ease-out-expo);
  }
  .card :global(.card__copy) {
    position: relative;
    z-index: 1;
  }
  @media (hover: hover) {
    .card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
      border-color: var(--line-strong);
    }
    .card:hover .card__media img {
      transform: scale(1.035);
    }
    .card:hover .card__arrow {
      transform: translateX(3px);
    }
  }
  .card:focus-within .card__arrow {
    transform: translateX(3px);
  }
</style>
