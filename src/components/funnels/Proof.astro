---
/**
 * Proof strip. Operational facts only (decisions: Lead Drift numbers not cleared yet),
 * each traceable to decisions.md or the owner's repo. No invented metrics.
 */
import { PROOF } from '../../data/funnels/content';
import { yearsBuilding } from '../../data/funnels/profile';

const facts = [...PROOF, { value: `${yearsBuilding()}+ years`, label: 'Building automations since 2022' }];
---

<section class="proof" id="proof" aria-labelledby="proof-title">
  <div class="container">
    <h2 id="proof-title" class="visually-hidden">Proof, in facts</h2>
    <ul class="proof__list" role="list" data-reveal-stagger>
      {
        facts.map((f) => (
          <li class="proof__item">
            <span class="proof__value">{f.value}</span>
            <span class="proof__label">{f.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proof {
    padding-block: var(--space-6) var(--space-4);
  }
  .proof__list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .proof__item {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .proof__item:first-child {
    background: var(--btn-bg);
    color: var(--btn-fg);
    box-shadow: none;
  }
  .proof__value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .proof__item:first-child .proof__value::after {
    content: '';
    display: inline-block;
    width: 0.3em;
    height: 0.3em;
    margin-left: 0.12em;
    border-radius: 50%;
    background: var(--accent);
  }
  .proof__label {
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.45;
  }
  .proof__item:first-child .proof__label {
    color: inherit;
    opacity: 0.78;
  }
</style>
