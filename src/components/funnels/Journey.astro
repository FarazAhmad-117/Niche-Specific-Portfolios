---
/**
 * ★ Signature: follow one lead (brief §4 item 4), as an in-place player, not a scroll-jack.
 *
 * Desktop: steps on the left (the current one open, with a story-style progress bar), a phone
 * on the right where each message lands on the spring. Phone: the phone first, then the
 * current step's card and a dot row. Costs about one screen of scroll on either.
 *
 * Playback: starts when a third of the player is on screen. The current step's progress bar
 * is a CSS animation, and its `animationend` advances the story, so pausing (button, off
 * screen, hidden tab) just pauses the bar and nothing can drift out of sync. Clicking a step,
 * prev or next hands control to the visitor (playback pauses; play resumes). Under reduced
 * motion it never autoplays and there is no play button: stepping is manual.
 *
 * Without JS: every step is open and the phone shows the whole thread.
 * The phone is a visual duplicate (aria-hidden); the ordered list is the accessible content.
 */
import { JOURNEY } from '../../data/funnels/content';

const n = JOURNEY.length;
const VB_W = 300;
const pts = JOURNEY.map((_, i) => ({ x: 14 + (i * (VB_W - 28)) / (n - 1), y: i % 2 ? 30 : 12 }));
const curveD = pts.reduce((d, p, i) => {
  if (i === 0) return `M${p.x} ${p.y}`;
  const prev = pts[i - 1]!;
  const mx = (prev.x + p.x) / 2;
  return `${d}C${mx} ${prev.y} ${mx} ${p.y} ${p.x} ${p.y}`;
}, '');
const STEP_MS = 3400;
---

<section class="section journey" id="follow" aria-labelledby="follow-title">
  <div class="container head head--split">
    <p class="eyebrow">Follow one lead</p>
    <h2 id="follow-title">From form to booked call, on its own.</h2>
    <p class="lede">
      Watch Sam, an example lead, move through a typical nurture build. Every step is something I set up and test before a
      real lead touches it.
    </p>
  </div>

  <div class="container">
    <div class="player" data-player style={`--step-ms:${STEP_MS}ms`} data-pause-offscreen>
      <div class="player__side">
        <ol class="steps" role="list">
          {
            JOURNEY.map((s, i) => (
              <li class="step" data-step={i} data-day={s.day} data-time={s.time} data-channel={s.channel}>
                <button class="step__btn" type="button" data-step-btn={i}>
                  <span class="step__dot" aria-hidden="true" />
                  <span class="step__when mono">
                    {s.day} · {s.time}
                  </span>
                  <span class="step__title">{s.title}</span>
                  <span class="visually-hidden">
                    , step {i + 1} of {n}
                  </span>
                </button>
                <div class="step__body">
                  <div class="step__body-inner">
                    <p class="step__text">{s.text}</p>
                    <div class="step__msg">
                      {s.msg.kind === 'event' || s.msg.kind === 'win' ? (
                        <p class:list={['event', { 'event--rose': s.msg.kind === 'win' }]}>{s.msg.text}</p>
                      ) : (
                        <p class:list={['bubble', s.msg.kind === 'out' ? 'bubble--out' : 'bubble--in']}>
                          {s.msg.meta && <span class="bubble__meta">{s.msg.meta}</span>}
                          {s.msg.text}
                        </p>
                      )}
                    </div>
                  </div>
                </div>
                <span class="step__bar" aria-hidden="true">
                  <span data-bar />
                </span>
              </li>
            ))
          }
        </ol>

        <div class="controls" data-controls hidden>
          <button class="ctl" type="button" data-prev aria-label="Previous step">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
          </button>
          <button class="ctl ctl--play" type="button" data-play aria-label="Pause the walkthrough">
            <svg class="ctl__pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6v12M15 6v12" /></svg>
            <svg class="ctl__play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
          </button>
          <button class="ctl" type="button" data-next aria-label="Next step">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
          </button>
          <span class="controls__count mono" aria-hidden="true">
            <span data-count>1</span> / {n}
          </span>
          <span class="controls__dots" aria-hidden="true">
            {JOURNEY.map((_, i) => <span class="controls__dot" data-dot={i} />)}
          </span>
        </div>
        <p class="journey__note text-3">Example lead and business. Timings are typical, not measured.</p>
      </div>

      <div class="phone" aria-hidden="true">
        <div class="phone__head">
          <div class="phone__count">
            <span class="phone__count-label mono">Stage</span>
            <span class="phone__count-num num"><span data-phone-num>{n}</span><span class="text-3">/{n}</span></span>
          </div>
          <div class="phone__clock mono">
            <span data-phone-day>{JOURNEY[n - 1]?.day}</span>
            <span class="phone__time" data-phone-time>{JOURNEY[n - 1]?.time}</span>
          </div>
        </div>
        <svg class="phone__curve" viewBox={`0 0 ${VB_W} 42`}>
          <path class="phone__curve-bg" d={curveD}></path>
          <path class="phone__curve-fg" d={curveD} pathLength="1" data-phone-curve></path>
          {pts.map((p, i) => <circle class="phone__node is-on" cx={p.x} cy={p.y} r="4.5" data-node={i} />)}
        </svg>
        <div class="phone__screen">
          <div class="phone__who">
            <span class="phone__avatar">S</span>
            <span><strong>Sam</strong> <span class="text-3">· example lead</span></span>
            <span class="phone__channel mono" data-phone-channel>{JOURNEY[n - 1]?.channel}</span>
          </div>
          <div class="phone__thread">
            {
              JOURNEY.map((s, i) => (
                <div class="pmsg is-on" data-pmsg={i}>
                  <div class="pmsg__inner">
                    {s.msg.kind === 'event' || s.msg.kind === 'win' ? (
                      <p class:list={['event', { 'event--rose': s.msg.kind === 'win' }]}>{s.msg.text}</p>
                    ) : (
                      <p class:list={['bubble', s.msg.kind === 'out' ? 'bubble--out' : 'bubble--in']}>
                        {s.msg.meta && <span class="bubble__meta">{s.msg.meta}</span>}
                        {s.msg.text}
                      </p>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .player {
    display: grid;
    gap: var(--space-6);
    padding: clamp(1rem, 0.6rem + 1.6vw, 2rem);
    border-radius: var(--radius-xl);
    background: var(--surface-1);
  }
  @media (min-width: 960px) {
    .player {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      gap: clamp(2rem, 1rem + 3vw, 4.5rem);
      align-items: center;
      padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    }
  }
  .player__side {
    display: grid;
    gap: var(--space-4);
    align-content: center;
    min-width: 0;
  }

  /* ---------- steps (no JS: all open, a plain list) ---------- */
  .steps {
    display: grid;
    gap: 4px;
    margin: 0;
  }
  .step {
    position: relative;
    padding: 10px 14px 12px 40px;
    border-radius: var(--radius-m);
    transition: background-color 420ms var(--ease-out-quint);
  }
  .step__btn {
    display: grid;
    gap: 2px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    color: var(--text);
    border-radius: var(--radius-s);
  }
  .step__dot {
    position: absolute;
    left: 14px;
    top: 16px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--surface-1);
    box-shadow: inset 0 0 0 2px var(--accent);
    transition:
      background-color 300ms var(--ease-out-quint),
      transform 520ms var(--ease-spring);
  }
  .step__when {
    color: var(--text-3);
    font-size: 0.6875rem;
  }
  .step__title {
    font-weight: 700;
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.3125rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .step__text {
    margin-top: 6px;
    color: var(--text-2);
    font-size: var(--fs-small);
    max-width: 52ch;
  }
  .step__msg {
    margin-top: var(--space-3);
    max-width: 28rem;
  }
  .step__msg .event {
    margin-inline: 0;
  }
  .step__bar {
    display: none;
  }
  .journey__note {
    font-size: 0.8125rem;
  }

  /* ---------- live (JS) ---------- */
  .is-live .step__btn {
    cursor: pointer;
  }
  .is-live .step.is-past .step__dot,
  .is-live .step[aria-current='step'] .step__dot {
    background: var(--accent);
  }
  .is-live .step[aria-current='step'] {
    background: var(--surface-2);
    box-shadow: var(--shadow-soft);
  }
  .is-live .step[aria-current='step'] .step__dot {
    transform: scale(1.25);
  }
  .is-live .step:not([aria-current='step']) .step__title {
    color: var(--text-2);
  }
  @media (hover: hover) {
    .is-live .step:not([aria-current='step']):hover {
      background: color-mix(in srgb, var(--surface-2) 55%, transparent);
    }
  }
  /* Accordion: only the current step opens; height glides via grid rows. */
  .is-live .step__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 560ms var(--ease-out-quint);
  }
  .is-live .step[aria-current='step'] .step__body {
    grid-template-rows: 1fr;
  }
  .is-live .step__body-inner {
    min-height: 0;
    overflow: hidden;
  }
  .is-live .step__text {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 300ms var(--ease-out-quint),
      transform 560ms var(--ease-out-quint);
  }
  .is-live .step[aria-current='step'] .step__text {
    opacity: 1;
    transform: none;
    transition-delay: 120ms;
  }
  /* Story-style progress bar on the current step. Its animationend advances the story. */
  .is-live .step__bar {
    display: block;
    position: absolute;
    left: 40px;
    right: 14px;
    bottom: 6px;
    height: 3px;
    border-radius: 3px;
    background: var(--line);
    overflow: hidden;
    opacity: 0;
    transition: opacity 300ms var(--ease-out-quint);
  }
  .is-live .step[aria-current='step'] .step__bar {
    opacity: 1;
  }
  .step__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }
  /* Always attached to the current bar and only paused/resumed, so a pause continues from
     where it stopped instead of restarting the step. */
  .is-live .step[aria-current='step'] .step__bar span {
    animation: bar-fill var(--dur, var(--step-ms)) linear forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .is-live .step__bar {
      display: none !important;
    }
  }
  .is-live:not(.is-playing) .step[aria-current='step'] .step__bar span,
  .is-live.is-paused .step[aria-current='step'] .step__bar span,
  .is-live.is-hidden-tab .step[aria-current='step'] .step__bar span {
    animation-play-state: paused;
  }
  @keyframes bar-fill {
    to {
      transform: scaleX(1);
    }
  }
  /* Desktop: the phone shows the message, so the step keeps only its text. */
  @media (min-width: 960px) {
    .is-live .step__msg {
      display: none;
    }
  }

  /* ---------- controls ---------- */
  .controls {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-left: 2px;
  }
  .ctl {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      transform var(--dur-press) var(--ease-out-quint),
      background-color var(--dur-hover) var(--ease-out-quint);
  }
  .ctl svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ctl--play {
    background: var(--btn-bg);
    color: var(--btn-fg);
    box-shadow: none;
  }
  .ctl--play .ctl__play path {
    fill: currentColor;
    stroke: none;
  }
  .ctl__play {
    display: none;
  }
  .ctl--play[data-state='paused'] .ctl__play {
    display: block;
  }
  .ctl--play[data-state='paused'] .ctl__pause {
    display: none;
  }
  @media (hover: hover) {
    .ctl:hover {
      transform: scale(1.06);
    }
  }
  .ctl:active {
    transform: scale(0.94);
  }
  .controls__count {
    white-space: nowrap;
    margin-left: 6px;
    color: var(--text-3);
  }
  .controls__dots {
    display: none;
  }

  /* ---------- the phone ---------- */
  .phone {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    gap: var(--space-3);
    width: 100%;
    max-width: 440px;
    height: 600px;
    justify-self: center;
    padding: var(--space-4);
    border-radius: var(--radius-xl);
    background: var(--bg);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-lift);
  }
  .phone__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 4px 8px 0;
  }
  .phone__count {
    display: grid;
    line-height: 1;
  }
  .phone__count-label {
    color: var(--text-3);
    margin-bottom: 6px;
  }
  .phone__count-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 3rem;
    letter-spacing: -0.04em;
  }
  .phone__count-num .text-3 {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }
  .phone__clock {
    display: grid;
    justify-items: end;
    gap: 2px;
    color: var(--text-3);
  }
  .phone__time {
    color: var(--text);
    font-size: 1rem;
  }
  .phone__curve {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .phone__curve-bg,
  .phone__curve-fg {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .phone__curve-bg {
    stroke: var(--line-strong);
    stroke-dasharray: 2 6;
  }
  .phone__curve-fg {
    stroke: var(--accent);
    stroke-dasharray: 1;
    stroke-dashoffset: var(--dash, 0);
    transition: stroke-dashoffset 700ms var(--ease-out-quint);
  }
  .phone__node {
    fill: var(--bg);
    stroke: var(--line-strong);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      fill 300ms var(--ease-out-quint),
      stroke 300ms var(--ease-out-quint),
      transform 520ms var(--ease-spring);
  }
  .phone__node.is-on {
    fill: var(--accent);
    stroke: var(--accent);
  }
  .phone__node.is-current {
    transform: scale(1.45);
  }
  .phone__screen {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-height: 0;
    border-radius: calc(var(--radius-xl) - 10px);
    background: var(--surface-1);
    overflow: hidden;
  }
  .phone__who {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    font-size: 0.875rem;
  }
  .phone__avatar {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-text);
    font-weight: 800;
    font-size: 0.8125rem;
  }
  .phone__channel {
    margin-left: auto;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--text-2);
  }
  /* Newest message at the bottom; older ones are pushed up and fade under the header. */
  .phone__thread {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 0;
    padding: 0 14px 14px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 56px);
    mask-image: linear-gradient(to bottom, transparent, #000 56px);
  }
  .pmsg {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 520ms var(--ease-out-quint);
  }
  .pmsg.is-on {
    grid-template-rows: 1fr;
  }
  .pmsg__inner {
    min-height: 0;
    overflow: hidden;
    padding: 5px 4px;
  }
  .pmsg__inner > * {
    opacity: 0;
    transform: translate3d(0, 16px, 0) scale(0.9);
    transition:
      opacity 240ms var(--ease-out-quint),
      transform 300ms var(--ease-out-quint);
  }
  .pmsg .bubble--out {
    transform-origin: 100% 100%;
  }
  .pmsg .bubble--in {
    transform-origin: 0% 100%;
  }
  .pmsg.is-on .pmsg__inner > * {
    opacity: 1;
    transform: none;
    transition:
      opacity 360ms var(--ease-out-quint) 90ms,
      transform var(--dur-bubble) var(--ease-spring) 90ms;
  }
  .pmsg .bubble {
    font-size: 0.9063rem;
  }

  /* ---------- phones: phone first, then only the current step and a dot row ---------- */
  @media (max-width: 959px) {
    .player__side {
      order: 2;
    }
    .phone {
      order: 1;
      height: 420px;
      max-width: none;
      padding: var(--space-3);
    }
    .phone__count-num {
      font-size: 2.25rem;
    }
    .is-live .step:not([aria-current='step']) {
      display: none;
    }
    .is-live .step__msg {
      display: none;
    }
    .is-live .step[aria-current='step'] {
      min-height: 9.5rem;
    }
    .controls__dots {
      display: flex;
      gap: 6px;
      margin-left: auto;
    }
    .controls__dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--line-strong);
      transition:
        background-color 300ms var(--ease-out-quint),
        width 420ms var(--ease-out-quint);
    }
    .controls__dot.is-on {
      background: var(--accent);
    }
    .controls__dot.is-current {
      width: 20px;
      border-radius: 4px;
    }
  }
  /* No JS on a phone: the phone would only repeat the list. */
  @media (max-width: 959px) {
    .player:not(.is-live) .phone {
      display: none;
    }
  }
</style>

<script>
  import { prefersReduced } from '../../lib/funnels/base';

  const player = document.querySelector<HTMLElement>('[data-player]');
  if (player) {
    const steps = [...player.querySelectorAll<HTMLElement>('[data-step]')];
    const pmsgs = [...player.querySelectorAll<HTMLElement>('[data-pmsg]')];
    const nodes = [...player.querySelectorAll<SVGCircleElement>('[data-node]')];
    const dots = [...player.querySelectorAll<HTMLElement>('[data-dot]')];
    const controls = player.querySelector<HTMLElement>('[data-controls]')!;
    const playBtn = player.querySelector<HTMLButtonElement>('[data-play]')!;
    const curve = player.querySelector<SVGPathElement>('[data-phone-curve]');
    const num = player.querySelector<HTMLElement>('[data-phone-num]');
    const count = player.querySelector<HTMLElement>('[data-count]');
    const day = player.querySelector<HTMLElement>('[data-phone-day]');
    const time = player.querySelector<HTMLElement>('[data-phone-time]');
    const channel = player.querySelector<HTMLElement>('[data-phone-channel]');
    const n = steps.length;
    const reduced = prefersReduced();

    let active = 0;
    let playing = false;
    let wantsPlay = !reduced; // the visitor's intent; visibility only gates it
    let started = false;

    const swap = (el: HTMLElement | null, text: string) => {
      if (!el || el.textContent === text) return;
      el.textContent = text;
      if (!reduced && typeof el.animate === 'function') {
        el.animate(
          [
            { transform: 'translateY(45%)', opacity: 0 },
            { transform: 'none', opacity: 1 },
          ],
          { duration: 460, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        );
      }
    };

    /** Restart the current bar's CSS animation from zero. */
    const restartBar = () => {
      const bar = steps[active]?.querySelector<HTMLElement>('[data-bar]');
      if (!bar) return;
      bar.style.animation = 'none';
      void bar.offsetWidth; // flush, so the next rule starts a fresh animation
      bar.style.animation = '';
    };

    const render = (i: number) => {
      active = (i + n) % n;
      steps.forEach((s, k) => {
        if (k === active) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
        s.classList.toggle('is-past', k < active);
      });
      pmsgs.forEach((m, k) => m.classList.toggle('is-on', k <= active));
      nodes.forEach((c, k) => {
        c.classList.toggle('is-on', k <= active);
        c.classList.toggle('is-current', k === active);
      });
      dots.forEach((d, k) => {
        d.classList.toggle('is-on', k <= active);
        d.classList.toggle('is-current', k === active);
      });
      curve?.style.setProperty('--dash', String(1 - active / Math.max(1, n - 1)));
      const s = steps[active]!;
      swap(num, String(active + 1));
      if (count) count.textContent = String(active + 1);
      swap(day, s.dataset.day ?? '');
      swap(time, s.dataset.time ?? '');
      swap(channel, s.dataset.channel ?? '');
      // The last step rests longer so "booked" lands before the loop restarts.
      player.style.setProperty('--dur', active === n - 1 ? 'calc(var(--step-ms) * 1.8)' : 'var(--step-ms)');
      restartBar();
    };

    const setPlaying = (on: boolean) => {
      playing = on;
      player.classList.toggle('is-playing', on);
      playBtn.dataset.state = wantsPlay ? 'playing' : 'paused';
      playBtn.setAttribute('aria-label', wantsPlay ? 'Pause the walkthrough' : 'Play the walkthrough');
    };

    // The bar finishing is the clock: advance, loop after the last step.
    player.addEventListener('animationend', (e) => {
      if (!playing || reduced) return;
      if (!(e.target instanceof HTMLElement) || !e.target.matches('[data-bar]')) return;
      render(active + 1);
    });

    const takeControl = (i: number) => {
      wantsPlay = false;
      setPlaying(false);
      render(i);
    };
    steps.forEach((s, i) => s.querySelector('[data-step-btn]')?.addEventListener('click', () => takeControl(i)));
    player.querySelector('[data-prev]')?.addEventListener('click', () => takeControl(active - 1));
    player.querySelector('[data-next]')?.addEventListener('click', () => takeControl(active + 1));
    playBtn.addEventListener('click', () => {
      wantsPlay = !wantsPlay;
      if (wantsPlay && active === n - 1) render(0);
      setPlaying(wantsPlay);
    });
    if (reduced) playBtn.hidden = true;

    player.classList.add('is-live');
    controls.hidden = false;
    render(0);
    setPlaying(false);

    // Play only while a third of the player is visible; the visitor's pause always wins.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => {
          if (!e) return;
          const visible = e.isIntersecting;
          if (visible && !started) {
            started = true;
            render(0);
          }
          setPlaying(visible && wantsPlay);
        },
        { threshold: 0.35 },
      ).observe(player);
    }
  }
</script>
