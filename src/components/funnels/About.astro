---
/**
 * About. The real portrait (black and white on black) sits in a soft organic frame with a
 * rose orbit; facts come from src/data/funnels/profile.ts only.
 */
import { Image } from 'astro:assets';
import { ABOUT } from '../../data/funnels/content';
import { PROFILE, yearsBuilding } from '../../data/funnels/profile';
import { TOOLS } from '../../data/funnels/site';

const facts = [
  { k: 'Based in', v: PROFILE.location },
  { k: 'Time zone', v: PROFILE.timeZone },
  { k: 'Building since', v: `${PROFILE.sinceYear} (${yearsBuilding()}+ years)` },
  { k: 'Company', v: `${PROFILE.companyRole}, ${PROFILE.company}` },
  { k: 'Builds in', v: TOOLS.join(', ') },
];
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <figure class="about__photo" data-reveal>
      <div class="about__frame">
        <Image
          src={PROFILE.portrait.src}
          alt={PROFILE.portrait.alt}
          widths={[320, 480, 640, 960]}
          sizes="(min-width: 1024px) 420px, 80vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <svg class="about__orbit" viewBox="0 0 200 200" aria-hidden="true">
        <path d="M100 8C160 8 192 52 192 100s-40 92-92 92S8 152 8 100 48 8 100 8" pathLength="1"></path>
        <circle r="7"><animateMotion dur="14s" repeatCount="indefinite" path="M100 8C160 8 192 52 192 100s-40 92-92 92S8 152 8 100 48 8 100 8"></animateMotion></circle>
      </svg>
      <figcaption class="visually-hidden">{PROFILE.name}</figcaption>
    </figure>

    <div class="about__copy">
      <p class="eyebrow">About</p>
      <h2 id="about-title">{ABOUT.title}</h2>
      {ABOUT.paragraphs.map((p, i) => <p class:list={[i === 0 ? 'lede' : 'about__p']}>{p}</p>)}
      <dl class="about__facts">
        {
          facts.map((f) => (
            <div>
              <dt class="mono">{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
  .about__photo {
    position: relative;
    width: min(100%, 420px);
    margin: 0 auto;
    aspect-ratio: 1;
  }
  .about__frame {
    position: absolute;
    inset: 7%;
    overflow: hidden;
    border-radius: 46% 54% 52% 48% / 50% 46% 54% 50%;
    background: #000;
    box-shadow: var(--shadow-lift);
  }
  .about__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .about__orbit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .about__orbit path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 0.006 0.012;
    vector-effect: non-scaling-stroke;
  }
  .about__orbit circle {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 3;
  }
  @media (prefers-reduced-motion: reduce) {
    .about__orbit circle {
      display: none;
    }
  }
  .about__copy {
    display: grid;
    gap: var(--space-5);
  }
  .about__copy h2 {
    max-width: 14ch;
  }
  .about__p {
    color: var(--text-2);
    max-width: var(--measure);
  }
  .about__facts {
    display: grid;
    gap: var(--space-3) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    margin: var(--space-3) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .about__facts dt {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .about__facts dd {
    margin: 2px 0 0;
    font-weight: 700;
  }
</style>
