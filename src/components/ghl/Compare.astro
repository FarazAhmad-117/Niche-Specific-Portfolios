---
/**
 * Comparison (brief §4 item 9): me vs a typical GHL VA vs a typical agency. A real table, so
 * screen readers get row and column headers. On phones each row becomes a small card with the
 * three answers side by side (no horizontal scroll).
 */
import { COMPARE } from '../../data/ghl/content';

const MARK_LABEL = { yes: 'Yes', some: 'Partly', no: 'No' } as const;
---

<section class="section compare" id="compare" aria-labelledby="compare-title">
  <div class="container">
    <div class="head head--split">
      <p class="eyebrow">Compare</p>
      <h2 id="compare-title">A developer, not another pair of hands in the builder.</h2>
      <p class="lede">{COMPARE.note}</p>
    </div>
    <div class="cmp" data-reveal>
      <table class="cmp__table">
        <caption class="visually-hidden">Working with me compared with a typical GoHighLevel VA and a typical agency</caption>
        <thead>
          <tr>
            <td class="cmp__corner"></td>
            {
              COMPARE.columns.map((c, i) => (
                <th scope="col" class:list={['cmp__col', { 'is-me': i === 0 }]}>
                  {c}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            COMPARE.rows.map((r) => (
              <tr>
                <th scope="row" class="cmp__row">
                  {r.label}
                </th>
                {r.cells.map((cell, i) => (
                  <td class:list={['cmp__cell', { 'is-me': i === 0 }]} data-col={COMPARE.columns[i]}>
                    <span class={`cmp__mark cmp__mark--${cell.mark}`} aria-hidden="true" />
                    <span class="visually-hidden">{MARK_LABEL[cell.mark]}: </span>
                    {cell.text}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .cmp {
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
  }
  .cmp__table {
    width: 100%;
    border-collapse: collapse;
  }
  .cmp__table th,
  .cmp__table td {
    padding: var(--space-4) var(--space-5);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  .cmp__table tbody tr:last-child > * {
    border-bottom: 0;
  }
  .cmp__col {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .cmp__col.is-me {
    color: var(--accent-text);
  }
  .cmp__row {
    font-weight: 600;
    width: 30%;
  }
  .cmp__cell {
    color: var(--text-2);
    font-size: var(--fs-small);
  }
  .cmp__cell.is-me {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    color: var(--text);
    font-weight: 500;
  }
  .cmp__mark {
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 8px;
    border-radius: 50%;
    vertical-align: 1px;
  }
  .cmp__mark--yes {
    background: var(--accent);
  }
  .cmp__mark--some {
    background: linear-gradient(90deg, var(--text-3) 50%, transparent 50%);
    box-shadow: inset 0 0 0 1.5px var(--text-3);
  }
  .cmp__mark--no {
    box-shadow: inset 0 0 0 1.5px var(--text-3);
  }

  /* Phones: each row is a card; the three answers sit in a 3-column grid, labelled. */
  @media (max-width: 719px) {
    .cmp {
      background: transparent;
      box-shadow: none;
      border-radius: 0;
    }
    .cmp__table,
    .cmp__table tbody,
    .cmp__table tr,
    .cmp__table th,
    .cmp__table td {
      display: block;
    }
    .cmp__table thead {
      display: none;
    }
    .cmp__table tbody {
      display: grid;
      gap: var(--space-3);
    }
    .cmp__table tr {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-radius: var(--radius-l);
      background: var(--surface-2);
      box-shadow: inset 0 0 0 1px var(--line);
      overflow: hidden;
    }
    .cmp__table th,
    .cmp__table td {
      border-bottom: 0;
      padding: var(--space-3);
    }
    .cmp__row {
      grid-column: 1 / -1;
      width: auto;
      border-bottom: 1px solid var(--line) !important;
    }
    .cmp__cell {
      font-size: 0.8125rem;
      line-height: 1.35;
    }
    .cmp__cell + .cmp__cell {
      border-left: 1px solid var(--line);
    }
    .cmp__cell::before {
      content: attr(data-col);
      display: block;
      margin-bottom: 4px;
      font-family: var(--font-mono);
      font-size: 0.625rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-3);
    }
    .cmp__cell.is-me::before {
      color: var(--accent-text);
    }
  }
</style>
