---
/**
 * Services. Five offers from decisions.md, no prices ("scoped on a call"); the sixth slot is
 * the free call itself. An "I run an agency / a business" switch (brief §4 item 6) rewrites
 * each offer's "Pick this if" line for that reader; it never hides an offer, so the grid
 * stays a full 3×2.
 *
 * Without JS the switch is hidden and both lines show, each labelled.
 */
import { OFFERS, PRICE_LINE } from '../../data/ghl/content';
import { bookingUrl } from '../../data/ghl/site';
---

<section class="section offers" id="services" aria-labelledby="services-title" data-offers data-audience="agency">
  <div class="container">
    <div class="head head--split">
      <p class="eyebrow">Services</p>
      <h2 id="services-title">Five ways in, for agencies and businesses.</h2>
      <div class="offers__intro">
        <p class="lede">Scope is agreed on a call before any work starts. Pick the one that sounds like you, or start with the call.</p>
        <div class="aud" role="group" aria-label="Show services for" data-aud hidden>
          <button type="button" class="aud__btn" data-aud-btn="agency" aria-pressed="true">I run an agency</button>
          <button type="button" class="aud__btn" data-aud-btn="business" aria-pressed="false">I run a business</button>
        </div>
      </div>
    </div>

    <ul class="offers__grid" role="list" data-reveal-stagger>
      {
        OFFERS.map((o, i) => (
          <li class="offer" id={`service-${o.id}`} data-notfor={o.notFor}>
            <div class="offer__top">
              <span class="offer__num mono" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {o.notFor === 'business' && <span class="tape offer__only">Agencies</span>}
            </div>
            <h3 class="offer__name">{o.name}</h3>
            <div class="offer__for">
              <p class="offer__line" data-for="agency">
                <span class="offer__for-label mono">
                  <span class="offer__for-js">Pick this if</span>
                  <span class="offer__for-nojs">Agencies: pick this if</span>
                </span>
                {o.forAgency}
              </p>
              <p class="offer__line" data-for="business">
                <span class="offer__for-label mono">
                  <span class="offer__for-js">Pick this if</span>
                  <span class="offer__for-nojs">Businesses: pick this if</span>
                </span>
                {o.forBusiness}
              </p>
            </div>
            <p class="offer__desc">{o.description}</p>
            <ul class="offer__gets" role="list">
              {o.gets.map((g) => (
                <li>{g}</li>
              ))}
            </ul>
            <div class="offer__foot">
              <span class="offer__price">{o.priceLine}</span>
              <a class="offer__cta" href={bookingUrl(`offer-${o.id}`)}>
                {o.cta}
                <span class="visually-hidden">: {o.name}</span>
                <span class="offer__arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        ))
      }
      <li class="offer offer--call inverse">
        <div class="offer__top">
          <span class="offer__num mono" aria-hidden="true">00</span>
        </div>
        <h3 class="offer__name">Not sure which?</h3>
        <p class="offer__desc">
          Start with the free 30-minute call. Bring your account, or the setup you have in mind; you leave with a clear next step.
        </p>
        <div class="offer__foot">
          <span class="offer__price">Free. Everything else is {PRICE_LINE.toLowerCase()}.</span>
        </div>
        <a class="btn offer__btn" href={bookingUrl('offer-unsure')}>
          <span class="btn__led" aria-hidden="true"></span>
          <span>Book a scoping call</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .offers__intro {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  @media (min-width: 960px) {
    .offers__intro {
      justify-self: end;
    }
  }
  .aud {
    display: inline-flex;
    flex-wrap: wrap;
    padding: 3px;
    border-radius: var(--radius-s);
    background: var(--surface-1);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .aud__btn {
    min-height: var(--tap);
    padding: 0 16px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--text-2);
    font-weight: 600;
    font-size: 0.9375rem;
    transition:
      background-color 360ms var(--ease-out-expo),
      color 360ms var(--ease-out-expo),
      box-shadow 360ms var(--ease-out-expo);
  }
  .aud__btn[aria-pressed='true'] {
    background: var(--btn-bg);
    color: var(--btn-fg);
    box-shadow: var(--shadow-soft);
  }

  .offers__grid {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  @media (min-width: 720px) {
    .offers__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .offers__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .offer {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto auto;
    gap: var(--space-4);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
    isolation: isolate;
    transition: box-shadow 600ms var(--ease-out-expo);
  }
  /* A teal rail lights along the top edge on hover, left to right, out-expo. */
  .offer::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 900ms var(--ease-out-expo);
  }
  @media (hover: hover) {
    .offer:hover::before {
      transform: scaleX(1);
    }
    .offer:not(.offer--call):hover {
      box-shadow:
        inset 0 0 0 1px var(--line-strong),
        var(--shadow-soft);
    }
  }
  .offer:focus-within::before {
    transform: scaleX(1);
  }
  .offer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 24px;
  }
  .offer__num {
    color: var(--accent-text);
  }
  .offer__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .offer__for {
    display: grid;
    gap: var(--space-2);
  }
  .offer__line {
    display: grid;
    gap: 4px;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--accent);
    background: var(--surface-1);
    font-weight: 500;
    line-height: 1.4;
  }
  .offer__for-label {
    color: var(--accent-text);
    text-transform: uppercase;
    font-size: 0.6875rem;
  }
  .offer__for-js {
    display: none;
  }
  /* Live: one line per audience, swapped with a short lift. */
  .offers.is-live .offer__for-js {
    display: inline;
  }
  .offers.is-live .offer__for-nojs {
    display: none;
  }
  .offers.is-live[data-audience='agency'] .offer__line[data-for='business'],
  .offers.is-live[data-audience='business'] .offer__line[data-for='agency'] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .offers.is-live .offer__line {
      animation: line-in 520ms var(--ease-out-quint) both;
    }
  }
  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .offers[data-audience='business'] .offer[data-notfor='business'] .offer__line {
    border-left-color: var(--line-strong);
  }
  .offer__desc {
    color: var(--text-2);
  }
  .offer__gets {
    display: grid;
    gap: 6px;
    margin: 0;
    font-size: var(--fs-small);
  }
  .offer__gets li {
    position: relative;
    padding-left: 22px;
  }
  .offer__gets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 12px;
    height: 7px;
    border-left: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg) translate(1px, -1px);
  }
  .offer__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .offer__price {
    color: var(--text-3);
    font-size: var(--fs-small);
  }
  .offer__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap);
    font-weight: 600;
    text-decoration: none;
    color: var(--text);
  }
  /* Stretch the link over the whole card, keep the text the only visible label. */
  .offer__cta::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .offer__cta:focus-visible {
    outline: none;
  }
  .offer:has(.offer__cta:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .offer__arrow {
    display: inline-block;
    transition: transform 520ms var(--ease-out-expo);
  }
  @media (hover: hover) {
    .offer:hover .offer__arrow {
      transform: translateX(5px);
    }
  }
  .offer--call {
    grid-template-rows: auto auto 1fr auto auto;
    background: var(--btn-bg);
    color: var(--btn-fg);
    box-shadow: none;
  }
  .offer--call .offer__num {
    color: var(--accent-inv);
  }
  .offer--call .offer__desc,
  .offer--call .offer__price {
    color: inherit;
    opacity: 0.8;
  }
  .offer--call .offer__foot {
    border-top-color: color-mix(in srgb, currentColor 20%, transparent);
  }
  .offer__btn {
    justify-self: start;
    background: var(--btn-fg);
    color: var(--btn-bg);
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-offers]');
  const group = section?.querySelector<HTMLElement>('[data-aud]');
  if (section && group) {
    const btns = [...group.querySelectorAll<HTMLButtonElement>('[data-aud-btn]')];
    const set = (aud: string) => {
      section.dataset.audience = aud;
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.audBtn === aud)));
    };
    btns.forEach((b) => b.addEventListener('click', () => set(b.dataset.audBtn ?? 'agency')));
    section.classList.add('is-live');
    group.hidden = false;
  }
</script>
