---
/**
 * FAQ. Native <details>, so it works without JS and with find-in-page. Where the browser
 * supports ::details-content and interpolate-size, the answer's height glides open on
 * out-quint; elsewhere it opens instantly. Copy is shared with the FAQPage JSON-LD.
 */
import { FAQ } from '../../data/ghl/content';
import { bookingUrl } from '../../data/ghl/site';
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__head">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title">What people ask first.</h2>
      <p class="lede">Something else? Ask it on the call; that’s what it’s for.</p>
      <a class="btn btn--ghost btn--side" href={bookingUrl('faq')}>
        <span>Book a scoping call</span>
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <div class="faq__list" data-reveal-stagger>
      {
        FAQ.map((f, i) => (
          <details class="qa">
            <summary class="qa__q">
              <span class="qa__num mono" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="qa__text">{f.q}</span>
              <span class="qa__switch" aria-hidden="true" />
            </summary>
            <p class="qa__a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 1024px) {
    .faq__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
    .faq__head {
      position: sticky;
      top: calc(var(--nav-h) + 48px);
    }
  }
  .faq__head {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .faq__list {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .qa {
    border-bottom: 1px solid var(--line);
    transition: background-color 400ms var(--ease-out-quint);
  }
  .qa[open] {
    background: var(--surface-1);
  }
  .qa__q {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    padding: var(--space-4) var(--space-4);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }
  .qa__q::-webkit-details-marker {
    display: none;
  }
  .qa__num {
    color: var(--text-3);
  }
  .qa[open] .qa__num {
    color: var(--accent-text);
  }
  /* A small toggle switch: off when closed, on (teal) when open. */
  .qa__switch {
    position: relative;
    flex: none;
    width: 30px;
    height: 16px;
    border-radius: 4px;
    background: var(--surface-1);
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
    transition:
      background-color 360ms var(--ease-out-quint),
      box-shadow 360ms var(--ease-out-quint);
  }
  .qa__switch::after {
    content: '';
    position: absolute;
    left: 3px;
    top: 3px;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--text-3);
    transition:
      transform 520ms var(--ease-spring),
      background-color 360ms var(--ease-out-quint);
  }
  .qa[open] .qa__switch {
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }
  .qa[open] .qa__switch::after {
    transform: translateX(14px);
    background: var(--accent);
  }
  .qa__a {
    padding: 0 var(--space-4) var(--space-5) calc(var(--space-4) * 2 + 2ch);
    color: var(--text-2);
    max-width: 66ch;
  }
  @media (max-width: 560px) {
    .qa__a {
      padding-left: var(--space-4);
    }
  }
  @supports selector(::details-content) {
    .qa {
      interpolate-size: allow-keywords;
    }
    .qa::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 520ms var(--ease-out-quint),
        content-visibility 520ms allow-discrete;
    }
    .qa[open]::details-content {
      block-size: auto;
    }
  }
</style>
