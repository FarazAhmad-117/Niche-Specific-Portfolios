</style>

<script>
  import { prefersReduced } from '../../lib/ghl/base';

  const sb = document.querySelector<HTMLElement>('[data-sb]');
  if (sb) {
    const steps = [...sb.querySelectorAll<HTMLElement>('[data-st]')];
    const segs = [...sb.querySelectorAll<HTMLElement>('[data-seg]')];
    const dots = [...sb.querySelectorAll<HTMLElement>('[data-dot]')];
    const flows = [...sb.querySelectorAll<HTMLElement>('[data-flow]')].filter((el) => el.classList.contains('flow'));
    const logs = [...sb.querySelectorAll<HTMLElement>('[data-log]')];
    const rows = [...sb.querySelectorAll<HTMLElement>('[data-row]')];
    const modeBtns = [...sb.querySelectorAll<HTMLButtonElement>('[data-mode-btn]')];
    const playBtn = sb.querySelector<HTMLButtonElement>('[data-play]')!;
    const faultsNum = sb.querySelector<HTMLElement>('[data-sb-faults]');
    const faultsLabel = sb.querySelector<HTMLElement>('[data-sb-faults-label]');
    const crumb = sb.querySelector<HTMLElement>('[data-crumb]');
    const statusText = sb.querySelector<HTMLElement>('[data-status-text]');
    const count = sb.querySelector<HTMLElement>('[data-sb-count]');
    const live = sb.querySelector<HTMLElement>('[data-sb-live]');
    const n = steps.length;
    // Per-step state comes from the markup, so no page copy is bundled into this script.
    const STEPS = steps.map((st) => ({
      mode: st.dataset.mode === 'before' ? 'before' : 'after',
      wf: st.dataset.wf ?? '',
      flow: st.dataset.flow ?? '',
      faults: Number(st.dataset.faults ?? 0),
      test: st.dataset.test !== undefined,
      title: st.dataset.title ?? '',
      status: st.dataset.status ?? 'Published',
      name: st.dataset.name ?? '',
    }));
    const reduced = prefersReduced();

    let active = 0;
    let playing = false;
    let wantsPlay = !reduced; // the visitor's intent; visibility only gates it
    let started = false;

    /** Restart the current segment's CSS animation from zero. */
    const restartFill = () => {
      const fill = segs[active]?.querySelector<HTMLElement>('[data-seg-fill]');
      if (!fill) return;
      fill.style.animation = 'none';
      void fill.offsetWidth; // flush, so the next rule starts a fresh animation
      fill.style.animation = '';
    };

    /** Toggling `is-on` off and on restarts the flow's card and log animations. */
    const replay = (el: HTMLElement | undefined) => {
      if (!el) return;
      el.classList.remove('is-on');
      void el.offsetWidth;
      el.classList.add('is-on');
    };

    const render = (i: number) => {
      const prev = STEPS[active];
      active = (i + n) % n;
      const s = STEPS[active]!;
      sb.dataset.step = String(active);
      sb.dataset.mode = s.mode;
      sb.dataset.status = s.status;
      if (s.test) sb.dataset.test = '';
      else delete sb.dataset.test;

      const flow = flows.find((f) => f.dataset.flow === s.flow);
      flows.forEach((f) => f !== flow && f.classList.remove('is-on'));
      // Same flow, new step (rewire → test): replay it so the test run starts from the top.
      if (flow && (!flow.classList.contains('is-on') || prev?.flow === s.flow)) replay(flow);
      logs.forEach((l, k) => (k === active ? replay(l) : l.classList.remove('is-on')));

      rows.forEach((r) => r.classList.toggle('is-sel', r.dataset.row === s.wf));
      // A fault dot stays on its row once the step that finds it has been reached.
      const found = new Set(STEPS.slice(0, active + 1).filter((x) => x.mode === 'before' && x.faults > 0).map((x) => x.wf));
      rows.forEach((r) => r.classList.toggle('is-found', s.mode === 'before' && found.has(r.dataset.row ?? '')));

      steps.forEach((st, k) => {
        if (k === active) st.setAttribute('aria-current', 'step');
        else st.removeAttribute('aria-current');
      });
      segs.forEach((g, k) => {
        g.classList.toggle('is-past', k < active);
        g.classList.toggle('is-current', k === active);
      });
      dots.forEach((d, k) => {
        d.classList.toggle('is-on', k <= active);
        d.classList.toggle('is-current', k === active);
      });
      modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modeBtn === s.mode)));
      if (faultsNum) faultsNum.textContent = String(s.faults);
      if (faultsLabel) faultsLabel.textContent = s.mode === 'before' ? 'Faults found' : 'Faults open';
      if (crumb) crumb.textContent = s.name;
      if (statusText) statusText.textContent = s.status;
      if (count) count.textContent = String(active + 1);
      // The test step rests longer so every tick lands before the loop.
      sb.style.setProperty('--dur', s.test ? 'calc(var(--step-ms) * 1.5)' : 'var(--step-ms)');
      restartFill();
    };

    const setPlaying = (on: boolean) => {
      playing = on;
      sb.classList.toggle('is-playing', on);
      playBtn.dataset.state = wantsPlay ? 'playing' : 'paused';
      playBtn.setAttribute('aria-label', wantsPlay ? 'Pause the walkthrough' : 'Play the walkthrough');
    };

    // The segment finishing is the clock: advance, loop after the last step.
    sb.addEventListener('animationend', (e) => {
      if (!playing || reduced) return;
      if (!(e.target instanceof HTMLElement) || !e.target.matches('[data-seg-fill]')) return;
      render(active + 1);
    });

    // Announce only what the visitor asked for (never autoplay), once, after it settles.
    let liveTimer: number | undefined;
    const announce = () => {
      window.clearTimeout(liveTimer);
      liveTimer = window.setTimeout(() => {
        const s = STEPS[active]!;
        if (live) live.textContent = `Step ${active + 1} of ${n}, ${s.mode}: ${s.title}`;
      }, 250);
    };
    const takeControl = (i: number) => {
      wantsPlay = false;
      setPlaying(false);
      render(i);
      announce();
    };
    steps.forEach((st, i) => st.querySelector('[data-st-btn]')?.addEventListener('click', () => takeControl(i)));
    sb.querySelector('[data-prev]')?.addEventListener('click', () => takeControl(active - 1));
    sb.querySelector('[data-next]')?.addEventListener('click', () => takeControl(active + 1));
    modeBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const target = STEPS.findIndex((s) => s.mode === b.dataset.modeBtn);
        if (target > -1 && STEPS[active]?.mode !== b.dataset.modeBtn) takeControl(target);
        else {
          wantsPlay = false;
          setPlaying(false);
        }
      }),
    );
    // Pointer shortcut: a list row jumps to the first step about that workflow. The steps
    // list is the keyboard path to the same content.
    rows.forEach((r) =>
      r.addEventListener('click', () => {
        const target = STEPS.findIndex((s) => s.wf === r.dataset.row);
        if (target > -1) takeControl(target);
      }),
    );
    playBtn.addEventListener('click', () => {
      wantsPlay = !wantsPlay;
      if (wantsPlay && active === n - 1) render(0);
      setPlaying(wantsPlay);
    });
    if (reduced) playBtn.hidden = true;

    sb.classList.add('is-live');
    sb.querySelectorAll<HTMLElement>('[data-sb-controls], [data-sb-segs], [data-sb-mode]').forEach((el) => (el.hidden = false));
    render(0);
    setPlaying(false);

    // Play only while a third of the player is visible; the visitor's pause always wins.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => {
          if (!e) return;
          const visible = e.isIntersecting;
          if (visible && !started) {
            started = true;
            render(0);
          }
          setPlaying(visible && wantsPlay);
        },
        { threshold: 0.33 },
      ).observe(sb);
    }
  }
</script>
