  }
  .is-live .st__text {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 300ms var(--ease-out-quint),
      transform 560ms var(--ease-out-quint);
  }
  .is-live .st[aria-current='step'] .st__text {
    opacity: 1;
    transform: none;
    transition-delay: 120ms;
  }
  .sb__controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ctl {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
