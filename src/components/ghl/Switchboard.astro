  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.97);
    }
  }
  @keyframes draw-down {
    from {
      transform: scaleY(0);
      opacity: 0;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @keyframes log-in {
    from {
      opacity: 0;
      transform: translateX(8px);
    }
  }
  @keyframes tag-pop {
    from {
      opacity: 0;
      transform: translateY(4px) scale(0.85);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes tick {
    from {
      opacity: 0;
      transform: scale(0.3);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes run {
    0% {
      box-shadow:
        inset 0 0 0 1px var(--line-strong),
        0 0 0 0 color-mix(in srgb, var(--accent) 40%, transparent);
    }
    40% {
      box-shadow:
        inset 0 0 0 2px var(--accent),
        0 0 0 6px color-mix(in srgb, var(--accent) 18%, transparent);
    }
    100% {
      box-shadow:
        inset 0 0 0 1.5px var(--accent),
        0 0 0 0 transparent;
    }
  }

  /* ---------- story segments ---------- */
  .sb__segs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 4px;
    padding-inline: 4px;
  }
  .seg {
    height: 3px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .seg__fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }
  .seg.is-past .seg__fill {
    transform: scaleX(1);
  }
  .seg.is-current .seg__fill {
    animation: seg-fill var(--dur, var(--step-ms)) linear forwards;
  }
  .sb:not(.is-playing) .seg.is-current .seg__fill {
    animation-play-state: paused;
  }
  @keyframes seg-fill {
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .seg.is-current .seg__fill {
      animation: none;
      transform: scaleX(1);
    }
  }

  /* =========================================================
     Steps, mode switch, controls
     ========================================================= */
  .sb__side {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    min-width: 0;
  }
  .sb__mode {
    display: inline-flex;
    justify-self: start;
    padding: 3px;
    border-radius: var(--radius-s);
    background: var(--surface-1);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .sb__mode-btn {
    min-height: 36px;
    padding: 0 16px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--text-2);
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      background-color 360ms var(--ease-out-expo),
      color 360ms var(--ease-out-expo),
      box-shadow 360ms var(--ease-out-expo);
  }
  .sb__mode-btn[aria-pressed='true'] {
    background: var(--surface-2);
    color: var(--text);
    box-shadow: var(--shadow-soft), inset 0 0 0 1px var(--line);
  }
  .sb__steps {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .st {
    position: relative;
    border-bottom: 1px solid var(--line);
  }
  .st::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    bottom: -1px;
    width: 3px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 520ms var(--ease-out-expo);
  }
  .st__btn {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-3);
    width: 100%;
    min-height: var(--tap);
    padding: 12px 4px 12px 14px;
    border: 0;
    background: none;
    color: var(--text);
    text-align: left;
  }
  .st__num {
    color: var(--text-3);
  }
  .st__title {
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  .st__mode {
    font-size: 0.6875rem;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .st__mode::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 6px;
    border-radius: 50%;
    vertical-align: 1px;
  }
  .st__mode--before::before {
    background: var(--fault-led);
  }
  .st__mode--after::before {
    background: var(--accent);
  }
  .st__text {
    padding: 0 4px 16px 14px;
