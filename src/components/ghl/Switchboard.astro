    }
    .log {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    }
    .win__body {
      min-height: 0;
    }
  }
  /* Below 1200: window first, then the current step only. */
  @media (max-width: 1199px) {
