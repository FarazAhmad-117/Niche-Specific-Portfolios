---
/**
 * About. The real portrait (black and white on black) mounted in a panel bezel with two
 * screws and a status strip; facts come from src/data/ghl/profile.ts only.
 */
import { Image } from 'astro:assets';
import { ABOUT } from '../../data/ghl/content';
import { PROFILE, yearsBuilding } from '../../data/ghl/profile';
import { STACK } from '../../data/ghl/site';

const facts = [
  { k: 'Based in', v: PROFILE.location },
  { k: 'Time zone', v: PROFILE.timeZone },
  { k: 'Building since', v: `${PROFILE.sinceYear} (${yearsBuilding()}+ years)` },
  { k: 'Company', v: `${PROFILE.companyRole}, ${PROFILE.company}` },
];
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <figure class="about__photo" data-reveal>
      <div class="about__bezel">
        <span class="about__screw" aria-hidden="true"></span>
        <span class="about__screw about__screw--r" aria-hidden="true"></span>
        <div class="about__frame">
          <Image
            src={PROFILE.portrait.src}
            alt={PROFILE.portrait.alt}
            widths={[320, 480, 640, 960]}
            sizes="(min-width: 1024px) 420px, 80vw"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="about__strip mono">
          <span class="led led--breathe" aria-hidden="true"></span>
          {PROFILE.name} · {PROFILE.timeZone}
        </figcaption>
      </div>
    </figure>

    <div class="about__copy">
      <p class="eyebrow">About</p>
      <h2 id="about-title">{ABOUT.title}</h2>
      {ABOUT.paragraphs.map((p, i) => <p class:list={[i === 0 ? 'lede' : 'about__p']}>{p}</p>)}
      <dl class="about__facts">
        {
          facts.map((f) => (
            <div>
              <dt class="mono">{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
      <div class="about__stack">
        <p class="mono about__stack-label">Works with</p>
        <ul role="list">
          {
            STACK.map((s) => (
              <li class="tape">{s}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
  .about__photo {
    width: min(100%, 420px);
    margin: 0 auto;
  }
  .about__bezel {
    position: relative;
    display: grid;
    gap: 10px;
    padding: 22px 22px 14px;
    border-radius: var(--radius-xl);
    background: var(--surface-1);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-lift);
  }
  .about__screw {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: linear-gradient(135deg, transparent 42%, var(--line-strong) 42% 58%, transparent 58%), var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .about__screw--r {
    left: auto;
    right: 8px;
  }
  .about__frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: #000;
  }
  .about__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .about__strip {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-3);
  }
  .about__copy {
    display: grid;
    gap: var(--space-5);
  }
  .about__copy h2 {
    max-width: 16ch;
  }
  .about__p {
    color: var(--text-2);
    max-width: var(--measure);
  }
  .about__facts {
    display: grid;
    gap: var(--space-3) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    margin: var(--space-3) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .about__facts dt {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .about__facts dd {
    margin: 2px 0 0;
    font-weight: 600;
  }
  .about__stack {
    display: grid;
    gap: var(--space-2);
  }
  .about__stack-label {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .about__stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
  }
</style>
