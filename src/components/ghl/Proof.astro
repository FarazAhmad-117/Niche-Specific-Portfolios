---
/**
 * Proof strip (brief §4 item 2): developer-level facts, each true of the owner's own pipeline.
 * No numbers we don't have: lead-delivery figures are a visible TODO chip.
 */
import { PROOF, PROOF_TODO } from '../../data/ghl/content';
---

<section class="proof" id="proof" aria-labelledby="proof-title">
  <div class="container">
    <h2 id="proof-title" class="visually-hidden">Proof</h2>
    <ul class="proof__rail" role="list" data-reveal-stagger>
      {
        PROOF.map((p, i) => (
          <li class="proof__item">
            <span class="proof__num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="proof__value">{p.value}</span>
            <span class="proof__label">{p.label}</span>
          </li>
        ))
      }
    </ul>
    <p class="proof__todo"><span class="todo">{PROOF_TODO}</span></p>
  </div>
</section>

<style>
  .proof {
    padding-block: var(--space-6) var(--space-4);
  }
  .proof__rail {
    display: grid;
    margin: 0;
    border-block: 1px solid var(--line);
  }
  @media (min-width: 720px) {
    .proof__rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .proof__rail {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .proof__item {
    position: relative;
    display: grid;
    gap: 6px;
    align-content: start;
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
  }
  .proof__item + .proof__item {
    border-top: 1px solid var(--line);
  }
  @media (min-width: 720px) {
    .proof__item + .proof__item {
      border-top: 0;
    }
    .proof__item:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .proof__item:nth-child(even) {
      padding-left: var(--space-5);
      border-left: 1px solid var(--line);
    }
  }
  @media (min-width: 1100px) {
    .proof__item:nth-child(n + 3) {
      border-top: 0;
    }
    .proof__item:not(:first-child) {
      padding-left: var(--space-5);
      border-left: 1px solid var(--line);
    }
  }
  .proof__num {
    color: var(--accent-text);
  }
  .proof__value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2.125rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .proof__label {
    color: var(--text-2);
    font-size: var(--fs-small);
    max-width: 32ch;
  }
  .proof__todo {
    margin-top: var(--space-4);
  }
</style>
