---
/**
 * What every build includes (brief §4 item 7). Six items, 3×2, each on a module plate with a
 * screw at the corner and a line icon.
 */
import { INCLUDED } from '../../data/ghl/content';

const ICONS: Record<(typeof INCLUDED)[number]['icon'], string> = {
  tag: 'M4 12.5V5h7.5l8 8-7.5 7.5zM8 8.5h.01',
  map: 'M9 4 3 6.5v13.5L9 17.5l6 2.5 6-2.5V4l-6 2.5zM9 4v13.5M15 6.5V20',
  flask: 'M9 3h6M10 3v6l-5.5 9.5A1.6 1.6 0 0 0 5.9 21h12.2a1.6 1.6 0 0 0 1.4-2.5L14 9V3M7.5 15h9',
  bell: 'M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15zM10 20.5a2 2 0 0 0 4 0',
  shield: 'M12 3 4.5 6v5.5c0 4.6 3.2 8.2 7.5 9.5 4.3-1.3 7.5-4.9 7.5-9.5V6zM8.8 12l2.2 2.2 4.4-4.4',
  play: 'M3.5 5.5h17v13h-17zM10 9v6l5-3z',
};
---

<section class="section included" id="included" aria-labelledby="included-title">
  <div class="container">
    <div class="head head--split">
      <p class="eyebrow">In every build</p>
      <h2 id="included-title">The parts most builds skip.</h2>
      <p class="lede">None of these are upsells. They’re how an account stays readable after I hand it back.</p>
    </div>
    <ul class="inc" role="list" data-reveal-stagger>
      {
        INCLUDED.map((item, i) => (
          <li class="inc__item">
            <span class="inc__screw" aria-hidden="true" />
            <div class="inc__head">
              <svg class="inc__icon" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
                <path d={ICONS[item.icon]} />
              </svg>
              <span class="inc__num mono" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <h3 class="inc__title">{item.title}</h3>
            <p class="inc__text">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .inc {
    display: grid;
    gap: 1px;
    margin: 0;
    border-radius: var(--radius-xl);
    background: var(--line);
    box-shadow: 0 0 0 1px var(--line);
    overflow: hidden;
  }
  @media (min-width: 720px) {
    .inc {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .inc {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .inc__item {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    background: var(--surface-2);
    transition: background-color 500ms var(--ease-out-quint);
  }
  @media (hover: hover) {
    .inc__item:hover {
      background: var(--bg);
    }
    .inc__item:hover .inc__icon path {
      stroke: var(--accent);
    }
  }
  .inc__screw {
    position: absolute;
    right: 14px;
    top: 14px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, transparent 42%, var(--line-strong) 42% 58%, transparent 58%), var(--surface-1);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .inc__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .inc__icon path {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 400ms var(--ease-out-quint);
  }
  .inc__num {
    color: var(--text-3);
  }
  .inc__title {
    font-size: 1.1875rem;
  }
  .inc__text {
    color: var(--text-2);
    font-size: var(--fs-small);
  }
</style>
