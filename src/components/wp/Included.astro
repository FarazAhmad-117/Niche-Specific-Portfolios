---
/**
 * "What every site includes" (brief §4 item 7): six items in a 3×2 grid ruled like a newspaper
 * page, a hairline between every column and row.
 */
import { INCLUDED } from '../../data/wp/content';
import { folio } from '../../data/wp/site';

const ICONS: Record<(typeof INCLUDED)[number]['icon'], string> = {
  backup: 'M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zM4 7v5c0 1.7 3.6 3 8 3s8-1.3 8-3V7M4 12v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5',
  staging: 'M3.5 6.5h11v8h-11zM9.5 14.5v3M6 17.5h7M14.5 9.5h6v8h-6',
  shield: 'M12 3.5l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9v-5zM9 12l2.2 2.2L15.5 10',
  blocks: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM16.5 13v7M13 16.5h7',
  redirect: 'M4 7h9a4 4 0 0 1 0 8H6M8.5 12L5.5 15l3 3M17 4l3 3-3 3',
  play: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17zM10 8.5v7l6-3.5z',
};
---

<section class="section inc" id="included" aria-labelledby="included-title">
  <div class="container">
    <div class="head head--split" data-draw>
      <p class="folio">
        <span class="folio__no">§ {folio('included')}</span>
        <span class="folio__name">In every site</span>
        <span>Standard</span>
      </p>
      <h2 id="included-title">What every site gets, whatever we start with.</h2>
      <p class="lede">Not extras on a menu. This is how I leave every WordPress site I work on.</p>
    </div>

    <ul class="inc__grid" role="list" data-reveal-stagger>
      {
        INCLUDED.map((it) => (
          <li class="inc__item">
            <svg class="inc__icon" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
              <path d={ICONS[it.icon]} />
            </svg>
            <h3 class="inc__title">{it.title}</h3>
            <p class="inc__text">{it.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .inc__grid {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--text);
  }
  @media (min-width: 640px) {
    .inc__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .inc__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .inc__item {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-5) var(--space-6) 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .inc__item {
      padding-left: var(--space-5);
      border-left: 1px solid var(--line);
    }
    .inc__item:nth-child(2n + 1) {
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (min-width: 1024px) {
    .inc__item:nth-child(2n + 1) {
      padding-left: var(--space-5);
      border-left: 1px solid var(--line);
    }
    .inc__item:nth-child(3n + 1) {
      padding-left: 0;
      border-left: 0;
    }
  }
  .inc__icon {
    margin-bottom: var(--space-2);
    color: var(--accent-text);
  }
  .inc__icon path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .inc__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.4375rem;
    line-height: 1.15;
    letter-spacing: -0.018em;
  }
  .inc__text {
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.5;
    max-width: 36ch;
  }
</style>
