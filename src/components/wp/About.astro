---
/**
 * About, set as a profile page: the real portrait (black and white on black) as a plate with a
 * caption rule, and the copy beside it. Facts come from src/data/wp/profile.ts only.
 */
import { Image } from 'astro:assets';
import { ABOUT } from '../../data/wp/content';
import { PROFILE, yearsBuilding } from '../../data/wp/profile';
import { folio } from '../../data/wp/site';

const facts = [
  { k: 'Based in', v: PROFILE.location },
  { k: 'Time zone', v: PROFILE.timeZone },
  { k: 'Building since', v: `${PROFILE.sinceYear} (${yearsBuilding()}+ years)` },
  { k: 'Company', v: `${PROFILE.companyRole}, ${PROFILE.company}` },
];
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="head" data-draw>
      <p class="folio">
        <span class="folio__no">§ {folio('about')}</span>
        <span class="folio__name">About</span>
        <span>Profile</span>
      </p>
    </div>
    <div class="about__grid">
      <figure class="about__photo" data-reveal>
        <div class="about__frame">
          <Image
            src={PROFILE.portrait.src}
            alt={PROFILE.portrait.alt}
            widths={[320, 480, 640, 960]}
            sizes="(min-width: 1024px) 400px, 80vw"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="about__cap mono">{PROFILE.name} · {PROFILE.location}</figcaption>
      </figure>

      <div class="about__copy">
        <h2 id="about-title">{ABOUT.title}</h2>
        {ABOUT.paragraphs.map((p, i) => <p class:list={[i === 0 ? 'lede about__lede' : 'about__p']}>{p}</p>)}
        <dl class="about__facts">
          {
            facts.map((f) => (
              <div>
                <dt class="kicker">{f.k}</dt>
                <dd>{f.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: var(--space-8);
      align-items: start;
    }
  }
  .about__photo {
    max-width: 420px;
    margin: 0;
  }
  .about__frame {
    overflow: hidden;
    border-radius: var(--radius-s);
    background: #000;
    aspect-ratio: 4 / 5;
  }
  .about__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about__cap {
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid var(--text);
    color: var(--text-3);
  }
  .about__copy {
    display: grid;
    gap: var(--space-5);
  }
  .about__copy h2 {
    max-width: 16ch;
  }
  .about__p {
    color: var(--text-2);
    max-width: var(--measure);
  }
  .about__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: var(--space-2) 0 0;
    border-top: 1px solid var(--line);
  }
  .about__facts div {
    display: grid;
    gap: 2px;
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-bottom: 1px solid var(--line);
  }
  .about__facts dd {
    margin: 0;
    font-weight: 500;
  }
</style>
