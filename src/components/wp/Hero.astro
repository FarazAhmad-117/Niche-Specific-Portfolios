---
/**
 * Hero. Left: the headline, set like a magazine cover line, and the two calls to action.
 * Right: a proof sheet. A page of an example site open in the block editor, two earlier proofs
 * stacked behind it. One block is selected per beat (2.8s): its outline and block tag snap on
 * (out-expo, spring) and its margin note is written in (out-quint), the way an editor marks
 * up a proof. Notes stay as they are reached; after the last one the sheet rests, then the
 * notes lift off together and the round starts again. Captioned as illustrative.
 *
 * Motion (all off under reduced motion): headline lines rise out of their own line boxes,
 * 90ms apart; a proofreader's underline draws under "yours"; three column rules draw down the
 * background. Without JS, or under reduced motion, the sheet shows its finished state (every
 * note written, nothing selected). The pause button uses one pattern: a fixed label and
 * aria-pressed.
 */
import { HERO, HERO_BLOCKS, HERO_CAPTION } from '../../data/wp/content';
import { EXAMPLE_SITE } from '../../data/wp/player';
import { bookingUrl } from '../../data/wp/site';

const n = HERO_BLOCKS.length;
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero__rules" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="hero__inner container">
    <div class="hero__copy">
      <p class="hero__dateline mono">
        <span>{HERO.eyebrow}</span>
        <span class="hero__dot" aria-hidden="true"></span>
        <span>Faraz Ahmad</span>
      </p>
      <h1 id="hero-title" class="hero__title" aria-label={HERO.headlineText}>
        {
          HERO.headline.map((line, li) => (
            <span class="hero__line" aria-hidden="true">
              <span class="hero__li" style={`--l:${li}`}>
                {line.map((run) =>
                  'em' in run && run.em ? (
                    <span class="em hero__em">
                      {run.t}
                      <svg class="hero__under" viewBox="0 0 120 12" preserveAspectRatio="none" aria-hidden="true">
                        <path d="M2 8.5C22 4.5 46 3.5 66 5.5S104 9.5 118 4" pathLength="1" />
                      </svg>
                    </span>
                  ) : (
                    <span>{run.t}</span>
                  ),
                )}
              </span>
            </span>
          ))
        }
      </h1>
      <p class="lede hero__lede">{HERO.lede}</p>
      <div class="hero__ctas">
        <a class="btn" href={bookingUrl('hero')}>
          <span>{HERO.primary}</span>
        </a>
        <a class="btn btn--ghost" href="#offer-audit">
          <span>{HERO.secondary}</span>
          <span class="btn__arrow" aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="hero__note text-3">{HERO.note}</p>
    </div>

    <figure class="sheet" data-sheet data-done aria-labelledby="sheet-cap">
      <div class="sheet__back sheet__back--2" aria-hidden="true"></div>
      <div class="sheet__back sheet__back--1" aria-hidden="true"></div>
      <div class="sheet__page" data-pause-offscreen>
        <div class="sheet__chrome">
          <span class="sheet__pil" aria-hidden="true">¶</span>
          <span class="sheet__doc">
            <span class="sheet__doc-name">Home</span>
            <span class="sheet__doc-meta mono">{EXAMPLE_SITE} · Page</span>
          </span>
          <span class="sheet__count mono" aria-hidden="true"><span data-sheet-count>{n}</span>/{n} checked</span>
          <button class="sheet__pp" type="button" data-sheet-pp aria-label="Pause the proof-sheet animation" aria-pressed="false" hidden>
            <svg class="sheet__pp-pause" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M9 6v12M15 6v12"></path></svg>
            <svg class="sheet__pp-play" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
          </button>
        </div>

        <ol class="sheet__body" role="list">
          {
            HERO_BLOCKS.map((b, i) => (
              <li class={`row row--${b.kind} is-on`} data-row={i}>
                <div class="blk" aria-hidden="true">
                  <span class="blk__tag mono">{b.block}</span>
                  {b.kind === 'heading' && (
                    <span class="blk__heading">
                      Notes from the <i>north shore</i>
                    </span>
                  )}
                  {b.kind === 'image' && (
                    <span class="blk__image">
                      <span class="blk__sun" />
                      <span class="blk__hill" />
                    </span>
                  )}
                  {b.kind === 'query' && (
                    <span class="blk__query">
                      {[0, 1, 2].map((q) => (
                        <span class="blk__post">
                          <span class="blk__thumb" />
                          <span class="blk__lines">
                            <span style={`--w:${[78, 64, 70][q]}%`} />
                            <span style={`--w:${[46, 52, 38][q]}%`} />
                          </span>
                        </span>
                      ))}
                    </span>
                  )}
                  {b.kind === 'buttons' && (
                    <span class="blk__buttons">
                      <span class="blk__btn">Subscribe</span>
                      <span class="blk__btn blk__btn--ghost">Read the issue</span>
                    </span>
                  )}
                  {b.kind === 'footer' && (
                    <span class="blk__footer">
                      <span style="--w:34%" />
                      <span style="--w:22%" />
                    </span>
                  )}
                </div>
                <p class="note">
                  <span class="note__mark">{b.mark}</span>
                  <span class="note__text">{b.note}</span>
                </p>
              </li>
            ))
          }
        </ol>
      </div>
      <figcaption id="sheet-cap" class="sheet__cap text-3">
        <span class="stamp">Illustrative</span>
        {HERO_CAPTION}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-top: calc(var(--nav-h) + clamp(2.5rem, 1.5rem + 4vw, 5.5rem));
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
    background: var(--bg);
  }
  /* Three faint column rules down the page, drawn in from the top. */
  .hero__rules {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: min(100% - 2 * var(--margin), var(--container-max));
    margin-inline: auto;
    pointer-events: none;
  }
  /* Rules run down the top margin and fade out within 100px (fixed lengths, so they stop above the copy at every width).
     Painted as a 1px gradient, so nothing crosses the headline. */
  .hero__rules span {
    background: linear-gradient(var(--line), var(--line) 40px, transparent 100px) right top / 1px
      100% no-repeat;
    transform-origin: top;
  }
  .hero__rules span:nth-child(1) {
    grid-column: 1;
  }
  .hero__rules span:nth-child(2) {
    grid-column: 2;
  }
  .hero__rules span:nth-child(3) {
    grid-column: 3;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__rules span {
      animation: hero-rule 1600ms var(--ease-out-quint) both;
    }
    .hero__rules span:nth-child(2) {
      animation-delay: 120ms;
    }
    .hero__rules span:nth-child(3) {
      animation-delay: 240ms;
    }
  }
  @keyframes hero-rule {
    from {
      transform: scaleY(0);
    }
  }

  /* ---------- layout ---------- */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
    align-items: center;
  }
  @media (min-width: 1100px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      min-height: min(74svh, 720px);
    }
  }
  .hero__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .hero__dateline {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
    border-block: 1px solid var(--text);
    color: var(--text-2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hero__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .hero__title {
    margin-top: var(--space-2);
  }
  /* Each line rises inside its own clipped box. The padding (cancelled by the negative margin)
     keeps descenders and the underline inside the clip. */
  .hero__line {
    display: block;
    overflow: clip;
    padding: 0.02em 0.06em 0.16em;
    margin: -0.02em -0.06em -0.16em;
  }
  .hero__li {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__li {
      animation: hero-rise 1100ms var(--ease-out-quint) both;
      animation-delay: calc(80ms + var(--l) * 90ms);
    }
  }
  @keyframes hero-rise {
    from {
      transform: translate3d(0, 105%, 0);
    }
  }
  .hero__em {
    position: relative;
    display: inline-block;
    padding-right: 0.04em;
  }
  /* A proofreader's underline: hand-drawn, behind the descenders. */
  .hero__under {
    position: absolute;
    left: -0.02em;
    right: 0.02em;
    bottom: -0.06em;
    width: calc(100% + 0.04em);
    height: 0.14em;
    overflow: visible;
    z-index: -1;
  }
  .hero__em {
    isolation: isolate;
  }
  .hero__under path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__under path {
      animation: hero-under 900ms var(--ease-in-out-quart) 1000ms both;
    }
  }
  @keyframes hero-under {
    from {
      stroke-dashoffset: 1;
    }
  }
  .hero__lede {
    max-width: 48ch;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .hero__note {
    margin: 0;
    font-size: var(--fs-small);
    max-width: 46ch;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__dateline,
    .hero__lede,
    .hero__ctas,
    .hero__note,
    .sheet {
      animation: hero-lift 900ms var(--ease-out-quint) both;
    }
    .hero__lede {
      animation-delay: 420ms;
    }
    .hero__ctas {
      animation-delay: 520ms;
    }
    .hero__note {
      animation-delay: 600ms;
    }
    .sheet {
      animation-delay: 300ms;
    }
  }
  @keyframes hero-lift {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0);
    }
  }

  /* =========================================================
     The proof sheet
     ========================================================= */
  .sheet {
    position: relative;
    width: 100%;
    max-width: 540px;
    justify-self: center;
    margin: 0;
    padding: 18px 18px 0 0;
  }
  @media (min-width: 1100px) {
    .sheet {
      justify-self: end;
    }
  }
  /* Earlier proofs, stacked behind: depth, and "this page has been through rounds". */
  .sheet__back {
    position: absolute;
    border-radius: var(--radius-m);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
  }
  .sheet__back--2 {
    inset: 0 0 64px 36px;
    transform: rotate(2.2deg);
    background: var(--surface-1);
  }
  .sheet__back--1 {
    inset: 9px 9px 52px 18px;
    transform: rotate(1deg);
  }
  .sheet__page {
    position: relative;
    display: grid;
    border-radius: var(--radius-m);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-lift);
  }
  .sheet__chrome {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 10px 12px 10px 14px;
    border-bottom: 1px solid var(--line);
  }
  .sheet__pil {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-s);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1;
  }
  .sheet__doc {
    display: grid;
    line-height: 1.2;
    min-width: 0;
  }
  .sheet__doc-name {
    font-weight: 600;
    font-size: 0.875rem;
  }
  .sheet__doc-meta {
    color: var(--text-3);
    font-size: 0.6875rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sheet__count {
    margin-left: auto;
    color: var(--text-2);
    font-size: 0.6875rem;
    white-space: nowrap;
  }
  .sheet__count span {
    color: var(--accent-text);
    font-weight: 600;
  }
  .sheet__pp {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-s);
    background: var(--surface-1);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .sheet__pp svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .sheet__pp-play path {
    fill: currentColor;
    stroke: none;
  }
  .sheet__pp-play,
  .sheet__pp[aria-pressed='true'] .sheet__pp-pause {
    display: none;
  }
  .sheet__pp[aria-pressed='true'] .sheet__pp-play {
    display: block;
  }

  /* Page column + margin column, one row per block. */
  .sheet__body {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 16px 14px 18px 18px;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9.5rem;
    gap: 16px;
    align-items: center;
  }
  .blk {
    position: relative;
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-xs);
    box-shadow: inset 0 0 0 1px transparent;
    transition: box-shadow 420ms var(--ease-out-expo);
  }
  /* The block tag: the editor's label on a selected block. */
  .blk__tag {
    position: absolute;
    left: 6px;
    top: -10px;
    padding: 0 6px;
    border-radius: var(--radius-xs);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.6875rem;
    line-height: 1.6;
    opacity: 0;
    transform: translateY(4px) scale(0.9);
    transform-origin: left bottom;
    transition:
      opacity 240ms var(--ease-out-quint),
      transform 520ms var(--ease-spring);
  }
  .row.is-sel .blk {
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }
  .row.is-sel .blk__tag {
    opacity: 1;
    transform: none;
  }

  /* Block mocks: shapes, and a line of real text in the heading. */
  .blk__heading {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.3125rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .blk__heading i {
    color: var(--accent-text);
  }
  .blk__image {
    position: relative;
    display: block;
    height: 86px;
    border-radius: var(--radius-xs);
    background: linear-gradient(180deg, var(--accent-soft), color-mix(in srgb, var(--accent-soft) 40%, var(--surface-1)));
    overflow: hidden;
  }
  .blk__sun {
    position: absolute;
    right: 22%;
    top: 18px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.55;
  }
  .blk__hill {
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: -38px;
    height: 74px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--text) 18%, var(--surface-1));
  }
  .blk__query {
    display: grid;
    gap: 7px;
  }
  .blk__post {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 9px;
    align-items: center;
  }
  .blk__thumb {
    height: 22px;
    border-radius: var(--radius-xs);
    background: var(--surface-1);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .blk__lines,
  .blk__footer {
    display: grid;
    gap: 5px;
  }
  .blk__lines span,
  .blk__footer span {
    display: block;
    width: var(--w);
    height: 5px;
    border-radius: 3px;
    background: var(--line);
  }
  .blk__lines span:first-child {
    background: color-mix(in srgb, var(--text) 32%, var(--surface-2));
  }
  .blk__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .blk__btn {
    padding: 3px 12px;
    border-radius: var(--radius-xs);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.6;
  }
  .blk__btn--ghost {
    background: transparent;
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .blk__footer {
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }

  /* A margin note: a rule out from the block, the mark in ultramarine italic, then the note. */
  .note {
    position: relative;
    display: grid;
    gap: 1px;
    padding-left: 12px;
    border-left: 1.5px solid var(--accent);
    line-height: 1.3;
  }
  .note::before {
    content: '';
    position: absolute;
    right: 100%;
    top: 50%;
    width: 14px;
    height: 1px;
    background: var(--accent);
  }
  .note__mark {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.15;
    color: var(--accent-text);
  }
  .note__text {
    color: var(--text-2);
    font-size: 0.75rem;
  }
  /* A note not reached yet: the slot shows only a faint rule, nothing to read. */
  .note {
    clip-path: inset(0 0 0 0);
    transition: clip-path 700ms var(--ease-out-quint);
  }
  .row:not(.is-on) .note {
    clip-path: inset(0 100% 0 0);
    transition-duration: 380ms;
  }
  .sheet[data-static] .note {
    transition: none;
  }

  .sheet__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin-top: var(--space-4);
    padding-inline: 4px;
    font-size: 0.8125rem;
  }

  /* Narrow: the margin moves under each block. */
  @media (max-width: 560px) {
    .sheet {
      padding: 12px 12px 0 0;
    }
    .sheet__body {
      padding: 14px 12px 16px 14px;
    }
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
    .note {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
      column-gap: 8px;
      margin-left: 10px;
    }
    .note::before {
      display: none;
    }
    .blk__heading {
      font-size: 1.125rem;
    }
    .blk__image {
      height: 64px;
    }
    .blk__query .blk__post:nth-child(3) {
      display: none;
    }
    .sheet__doc-meta {
      display: none;
    }
  }
</style>

<script>
  import { prefersReduced } from '../../lib/wp/base';

  const sheet = document.querySelector<HTMLElement>('[data-sheet]');
  if (sheet && !prefersReduced()) {
    const rows = [...sheet.querySelectorAll<HTMLElement>('[data-row]')];
    const count = sheet.querySelector<HTMLElement>('[data-sheet-count]');
    const pp = sheet.querySelector<HTMLButtonElement>('[data-sheet-pp]');
    const n = rows.length;
    const last = n - 1;
    const BEAT_MS = 2800;
    const HOLD = 2; // extra beats resting on the finished sheet before the round restarts

    /** -1 = a fresh sheet (no notes); 0..last = that block is selected, notes up to it written. */
    const show = (i: number, select = true) => {
      rows.forEach((r, k) => {
        r.classList.toggle('is-on', k <= i);
        r.classList.toggle('is-sel', select && k === i);
      });
      if (count) count.textContent = String(Math.max(0, i + 1));
      if (i === last && !select) sheet.dataset.done = '';
      else delete sheet.dataset.done;
    };

    let beat = -1;
    let timer: number | undefined;
    let visible = false;
    let userPaused = false; // the visitor's pause always wins (WCAG 2.2.2)
    const tick = () => {
      beat = beat + 1 > n + HOLD - 1 ? -1 : beat + 1;
      if (beat <= last) show(beat);
      else show(last, false); // resting: everything written, nothing selected
    };
    const play = () => {
      if (timer !== undefined || !visible || document.hidden || userPaused) return;
      timer = window.setInterval(tick, BEAT_MS);
    };
    const pause = () => {
      window.clearInterval(timer);
      timer = undefined;
    };
    if (pp) {
      pp.hidden = false;
      pp.addEventListener('click', () => {
        userPaused = !userPaused;
        pp.setAttribute('aria-pressed', String(userPaused));
        if (userPaused) {
          pause();
          // Paused means finished: every note written, nothing half-drawn.
          beat = last + HOLD;
          show(last, false);
        } else play();
      });
    }
    // The server render is the finished sheet; start from a fresh one without animating the wipe.
    sheet.dataset.static = '';
    show(-1);
    requestAnimationFrame(() => requestAnimationFrame(() => delete sheet.dataset.static));
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        visible = Boolean(e?.isIntersecting);
        if (visible) play();
        else pause();
      }).observe(sheet);
    } else {
      visible = true;
      play();
    }
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
  }
</script>
