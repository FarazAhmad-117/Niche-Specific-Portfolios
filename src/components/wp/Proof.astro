---
/**
 * Proof strip (brief §4 item 2), set as a newspaper index line: four cells between rules. The
 * brief asks for sites, speed gains and plugins removed; those numbers are open
 * (decisions.md › wp › Real numbers per case), so they are dashed TODO slots, never a guess.
 * The filled cell is a verified fact about AI SEO Automator.
 */
import { PROOF } from '../../data/wp/content';
---

<section class="proof" id="proof" aria-label="Proof">
  <div class="container">
    <ul class="proof__row" role="list">
      <li class="proof__cell proof__cell--fact">
        <span class="proof__value">{PROOF.filled.value}</span>
        <span class="proof__label">{PROOF.filled.label}</span>
      </li>
      {
        PROOF.todo.map((t) => (
          <li class="proof__cell">
            <span class="proof__value proof__value--empty" aria-hidden="true">—</span>
            <span class="proof__label">{t.label}</span>
            <span class="todo">{t.chip}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proof {
    position: relative;
    padding-block: var(--space-5) var(--space-6);
  }
  .proof__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--text);
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 960px) {
    .proof__row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .proof__cell {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: var(--space-5) var(--space-4) var(--space-5) 0;
  }
  .proof__cell + .proof__cell {
    padding-left: var(--space-4);
    border-left: 1px solid var(--line);
  }
  @media (max-width: 959px) {
    .proof__cell:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .proof__cell:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  .proof__value {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.75rem, 1.5rem + 0.9vw, 2.375rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .proof__cell--fact .proof__value {
    font-style: italic;
    color: var(--accent-text);
  }
  .proof__value--empty {
    color: var(--text-3);
  }
  .proof__label {
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.45;
    max-width: 30ch;
  }
  .proof .todo {
    margin-top: 4px;
  }
</style>
