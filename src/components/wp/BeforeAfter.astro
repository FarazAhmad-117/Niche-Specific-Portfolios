<script>
  import { prefersReduced } from '../../lib/wp/base';

  const ba = document.querySelector<HTMLElement>('[data-ba]');
  if (ba) {
    const steps = [...ba.querySelectorAll<HTMLElement>('[data-st]')];
    const segs = [...ba.querySelectorAll<HTMLElement>('[data-seg]')];
    const dots = [...ba.querySelectorAll<HTMLElement>('[data-dot]')];
    const screens = [...ba.querySelectorAll<HTMLElement>('[data-scr]')];
    const menuItems = [...ba.querySelectorAll<HTMLElement>('[data-mi]')];
    const playBtn = ba.querySelector<HTMLButtonElement>('[data-play]')!;
    const crumb = ba.querySelector<HTMLElement>('[data-crumb]');
    const modePill = ba.querySelector<HTMLElement>('[data-mode-pill]');
    const badge = ba.querySelector<HTMLElement>('[data-badge]');
    const countPlugins = ba.querySelector<HTMLElement>('[data-count-plugins]');
    const countUpdates = ba.querySelector<HTMLElement>('[data-count-updates]');
    const count = ba.querySelector<HTMLElement>('[data-ba-count]');
    const live = ba.querySelector<HTMLElement>('[data-ba-live]');
    const cmp = ba.querySelector<HTMLElement>('[data-cmp]')!;
    const handle = ba.querySelector<HTMLElement>('[data-cmp-handle]')!;
    const cmpPlugins = ba.querySelector<HTMLElement>('[data-cmp-plugins]');
    const meter = ba.querySelector<HTMLElement>('[data-cmp-meter]');
    const n = steps.length;

    // Example-site numbers (src/data/wp/player.ts COUNTS); the meter is relative, no units.
    const BEFORE = { plugins: 47, updates: 9, weight: 0.92 };
    const AFTER = { plugins: 12, updates: 0, weight: 0.24 };
    const CRUMBS: Record<string, string> = {
      plugins: 'Plugins › Installed plugins',
      health: 'Tools › Site Health',
      editor: 'Appearance › Editor › Home',
      compare: 'Pages › Home › Preview',
    };
    const MODES: Record<string, string> = { before: 'Before', fix: 'On staging', after: 'After' };

    // Per-step state comes from the markup, so no page copy is bundled into this script.
    const STEPS = steps.map((st) => ({
      mode: st.dataset.mode ?? 'after',
      screen: st.dataset.screen ?? 'compare',
      menu: st.dataset.menu ?? '',
      flags: st.dataset.flags !== undefined,
      fixed: st.dataset.fixed !== undefined,
      title: st.dataset.title ?? '',
    }));
    const reduced = prefersReduced();

    let active = n - 1;
    let playing = false;
    let wantsPlay = !reduced; // the visitor's intent; visibility only gates it
    let visible = false;
    let started = false;
    let userCompare = false; // the visitor has taken the compare handle

    /* ---------- the compare ---------- */
    let pos = 50;
    const setPos = (p: number) => {
      pos = Math.max(0, Math.min(100, p));
      cmp.style.setProperty('--pos', `${pos}%`);
      // The before page shows left of the divider: more "before" means more plugins.
      const t = pos / 100;
      const plugins = Math.round(AFTER.plugins + (BEFORE.plugins - AFTER.plugins) * t);
      if (cmpPlugins) cmpPlugins.textContent = String(plugins);
      if (meter) meter.style.width = `${(AFTER.weight + (BEFORE.weight - AFTER.weight) * t) * 100}%`;
      handle.setAttribute('aria-valuenow', String(Math.round(pos)));
      handle.setAttribute(
        'aria-valuetext',
        `${Math.round(100 - pos)}% of the after page shown; ${plugins} plugins on this illustrative scale`,
      );
    };

    /** Story clock → divider: hold, sweep toward "before", across to "after", settle. */
    const sweepAt = (p: number): number => {
      const ease = (x: number) => 0.5 - Math.cos(Math.PI * x) / 2;
      const seg = (a: number, b: number, from: number, to: number) => from + (to - from) * ease((p - a) / (b - a));
      if (p < 0.1) return 50;
      if (p < 0.38) return seg(0.1, 0.38, 50, 88);
      if (p < 0.74) return seg(0.38, 0.74, 88, 10);
      if (p < 0.94) return seg(0.74, 0.94, 10, 50);
      return 50;
    };
    let raf = 0;
    const fillAnim = (): Animation | undefined =>
      segs[active]?.querySelector<HTMLElement>('[data-seg-fill]')?.getAnimations()[0];
    const sweepLoop = () => {
      raf = 0;
      if (STEPS[active]?.screen !== 'compare' || userCompare || reduced) return;
      const a = fillAnim();
      const dur = a?.effect?.getTiming().duration;
      const t = a?.currentTime;
      if (a && typeof dur === 'number' && typeof t === 'number' && dur > 0) setPos(sweepAt(Math.min(1, t / dur)));
      if (playing) raf = requestAnimationFrame(sweepLoop);
    };
    const kickSweep = () => {
      if (!raf && playing) raf = requestAnimationFrame(sweepLoop);
    };

    /* ---------- counters ---------- */
    let shown = { plugins: AFTER.plugins, updates: AFTER.updates };
    let countRaf = 0;
    const paintCounts = (p: number, u: number) => {
      if (countPlugins) countPlugins.textContent = String(p);
      if (countUpdates) countUpdates.textContent = String(u);
      if (badge) {
        badge.textContent = String(u);
        badge.classList.toggle('is-zero', u === 0);
      }
    };
    const rollCounts = (to: { plugins: number; updates: number }) => {
      cancelAnimationFrame(countRaf);
      const from = { ...shown };
      shown = { ...to };
      if (reduced || (from.plugins === to.plugins && from.updates === to.updates)) {
        paintCounts(to.plugins, to.updates);
        return;
      }
      const t0 = performance.now();
      const D = 1100;
      const frame = (now: number) => {
        const k = Math.min(1, (now - t0) / D);
        const e = 1 - Math.pow(1 - k, 4);
        paintCounts(
          Math.round(from.plugins + (to.plugins - from.plugins) * e),
          Math.round(from.updates + (to.updates - from.updates) * e),
        );
        if (k < 1) countRaf = requestAnimationFrame(frame);
      };
      // The count rolls once the struck lines have started drawing.
      window.setTimeout(() => (countRaf = requestAnimationFrame(frame)), 500);
    };

    /** Restart the current segment's CSS animation from zero. */
    const restartFill = () => {
      const fill = segs[active]?.querySelector<HTMLElement>('[data-seg-fill]');
      if (!fill) return;
      fill.style.animation = 'none';
      void fill.offsetWidth; // flush, so the next rule starts a fresh animation
      fill.style.animation = '';
    };
    /** Toggling `is-on` off and on restarts a screen's row animations. */
    const replay = (el: HTMLElement) => {
      el.classList.remove('is-on');
      void el.offsetWidth;
      el.classList.add('is-on');
    };

    const render = (i: number) => {
      active = (i + n) % n;
      const s = STEPS[active]!;
      ba.dataset.step = String(active);
      ba.dataset.mode = s.mode;
      ba.dataset.screen = s.screen;
      if (s.flags) ba.dataset.flags = '';
      else delete ba.dataset.flags;
      if (s.fixed) ba.dataset.fixed = '';
      else delete ba.dataset.fixed;

      screens.forEach((el) => (el.dataset.scr === s.screen ? replay(el) : el.classList.remove('is-on')));
      menuItems.forEach((m) => m.classList.toggle('is-cur', m.dataset.mi === s.menu));
      if (crumb) crumb.textContent = CRUMBS[s.screen] ?? '';
      if (modePill) modePill.textContent = MODES[s.mode] ?? '';
      rollCounts(s.fixed ? AFTER : BEFORE);

      steps.forEach((st, k) => {
        st.classList.toggle('is-current', k === active);
        const b = st.querySelector('[data-st-btn]');
        if (k === active) b?.setAttribute('aria-current', 'step');
        else b?.removeAttribute('aria-current');
      });
      segs.forEach((g, k) => {
        g.classList.toggle('is-past', k < active);
        g.classList.toggle('is-current', k === active);
      });
      dots.forEach((d, k) => {
        d.classList.toggle('is-on', k <= active);
        d.classList.toggle('is-current', k === active);
      });
      if (count) count.textContent = String(active + 1);

      // The compare rests longer, so the sweep can run there and back.
      ba.style.setProperty('--dur', s.screen === 'compare' ? 'calc(var(--step-ms) * 1.6)' : 'var(--step-ms)');
      userCompare = false;
      if (s.screen === 'compare') setPos(50);
      restartFill();
      kickSweep();
    };

    const setPlaying = (on: boolean) => {
      playing = on;
      ba.classList.toggle('is-playing', on);
      playBtn.dataset.state = on ? 'playing' : 'paused';
      playBtn.setAttribute('aria-label', on ? 'Pause the walkthrough' : 'Play the walkthrough');
      if (on) kickSweep();
    };
    const sync = () => setPlaying(visible && wantsPlay && !document.hidden);

    // The segment finishing is the clock: advance, loop after the last step.
    ba.addEventListener('animationend', (e) => {
      if (!playing || reduced) return;
      if (!(e.target instanceof HTMLElement) || !e.target.matches('[data-seg-fill]')) return;
      render(active + 1);
    });

    // Announce only what the visitor asked for (never autoplay), once, after it settles.
    let liveTimer: number | undefined;
    const announce = () => {
      window.clearTimeout(liveTimer);
      liveTimer = window.setTimeout(() => {
        const s = STEPS[active]!;
        if (live) live.textContent = `Step ${active + 1} of ${n}, ${MODES[s.mode] ?? ''}: ${s.title}`;
      }, 250);
    };
    const pauseForVisitor = () => {
      wantsPlay = false;
      setPlaying(false);
    };
    const takeControl = (i: number) => {
      pauseForVisitor();
      render(i);
      announce();
    };
    steps.forEach((st, i) => st.querySelector('[data-st-btn]')?.addEventListener('click', () => takeControl(i)));
    ba.querySelector('[data-prev]')?.addEventListener('click', () => takeControl(active - 1));
    ba.querySelector('[data-next]')?.addEventListener('click', () => takeControl(active + 1));
    // Pointer shortcut: an admin menu item jumps to the first step on that screen. The steps
    // list is the keyboard path to the same content.
    menuItems.forEach((m) =>
      m.addEventListener('click', () => {
        const target = STEPS.findIndex((s) => s.menu === m.dataset.mi);
        if (target > -1) takeControl(target);
      }),
    );
    playBtn.addEventListener('click', () => {
      // The button follows what is on screen: Pause while it plays, Play otherwise.
      wantsPlay = !playing;
      if (wantsPlay && active === n - 1) render(0);
      sync();
    });
    if (reduced) playBtn.hidden = true;

    /* ---------- the compare handle: pointer anywhere on the page, keys on the handle ---------- */
    handle.hidden = false;
    handle.tabIndex = 0;
    handle.setAttribute('role', 'slider');
    handle.setAttribute('aria-label', 'Compare the example homepage before and after');
    handle.setAttribute('aria-valuemin', '0');
    handle.setAttribute('aria-valuemax', '100');
    handle.setAttribute('aria-orientation', 'horizontal');
    const takeCompare = () => {
      userCompare = true;
      cancelAnimationFrame(raf);
      raf = 0;
      pauseForVisitor();
    };
    const posFromEvent = (e: PointerEvent) => {
      const r = cmp.getBoundingClientRect();
      return ((e.clientX - r.left) / r.width) * 100;
    };
    let dragId: number | null = null;
    let startX = 0;
    let startY = 0;
    let decided = false;
    cmp.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      dragId = e.pointerId;
      startX = e.clientX;
      startY = e.clientY;
      // Mouse and pen drag at once; touch waits to see if the finger moves sideways, so a
      // vertical swipe still scrolls the page (touch-action: pan-y).
      decided = e.pointerType !== 'touch' || e.target === handle || handle.contains(e.target as Node);
      if (decided) {
        takeCompare();
        cmp.setPointerCapture(e.pointerId);
        cmp.classList.add('is-dragging');
        setPos(posFromEvent(e));
      }
    });
    cmp.addEventListener('pointermove', (e) => {
      if (dragId !== e.pointerId) return;
      if (!decided) {
        const dx = Math.abs(e.clientX - startX);
        const dy = Math.abs(e.clientY - startY);
        if (dy > 8 && dy > dx) {
          dragId = null;
          return;
        }
        if (dx < 6) return;
        decided = true;
        takeCompare();
        cmp.setPointerCapture(e.pointerId);
        cmp.classList.add('is-dragging');
      }
      setPos(posFromEvent(e));
    });
    const end = (e: PointerEvent) => {
      if (dragId !== e.pointerId) return;
      // A tap (touch that never moved) still sets the divider where it landed.
      if (!decided && e.type === 'pointerup') {
        takeCompare();
        setPos(posFromEvent(e));
      }
      dragId = null;
      cmp.classList.remove('is-dragging');
    };
    cmp.addEventListener('pointerup', end);
    cmp.addEventListener('pointercancel', end);
    handle.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 10 : 2;
      const map: Record<string, number> = {
        ArrowLeft: pos - step,
        ArrowDown: pos - step,
        ArrowRight: pos + step,
        ArrowUp: pos + step,
        PageDown: pos - 10,
        PageUp: pos + 10,
        Home: 0,
        End: 100,
      };
      const next = map[e.key];
      if (next === undefined) return;
      e.preventDefault();
      takeCompare();
      setPos(next);
    });

    /*
     * Reserve height: measure every step expanded once (and again on resize), then give the
     * list (desktop: all titles + the longest text) or the current-step card (narrow: the
     * tallest step) that height, so the controls and the page below never move.
     */
    const list = ba.querySelector<HTMLElement>('.ba__steps');
    const reserve = () => {
      if (!list) return;
      ba.classList.add('is-measuring');
      let base = 0;
      let maxText = 0;
      let maxStep = 0;
      steps.forEach((st) => {
        const inner = st.querySelector<HTMLElement>('.st__body-inner');
        const t = inner?.offsetHeight ?? 0;
        const h = st.offsetHeight;
        base += h - t;
        maxText = Math.max(maxText, t);
        maxStep = Math.max(maxStep, h);
      });
      ba.classList.remove('is-measuring');
      const border = parseFloat(getComputedStyle(list).borderTopWidth) || 0;
      ba.style.setProperty('--ba-steps-h', `${Math.ceil(base + maxText + border)}px`);
      ba.style.setProperty('--ba-card-h', `${Math.ceil(maxStep)}px`);
    };
    let lastW = 0;
    if ('ResizeObserver' in window) {
      new ResizeObserver(([e]) => {
        const w = Math.round(e?.contentRect.width ?? 0);
        if (w === lastW) return;
        lastW = w;
        reserve();
      }).observe(ba);
    }
    document.fonts?.ready.then(reserve).catch(() => {});

    ba.classList.add('is-live');
    steps.forEach((st) => st.querySelector<HTMLButtonElement>('[data-st-btn]')?.removeAttribute('disabled'));
    ba.querySelectorAll<HTMLElement>('[data-ba-controls], [data-ba-segs]').forEach((el) => (el.hidden = false));
    // Reduced motion opens on the finished step and stays put; otherwise the story starts at
    // step 1 when the player comes into view.
    render(reduced ? n - 1 : 0);
    setPlaying(false);
    setPos(50);

    // "In view" = a third of the player is visible, or it covers a third of the viewport (a
    // player taller than a landscape phone can never be a third visible).
    if ('IntersectionObserver' in window && !reduced) {
      const thresholds = Array.from({ length: 21 }, (_, k) => k / 20);
      new IntersectionObserver(
        ([e]) => {
          if (!e) return;
          const covers = e.intersectionRect.height >= window.innerHeight / 3;
          visible = e.isIntersecting && (e.intersectionRatio >= 1 / 3 || covers);
          if (visible && !started) {
            started = true;
            render(0);
          }
          sync();
        },
        { threshold: thresholds },
      ).observe(ba);
    }
    document.addEventListener('visibilitychange', sync);
  }
</script>
