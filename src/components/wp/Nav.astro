---
/**
 * Nav, set like a masthead: full-width paper with a hairline rule under it, the pilcrow mark
 * and the name, section links in small caps, the theme disc and the booking button. Tucks away
 * while you scroll down and slides back the moment you scroll up (out-quint); never hides while
 * it holds keyboard focus or its menu is open.
 * Phone: brand, theme disc, and a menu button that drops a sheet with the links and the CTA.
 */
import ThemeToggle from './ThemeToggle.astro';
import { NAV_LINKS, PERSON_NAME, bookingUrl } from '../../data/wp/site';
import { BOWL_D, STEMS_D } from '../../lib/wp/brand-mark';
import { isHome, link, sectionHref } from '../../lib/wp/paths';

const href = (id: string) => sectionHref(Astro.url, id);
const brandHref = isHome(Astro.url) ? '#top' : link('/');
---

<header class="nav" data-nav style="view-transition-name: site-nav">
  <div class="nav__bar">
    <a class="nav__brand" href={brandHref} aria-label={`${PERSON_NAME}, WordPress developer: home`}>
      <svg class="nav__mark" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
        <rect width="32" height="32" rx="6" fill="currentColor"></rect>
        <path class="nav__bowl" d={BOWL_D} fill="var(--accent)"></path>
        <path d={STEMS_D} fill="var(--bg)"></path>
      </svg>
      <span class="nav__name">{PERSON_NAME}</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul role="list">
        {
          NAV_LINKS.map((l) => (
            <li>
              <a class="nav__link" href={href(l.id)}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__end">
      <ThemeToggle />
      <a class="btn nav__cta" href={bookingUrl('nav')}>
        <span>Book a call</span>
      </a>
      <button class="nav__menu-btn" type="button" aria-expanded="false" aria-controls="nav-sheet" data-menu-btn>
        <span class="visually-hidden">Menu</span>
        <span class="nav__burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="nav__sheet" id="nav-sheet" data-menu hidden>
    <ul role="list">
      {
        NAV_LINKS.map((l, i) => (
          <li style={`--i:${i}`}>
            <a class="nav__sheet-link" href={href(l.id)} data-menu-link>
              <span class="nav__sheet-num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn nav__sheet-cta" href={bookingUrl('menu')}>
      <span>Book a scoping call</span>
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    padding-top: env(safe-area-inset-top, 0px);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    -webkit-backdrop-filter: saturate(1.2) blur(14px);
    backdrop-filter: saturate(1.2) blur(14px);
    border-bottom: 1px solid var(--line);
    transform: translate3d(0, 0, 0);
    transition: transform 560ms var(--ease-out-quint);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nav {
      background: var(--bg);
    }
  }
  .nav.is-tucked {
    transform: translate3d(0, calc(-100% - 2px), 0);
  }
  .nav__bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: min(100% - 2 * var(--margin), var(--container-max));
    min-height: var(--nav-h);
    margin-inline: auto;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    padding-right: 6px;
    border-radius: var(--radius-s);
    color: var(--text);
    text-decoration: none;
  }
  .nav__mark {
    flex: none;
  }
  .nav__bowl {
    transform-origin: 15.6px 12.35px;
    transition: transform 620ms var(--ease-spring);
  }
  @media (hover: hover) {
    .nav__brand:hover .nav__bowl {
      transform: scale(1.12);
    }
  }
  .nav__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  .nav__links {
    display: none;
    margin-inline: auto;
  }
  .nav__links ul {
    display: flex;
    gap: 2px;
    margin: 0;
  }
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 14px;
    color: var(--text-2);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color var(--dur-hover) var(--ease-out-quint);
  }
  .nav__link:focus-visible,
  .nav__link[aria-current='location'] {
    color: var(--text);
  }
  /* Current section: a rule drawn under the label, like an underlined section name. */
  .nav__link::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 8px;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 520ms var(--ease-out-expo);
  }
  .nav__link[aria-current='location']::after {
    transform: scaleX(1);
  }
  @media (hover: hover) {
    .nav__link:hover {
      color: var(--text);
    }
    .nav__link:hover::after {
      transform: scaleX(1);
    }
  }

  .nav__end {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }
  .nav__cta {
    display: none;
    min-height: 44px;
    padding-inline: 18px;
    font-size: 0.9375rem;
  }
  @media (min-width: 900px) {
    .nav__links {
      display: block;
    }
    .nav__cta {
      display: inline-flex;
    }
    .nav__end {
      margin-left: 0;
    }
    .nav__menu-btn {
      display: none !important;
    }
  }

  .nav__menu-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius-s);
    background: var(--btn-bg);
    color: var(--btn-fg);
    touch-action: manipulation;
  }
  .nav__burger {
    display: grid;
    gap: 5px;
    width: 18px;
  }
  .nav__burger span {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 420ms var(--ease-out-expo);
  }
  .nav__menu-btn[aria-expanded='true'] .nav__burger span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .nav__menu-btn[aria-expanded='true'] .nav__burger span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Without JS the menu button and theme disc cannot work: hide them and show the CTA. The
     footer's "On this page" links stay as the way around. */
  :global(html:not(.js)) .nav__menu-btn,
  :global(html:not(.js)) .nav :global(.tt) {
    display: none;
  }
  :global(html:not(.js)) .nav__cta {
    display: inline-flex;
  }
  @media (max-width: 420px) {
    :global(html:not(.js)) .nav__cta {
      padding-inline: 12px;
    }
  }
  @media (forced-colors: active) {
    .nav__link::after {
      background: CanvasText;
      forced-color-adjust: none;
    }
  }

  /* ---------- phone sheet ---------- */
  .nav__sheet {
    max-height: calc(100dvh - var(--nav-h) - 16px - env(safe-area-inset-top, 0px));
    overflow-y: auto;
    overscroll-behavior: contain;
    width: min(100% - 2 * var(--margin), var(--container-max));
    margin: 0 auto;
    padding: var(--space-2) 0 var(--space-5);
    border-top: 1px solid var(--line);
    transform-origin: top center;
  }
  .nav__sheet ul {
    display: grid;
    margin: 0 0 var(--space-5);
  }
  .nav__sheet-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    min-height: 60px;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.625rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--text);
    text-decoration: none;
  }
  .nav__sheet-num {
    color: var(--accent-text);
  }
  .nav__sheet-cta {
    width: 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav__sheet.is-open {
      animation: nav-sheet-in 460ms var(--ease-out-quint) both;
    }
    .nav__sheet.is-open li {
      animation: nav-sheet-item 520ms var(--ease-out-quint) both;
      animation-delay: calc(60ms + var(--i) * 50ms);
    }
  }
  @keyframes nav-sheet-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @keyframes nav-sheet-item {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
</style>

<script>
  import { getActiveMotion } from '../../lib/motion-registry';

  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const btn = nav?.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const sheet = nav?.querySelector<HTMLElement>('[data-menu]');

  if (nav && btn && sheet) {
    let open = false;
    const desktop = window.matchMedia('(min-width: 900px)');

    const setOpen = (next: boolean, restoreFocus = false) => {
      if (open === next) return;
      open = next;
      btn.setAttribute('aria-expanded', String(next));
      btn.querySelector('.visually-hidden')!.textContent = next ? 'Close menu' : 'Menu';
      sheet.hidden = !next;
      sheet.classList.toggle('is-open', next);
      nav.classList.remove('is-tucked');
      document.documentElement.classList.toggle('menu-open', next);
      const m = getActiveMotion();
      if (next) m?.stop();
      else m?.start();
      if (!next && restoreFocus) btn.focus();
    };

    btn.addEventListener('click', () => setOpen(!open));
    sheet.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (open && e.key === 'Escape') setOpen(false, true);
    });
    document.addEventListener('pointerdown', (e) => {
      if (open && e.target instanceof Node && !nav.contains(e.target)) setOpen(false);
    });
    nav.addEventListener('focusout', (e) => {
      if (open && e.relatedTarget instanceof Node && !nav.contains(e.relatedTarget)) setOpen(false);
    });
    desktop.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });

    // Tuck on scroll down, return on scroll up. Small jitters (< 6px) are ignored.
    let lastY = window.scrollY;
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const y = window.scrollY;
        const dy = y - lastY;
        if (Math.abs(dy) < 6) return;
        // Only keyboard focus pins the nav: a mouse click leaves focus on the link it clicked.
        let keyboardFocus = false;
        try {
          keyboardFocus = nav.matches(':has(:focus-visible)');
        } catch {
          keyboardFocus = false;
        }
        const keep = open || keyboardFocus || y < 120;
        nav.classList.toggle('is-tucked', !keep && dy > 0);
        lastY = y;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    nav.addEventListener('focusin', () => {
      try {
        if (nav.matches(':has(:focus-visible)')) nav.classList.remove('is-tucked');
      } catch {
        nav.classList.remove('is-tucked');
      }
    });

    // Current-section rule on desktop links.
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('.nav__link')];
    const targets = links
      .map((a) => document.getElementById(a.hash.slice(1)))
      .filter((el): el is HTMLElement => el !== null);
    if ('IntersectionObserver' in window && targets.length) {
      const visible = new Set<string>();
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
          const current = targets.find((t) => visible.has(t.id))?.id;
          links.forEach((a) => {
            if (a.hash.slice(1) === current) a.setAttribute('aria-current', 'location');
            else a.removeAttribute('aria-current');
          });
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      targets.forEach((t) => io.observe(t));
    }
  }
</script>
