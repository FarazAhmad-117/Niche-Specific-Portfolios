---
/**
 * Case studies, laid out as a results page for `site:<seo host>`: one result per present case
 * with favicon, breadcrumb URL, blue title, snippet and "rich result" facts, and a thumbnail.
 * The title of each linked result shares a view-transition-name with the case page h1, so it
 * morphs into the page heading on navigation.
 * The last result (any client site) has no data yet: no page, a visible placeholder. When the
 * person has no project case at all, OWN_RESULT_SLOT (also a placeholder) comes before it.
 */
import Todo from './Todo.astro';
import { CASES, CASES_LEDE, CLIENT_CASE, OWN_RESULT_SLOT, SEO_HOST } from '../../data/seo/cases';
import { createLink } from '../../lib/link';

const link = createLink('seo');
const resultCount = CASES.length + (OWN_RESULT_SLOT ? 1 : 0) + 1;
---

<section class="section section--rule cases" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="head head--split">
      <p class="eyebrow">Case studies</p>
      <h2 id="work-title">Work you can <span class="mark" data-mark>check yourself.</span></h2>
      <p class="lede">{CASES_LEDE}</p>
    </div>

    <div class="serp">
      <div class="serp__bar" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="16" height="16"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        <span class="mono">site:{SEO_HOST} case studies</span>
      </div>
      <p class="serp__count mono">{resultCount} results</p>

      <ol class="serp__list" role="list" data-reveal-stagger>
        {
          CASES.map((c) => (
            <li class="res">
              <div class="res__main">
                <div class="serp-site">
                  <span class="serp-fav" aria-hidden="true">
                    <span class="res__fav">{c.name.charAt(0).toUpperCase()}</span>
                  </span>
                  <span class="serp-name">{c.name}</span>
                  <span class="serp-url">{SEO_HOST} › work › {c.slug}</span>
                </div>
                <h3 class="res__title case-vt" style={`--vt: case-${c.slug}`}>
                  <a class="serp-title res__link" href={link(`/work/${c.slug}/`)}>
                    {c.cardTitle}
                  </a>
                </h3>
                <p class="res__snippet">
                  <span class="res__role mono">{c.role} — </span>
                  {c.angle}
                </p>
                <ul class="res__rich" role="list">
                  {c.rich.map((r) => (
                    <li class="chip">{r}</li>
                  ))}
                </ul>
              </div>
              <div class="res__thumb" aria-hidden="true">
                {c.slug === 'farazahmad-dev' ? (
                  <svg class="thumb thumb--ring" viewBox="0 0 120 120">
                    <circle cx="60" cy="60" r="44" class="thumb__track" />
                    <circle cx="60" cy="60" r="44" class="thumb__arc" pathLength="100" />
                    <text x="60" y="68" text-anchor="middle" class="thumb__num">100</text>
                    <text x="60" y="88" text-anchor="middle" class="thumb__lbl">SEO</text>
                  </svg>
                ) : (
                  <svg class="thumb thumb--flow" viewBox="0 0 120 120">
                    {[0, 1, 2, 3, 4].map((k) => (
                      <rect x="16" y={14 + k * 19} width={k === 2 ? 88 : 64 + (k % 2) * 16} height="11" rx="2" class:list={['thumb__bar', { 'thumb__bar--on': k === 3 }]} />
                    ))}
                  </svg>
                )}
              </div>
            </li>
          ))
        }
        {
          OWN_RESULT_SLOT && (
            <li class="res res--pending">
              <div class="res__main">
                <div class="serp-site">
                  <span class="serp-fav" aria-hidden="true"><span class="res__fav">?</span></span>
                  <span class="serp-name">{OWN_RESULT_SLOT.name}</span>
                  <span class="serp-url">{OWN_RESULT_SLOT.url}</span>
                </div>
                <h3 class="res__title res__title--plain">{OWN_RESULT_SLOT.cardTitle}</h3>
                <p class="res__snippet">{OWN_RESULT_SLOT.angle}</p>
                <p class="res__rich"><Todo value={OWN_RESULT_SLOT.placeholder} /></p>
              </div>
              <div class="res__thumb res__thumb--empty" aria-hidden="true" />
            </li>
          )
        }
        <li class="res res--pending">
          <div class="res__main">
            <div class="serp-site">
              <span class="serp-fav" aria-hidden="true"><span class="res__fav">?</span></span>
              <span class="serp-name">{CLIENT_CASE.name}</span>
              <span class="serp-url">{CLIENT_CASE.url}</span>
            </div>
            <h3 class="res__title res__title--plain">{CLIENT_CASE.cardTitle}</h3>
            <p class="res__snippet">{CLIENT_CASE.angle}</p>
            <p class="res__rich"><Todo value={CLIENT_CASE.placeholder} /></p>
          </div>
          <div class="res__thumb res__thumb--empty" aria-hidden="true">
            <svg class="thumb" viewBox="0 0 120 120">
              <path d="M12 92 L36 88 L52 90 L68 70 L84 60 L108 34" class="thumb__ghost" />
              <path d="M12 104H108" class="thumb__axis" />
            </svg>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .cases .head > h2 {
    max-width: 14ch;
  }
  .serp {
    max-width: 62rem;
  }
  .serp__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 20px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--text-2);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .serp__bar .mono {
    font-size: 0.875rem;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .serp__count {
    margin: var(--space-4) 0 var(--space-2) 20px;
    color: var(--text-3);
  }
  .serp__list {
    display: grid;
    margin: 0;
  }

  .res {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-5);
    padding: var(--space-5) 20px;
    border-top: 1px solid var(--line);
    border-radius: var(--radius-m);
    transition: background-color var(--dur-hover) var(--ease-out);
  }
  .res:first-child {
    border-top: 0;
  }
  @media (hover: hover) {
    .res:not(.res--pending):hover {
      background: var(--surface-2);
    }
  }
  .res:has(.res__link:focus-visible) {
    background: var(--surface-2);
  }
  .res__main {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .res__fav {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8125rem;
  }
  .res__title {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    view-transition-name: var(--vt);
  }
  .res__title--plain {
    color: var(--text-2);
  }
  .res__link {
    text-decoration: underline 1.5px transparent;
    text-underline-offset: 0.18em;
    transition: text-decoration-color var(--dur-hover) var(--ease-out);
  }
  /* The whole result is the click target. */
  .res__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-m);
  }
  .res__link:focus-visible {
    outline: none;
    text-decoration-color: currentColor;
  }
  .res__link:focus-visible::after {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  @media (hover: hover) {
    .res:hover .res__link {
      text-decoration-color: currentColor;
    }
  }
  .res__snippet {
    max-width: 62ch;
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  .res__role {
    color: var(--text-3);
  }
  .res__rich {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
  }

  .res__thumb {
    align-self: start;
    width: clamp(76px, 12vw, 120px);
    aspect-ratio: 1;
    border-radius: var(--radius-m);
    background: var(--surface-1);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .res__thumb--empty {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
    border: 0;
    outline: 1.5px dashed var(--line-strong);
    outline-offset: -1.5px;
  }
  @media (max-width: 559px) {
    .res {
      grid-template-columns: minmax(0, 1fr);
      padding-inline: 12px;
    }
    .res__thumb {
      display: none;
    }
    .serp__count {
      margin-left: 12px;
    }
  }
  .thumb {
    width: 100%;
    height: 100%;
  }
  .thumb__track {
    fill: none;
    stroke: var(--line);
    stroke-width: 8;
  }
  .thumb__arc {
    fill: none;
    stroke: var(--success);
    stroke-width: 8;
    stroke-linecap: round;
    stroke-dasharray: 100 100;
    transform: rotate(-90deg);
    transform-origin: 60px 60px;
  }
  .thumb__num {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 28px;
    letter-spacing: -0.04em;
    fill: var(--text);
  }
  .thumb__lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    fill: var(--text-3);
  }
  .thumb__bar {
    fill: var(--line-strong);
  }
  .thumb__bar--on {
    fill: var(--accent);
  }
  .thumb__ghost {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 3;
    stroke-dasharray: 5 6;
    stroke-linecap: round;
  }
  .thumb__axis {
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }
  @media (prefers-reduced-motion: no-preference) {
    .serp__list.is-armed.is-revealed .thumb__arc {
      animation: ring-draw var(--dur-draw) var(--ease-draw) 300ms both;
    }
  }
  @keyframes ring-draw {
    from {
      stroke-dasharray: 0 100;
    }
  }
</style>
