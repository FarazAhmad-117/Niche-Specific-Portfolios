---
/**
 * Theme toggle. aria-label "Dark theme" + aria-pressed = dark on. Persists to
 * localStorage('theme'); the no-flash inline script lives in the Layout <head>.
 * Glyph: a sun whose rays retract as a shadow slides over it into a crescent (--ease-swap).
 * The swap itself is a left-to-right "marker" wipe of the new theme over the old one, through
 * the View Transitions API when present.
 */
---

<button type="button" class="tt" aria-label="Dark theme" aria-pressed="false" data-theme-toggle>
  <svg class="tt__svg" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <mask id="tt-moon">
      <rect width="24" height="24" fill="#fff"></rect>
      <circle class="tt__bite" cx="24" cy="4" r="7" fill="#000"></circle>
    </mask>
    <circle class="tt__core" cx="12" cy="12" r="5" fill="currentColor" mask="url(#tt-moon)"></circle>
    <g class="tt__rays" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
    </g>
  </svg>
</button>

<style>
  .tt {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--text);
    touch-action: manipulation;
    transition:
      background-color var(--dur-hover) var(--ease-out),
      transform var(--dur-press) var(--ease-out);
  }
  .tt__core {
    transform-origin: 12px 12px;
    transition: transform 600ms var(--ease-swap);
  }
  .tt__bite {
    transition: transform 600ms var(--ease-swap);
  }
  .tt__rays {
    transform-origin: 12px 12px;
    transition:
      transform 600ms var(--ease-swap),
      opacity 300ms var(--ease-out);
  }
  .tt[aria-pressed='true'] .tt__core {
    transform: scale(1.55);
  }
  .tt[aria-pressed='true'] .tt__bite {
    transform: translate(-9px, 4.5px);
  }
  .tt[aria-pressed='true'] .tt__rays {
    transform: rotate(45deg) scale(0.5);
    opacity: 0;
  }
  .tt:focus-visible {
    background: var(--surface-1);
  }
  @media (hover: hover) {
    .tt:hover {
      background: var(--surface-1);
    }
  }
  .tt:active {
    transform: scale(0.92);
  }
</style>

<script>
  const root = document.documentElement;
  const KEY = 'theme';
  type Theme = 'light' | 'dark';
  const COLORS: Record<Theme, string> = { light: '#f5f5f0', dark: '#0f1012' };

  let dark: MediaQueryList | null = null;
  try {
    dark = window.matchMedia('(prefers-color-scheme: dark)');
  } catch {
    dark = null;
  }
  const reduced = (): boolean => {
    try {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch {
      return false;
    }
  };
  const stored = (): Theme | null => {
    try {
      const t = localStorage.getItem(KEY);
      return t === 'light' || t === 'dark' ? t : null;
    } catch {
      return null;
    }
  };
  const effective = (): Theme => {
    const t = root.dataset.theme;
    if (t === 'light' || t === 'dark') return t;
    return dark?.matches ? 'dark' : 'light';
  };

  function sync() {
    const theme = effective();
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.setAttribute('aria-pressed', String(theme === 'dark'));
    });
    const metas = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
    if (stored()) metas.forEach((m) => (m.content = COLORS[theme]));
    else metas.forEach((m) => (m.content = m.media.includes('dark') ? COLORS.dark : COLORS.light));
  }

  function apply(theme: Theme) {
    root.dataset.theme = theme;
    try {
      localStorage.setItem(KEY, theme);
    } catch {
      /* private mode: the choice lasts for this page only */
    }
    sync();
  }

  let busy = false;
  function toggle() {
    if (busy) return; // a second click mid-wipe would snapshot a half-drawn page
    const next: Theme = effective() === 'dark' ? 'light' : 'dark';
    if (reduced() || typeof document.startViewTransition !== 'function') {
      apply(next);
      return;
    }
    busy = true;
    root.classList.add('theme-vt');
    try {
      const vt = document.startViewTransition(() => apply(next));
      vt.ready
        .then(() => {
          // Same stroke as the highlighter: --ease-marker, left to right.
          root.animate(
            { clipPath: ['inset(0 100% 0 0)', 'inset(0 0% 0 0)'] },
            { duration: 640, easing: 'cubic-bezier(0.65, 0, 0.25, 1)', pseudoElement: '::view-transition-new(root)' },
          );
        })
        .catch(() => {});
      vt.finished.finally(() => {
        root.classList.remove('theme-vt');
        busy = false;
      });
    } catch {
      root.classList.remove('theme-vt');
      busy = false;
      apply(next);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', toggle);
  });
  dark?.addEventListener('change', sync);
  window.addEventListener('storage', (e) => {
    if (e.key !== KEY) return;
    const t = stored();
    if (t) root.dataset.theme = t;
    else delete root.dataset.theme;
    sync();
  });
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    const t = stored();
    if (t) root.dataset.theme = t;
    sync();
  });
  sync();
</script>
