---
/**
 * Offers (decisions.md › seo): the audit as the featured first step, the other four in a
 * 2 × 2 block beside it, so the grid fills complete rows. No prices: "Scoped on a call".
 */
import { OFFERS, PRICE_LINE } from '../../data/seo/content';
import { bookingUrl } from '../../data/seo/site';

const [featured, ...rest] = OFFERS;
---

<section class="section section--sunk offers" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="head head--split">
      <p class="eyebrow">Services</p>
      <h2 id="services-title">Start with the audit. <span class="mark" data-mark>Build from there.</span></h2>
      <p class="lede">Every engagement is scoped on a free call: what your site needs, in what order, and what it costs. No packages, no monthly fee for invisible work.</p>
    </div>

    <ul class="offers__grid" role="list" data-reveal-stagger>
      {
        featured && (
          <li class="offer offer--featured inverse" id={`offer-${featured.id}`}>
            <p class="offer__n mono">01 · Start here</p>
            <h3 class="offer__name">{featured.name}</h3>
            <p class="offer__desc">{featured.description}</p>
            <ul class="offer__inc" role="list">
              {featured.includes.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
            <div class="offer__foot">
              <span class="offer__price mono">{PRICE_LINE}</span>
              <a class="btn offer__cta" href={bookingUrl('offer-audit')}>
                <span>Book a scoping call</span>
                <span class="btn__arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        )
      }
      {
        rest.map((o, i) => (
          <li class="offer" id={`offer-${o.id}`}>
            <p class="offer__n mono">{String(i + 2).padStart(2, '0')}</p>
            <h3 class="offer__name">{o.name}</h3>
            <p class="offer__desc">{o.description}</p>
            <ul class="offer__inc" role="list">
              {o.includes.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
            <p class="offer__price mono">{PRICE_LINE}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .offers__grid {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  @media (min-width: 720px) {
    .offers__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .offer--featured {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1100px) {
    .offers__grid {
      grid-template-columns: minmax(0, 1.15fr) repeat(2, minmax(0, 1fr));
      grid-template-rows: auto auto;
    }
    .offer--featured {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
  }
  .offer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface-2);
    min-width: 0;
    transition:
      border-color var(--dur-hover) var(--ease-out),
      transform 420ms var(--ease-out);
  }
  @media (hover: hover) {
    .offer:not(.offer--featured):hover {
      border-color: var(--line-strong);
      transform: translateY(-2px);
    }
  }
  .offer__n {
    color: var(--text-3);
  }
  .offer__name {
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
  }
  .offer__desc {
    color: var(--text-2);
    font-size: var(--fs-small);
  }
  .offer__inc {
    display: grid;
    gap: 6px;
    margin: var(--space-2) 0 0;
    font-size: var(--fs-small);
  }
  .offer__inc li {
    position: relative;
    padding-left: 22px;
  }
  .offer__inc li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 12px;
    height: 7px;
    border-radius: 2px;
    background: var(--accent);
  }
  .offer__price {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px dashed var(--line-strong);
    color: var(--text-3);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Featured: an ink card (inverts in dark mode), big name, CTA. */
  .offer--featured {
    background: var(--btn-bg);
    color: var(--btn-fg);
    border-color: var(--btn-bg);
  }
  /* A yellow tab reads in both themes (ink card in light, paper card in dark). */
  .offer--featured .offer__n {
    align-self: flex-start;
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }
  .offer--featured .offer__name {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.75rem);
    letter-spacing: -0.035em;
  }
  .offer--featured .offer__desc,
  .offer--featured .offer__inc {
    color: color-mix(in srgb, var(--btn-fg) 82%, transparent);
    font-size: var(--fs-body);
  }
  .offer--featured .offer__inc {
    gap: 10px;
  }
  .offer__foot {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    margin-top: auto;
    padding-top: var(--space-5);
    border-top: 1px dashed color-mix(in srgb, var(--btn-fg) 30%, transparent);
  }
  .offer__foot .offer__price {
    margin: 0;
    padding: 0;
    border: 0;
    color: color-mix(in srgb, var(--btn-fg) 70%, transparent);
  }
  .offer__cta {
    background: var(--btn-fg);
    color: var(--btn-bg);
  }
  @media (hover: hover) {
    .offer__cta:hover {
      color: var(--on-accent);
    }
  }
  .offer__cta:focus-visible {
    color: var(--on-accent);
  }
</style>
