---
/**
 * The engine (brief §4 item 5): the content pipeline with the human edit as the gate.
 * A "page" token walks the pipeline on a CSS loop: each stage lights in turn, the token waits
 * longest at the human edit, gets an "Approved" stamp, and only then moves on to the checks.
 * A dashed return path shows drafts being sent back.
 * Desktop: one row of seven stages. Phone: a vertical rail. The loop pauses off screen and is
 * off under reduced motion (everything shows lit, as a static diagram).
 */
import { ENGINE } from '../../data/seo/content';

const steps = ENGINE.steps;
const gateIndex = steps.findIndex((s) => s.gate);
---

<section class="section section--rule engine" id="engine" aria-labelledby="engine-title">
  <div class="container">
    <div class="head head--split">
      <p class="eyebrow">The engine</p>
      <h2 id="engine-title">
        AI does the legwork. <span class="mark" data-mark>A person signs off</span> every page.
      </h2>
      <p class="lede">{ENGINE.lede}</p>
    </div>

    <div class="pipe" data-pause-offscreen style={`--n: ${steps.length}; --gate: ${gateIndex}`}>
      <ol class="pipe__list" role="list">
        {
          steps.map((s, i) => (
            <li class:list={['pipe__step', { 'pipe__step--gate': s.gate }]} style={`--k: ${i}`}>
              <span class="pipe__node" aria-hidden="true">
                <span class="pipe__n mono">{String(i + 1).padStart(2, '0')}</span>
              </span>
              <div class="pipe__copy">
                <h3 class="pipe__title">
                  {s.title}
                  {s.gate && <span class="pipe__gate-tag mono">the gate</span>}
                </h3>
                <p class="pipe__text">{s.text}</p>
                {s.gate && (
                  <p class="pipe__stamp mono" aria-hidden="true">
                    Approved
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="pipe__return mono">
        <span class="pipe__return-line" aria-hidden="true"></span>
        <span>↺ {ENGINE.rejectNote}: back to the brief, never to your site</span>
      </p>
    </div>
  </div>
</section>

<style>
  .engine .head > h2 {
    max-width: 17ch;
  }
  /*
   * One loop of --cycle; each stage owns an equal slot except the gate, which holds for 3.
   * Slots: 0,1,2 (research, brief, draft), 3..5 (human edit), 6, 7, 8 (checks, publish, measure).
   * The keyframes below are written for that 9-slot cycle.
   */
  .pipe {
    --cycle: 10.8s;
    position: relative;
  }
  .pipe__list {
    position: relative;
    display: grid;
    gap: 0;
    margin: 0;
  }
  /* The rail the stages hang on. */
  .pipe__list::before {
    content: '';
    position: absolute;
    left: 19px;
    top: 20px;
    bottom: 20px;
    width: 2px;
    background: var(--line-strong);
  }
  .pipe__step {
    position: relative;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
  }
  .pipe__node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-s);
    background: var(--bg);
    color: var(--text-2);
  }
  .pipe__n {
    font-size: 0.75rem;
    font-weight: 600;
  }
  .pipe__copy {
    display: grid;
    gap: 4px;
    padding-top: 6px;
    min-width: 0;
  }
  .pipe__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 1.125rem;
  }
  .pipe__text {
    max-width: 42ch;
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  .pipe__gate-tag {
    padding: 2px 7px;
    border-radius: var(--radius-xs);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The gate: a yellow block, bigger node, a stamp. */
  .pipe__step--gate .pipe__copy {
    padding: var(--space-4);
    border-radius: var(--radius-m);
    background: var(--accent);
    color: var(--on-accent);
  }
  .pipe__step--gate .pipe__text {
    color: var(--on-accent);
  }
  .pipe__step--gate .pipe__node {
    border-color: var(--on-accent);
    background: var(--accent);
    color: var(--on-accent);
  }
  .pipe__stamp {
    justify-self: start;
    margin-top: 6px;
    padding: 3px 9px;
    border: 1.5px solid var(--on-accent);
    border-radius: var(--radius-xs);
    color: var(--on-accent);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transform: rotate(-4deg);
  }

  .pipe__return {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    color: var(--text-2);
  }
  .pipe__return-line {
    flex: none;
    width: 40px;
    height: 0;
    border-top: 1.5px dashed var(--text-3);
  }

  @media (min-width: 1100px) {
    .pipe__list {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: var(--space-3);
      align-items: start;
    }
    .pipe__list::before {
      left: 20px;
      right: 20px;
      top: 31px;
      bottom: auto;
      width: auto;
      height: 2px;
    }
    .pipe__step {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .pipe__copy {
      padding-top: 0;
    }
    .pipe__step--gate {
      margin-top: -10px;
    }
    .pipe__step--gate .pipe__node {
      width: 48px;
      height: 48px;
      margin-top: -4px;
    }
    .pipe__step--gate .pipe__copy {
      margin-inline: -8px;
    }
    .pipe__title {
      font-size: 1.0625rem;
    }
    /* The return path: a dashed bracket from the gate back to "Brief". */
    .pipe__return {
      margin-left: calc(100% / 7);
    }
  }

  /* ---------- the loop ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .pipe__node {
      animation: pipe-lit var(--cycle) var(--ease-out) infinite;
      animation-delay: calc(var(--k) * var(--cycle) / 9);
    }
    /* Stages after the gate wait for its two extra slots. */
    .pipe__step:nth-child(n + 5) .pipe__node {
      animation-delay: calc((var(--k) + 2) * var(--cycle) / 9);
    }
    .pipe__step--gate .pipe__node {
      animation-name: pipe-gate;
    }
    .pipe__stamp {
      animation: pipe-stamp var(--cycle) var(--ease-spring) infinite;
      animation-delay: calc(var(--gate) * var(--cycle) / 9);
    }
  }
  /* A stage lights for one slot (1/9 of the loop). */
  @keyframes pipe-lit {
    0% {
      background: var(--btn-bg);
      border-color: var(--btn-bg);
      color: var(--btn-fg);
      transform: scale(1.08);
    }
    10% {
      background: var(--btn-bg);
      border-color: var(--btn-bg);
      color: var(--btn-fg);
      transform: scale(1);
    }
    14%,
    100% {
      background: var(--bg);
      border-color: var(--line-strong);
      color: var(--text-2);
      transform: scale(1);
    }
  }
  /* The gate holds for three slots and pulses while "reviewing". */
  @keyframes pipe-gate {
    0%,
    30% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent);
    }
    15% {
      box-shadow: 0 0 0 10px color-mix(in srgb, var(--accent) 0%, transparent);
    }
    33%,
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  /* The stamp lands near the end of the gate's hold. */
  @keyframes pipe-stamp {
    0%,
    22% {
      opacity: 0;
      transform: rotate(-4deg) scale(1.6);
    }
    27%,
    90% {
      opacity: 1;
      transform: rotate(-4deg) scale(1);
    }
    96%,
    100% {
      opacity: 0;
      transform: rotate(-4deg) scale(1);
    }
  }
</style>
