---
/**
 * Hero "snippet lab": four fixes in the page source, and what each one changes in how an
 * example page shows up in search. It is the pitch in one widget: the SEO lives in the code.
 *
 * Behaviour
 *  - Server render = every fix on (the finished result), so no-JS and reduced-motion visitors
 *    see the good snippet straight away.
 *  - With JS and motion allowed, it resets to "before" and applies one fix every ~1.5s while
 *    on screen; then it holds the final state. Play / pause / replay button.
 *  - Each fix is a toggle button (aria-pressed): turn it off to see what breaks. Touching one
 *    stops the autoplay.
 *  - The store, query and URLs are an example, and the widget says so.
 */
import { LAB } from '../../data/seo/content';

const fixIds = LAB.fixes.map((f) => f.id);
const state = Object.fromEntries(fixIds.map((id) => [`data-${id}`, 'on']));
---

<figure class="lab" data-lab data-pause-offscreen {...state} aria-labelledby="lab-title">
  <div class="lab__top">
    <p class="lab__title mono" id="lab-title"><span class="illus">Example</span> What the code changes in search</p>
    <button class="lab__play" type="button" data-lab-play hidden>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <g class="lab__ico lab__ico--pause"><rect x="3" y="2.5" width="3.2" height="11" rx="1"></rect><rect x="9.8" y="2.5" width="3.2" height="11" rx="1"></rect></g>
        <path class="lab__ico lab__ico--play" d="M4 2.6v10.8a.8.8 0 0 0 1.2.7l8.6-5.4a.8.8 0 0 0 0-1.4L5.2 1.9A.8.8 0 0 0 4 2.6z"></path>
        <path class="lab__ico lab__ico--replay" d="M8 2.2a5.8 5.8 0 1 1-5.5 4h1.7A4.2 4.2 0 1 0 8 3.8v2L4.8 3 8 .2z"></path>
      </svg>
      <span data-lab-play-label>Pause</span>
    </button>
  </div>

  <div class="lab__search" aria-hidden="true">
    <svg viewBox="0 0 20 20" width="16" height="16"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    <span class="lab__query">{LAB.query}</span>
  </div>

  <div class="lab__result">
    <div class="serp-site">
      <span class="serp-fav" aria-hidden="true"><span class="lab__fav">Y</span></span>
      <span class="serp-name">{LAB.site}</span>
      <span class="serp-url lab__url">
        <span class="lab__b lab__b--canonical">{LAB.before.url}</span><span class="lab__a lab__a--canonical">{LAB.after.url}</span>
      </span>
    </div>
    <p class="serp-title lab__rtitle">
      <span class="lab__b lab__b--title">{LAB.before.title}</span><span class="lab__a lab__a--title">{LAB.after.title}</span>
    </p>
    <p class="lab__snippet">
      <span class="lab__b lab__b--desc">{LAB.before.snippet}</span><span class="lab__a lab__a--desc">{LAB.after.snippet}</span>
    </p>
    <p class="lab__rich lab__a lab__a--schema"><span class="lab__dot" aria-hidden="true"></span>{LAB.after.rich}</p>
  </div>

  <ol class="lab__fixes" role="list" aria-label="Fixes in the page source">
    {
      LAB.fixes.map((f, i) => (
        <li>
          <button class="lab__fix" type="button" data-fix={f.id} aria-pressed="true">
            <span class="lab__ln mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="lab__code mono">{f.code}</span>
            <span class="lab__label">{f.label}</span>
            <span class="lab__state mono" aria-hidden="true">
              <span class="lab__state-on">fixed</span>
              <span class="lab__state-off">missing</span>
            </span>
          </button>
        </li>
      ))
    }
  </ol>
  <figcaption class="lab__status mono" data-lab-status aria-live="polite">
    <span data-lab-count>{fixIds.length}</span> of {fixIds.length} fixes in the page source
  </figcaption>
</figure>

<style>
  .lab {
    display: grid;
    gap: var(--space-4);
    padding: clamp(1rem, 0.8rem + 1vw, 1.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface-2);
    box-shadow: var(--shadow-lift);
    min-width: 0;
  }
  .lab__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 36px;
  }
  .lab__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--text-2);
  }
  .lab__play {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
    touch-action: manipulation;
    transition: background-color var(--dur-hover) var(--ease-out);
  }
  @media (hover: hover) {
    .lab__play:hover {
      background: var(--surface-1);
    }
  }
  .lab__play svg {
    fill: currentColor;
  }
  .lab__ico {
    display: none;
  }
  .lab__play[data-mode='pause'] .lab__ico--pause,
  .lab__play[data-mode='play'] .lab__ico--play,
  .lab__play[data-mode='replay'] .lab__ico--replay {
    display: inline;
  }
  /* The pause button needs a 44px target on touch screens. */
  @media (pointer: coarse) {
    .lab__play {
      min-height: var(--tap);
    }
  }

  .lab__search {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .lab__query {
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lab__query::after {
    content: '';
    display: inline-block;
    width: 1.5px;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--text);
    animation: lab-caret 1.1s steps(1) infinite;
  }
  @keyframes lab-caret {
    50% {
      opacity: 0;
    }
  }

  .lab__result {
    display: grid;
    gap: 6px;
    padding: var(--space-4);
    border-radius: var(--radius-m);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
    min-height: 11.5rem;
    align-content: start;
  }
  .lab__fav {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8125rem;
    color: var(--text);
  }
  .lab__rtitle {
    margin-top: 4px;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.3;
  }
  .lab__snippet {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-2);
  }
  .lab__rich {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--text-2);
  }
  .lab__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
  }

  /* Before / after: the figure's data-<fix> attribute decides which half shows. */
  .lab[data-title='on'] .lab__b--title,
  .lab[data-title='off'] .lab__a--title,
  .lab[data-desc='on'] .lab__b--desc,
  .lab[data-desc='off'] .lab__a--desc,
  .lab[data-canonical='on'] .lab__b--canonical,
  .lab[data-canonical='off'] .lab__a--canonical,
  .lab[data-schema='off'] .lab__a--schema {
    display: none;
  }
  .lab__b--desc {
    font-style: italic;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Whatever just appeared lands with a quick marker flash that fades to nothing. */
    .lab__a {
      animation: lab-flash 1100ms var(--ease-out);
      border-radius: 3px;
    }
    .lab__b {
      animation: lab-fade 360ms var(--ease-out);
    }
  }
  @keyframes lab-flash {
    0% {
      opacity: 0;
      background-color: var(--accent);
      color: var(--on-accent);
    }
    15% {
      opacity: 1;
      background-color: var(--accent);
      color: var(--on-accent);
    }
    100% {
      background-color: transparent;
    }
  }
  @keyframes lab-fade {
    from {
      opacity: 0;
    }
  }

  .lab__fixes {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
  }
  .lab__fix {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'ln code state'
      'ln label state';
    align-items: center;
    column-gap: 12px;
    width: 100%;
    min-height: 52px;
    padding: 6px 10px;
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--text);
    text-align: left;
    touch-action: manipulation;
    transition: background-color var(--dur-hover) var(--ease-out);
  }
  @media (hover: hover) {
    .lab__fix:hover {
      background: var(--surface-1);
    }
  }
  .lab__ln {
    grid-area: ln;
    color: var(--text-3);
  }
  .lab__code {
    grid-area: code;
    justify-self: start;
    padding: 1px 6px;
    margin-left: -6px;
    border-radius: 3px;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-size: 100% 100%;
    color: var(--on-accent);
    transition:
      background-size 520ms var(--ease-marker),
      color 300ms var(--ease-marker) 120ms;
    overflow-wrap: anywhere;
  }
  .lab__label {
    grid-area: label;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--text-2);
  }
  .lab__state {
    grid-area: state;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .lab__state-on {
    color: var(--success);
  }
  .lab__state-off {
    display: none;
    color: var(--text-3);
  }
  .lab__fix[aria-pressed='false'] .lab__code {
    background-size: 0% 100%;
    color: var(--text-3);
    text-decoration: line-through 1px;
  }
  .lab__fix[aria-pressed='false'] .lab__state-on {
    display: none;
  }
  .lab__fix[aria-pressed='false'] .lab__state-off {
    display: inline;
  }
  .lab__status {
    color: var(--text-3);
  }
  :global(html:not(.js)) .lab__fix {
    pointer-events: none;
  }
  @media (forced-colors: active) {
    .lab__code {
      forced-color-adjust: none;
      background-image: none;
      border: 1px solid CanvasText;
    }
  }
</style>

<script>
  type FixId = 'title' | 'desc' | 'canonical' | 'schema';

  const lab = document.querySelector<HTMLElement>('[data-lab]');
  const buttons = lab ? [...lab.querySelectorAll<HTMLButtonElement>('[data-fix]')] : [];
  const play = lab?.querySelector<HTMLButtonElement>('[data-lab-play]');
  const playLabel = lab?.querySelector<HTMLElement>('[data-lab-play-label]');
  const count = lab?.querySelector<HTMLElement>('[data-lab-count]');

  if (lab && buttons.length && play && playLabel && count) {
    const ids = buttons.map((b) => b.dataset.fix as FixId);
    const STEP = 1500;
    const reduced = (() => {
      try {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch {
        return false;
      }
    })();

    const set = (id: FixId, on: boolean) => {
      lab.setAttribute(`data-${id}`, on ? 'on' : 'off');
      buttons.find((b) => b.dataset.fix === id)?.setAttribute('aria-pressed', String(on));
      count.textContent = String(ids.filter((x) => lab.getAttribute(`data-${x}`) === 'on').length);
    };

    let timer: number | undefined;
    let next = 0; // index of the next fix the autoplay applies
    let playing = false;
    let visible = true;

    const setMode = (mode: 'pause' | 'play' | 'replay') => {
      play.dataset.mode = mode;
      playLabel.textContent = mode === 'pause' ? 'Pause' : mode === 'play' ? 'Play' : 'Replay';
    };
    const stop = () => {
      window.clearTimeout(timer);
      timer = undefined;
    };
    const tick = () => {
      if (!playing || !visible) return;
      const id = ids[next];
      if (!id) {
        playing = false;
        setMode('replay');
        return;
      }
      set(id, true);
      next += 1;
      timer = window.setTimeout(tick, next >= ids.length ? 400 : STEP);
    };
    const start = (fromScratch: boolean) => {
      stop();
      if (fromScratch) {
        ids.forEach((id) => set(id, false));
        next = 0;
      }
      playing = true;
      setMode('pause');
      timer = window.setTimeout(tick, fromScratch ? 900 : 300);
    };
    const pause = () => {
      stop();
      playing = false;
      setMode(next >= ids.length ? 'replay' : 'play');
    };

    play.hidden = false;
    play.addEventListener('click', () => {
      if (playing) pause();
      else start(next >= ids.length);
    });

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        pause();
        const id = b.dataset.fix as FixId;
        set(id, b.getAttribute('aria-pressed') !== 'true');
        // Manual edits leave nothing for the autoplay to "finish": offer a replay.
        next = ids.length;
        setMode('replay');
      }),
    );

    if (reduced) {
      // Final state stays; the toggles still work, and Replay steps through on request.
      next = ids.length;
      setMode('replay');
    } else {
      start(true);
    }

    // Only run while someone can see it.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        if (!e) return;
        visible = e.isIntersecting;
        if (visible && playing && timer === undefined) timer = window.setTimeout(tick, 400);
        if (!visible) stop();
      }).observe(lab);
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (playing && visible && timer === undefined) timer = window.setTimeout(tick, 400);
    });
  }
</script>
