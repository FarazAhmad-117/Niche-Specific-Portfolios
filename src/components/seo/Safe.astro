---
/**
 * How I keep it safe (brief §4 item 8): six rules in a 3 × 2 grid, each headed by a short
 * mono "config line" (links: none, review: human ...). The first one, no link building, is
 * said plainly, as decided.
 */
import { SAFE } from '../../data/seo/content';
---

<section class="section section--rule safe" id="safe" aria-labelledby="safe-title">
  <div class="container">
    <div class="head">
      <p class="eyebrow">How I keep it safe</p>
      <h2 id="safe-title">{SAFE.title}</h2>
    </div>

    <ul class="safe__grid" role="list" data-reveal-stagger>
      {
        SAFE.items.map((it, i) => (
          <li class:list={['rule', { 'rule--lead': i === 0 }]}>
            <code class="rule__code">{it.code}</code>
            <h3 class="rule__title">{it.title}</h3>
            <p class="rule__text">{it.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .safe__grid {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 720px) {
    .safe__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .safe__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .rule {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5) var(--space-6) 0;
    border-bottom: 1px solid var(--line);
    min-width: 0;
  }
  @media (min-width: 720px) {
    .rule {
      padding-left: var(--space-5);
      border-left: 1px solid var(--line);
    }
    .rule:nth-child(2n + 1) {
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (min-width: 1100px) {
    .rule:nth-child(2n + 1) {
      padding-left: var(--space-5);
      border-left: 1px solid var(--line);
    }
    .rule:nth-child(3n + 1) {
      padding-left: 0;
      border-left: 0;
    }
  }
  .rule__code {
    justify-self: start;
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    background: var(--surface-1);
    box-shadow: inset 0 0 0 1px var(--line);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text);
  }
  .rule--lead .rule__code {
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: none;
  }
  .rule__title {
    font-size: 1.375rem;
  }
  .rule__text {
    max-width: 40ch;
    color: var(--text-2);
    font-size: var(--fs-small);
  }
</style>
