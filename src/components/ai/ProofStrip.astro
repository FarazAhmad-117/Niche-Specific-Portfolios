---
/**
 * Proof strip: the facts a visitor can check, read like the header of a spec sheet.
 * Every value is owner-stated or verified (src/data/ai/profile.ts, cases.ts). No samples,
 * no placeholders. The stack row comes from STACK (site.ts), never hardcoded.
 */
import Section from './Section.astro';
import StackMarks from './StackMarks.astro';
import { STACK } from '../../data/ai/site';
import { PROFILE } from '../../data/ai/profile';

const facts = [
  { value: String(PROFILE.sinceYear), label: 'The year I started building AI and automation systems' },
  { value: PROFILE.company, label: `${PROFILE.companyRole}. The company behind Lead Drift and Yard Terminal` },
  { value: 'UTC+5', label: `${PROFILE.location} · PKT` },
];
---

<Section id="proof" label="At a glance">
  <h2 id="proof-title" class="visually-hidden">At a glance</h2>

  <ul class="proof plain-list" data-reveal-stagger>
    <li class="proof__cell proof__cell--live">
      <p class="proof__value"><span class="pill">Running in production</span></p>
      <p class="proof__label">
        <strong>Lead Drift</strong>, Indepth Solution's own growth engine, built and run by me.
      </p>
    </li>
    {
      facts.map((f) => (
        <li class="proof__cell">
          <p class="proof__value proof__value--text">{f.value}</p>
          <p class="proof__label">{f.label}</p>
        </li>
      ))
    }
  </ul>

  <div class="proof__stack">
    <p class="mono-label">Tools I build with</p>
    <StackMarks tools={STACK} label="Tools I build with" />
  </div>
</Section>

<style>
  .proof {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }
  .proof__cell {
    display: grid;
    align-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-4) var(--space-5) 0;
  }
  /* The one live fact spans the row on small screens. */
  .proof__cell--live {
    grid-column: 1 / -1;
    border-block-end: 1px solid var(--line);
  }
  .proof__cell--live ~ .proof__cell:nth-child(even) {
    padding-inline-start: 0;
    border-inline-start: 0;
  }
  .proof__cell--live ~ .proof__cell:nth-child(odd) {
    padding-inline-start: var(--space-4);
    border-inline-start: 1px solid var(--line);
  }
  .proof__cell--live ~ .proof__cell:last-child {
    grid-column: 1 / -1;
    padding-inline-start: 0;
    border-inline-start: 0;
    border-block-start: 1px solid var(--line);
  }
  .proof__value {
    margin: 0;
    min-block-size: calc(var(--fs-display-m) * 1.02);
    display: flex;
    align-items: flex-start;
  }
  .proof__value--text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-display-m);
    line-height: var(--lh-heading);
    letter-spacing: var(--tr-heading);
    font-variant-numeric: tabular-nums;
  }
  .proof__label {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--text-2);
    max-inline-size: 30ch;
  }
  .proof__label strong {
    color: var(--text);
    font-weight: 600;
  }
  .proof__stack {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }
  .proof__stack > p {
    margin: 0;
  }

  @media (min-width: 1024px) {
    .proof {
      grid-template-columns: 1.3fr repeat(3, minmax(0, 1fr));
    }
    .proof__cell,
    .proof__cell--live,
    .proof__cell--live ~ .proof__cell:nth-child(n),
    .proof__cell--live ~ .proof__cell:last-child {
      grid-column: auto;
      padding: var(--space-5) var(--space-5);
      border-block: 0;
      border-inline-start: 1px solid var(--line);
    }
    .proof__cell--live {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
    .proof__stack {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      column-gap: var(--space-5);
    }
  }
</style>
