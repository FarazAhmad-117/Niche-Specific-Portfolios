---
/**
 * About: the real portrait and the facts a buyer checks (all from src/data/ai/profile.ts).
 * The portrait is black and white on solid black, so it sits in an ink frame in both themes,
 * with a mono caption plate under it like the label on an instrument.
 *
 * Project names come from the registry (src/person/projects.ts): the company's products are
 * named only while present, and the "runs in production" sentence only while the project is
 * there and confirmed live.
 */
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { MAIN_SITE_URL, PERSON_NAME } from '../../data/ai/site';
import { PROFILE } from '../../data/ai/profile';
import { COMPANY_PROJECT_NAMES, andList } from '../../data/ai/cases';
import { getProject } from '../../person/case-helpers';
import { FOUNDED_VERB, ROLE_IN_SENTENCE, andList as toolList, stackFor, withArticle } from '../../person/claims';

const mainHost = new URL(MAIN_SITE_URL).host;
/** "I founded X" only for a founder role (config.ts › companyRole); otherwise "I'm a CTO at X" with the role. */
const companyClause = FOUNDED_VERB ? `I ${FOUNDED_VERB} ${PROFILE.company}` : `I'm ${withArticle(ROLE_IN_SENTENCE)} at ${PROFILE.company}`;
const behind = COMPANY_PROJECT_NAMES.length ? `, the company behind ${andList(COMPANY_PROJECT_NAMES)}` : '';
const liveProject = getProject('lead-drift');
const live = liveProject?.live ? liveProject : undefined;
/** The company that makes the live project (registry `madeBy`), as data/ai/cases.ts names it. */
const liveMaker = live?.madeBy ?? PROFILE.company;
/** The tools sentence, from src/person/config.ts › stack; undefined when none of these is listed. */
const noCode = stackFor(['n8n', 'Make', 'Zapier', 'GoHighLevel']);
const code = stackFor(['Python', 'Next.js', 'MongoDB']);
const workLine =
  noCode.length && code.length
    ? `I work in ${toolList(noCode)}, and in custom code with ${toolList(code)} when no-code hits its limits.`
    : noCode.length
      ? `I work in ${toolList(noCode)}.`
      : code.length
        ? `I work in custom code with ${toolList(code)}.`
        : undefined;
const facts = [
  { k: 'Building since', v: String(PROFILE.sinceYear) },
  { k: 'Based in', v: PROFILE.location },
  { k: 'Time zone', v: PROFILE.timeZone },
  { k: 'Company', v: `${PROFILE.companyRole}, ${PROFILE.company}` },
];
---

<Section id="about">
  <div class="about">
    <figure class="about__photo theme-ink" data-reveal>
      <Image
        src={PROFILE.portrait.src}
        alt={PROFILE.portrait.alt}
        width={560}
        height={700}
        widths={[360, 560, 840]}
        sizes="(min-width: 1024px) 28vw, (min-width: 768px) 36vw, 80vw"
        loading="lazy"
        decoding="async"
        class="about__img"
      />
      <figcaption class="about__plate mono">
        <span>{PERSON_NAME}</span>
        <span class="about__plate-dim">{PROFILE.city} · {PROFILE.timeZone.split(' ')[0]}</span>
      </figcaption>
    </figure>

    <div class="about__copy">
      <h2 id="about-title">You talk to the person building it.</h2>
      <div class="prose about__text">
        <p class="about__lead">
          {`I'm ${PERSON_NAME}. I've been building AI and automation systems since ${PROFILE.sinceYear}, and ${companyClause}${behind}.`}
        </p>
        {
          live ? (
            workLine ? (
              <p>
                {`${workLine} ${live.name}`}, {liveMaker}'s own growth engine, is mine, and it runs in production.
              </p>
            ) : (
              <p>
                {live.name}, {liveMaker}'s own growth engine, is mine, and it runs in production.
              </p>
            )
          ) : (
            workLine && <p>{workLine}</p>
          )
        }
        <p>From the first call to handover, you deal with me, not an account manager.</p>
      </div>
      <dl class="about__facts">
        {
          facts.map((f) => (
            <div class="about__fact">
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
        <div class="about__fact">
          <dt>Main site</dt>
          <dd>
            <a class="link ext" href={MAIN_SITE_URL} target="_blank" rel="noopener">
              {mainHost}<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: var(--space-7);
  }
  /* Ink frame in both themes: the photo's black background bleeds into it. */
  .about__photo {
    margin: 0;
    inline-size: min(100%, 22rem);
    padding: 10px 10px 0;
    border: 1px solid var(--line-strong);
  }
  .about__photo :global(.about__img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: #000;
  }
  .about__plate {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 12px 2px 12px;
    font-size: var(--fs-mono-label);
    color: var(--text);
  }
  .about__plate-dim {
    color: var(--text-3);
  }

  .about__copy {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }
  .about__copy > h2 {
    margin: 0;
  }
  .about__text > p {
    margin: 0 0 var(--space-4);
    color: var(--text-2);
  }
  .about__text > .about__lead {
    font-size: var(--fs-lede);
    line-height: 1.5;
    color: var(--text);
  }
  .about__text > p:last-child {
    margin-block-end: 0;
  }
  .about__facts {
    display: grid;
    margin: 0;
    border-block-start: 1px solid var(--line-strong);
  }
  .about__fact {
    display: grid;
    grid-template-columns: minmax(7.5rem, 11rem) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-3);
    border-block-end: 1px solid var(--line);
  }
  .about__fact dt,
  .about__fact dd {
    margin: 0;
  }
  .about__fact dt {
    font: 500 var(--fs-mono-label) / 1.4 var(--font-mono);
    letter-spacing: var(--tr-mono-label);
    text-transform: uppercase;
    color: var(--text-3);
  }
  .about__fact dd {
    font-weight: 500;
  }
  .about__fact a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
    margin-block: -12px;
  }

  @media (min-width: 768px) {
    .about {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: start;
    }
    .about__photo {
      grid-column: 1 / span 3;
      inline-size: auto;
    }
    .about__copy {
      grid-column: 4 / -1;
    }
  }
  @media (min-width: 1024px) {
    .about {
      grid-template-columns: repeat(10, minmax(0, 1fr));
    }
    .about__photo {
      grid-column: 1 / span 4;
      position: sticky;
      top: calc(var(--nav-h) + var(--space-5));
    }
    .about__copy {
      grid-column: 6 / -1;
    }
  }
</style>
