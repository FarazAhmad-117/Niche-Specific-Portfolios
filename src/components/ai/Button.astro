---
/**
 * Button / button-styled link (spec §4.5).
 *
 * Props
 *   variant?: 'primary' | 'secondary' | 'ghost'   default 'primary'
 *   href?: string            renders <a> when given, else <button>
 *   size?: 'm' | 's'         m = 48px min-height, s = 44px
 *   arrow?: '→' | '↓' | '↗' | false   trailing glyph (aria-hidden), default '→' for primary, false otherwise
 *   surface?: 'auto' | 'ink' auto = follow theme tokens (ink button with lime square on bone,
 *                            lime button in dark theme and inside .theme-ink);
 *                            ink = force the lime-on-ink style regardless of context
 *   type?: 'button' | 'submit' | 'reset'   (button only, default 'button')
 *   disabled?: boolean       sets aria-disabled (keeps focus) and blocks clicks
 *   block?: boolean          full width
 *   class?: string, plus any other <a>/<button> attribute (data-*, aria-*, id ...)
 *
 * Slot: the label.
 */
import type { HTMLAttributes } from 'astro/types';

type Glyph = '→' | '↓' | '↗';
type Props = Omit<HTMLAttributes<'a'>, 'type' | 'class'> & {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  size?: 'm' | 's';
  arrow?: Glyph | false;
  surface?: 'auto' | 'ink';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  block?: boolean;
  class?: string;
};

const {
  variant = 'primary',
  href,
  size = 'm',
  arrow,
  surface = 'auto',
  type = 'button',
  disabled = false,
  block = false,
  class: className,
  ...rest
} = Astro.props;

const glyph = arrow === undefined ? (variant === 'primary' ? '→' : false) : arrow;
const classes = [
  'btn',
  `btn--${variant}`,
  `btn--${size}`,
  surface === 'ink' && 'btn--ink',
  block && 'btn--block',
  glyph === '↓' && 'btn--down',
  className,
];
const buttonRest = rest as HTMLAttributes<'button'>;
---

{
  href ? (
    <a
      href={disabled ? undefined : href}
      class:list={classes}
      aria-disabled={disabled ? 'true' : undefined}
      role={disabled ? 'link' : undefined}
      {...rest}
    >
      {variant === 'primary' && <span class="btn__square" aria-hidden="true" />}
      <span class="btn__label">
        <slot />
      </span>
      {glyph && (
        <span class="btn__arrow" aria-hidden="true">
          {glyph}
        </span>
      )}
    </a>
  ) : (
    <button type={type} class:list={classes} aria-disabled={disabled ? 'true' : undefined} {...buttonRest}>
      {variant === 'primary' && <span class="btn__square" aria-hidden="true" />}
      <span class="btn__label">
        <slot />
      </span>
      {glyph && (
        <span class="btn__arrow" aria-hidden="true">
          {glyph}
        </span>
      )}
    </button>
  )
}

<style>
  .btn {
    --btn-h: 48px;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: var(--btn-h);
    min-width: var(--tap);
    padding-inline: 20px;
    border: 1px solid transparent;
    border-radius: var(--radius-l);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.005em;
    text-align: center;
    text-decoration: none;
    white-space: normal;
    touch-action: manipulation;
    user-select: none;
    background: transparent;
    color: var(--text);
    transition:
      background-color var(--dur-hover) var(--ease-out),
      border-color var(--dur-hover) var(--ease-out),
      color var(--dur-hover) var(--ease-out),
      text-decoration-color var(--dur-hover) var(--ease-out),
      box-shadow var(--dur-hover) var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .btn--s {
    --btn-h: 44px;
    padding-inline: 16px;
    font-size: 0.9375rem;
  }
  .btn--block {
    display: flex;
    width: 100%;
  }
  .btn__label {
    min-width: 0;
  }
  .btn__arrow {
    display: inline-block;
    font-family: var(--font-body), "Segoe UI Symbol", sans-serif;
    transition: transform 320ms var(--ease-emph);
  }

  /* primary: ink + lime square on bone; lime in dark theme / consoles (tokens flip).
     A hairline top highlight gives the fill a little depth without a drop shadow. */
  .btn--primary {
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1);
  }
  .btn__square {
    display: var(--btn-square, none);
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--lime-400);
  }
  .btn--ink {
    --btn-primary-bg: var(--lime-400);
    --btn-primary-fg: var(--ink-950);
    --btn-primary-bg-hover: var(--lime-300);
    --btn-primary-bg-active: var(--lime-500);
    --btn-square: none;
  }

  /* secondary */
  .btn--secondary {
    border-color: var(--line-strong);
    color: var(--text);
  }

  /* ghost: underlined text, 44px hit area */
  .btn--ghost {
    min-height: var(--tap);
    padding-inline: 0;
    color: var(--text);
    text-decoration: underline 1px var(--line-strong);
    text-underline-offset: 5px;
  }

  /* hover twins focus-visible (§4.5) */
  .btn--primary:focus-visible {
    background: var(--btn-primary-bg-hover);
  }
  .btn--secondary:focus-visible {
    border-color: var(--text);
    background: var(--surface-1);
  }
  .btn--ghost:focus-visible {
    text-decoration-color: var(--accent-text);
    text-decoration-thickness: 2px;
  }
  .btn:focus-visible .btn__arrow {
    transform: translateX(3px);
  }
  .btn--down:focus-visible .btn__arrow {
    transform: translateY(3px);
  }
  .btn--primary:focus-visible .btn__square {
    animation: square-pulse 300ms var(--ease-out);
  }
  @media (hover: hover) {
    .btn--primary:hover {
      background: var(--btn-primary-bg-hover);
    }
    .btn--secondary:hover {
      border-color: var(--text);
      background: var(--surface-1);
    }
    .btn--ghost:hover {
      text-decoration-color: var(--accent-text);
      text-decoration-thickness: 2px;
    }
    .btn:hover .btn__arrow {
      transform: translateX(3px);
    }
    .btn--down:hover .btn__arrow {
      transform: translateY(3px);
    }
    .btn--primary:hover .btn__square {
      animation: square-pulse 300ms var(--ease-out);
    }
  }

  /* press: a small, quick give, released on the same curve */
  .btn:active:not([aria-disabled="true"]) {
    transform: scale(0.97);
    transition-duration: var(--dur-press);
  }
  .btn--ghost:active:not([aria-disabled="true"]) {
    transform: none;
  }
  .btn--primary:active:not([aria-disabled="true"]) {
    background: var(--btn-primary-bg-active);
  }
  .btn--ghost:active:not([aria-disabled="true"]) {
    color: var(--text-2);
  }

  /* disabled */
  .btn[aria-disabled="true"],
  .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  @keyframes square-pulse {
    50% {
      transform: scale(1.25);
    }
  }

  @media (forced-colors: active) {
    .btn {
      border-color: ButtonText;
    }
    .btn__square {
      background: ButtonText;
    }
  }
</style>
