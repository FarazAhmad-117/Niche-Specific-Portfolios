---
/**
 * Case studies on the home page: four compact cards in a 2×2 grid (one column on phones). Each
 * card is one link to its /work/<slug>/ page. Detail lives on the case page.
 *
 * Page transition: each card carries data-vt-case="<slug>", as do the case page hero panel and
 * its "next case" card. The inline script in the Layout names only the one case a navigation is
 * about (`case-<slug>`), on both documents, so the card box morphs into the hero (base.css).
 * Only the box morphs, never the title (different wrapping would stretch the text).
 * Cards are never reveal-armed: a transition may morph into one at load.
 *
 * Example mode (a project case absent from src/person/projects.ts): the grid's last row is
 * completed with dashed CASE_SLOT cards (none for the current owner, whose four cases fill it).
 */
import Todo from './Todo.astro';
import { CASES, CASE_SLOT, CASE_SLOTS } from '../../data/cloud/cases';
import { caseHref } from '../../lib/cloud/paths';
import { isTodo } from '../../data/cloud/todo';
---

<section class="section cases" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="head head--split">
      <p class="eyebrow">Case studies</p>
      <h2 id="work-title">The systems, and the numbers still to measure.</h2>
      <p class="lede">
        What each one has to guarantee and how it is built. Every metric is a baseline still to be measured, so it shows as
        a gap, not a guess.
      </p>
    </div>

    <ul class="cases__grid" role="list">
      {
        CASES.map((c) => {
          const lane = c.arch[0];
          return (
            <li class="case panel" id={`card-${c.slug}`} data-vt-case={c.slug}>
              <div class="case__top">
                <span class="case__kicker mono">{c.kicker}</span>
                <span class:list={['status', `status--${c.status.tone}`]}>{c.status.label}</span>
              </div>
              <h3 class="case__name">
                <a class="case__link" href={caseHref(c.slug)}>
                  {c.name}
                </a>
              </h3>
              <p class="case__title">{c.title}</p>

              {lane && (
                <ol class="case__arch" role="list" aria-label={`${c.name}: ${lane.title}`}>
                  {lane.nodes.map((nd) => (
                    <li class:list={['node', { 'node--todo': isTodo(nd.label) }]}>
                      <Todo value={nd.label} />
                    </li>
                  ))}
                </ol>
              )}

              <div class="case__metrics">
                <span class="case__metrics-label mono">Metrics</span>
                <span class="case__metrics-list">{c.metrics.map((m) => m.name).join(' · ')}</span>
                <span class="todo">TODO · baseline</span>
              </div>

              <div class="case__end">
                <span class="case__more" aria-hidden="true">
                  Read the case study <span class="case__arrow">→</span>
                </span>
                {c.pending && <span class="todo">{c.pending.startsWith('TODO') ? c.pending : `TODO · ${c.pending}`}</span>}
              </div>
            </li>
          );
        })
      }
      {
        Array.from({ length: CASE_SLOTS }, () => (
          <li class="case panel" aria-label="Case study placeholder">
            <div class="case__top">
              <span class="case__kicker mono">{CASE_SLOT.kicker}</span>
            </div>
            <p class="case__title">{CASE_SLOT.title}</p>
            <div class="case__end">
              {CASE_SLOT.chips.map((t) => <span class="todo">{t}</span>)}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cases__grid {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  @media (min-width: 900px) {
    .cases__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .case {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto auto;
    align-content: start;
    gap: var(--space-4);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    scroll-margin-top: var(--space-4);
    transition:
      transform 700ms var(--ease-out-expo),
      box-shadow 700ms var(--ease-out-expo);
  }
  /* The title link stretches over the card: the whole card is the target, one tab stop. */
  .case__link {
    color: inherit;
    text-decoration: none;
  }
  .case__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-m);
  }
  .case__link:focus-visible {
    outline: none;
  }
  .case:has(.case__link:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }
  @media (hover: hover) {
    .case:hover {
      transform: translateY(-3px);
      box-shadow:
        inset 0 0 0 1px var(--line-strong),
        var(--shadow-lift);
    }
    .case:hover .case__arrow {
      transform: translateX(5px);
    }
  }
  .case__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .case__kicker {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .case__name {
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 700;
    font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2.375rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .case__title {
    color: var(--text-2);
    font-weight: 600;
    line-height: 1.4;
    max-width: 44ch;
  }

  /* A compact architecture strip: nodes joined by hairlines. */
  .case__arch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-self: start;
    gap: 8px 22px;
    margin: 0;
  }
  .node {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 4px 10px;
    border-radius: var(--radius-xs);
    background: var(--surface-1);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .node:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    width: 22px;
    height: 1px;
    background: var(--line-strong);
  }
  .node:last-child {
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .node--todo {
    padding: 0;
    background: none !important;
    box-shadow: none !important;
  }
  .node--todo .todo {
    min-height: 32px;
  }

  .case__metrics {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
  }
  .case__metrics-label {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .case__metrics-list {
    font-weight: 600;
  }
  .case__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
  }
  .case__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
  }
  .case__arrow {
    display: inline-block;
    color: var(--accent-text);
    transition: transform 620ms var(--ease-out-expo);
  }
</style>
