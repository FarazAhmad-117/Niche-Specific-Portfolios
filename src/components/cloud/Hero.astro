---
/**
 * Hero: the decided headline, the two CTAs, and a calm status page for an example service.
 *
 * Visual: a deck of three panels. The two behind the status page step up and in, and only their
 * header strips show, each one whole and legible (no clipped fragments). The deck stretches to
 * the copy column, so its top meets the eyebrow and its foot meets the note.
 * Desktop: the hero fills the first screen (100svh minus the nav), content centred.
 *
 * Exactly one thing changes per beat (~2.8s): a deploy-log line arrives on the spring. After the
 * last line the panel rests, then the log clears and the cycle starts again. Paused off screen and
 * in hidden tabs. No JS / reduced motion: the finished state (latest lines) is what renders.
 * Decorative and stamped "Example"; the copy beside it is the content.
 */
import { HERO, HERO_CHECKS, HERO_LAYERS, HERO_LOG, HERO_SERVICES } from '../../data/cloud/content';
import { bookingUrl, SUPPORT_HOURS } from '../../data/cloud/site';

const DAYS = 30;
/** Historic blips per service row (bar index → tone), purely illustrative texture. */
const BLIPS: Record<string, Record<number, 'warn' | 'muted'>> = {
  api: { 9: 'warn' },
  worker: { 21: 'warn', 22: 'muted' },
};
const VISIBLE = 3;
const BEAT_MS = 2800;

/** A calm, shape-only latency trace (no axis numbers): deterministic, drawn once on the server. */
const TW = 240;
const TH = 60;
const pts = Array.from({ length: 49 }, (_, i) => {
  const y = 0.5 + 0.12 * Math.sin(i * 0.55) + 0.07 * Math.sin(i * 1.7 + 1) + (i === 17 ? 0.16 : 0) + (i === 18 ? 0.08 : 0);
  return [(i / 48) * TW, TH - y * TH * 0.62 - 6] as const;
});
const trendLine = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const trendArea = `${trendLine} L${TW} ${TH} L0 ${TH} Z`;
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero__grid-bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">{HERO.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">
        {HERO.headline.map((p) => (p.em ? <span class="em">{p.text}</span> : p.text))}
      </h1>
      <p class="lede hero__lede">{HERO.lede}</p>
      <div class="hero__ctas">
        <a class="btn" href={bookingUrl('hero')}>
          <span class="btn__led" aria-hidden="true"></span>
          <span>{HERO.primary}</span>
        </a>
        <a class="btn btn--ghost" href="#service-audit">
          <span>{HERO.secondary}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <p class="hero__note text-3">{HERO.note} <span class="hero__hours">Support {SUPPORT_HOURS}.</span></p>
    </div>

    <div class="hero__visual" aria-hidden="true" data-hero-visual data-pause-offscreen style={`--beat:${BEAT_MS}ms`}>
      {
        HERO_LAYERS.map((l, i) => (
          <div class:list={['layer', `layer--${i + 1}`]}>
            <span class="layer__title mono">{l.title}</span>
            <span class="status status--ok layer__status">{l.status}</span>
          </div>
        ))
      }

      <div class="board panel panel--ticks">
        <div class="board__head">
          <span class="board__title mono">status · example-app</span>
          <span class="stamp">Example</span>
        </div>
        <p class="board__overall status status--ok">All systems operational</p>

        <ul class="svc" role="list">
          {
            HERO_SERVICES.map((s) => (
              <li class="svc__row">
                <div class="svc__top">
                  <span class="svc__name mono">{s.name}</span>
                  <span class="svc__note mono">{s.note}</span>
                  <span class="svc__dot" />
                </div>
                <div class="svc__bars">
                  {Array.from({ length: DAYS }, (_, i) => (
                    <span class:list={['bar', BLIPS[s.name]?.[i] && `bar--${BLIPS[s.name]?.[i]}`]} />
                  ))}
                </div>
              </li>
            ))
          }
        </ul>
        <div class="svc__axis mono"><span>30 days ago</span><span>today</span></div>

        <div class="trend">
          <div class="trend__head mono">
            <span>latency · last 24h</span>
            <span class="trend__key">alert line</span>
          </div>
          <svg class="trend__svg" viewBox={`0 0 ${TW} ${TH}`} preserveAspectRatio="none">
            <path class="trend__area" d={trendArea} />
            <path class="trend__alert" d={`M0 10 H${TW}`} />
            <path class="trend__line" d={trendLine} />
          </svg>
        </div>

        <dl class="checks">
          {
            HERO_CHECKS.map((c) => (
              <div class="checks__cell">
                <dt class="mono">{c.k}</dt>
                <dd>{c.v}</dd>
              </div>
            ))
          }
        </dl>

        <div class="log">
          <p class="log__label mono">deploy log</p>
          <ol class="log__list" role="list" data-log>
            {
              HERO_LOG.map((l, i) => (
                <li class:list={['log__line', `log__line--${l.tone}`, { 'is-on': i >= HERO_LOG.length - VISIBLE }]} data-line>
                  <span class="log__t num">{l.t}</span>
                  <span class="log__text">{l.text}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(2.5rem, 1.5rem + 4vw, 6rem));
    padding-bottom: var(--space-section);
    overflow: hidden;
    overflow: clip;
  }
  /* Desktop: the first screen, content centred between the nav and the fold. */
  @media (min-width: 1080px) {
    .hero {
      display: flex;
      align-items: center;
      min-height: 100vh;
      min-height: 100svh;
      padding-top: calc(var(--nav-h) + clamp(1.5rem, 5svh, 4.5rem));
      padding-bottom: clamp(1.5rem, 5svh, 4.5rem);
    }
  }
  /* The ops-room floor: a faint dot grid fading out toward the copy. */
  .hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--grid-dot) 1px, transparent 1.2px);
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(70% 80% at 78% 45%, #000 30%, transparent 75%);
    mask-image: radial-gradient(70% 80% at 78% 45%, #000 30%, transparent 75%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 2rem + 4vw, 5rem);
  }
  @media (min-width: 1080px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      column-gap: clamp(2.5rem, 1rem + 3vw, 5rem);
      align-items: stretch;
    }
    .hero__copy {
      align-self: center;
    }
  }
  .hero__copy {
    min-width: 0;
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .hero__title {
    max-width: 13ch;
  }
  .hero__lede {
    max-width: 46ch;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .hero__note {
    font-size: var(--fs-small);
    max-width: 52ch;
  }
  .hero__hours {
    white-space: nowrap;
  }

  /* ---------- the deck ----------
   * --peek: how much of each panel behind shows (its whole header strip). Each layer steps in by
   * --step on both sides, so the deck reads as depth, not as offset clutter. */
  .hero__visual {
    --peek: clamp(34px, 3.4svh, 42px);
    --step: clamp(14px, 1.4vw, 22px);
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
    max-width: 600px;
    justify-self: center;
    padding-top: calc(2 * var(--peek));
  }
  @media (min-width: 1080px) {
    .hero__visual {
      justify-self: end;
    }
  }
  .layer {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: space-between;
    align-self: stretch;
    gap: 12px;
    height: calc(var(--peek) + 24px);
    padding: 0 16px 24px;
    border-radius: var(--radius-m) var(--radius-m) 0 0;
    box-shadow:
      inset 0 1px 0 var(--line),
      inset 1px 0 0 var(--line),
      inset -1px 0 0 var(--line);
  }
  .layer--1 {
    top: 0;
    left: calc(2 * var(--step));
    right: calc(2 * var(--step));
    background: color-mix(in srgb, var(--surface-1) 70%, var(--bg));
  }
  .layer--2 {
    top: var(--peek);
    left: var(--step);
    right: var(--step);
    background: var(--surface-1);
    box-shadow:
      inset 0 1px 0 var(--line),
      inset 1px 0 0 var(--line),
      inset -1px 0 0 var(--line),
      0 -10px 24px -18px rgb(0 0 0 / 0.25);
  }
  .layer__title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-2);
    font-size: 0.6875rem;
  }
  .layer--1 .layer__title {
    color: var(--text-3);
  }
  .layer__status {
    min-height: 22px;
    padding: 2px 8px;
    background: transparent;
    font-size: 0.625rem;
  }

  .board {
    position: relative;
    z-index: 1;
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.5svh, 16px);
    padding: clamp(16px, 1rem + 0.6vw, 24px);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-lift);
  }
  /* Only the latency trace flexes; every other row keeps its natural height. */
  .board > * {
    flex-shrink: 0;
  }
  .board__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .board__title {
    color: var(--text-2);
  }
  .board__overall {
    align-self: flex-start;
    background: var(--accent-soft);
    color: var(--text);
  }

  .svc {
    display: grid;
    gap: clamp(8px, 1.3svh, 14px);
    margin: 0;
  }
  .svc__top {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }
  .svc__name {
    color: var(--text);
    font-weight: 600;
  }
  .svc__note {
    color: var(--text-3);
    font-size: 0.625rem;
  }
  .svc__dot {
    width: 7px;
    height: 7px;
    margin-left: auto;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 22%, transparent);
  }
  .svc__bars {
    display: grid;
    grid-template-columns: repeat(30, 1fr);
    gap: 2px;
  }
  .bar {
    height: clamp(14px, 2.2svh, 22px);
    border-radius: 1.5px;
    background: var(--ok);
    opacity: 0.85;
  }
  .bar--warn {
    background: var(--warn);
  }
  .bar--muted {
    background: var(--line-strong);
  }
  .svc__axis {
    display: flex;
    justify-content: space-between;
    margin-top: -4px;
    color: var(--text-3);
    font-size: 0.5625rem;
    text-transform: uppercase;
  }

  /* Shape-only latency trace: grows to fill whatever height the copy column gives the deck. */
  .board > .trend {
    flex: 1 1 0;
  }
  .trend {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 72px;
    padding: 10px 12px 0;
    border-radius: var(--radius-s);
    background: var(--surface-1);
    overflow: hidden;
  }
  .trend__head {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    color: var(--text-3);
    font-size: 0.5625rem;
    text-transform: uppercase;
  }
  .trend__key {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .trend__key::before {
    content: '';
    width: 14px;
    border-top: 1.5px dashed var(--warn);
  }
  .trend__svg {
    flex: 1 1 0;
    width: 100%;
    height: 0; /* ignore the viewBox ratio: the trace takes whatever height is left */
    min-height: 44px;
  }
  .trend__area {
    fill: color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .trend__line {
    fill: none;
    stroke: var(--ok);
    stroke-width: 1.75;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .trend__alert {
    fill: none;
    stroke: var(--warn);
    stroke-width: 1.25;
    stroke-dasharray: 4 4;
    vector-effect: non-scaling-stroke;
  }

  /* Housekeeping checks: three states in a hairline strip. */
  .checks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-radius: var(--radius-s);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .checks__cell {
    display: grid;
    gap: 2px;
    min-width: 0;
    padding: 8px 12px;
  }
  .checks__cell + .checks__cell {
    box-shadow: inset 1px 0 0 var(--line);
  }
  .checks dt {
    color: var(--text-3);
    font-size: 0.5625rem;
    text-transform: uppercase;
  }
  .checks dd {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    font-weight: 650;
    font-size: 0.875rem;
    line-height: 1.3;
    white-space: nowrap;
  }
  .checks dd::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--ok);
  }

  /* ---------- deploy log: three lines tall, newest at the bottom, pinned to the foot ---------- */
  .log {
    margin-top: auto;
    padding: 10px 12px 12px;
    border-radius: var(--radius-s);
    background: var(--surface-1);
  }
  .log__label {
    margin-bottom: 6px;
    color: var(--text-3);
    font-size: 0.5625rem;
    text-transform: uppercase;
  }
  .log__list {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: calc(3 * 1.9em);
    margin: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.9;
  }
  .log__line {
    display: none;
    flex: none; /* never shrink to fit: older lines must scroll out of the top instead */
    align-items: center;
    height: 1.9em;
    gap: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .log__line.is-on {
    display: flex;
  }
  .log__t {
    flex: none;
    color: var(--text-3);
  }
  .log__text {
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text-2);
  }
  .log__line--ok .log__text::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 7px;
    border-radius: 1px;
    background: var(--ok);
    vertical-align: 0.08em;
  }
  .log__line.is-new {
    animation: line-in var(--dur-arrive) var(--ease-spring) both;
  }
  .log__line.is-new .log__text {
    color: var(--text);
  }
  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateY(70%);
    }
  }
  .log__list.is-clearing .log__line {
    opacity: 0;
    transition: opacity 500ms var(--ease-out-quint);
  }

  @media (max-width: 1079px) {
    .hero__visual {
      max-width: 560px;
    }
    .board > .trend {
      flex: none;
      height: 96px;
    }
  }
  /* Short desktop screens (1366×768 and the like): everything still fits above the fold. The
     headline is capped by height, the copy tightens, and the trace (pure texture) steps out. */
  @media (min-width: 1080px) {
    .hero__title {
      font-size: min(var(--fs-hero), 10.5svh);
    }
  }
  @media (min-width: 1080px) and (max-height: 840px) {
    .hero__copy {
      gap: var(--space-4);
    }
    .hero__title {
      font-size: min(var(--fs-hero), 9.5svh);
    }
    .hero__visual {
      --peek: 30px;
    }
    .board {
      gap: 9px;
      padding: 14px 18px;
    }
    .svc {
      gap: 7px;
    }
    .svc__top {
      margin-bottom: 4px;
    }
    .bar {
      height: 12px;
    }
    .trend {
      display: none;
    }
    .log {
      margin-top: 0;
    }
    .board {
      justify-content: space-between;
    }
  }
  @media (max-width: 520px) {
    .hero__visual {
      --peek: 34px;
      --step: 10px;
    }
    .layer {
      padding-inline: 12px;
    }
    .checks__cell {
      padding: 7px 9px;
    }
    .checks dd {
      font-size: 0.8125rem;
      gap: 5px;
    }
    .log__list {
      font-size: 0.625rem;
    }
  }
  /* Narrow phones: drop the timestamps so every log line reads in full. */
  @media (max-width: 400px) {
    .log__t {
      display: none;
    }
  }
</style>

<script>
  import { prefersReduced } from '../../lib/cloud/base';

  const vis = document.querySelector<HTMLElement>('[data-hero-visual]');
  const list = vis?.querySelector<HTMLElement>('[data-log]');
  if (vis && list && !prefersReduced()) {
    const lines = [...list.querySelectorAll<HTMLElement>('[data-line]')];
    const n = lines.length;
    const VISIBLE = 3;
    const beat = Number.parseFloat(getComputedStyle(vis).getPropertyValue('--beat')) || 2800;
    // Start from the server-rendered finished state (latest lines) so nothing jumps on first
    // paint: the first beat rests, then the log clears and fills in from the top.
    let shown = n; // lines 0..shown-1 are on; the newest is shown-1
    let timer: number | undefined;
    let onScreen = false;

    const render = (fresh: number | null) => {
      lines.forEach((l, i) => {
        l.classList.toggle('is-on', i < shown);
        l.classList.toggle('is-new', i === fresh);
      });
    };

    const tick = () => {
      if (shown < n) {
        shown += 1;
        render(shown - 1);
        schedule(shown === n ? beat * 2 : beat);
        return;
      }
      // Rest is over: clear softly, then start again from the first three lines.
      list.classList.add('is-clearing');
      timer = window.setTimeout(() => {
        list.classList.remove('is-clearing');
        shown = VISIBLE;
        render(null);
        schedule(beat);
      }, 520);
    };
    const schedule = (ms: number) => {
      window.clearTimeout(timer);
      if (!onScreen || document.hidden) return;
      timer = window.setTimeout(tick, ms);
    };
    const resume = () => {
      // A pause during the soft clear would leave the log blank: finish the reset first.
      if (list.classList.contains('is-clearing')) {
        list.classList.remove('is-clearing');
        shown = VISIBLE;
        render(null);
      }
      schedule(beat);
    };

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        onScreen = Boolean(e?.isIntersecting);
        if (onScreen) resume();
        else window.clearTimeout(timer);
      }).observe(vis);
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) window.clearTimeout(timer);
      else resume();
    });
  }
</script>
