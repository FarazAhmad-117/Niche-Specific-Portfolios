---
/**
 * Proof strip (brief §4 item 2). The ops numbers are baseline TODOs until real measurements are
 * cleared; the one real figure is the main site's own test suite. Below it, "Clouds & tools":
 * only tools the research proves are used, then TODO slots (decisions: clouds/certs are OPEN, so
 * no AWS/GCP/Terraform marks and no certification claims). Tool lines that claim the owner's own
 * stack show only while the projects they name exist (lib/cloud/tools.ts); TODO chips refill the row.
 */
import Todo from './Todo.astro';
import { PROOF } from '../../data/cloud/content';
import { SHOWN_TOOLS as TOOLS_VERIFIED, SHOWN_TOOLS_TODO as TOOLS_TODO } from '../../lib/cloud/tools';
import { isTodo } from '../../data/cloud/todo';
---

<section class="proof" id="proof" aria-labelledby="proof-title">
  <div class="container">
    <h2 id="proof-title" class="visually-hidden">Proof</h2>
    <dl class="proof__stats" data-reveal-stagger>
      {
        PROOF.map((p) => (
          <div class:list={['stat', { 'stat--todo': isTodo(p.value) }]}>
            <dt class="stat__label mono">{p.label}</dt>
            <dd class="stat__value num">
              <Todo value={p.value} />
            </dd>
            <dd class="stat__note">{p.note}</dd>
          </div>
        ))
      }
    </dl>

    <div class="tools">
      <p class="tools__label mono">Clouds &amp; tools</p>
      <ul class="tools__list" role="list">
        {
          TOOLS_VERIFIED.map((t) => (
            <li class="tool">
              <span class="tool__name">{t.name}</span>
              <span class="tool__where">{t.where}</span>
            </li>
          ))
        }
        {
          TOOLS_TODO.map((t) => (
            <li class="tool tool--todo">
              <span class="todo">{t}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .proof {
    padding-bottom: var(--space-4);
  }
  .proof__stats {
    display: grid;
    gap: 1px;
    margin: 0;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--line);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  @media (min-width: 640px) {
    .proof__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1080px) {
    .proof__stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .stat {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--surface-2);
  }
  .stat__label {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .stat__value {
    margin: 0;
    min-height: 3.2rem;
    display: flex;
    align-items: center;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 700;
    font-size: clamp(2rem, 1.6rem + 1.4vw, 3rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .stat__note {
    margin: 0;
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.45;
  }

  .tools {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .tools__label {
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .tools__list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  @media (min-width: 640px) {
    .tools__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1080px) {
    .tools__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .tool {
    display: grid;
    gap: 2px;
    align-content: center;
    min-height: 64px;
    padding: 10px 14px;
    border-radius: var(--radius-s);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .tool__name {
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }
  .tool__where {
    color: var(--text-3);
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .tool--todo {
    padding: 0;
    box-shadow: none;
  }
  .tool--todo .todo {
    height: 100%;
    min-height: 64px;
    padding: 10px 14px;
    border-radius: var(--radius-s);
  }
</style>
