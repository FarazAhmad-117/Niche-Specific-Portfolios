---
/**
 * Theme toggle: a small panel switch, day / night. aria-label "Dark theme" + aria-pressed = dark
 * on. Persists to localStorage('theme'); the no-flash inline script lives in the Layout <head>.
 * The knob slides on in-out-quart; the swap itself is a top-down wipe of the new theme over the
 * old one, through the View Transitions API when present.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button type="button" class:list={['tt', className]} aria-label="Dark theme" aria-pressed="false" data-theme-toggle>
  <span class="tt__track" aria-hidden="true">
    <svg class="tt__sun" viewBox="0 0 16 16" width="11" height="11"
      ><circle cx="8" cy="8" r="3.2"></circle><path
        d="M8 1.2v1.6M8 13.2v1.6M1.2 8h1.6M13.2 8h1.6M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M3.2 12.8l1.1-1.1M11.7 4.3l1.1-1.1"
      ></path></svg
    >
    <svg class="tt__moon" viewBox="0 0 16 16" width="11" height="11"><path d="M10.8 2.2a6 6 0 1 0 3 9.6A5 5 0 0 1 10.8 2.2z"></path></svg>
    <span class="tt__knob"></span>
  </span>
</button>

<style>
  .tt {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--text);
    touch-action: manipulation;
    transition: background-color var(--dur-hover) var(--ease-out-quint);
  }
  .tt__track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 38px;
    height: 22px;
    padding: 0 5px;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px var(--control-border);
    background: var(--surface-1);
  }
  .tt__track svg {
    fill: none;
    stroke: var(--text-3);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .tt__moon {
    fill: var(--text-3) !important;
    stroke: none !important;
  }
  .tt__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: var(--text);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
    transition: transform 520ms var(--ease-in-out-quart);
  }
  /* Day: the knob covers the moon side (right) and leaves the sun showing. Night: the reverse. */
  .tt[aria-pressed='false'] .tt__knob {
    transform: translateX(16px);
  }
  .tt[aria-pressed='true'] .tt__knob {
    transform: none;
    background: var(--accent);
  }
  .tt:focus-visible {
    background: var(--surface-1);
  }
  @media (hover: hover) {
    .tt:hover {
      background: var(--surface-1);
    }
  }
  .tt:active .tt__knob {
    scale: 0.9;
  }
  @media (forced-colors: active) {
    .tt__knob {
      background: CanvasText;
      forced-color-adjust: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const KEY = 'theme';
  type Theme = 'light' | 'dark';
  const COLORS: Record<Theme, string> = { light: '#f3f6f5', dark: '#0b1115' };

  let dark: MediaQueryList | null = null;
  try {
    dark = window.matchMedia('(prefers-color-scheme: dark)');
  } catch {
    dark = null;
  }
  const reduced = (): boolean => {
    try {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch {
      return false;
    }
  };
  const stored = (): Theme | null => {
    try {
      const t = localStorage.getItem(KEY);
      return t === 'light' || t === 'dark' ? t : null;
    } catch {
      return null;
    }
  };
  const effective = (): Theme => {
    const t = root.dataset.theme;
    if (t === 'light' || t === 'dark') return t;
    return dark?.matches ? 'dark' : 'light';
  };

  function sync() {
    const theme = effective();
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.setAttribute('aria-pressed', String(theme === 'dark'));
    });
    const metas = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
    if (stored()) metas.forEach((m) => (m.content = COLORS[theme]));
    else metas.forEach((m) => (m.content = m.media.includes('dark') ? COLORS.dark : COLORS.light));
  }

  function apply(theme: Theme) {
    root.dataset.theme = theme;
    try {
      localStorage.setItem(KEY, theme);
    } catch {
      /* private mode: the choice lasts for this page only */
    }
    sync();
  }

  let busy = false;
  function toggle() {
    if (busy) return; // a second click mid-wipe would snapshot a half-drawn page
    const next: Theme = effective() === 'dark' ? 'light' : 'dark';
    if (reduced() || typeof document.startViewTransition !== 'function') {
      apply(next);
      return;
    }
    busy = true;
    root.classList.add('theme-vt');
    try {
      const vt = document.startViewTransition(() => apply(next));
      vt.ready
        .then(() => {
          root.animate(
            { clipPath: ['inset(0 0 100% 0)', 'inset(0 0 0% 0)'] },
            { duration: 680, easing: 'cubic-bezier(0.76, 0, 0.24, 1)', pseudoElement: '::view-transition-new(root)' },
          );
        })
        .catch(() => {});
      vt.finished.finally(() => {
        root.classList.remove('theme-vt');
        busy = false;
      });
    } catch {
      root.classList.remove('theme-vt');
      busy = false;
      apply(next);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', toggle);
  });
  dark?.addEventListener('change', sync);
  window.addEventListener('storage', (e) => {
    if (e.key !== KEY) return;
    const t = stored();
    if (t) root.dataset.theme = t;
    else delete root.dataset.theme;
    sync();
  });
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    const t = stored();
    if (t) root.dataset.theme = t;
    sync();
  });
  sync();
</script>
