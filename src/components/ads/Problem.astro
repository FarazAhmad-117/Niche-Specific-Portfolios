---
/**
 * The problem (brief §4 item 3): "Ad platforms optimize for spend. Someone has to optimize for
 * you." A two-column ledger: what the platform optimizes for, and what you need watched. The
 * fears from the brief sit under it as plain chips.
 */
import { PROBLEM } from '../../data/ads/content';
---

<section class="section problem" id="problem" aria-labelledby="problem-title">
  <div class="container">
    <div class="head head--split">
      <p class="eyebrow">The problem</p>
      <h2 id="problem-title">{PROBLEM.title}</h2>
      <p class="lede">{PROBLEM.body}</p>
    </div>

    <div class="ledger" data-reveal>
      <div class="ledger__row ledger__row--head" aria-hidden="true">
        <span class="mono">The platform optimizes for</span>
        <span class="mono">You need</span>
      </div>
      <dl class="ledger__list">
        {
          PROBLEM.rows.map((r, i) => (
            <div class="ledger__row">
              <dt>
                <span class="ledger__num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="visually-hidden">The platform: </span>
                {r.platform}
              </dt>
              <dd>
                <span class="ledger__arrow" aria-hidden="true" />
                <span class="visually-hidden">You need: </span>
                {r.you}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="fears">
      <p class="fears__label mono">What keeps people up</p>
      <ul class="fears__list" role="list" data-reveal-stagger>
        {
          PROBLEM.fears.map((f) => (
            <li class="chip">
              <span class="pip pip--waste" aria-hidden="true" />
              {f}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .ledger {
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
    overflow: hidden;
  }
  .ledger__list {
    margin: 0;
  }
  .ledger__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border-top: 1px solid var(--line);
  }
  .ledger__row--head {
    border-top: 0;
    background: var(--surface-1);
  }
  .ledger__row--head span {
    padding: var(--space-3) var(--space-5);
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .ledger__row--head span + span {
    color: var(--accent-text);
  }
  .ledger__row dt,
  .ledger__row dd {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-5);
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.3125rem);
    line-height: 1.35;
  }
  .ledger__row dt {
    color: var(--text-2);
  }
  .ledger__row dd {
    position: relative;
    font-weight: 650;
    border-left: 1px solid var(--line);
  }
  .ledger__num {
    color: var(--text-3);
    flex: none;
  }
  /* A short dashed threshold leads into each answer. */
  .ledger__arrow {
    flex: none;
    width: 18px;
    height: 0;
    border-top: 2px dashed var(--accent-line);
    transform: translateY(-0.3em);
  }
  @media (max-width: 719px) {
    .ledger__row--head {
      display: none;
    }
    .ledger__row {
      grid-template-columns: 1fr;
    }
    .ledger__row dt {
      padding-bottom: var(--space-2);
      font-size: var(--fs-small);
    }
    .ledger__row dd {
      padding-top: 0;
      border-left: 0;
    }
  }

  .fears {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .fears__label {
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .fears__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
  }
</style>
