---
/**
 * Footer with the brand thread shared by every niche: the Clash Display person-name
 * signature, sized in container units so it spans the content width at every breakpoint.
 * Here it sits on the chart's baseline: a dashed threshold runs above it and a tick axis below.
 */
import { NAV_LINKS, CONTACT_EMAIL, BOOKING_URL, MAIN_SITE_URL, PERSON_NAME, bookingUrl } from '../../data/ads/site';
import { signatureStyle } from '../../lib/shared/signature';
import { CALL_PROMISE } from '../../data/ads/content';
import { nicheHost } from '../../niches';
import { sectionHref } from '../../lib/ads/paths';

const year = new Date().getFullYear();
// Shrinks the signature for names longer than 11 characters (no style attribute otherwise).
const sigStyle = signatureStyle(PERSON_NAME);
const host = (u: string) => new URL(u).host;
---

<footer class="foot">
  <div class="container">
    <div class="foot__top">
      <div class="foot__intro">
        <p class="foot__lead">Free 30-minute scoping call.</p>
        <p class="foot__promise">{CALL_PROMISE}.</p>
        <a class="btn foot__book" href={bookingUrl('footer')}>
          <span class="btn__bars" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>Book a scoping call</span>
        </a>
      </div>

      <nav class="foot__col" aria-label="Footer">
        <p class="foot__label">On this page</p>
        <ul role="list">
          {
            NAV_LINKS.map((l) => (
              <li>
                <a class="foot__link" href={sectionHref(Astro.url, l.id)}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="foot__col">
        <p class="foot__label">Contact</p>
        <ul role="list">
          <li><a class="foot__link" href={bookingUrl('footer-contact')}>{host(BOOKING_URL)}</a></li>
          <li><a class="foot__link foot__email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        </ul>
      </div>

      <div class="foot__col">
        <p class="foot__label">Elsewhere</p>
        <ul role="list">
          {
            [MAIN_SITE_URL].map((u) => (
              <li>
                <a class="foot__link" href={u} target="_blank" rel="noopener">
                  {host(u)}
                  <span aria-hidden="true">↗</span>
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="foot__sig-wrap" data-reveal>
      <span class="threshold foot__threshold" aria-hidden="true"></span>
      <p class="foot__signature" style={sigStyle} aria-hidden="true">{PERSON_NAME}</p>
      <span class="foot__axis" aria-hidden="true"></span>
    </div>

    <div class="foot__legal">
      <p class="mono">© <span class="num">{year}</span> {PERSON_NAME} · {nicheHost('ads')}</p>
      <a class="foot__link" href="#top">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    padding-bottom: calc(var(--space-4) + var(--sticky-cta-h) + 28px + env(safe-area-inset-bottom));
    color: var(--text);
    background: var(--surface-1);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 960px) {
    .foot {
      padding-bottom: var(--space-5);
    }
  }
  .foot__top {
    display: grid;
    gap: var(--space-7) var(--space-6);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .foot__intro {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .foot__lead {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .foot__promise {
    max-width: 40ch;
    color: var(--text-2);
  }
  .foot__book {
    margin-top: var(--space-3);
  }
  .foot__col {
    min-width: 0;
  }
  .foot__col:last-child {
    grid-column: 1 / -1;
  }
  @media (min-width: 960px) {
    .foot__top {
      grid-template-columns: 1.6fr 1fr 1.3fr 1fr;
    }
    .foot__intro,
    .foot__col:last-child {
      grid-column: auto;
    }
  }
  .foot__label {
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .foot ul {
    margin: 0;
  }
  .foot__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap);
    max-width: 100%;
    color: var(--text);
    text-decoration: underline 1px transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--dur-hover) var(--ease-out-quint);
  }
  .foot__link:focus-visible {
    text-decoration-color: var(--accent-line);
  }
  @media (hover: hover) {
    .foot__link:hover {
      text-decoration-color: var(--accent-line);
    }
  }
  .foot__email {
    overflow-wrap: anywhere;
  }

  .foot__sig-wrap {
    position: relative;
    container-type: inline-size;
    margin-top: var(--space-9);
  }
  .foot__threshold {
    margin-bottom: 0.6rem;
    opacity: 0.8;
  }
  .foot__signature {
    font-family: var(--font-signature);
    font-weight: 600;
    /* "Faraz Ahmad" in Clash 600 at -0.035em spans 6.315em (measured for the ai footer). */
    font-size: calc(100cqi / 6.29);
    line-height: 0.82;
    letter-spacing: -0.035em;
    white-space: nowrap;
    margin-left: -0.035em;
    user-select: none;
  }
  .foot__axis {
    display: block;
    height: 7px;
    margin-top: 0.4rem;
    background:
      linear-gradient(var(--line-strong), var(--line-strong)) left top / 100% 1px no-repeat,
      repeating-linear-gradient(90deg, var(--line-strong) 0 1px, transparent 1px calc(100% / 14)) left top / 100% 7px no-repeat;
    opacity: 0.7;
  }
  .foot__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
    color: var(--text-3);
  }
  .foot__legal p {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
