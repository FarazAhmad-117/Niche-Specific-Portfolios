---
/**
 * About. The real portrait (black and white on black) in a terminal frame with a status bar;
 * facts from src/data/ads/profile.ts only.
 */
import { Image } from 'astro:assets';
import { ABOUT, SHOW_NO_PARTNER_NOTE } from '../../data/ads/content';
import { PROFILE } from '../../data/ads/profile';
import { yearsSuffix } from '../../person/person';
import { PLATFORMS, STACK } from '../../data/ads/site';

const facts = [
  { k: 'Based in', v: PROFILE.location },
  { k: 'Time zone', v: PROFILE.timeZone },
  { k: 'Building since', v: `${PROFILE.sinceYear}${yearsSuffix()}` },
  { k: 'Company', v: `${PROFILE.companyRole}, ${PROFILE.company}` },
];
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <figure class="about__photo" data-reveal>
      <div class="about__frame">
        <Image
          src={PROFILE.portrait.src}
          alt={PROFILE.portrait.alt}
          widths={[320, 480, 640, 960]}
          sizes="(min-width: 1024px) 420px, 80vw"
          loading="lazy"
          decoding="async"
        />
        <span class="about__cross" aria-hidden="true"></span>
      </div>
      <figcaption class="about__strip mono">
        <span class="pip pip--watch" aria-hidden="true"></span>
        {PROFILE.name} · {PROFILE.timeZone}
      </figcaption>
    </figure>

    <div class="about__copy">
      <p class="eyebrow">About</p>
      <h2 id="about-title">{ABOUT.title}</h2>
      {ABOUT.paragraphs.map((p, i) => <p class:list={[i === 0 ? 'lede' : 'about__p']}>{p}</p>)}
      <dl class="about__facts">
        {
          facts.map((f) => (
            <div>
              <dt class="mono">{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
      <div class="about__stack">
        <p class="mono about__stack-label">Platforms</p>
        <ul role="list">{PLATFORMS.map((s) => <li class="cond">{s}</li>)}</ul>
        <p class="mono about__stack-label">Works with</p>
        {STACK.length > 0 ? <ul role="list">{STACK.map((s) => <li class="cond">{s}</li>)}</ul> : <p class="todo">TODO · Add the tools you work with (src/person/config.ts › stack)</p>}
        {SHOW_NO_PARTNER_NOTE && <p class="about__note text-3">No Google or Meta partner status, and no badges.</p>}
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
  .about__photo {
    width: min(100%, 420px);
    margin: 0 auto;
    padding: 10px;
    border-radius: var(--radius-xl);
    background: var(--inv-bg);
    box-shadow: var(--shadow-lift);
  }
  .about__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: #000;
  }
  .about__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  /* Corner crop marks, like a chart's plot area. */
  .about__cross {
    position: absolute;
    inset: 12px;
    pointer-events: none;
    background:
      linear-gradient(var(--accent-inv), var(--accent-inv)) left top / 14px 2px no-repeat,
      linear-gradient(var(--accent-inv), var(--accent-inv)) left top / 2px 14px no-repeat,
      linear-gradient(var(--accent-inv), var(--accent-inv)) right bottom / 14px 2px no-repeat,
      linear-gradient(var(--accent-inv), var(--accent-inv)) right bottom / 2px 14px no-repeat;
    opacity: 0.85;
  }
  .about__strip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 6px 2px;
    color: var(--inv-2);
  }
  .about__copy {
    display: grid;
    gap: var(--space-5);
  }
  .about__copy h2 {
    max-width: 17ch;
  }
  .about__p {
    color: var(--text-2);
    max-width: var(--measure);
  }
  .about__facts {
    display: grid;
    gap: var(--space-3) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    margin: var(--space-3) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .about__facts dt {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .about__facts dd {
    margin: 2px 0 0;
    font-weight: 650;
  }
  .about__stack {
    display: grid;
    gap: var(--space-2);
  }
  .about__stack-label {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .about__stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 var(--space-2);
  }
  .about__note {
    font-size: 0.8125rem;
  }
</style>
