---
/**
 * Final CTA + the shared contact form, on a terminal panel. The form posts to the main site's
 * contact endpoint. What the backend stores for niche-site leads is not verified
 * (docs/todo/ads.md), so the copy here makes no claim about it.
 */
import ContactForm from '../shared/ContactForm.astro';
import { CALL_PROMISE } from '../../data/ads/content';
import { CONTACT_EMAIL, bookingUrl } from '../../data/ads/site';
---

<section class="section cta" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="cta__card">
      <div class="cta__copy inverse">
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title">Tell me what your budget should never do.</h2>
        <p class="lede">Free 30-minute scoping call. {CALL_PROMISE}.</p>
        <a class="btn cta__book" href={bookingUrl('final')}>
          <span class="btn__bars" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>Book a scoping call</span>
        </a>
        <p class="cta__mail">
          Or email <a class="link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </p>
        <span class="threshold cta__threshold" aria-hidden="true"></span>
      </div>

      <div class="cta__form">
        <div class="cta__form-head">
          <p class="cta__form-title">Or write it down</p>
        </div>
        <ContactForm
          niche="ads"
          cta="Send message"
          fallbackEmail={CONTACT_EMAIL}
          labels={{ message: 'Which platforms, roughly what monthly spend, and what worries you most?' }}
          messages={{ success: 'Thanks, your message is on its way. I’ll reply soon.' }}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .cta__card {
    position: relative;
    display: grid;
    gap: var(--space-7);
    padding: clamp(1.5rem, 1rem + 3vw, 4rem);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(var(--inv-line) 1px, transparent 1px) 0 0 / 100% 48px,
      var(--inv-bg);
    color: var(--inv-fg);
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .cta__card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .cta__copy {
    position: relative;
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .cta__copy .eyebrow {
    color: var(--inv-2);
  }
  .cta__copy .eyebrow::before {
    border-color: var(--accent-inv);
  }
  .cta__copy .lede,
  .cta__mail {
    color: var(--inv-2);
  }
  .cta__copy h2 {
    max-width: 14ch;
  }
  .cta__book {
    --btn-rise: var(--inv-fg);
    --btn-rise-fg: var(--inv-bg);
  }
  .cta__mail {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .cta__mail .link {
    color: var(--inv-fg);
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
  }
  .cta__threshold {
    width: 100%;
    margin-top: var(--space-4);
    border-color: var(--accent-inv);
    opacity: 0.6;
  }

  /* ---------- the shared form, themed from here ---------- */
  .cta__form {
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border-radius: var(--radius-l);
    background: var(--bg);
    color: var(--text);
    --cf-gap: 1rem;
    --cf-bg: var(--surface-2);
    --cf-border: var(--line-strong);
    --cf-radius: var(--radius-s);
    --cf-pad: 0.8rem 1rem;
    --cf-focus: var(--focus);
    --cf-btn-bg: var(--btn-bg);
    --cf-btn-color: var(--btn-fg);
    --cf-error: var(--error);
    --cf-success: var(--success);
  }
  .cta__form-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-4);
  }
  .cta__form-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
    letter-spacing: -0.02em;
  }
  .cta__form :global(.cf__label) {
    font-weight: 650;
    font-size: var(--fs-small);
  }
  .cta__form :global(.cf__control) {
    min-height: 48px;
    transition:
      border-color var(--dur-hover) var(--ease-out-quint),
      box-shadow var(--dur-hover) var(--ease-out-quint);
  }
  .cta__form :global(.cf__control:focus-visible) {
    outline: none;
    border-color: var(--focus);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 28%, transparent);
  }
  /* Same language as .btn: an amber plate; a graphite bar rises through it on hover. Colours
     are set here explicitly because the base reset (button { color: inherit }) outranks the
     form's zero-specificity defaults. */
  .cta__form :global(.cf__submit) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 24px;
    border: 0;
    border-radius: var(--radius-s);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-body);
    font-weight: 650;
    font-size: 1rem;
    letter-spacing: 0;
    transition:
      transform var(--dur-press) var(--ease-out-quint),
      color 420ms var(--ease-out-quint) 140ms;
  }
  .cta__form :global(.cf__submit)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--btn-rise);
    transform: scaleY(0);
    transform-origin: center bottom;
    transition: transform 1000ms var(--ease-out-quint);
  }
  .cta__form :global(.cf__submit:focus-visible) {
    color: var(--btn-rise-fg);
  }
  .cta__form :global(.cf__submit:focus-visible)::before {
    transform: scaleY(1);
  }
  @media (hover: hover) {
    .cta__form :global(.cf__submit:hover:not(:disabled)) {
      color: var(--btn-rise-fg);
    }
    .cta__form :global(.cf__submit:hover:not(:disabled))::before {
      transform: scaleY(1);
    }
  }
  .cta__form :global(.cf__submit:disabled) {
    opacity: 0.7;
  }
  .cta__form :global(.cf__submit:active) {
    transform: scale(0.97);
  }
  .cta__form :global(.cf__status) {
    font-size: var(--fs-small);
  }
  .cta__form :global(.cf__fallback) {
    color: var(--accent-text);
    font-weight: 650;
  }
</style>
