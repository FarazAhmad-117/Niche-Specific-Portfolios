---
/**
 * Hero. Left: who this is and what it does, in one look. Right: an EXAMPLE app audit as a tidy
 * admin panel (an "Apps" table with a status badge per row), with a second panel behind it for
 * depth. Every row is a common kind of Shopify app; the badge is the method (keep, replace,
 * remove, defer), not a client result, and the caption says so.
 *
 * Motion (all optional, all off under reduced motion):
 *  - each headline line slides up out of its own line box, 90ms apart, out-quint; a clay rule
 *    draws under "fewer apps." (in-out-quart)
 *  - the panel changes once per beat (2.8s): one row is read (a highlight slides to it,
 *    in-out-quart), then its badge lands on the spring. After the last row the summary shows,
 *    holds, and the panel quietly resets.
 * Without JS, or under reduced motion, the panel shows its finished state (every badge).
 */
import { HERO, HERO_RECEIPT, VERDICT_LABEL } from '../../data/shopify/content';
import { bookingUrl } from '../../data/shopify/site';

const lines = HERO.headline;
const n = HERO_RECEIPT.length;
const everyPage = HERO_RECEIPT.filter((r) => r.verdict === 'keep').length;
const accentAt = lines[2]!.indexOf(HERO.accentFrom);
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__copy">
      <p class="eyebrow">{HERO.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__line"><span class="hero__li" style="--l:0">{lines[0]}</span></span>
        <span class="hero__line"><span class="hero__li" style="--l:1">{lines[1]}</span></span>
        <span class="hero__line">
          <span class="hero__li" style="--l:2">
            {lines[2]!.slice(0, accentAt)}<span class="hero__accent em">{lines[2]!.slice(accentAt)}<span class="hero__total" aria-hidden="true"></span></span>
          </span>
        </span>
      </h1>
      <p class="lede hero__lede">{HERO.lede}</p>
      <div class="hero__ctas">
        <a class="btn" href={bookingUrl('hero')}>
          <span>{HERO.primary}</span>
        </a>
        <a class="btn btn--ghost" href="#offer-audit">
          <span>{HERO.secondary}</span>
          <span class="btn__arrow" aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="hero__note text-3">{HERO.note}</p>
    </div>

    <figure class="rc" data-rc data-done style={`--n:${n};--at:${n - 1}`} aria-labelledby="rc-cap">
      <div class="rc__behind" aria-hidden="true"></div>
      <div class="rc__paper-wrap" data-pause-offscreen>
        <div class="receipt rc__paper">
          <div class="rc__head">
            <span class="rc__icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="16" height="16"><rect x="2.5" y="2.5" width="6" height="6" rx="1.5"></rect><rect x="11.5" y="2.5" width="6" height="6" rx="1.5"></rect><rect x="2.5" y="11.5" width="6" height="6" rx="1.5"></rect><rect x="11.5" y="11.5" width="6" height="6" rx="1.5"></rect></svg>
            </span>
            <span class="rc__store">Apps</span>
            <span class="tag tag--example rc__kind">Example store</span>
            <button class="rc__pp" type="button" data-rc-pp aria-label="Pause the audit animation" aria-pressed="false" hidden>
              <svg class="rc__pp-pause" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M9 6v12M15 6v12"></path></svg>
              <svg class="rc__pp-play" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
            </button>
          </div>
          <div class="rc__cols" aria-hidden="true">
            <span>App</span><span>Verdict</span>
          </div>
          <ol class="rc__rows" role="list">
            {
              HERO_RECEIPT.map((r, i) => (
                <li class="rc__row is-on" data-row={i}>
                  <span class="rc__app-wrap">
                    <span class="rc__app">{r.app}</span>
                    <span class="rc__note">{r.note}</span>
                  </span>
                  <span class={`rc__stamp rc__stamp--${r.verdict}`}>{VERDICT_LABEL[r.verdict]}</span>
                </li>
              ))
            }
          </ol>
          <div class="rc__total">
            <span>Apps loading on every page</span>
            <span class="rc__total-val num">
              <span class="rc__from">{n}</span>
              <span class="rc__arrow" aria-hidden="true">→</span>
              <span class="rc__to">{everyPage}</span>
            </span>
          </div>
        </div>
      </div>
      <figcaption id="rc-cap" class="rc__cap text-3">
        An example audit, not a client store: the kinds of app I find most, and what I do with each.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-top: calc(var(--nav-h) + clamp(3rem, 2rem + 5vw, 6rem));
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  /* ---------- layout ---------- */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
    align-items: center;
  }
  @media (min-width: 1100px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.85fr);
      min-height: min(72svh, 700px);
    }
  }
  .hero__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .hero__title {
    margin-top: var(--space-1);
  }
  .hero__line {
    display: block;
    overflow: clip;
    /* Room for descenders and the rule inside the clip. */
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .hero__li {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__li {
      animation: rise 1050ms var(--ease-out-quint) both;
      animation-delay: calc(80ms + var(--l) * 90ms);
    }
  }
  @keyframes rise {
    from {
      transform: translate3d(0, 105%, 0);
    }
  }
  .hero__accent {
    position: relative;
    white-space: nowrap;
  }
  /* A clean clay rule under the accent words. */
  .hero__total {
    position: absolute;
    left: 0.02em;
    right: 0.32em;
    bottom: -0.02em;
    height: 0.06em;
    border-radius: 0.03em;
    background: currentColor;
    transform-origin: left center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__total {
      animation: draw 900ms var(--ease-in-out-quart) 900ms both;
    }
  }
  @keyframes draw {
    from {
      transform: scaleX(0);
    }
  }
  .hero__lede {
    max-width: 46ch;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .hero__note {
    margin: 0;
    font-size: var(--fs-small);
    max-width: 46ch;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__lede,
    .hero__ctas,
    .hero__note,
    .rc {
      animation: lift 900ms var(--ease-out-quint) both;
    }
    .hero__lede {
      animation-delay: 420ms;
    }
    .hero__ctas {
      animation-delay: 520ms;
    }
    .hero__note {
      animation-delay: 600ms;
    }
    .rc {
      animation-delay: 360ms;
    }
  }
  @keyframes lift {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0);
    }
  }

  /* =========================================================
     The Apps panel
     ========================================================= */
  .rc {
    position: relative;
    width: 100%;
    max-width: 440px;
    justify-self: center;
    margin: 0;
    padding: 14px 14px 0 0;
  }
  @media (min-width: 1100px) {
    .rc {
      justify-self: end;
    }
  }
  /* A second panel behind, offset: depth, and "one store out of many". */
  .rc__behind {
    position: absolute;
    inset: 0 0 52px 14px;
    border-radius: var(--radius-l);
    background: var(--surface-1);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .rc__paper-wrap {
    position: relative;
  }
  .rc__paper {
    padding: 0;
    overflow: hidden;
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-lift);
  }
  .rc__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--line);
  }
  .rc__icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-s);
    background: var(--surface-1);
  }
  .rc__icon rect {
    fill: none;
    stroke: var(--text-2);
    stroke-width: 1.5;
  }
  .rc__store {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text);
  }
  .rc__pp {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin: -4px -6px -4px auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-s);
    background: var(--surface-2);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .rc__pp svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .rc__pp-play path {
    fill: currentColor;
    stroke: none;
  }
  .rc__pp-play,
  .rc__pp[aria-pressed='true'] .rc__pp-pause {
    display: none;
  }
  .rc__pp[aria-pressed='true'] .rc__pp-play {
    display: block;
  }
  .rc__cols {
    display: flex;
    justify-content: space-between;
    padding: 8px var(--space-5);
    background: var(--surface-1);
    border-bottom: 1px solid var(--line);
    color: var(--text-3);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .rc__rows {
    position: relative;
    display: grid;
    margin: 0;
  }
  .rc__row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 10px var(--space-5);
    border-bottom: 1px solid var(--line);
    transition: background-color 600ms var(--ease-in-out-quart);
  }
  .rc__row.is-reading {
    background: color-mix(in srgb, var(--accent) 8%, var(--surface-2));
  }
  .rc__app-wrap {
    display: grid;
    min-width: 0;
  }
  .rc__app {
    color: var(--text);
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .rc__note {
    color: var(--text-3);
    font-size: 0.8125rem;
  }
  /* The verdict: an admin status badge. Unbadged rows keep the slot (no reflow). */
  .rc__stamp {
    flex: none;
    min-width: 5.6em;
    padding: 2px 10px;
    border-radius: var(--radius-s);
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: center;
    opacity: 0;
    transform: scale(1.3);
    transition:
      opacity 200ms var(--ease-out-quint),
      transform var(--dur-stamp) var(--ease-spring);
  }
  .rc__row.is-on .rc__stamp {
    opacity: 1;
    transform: none;
  }
  .rc__stamp--keep {
    background: var(--surface-1);
    color: var(--text-2);
  }
  .rc__stamp--replace {
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .rc__stamp--remove {
    background: var(--btn-bg);
    color: var(--btn-fg);
  }
  .rc__stamp--defer {
    background: var(--warn-bg);
    color: var(--warn);
  }
  .rc__total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--surface-1);
    color: var(--text);
    font-weight: 600;
    font-size: 0.9375rem;
    opacity: 0.0001;
    transition: opacity 500ms var(--ease-out-quint);
  }
  .rc[data-done] .rc__total {
    opacity: 1;
  }
  .rc__total-val {
    display: inline-flex;
    gap: 6px;
    align-items: baseline;
  }
  .rc__from {
    color: var(--text-3);
    text-decoration: line-through 1.5px;
  }
  .rc__arrow {
    color: var(--text-3);
  }
  .rc__to {
    color: var(--accent-text);
    font-size: 1.125rem;
  }
  .rc__cap {
    position: relative;
    margin-top: var(--space-4);
    padding-inline: 4px;
    font-size: 0.8125rem;
  }
  @media (max-width: 480px) {
    .rc__head,
    .rc__row,
    .rc__cols,
    .rc__total {
      padding-inline: var(--space-4);
    }
  }
</style>

<script>
  import { prefersReduced } from '../../lib/shopify/base';

  const rc = document.querySelector<HTMLElement>('[data-rc]');
  if (rc && !prefersReduced()) {
    const rows = [...rc.querySelectorAll<HTMLElement>('[data-row]')];
    const n = rows.length;
    const BEAT_MS = 2800;
    const STAMP_DELAY = 900; // read the line first, then the stamp lands
    const HOLD = 2; // extra beats on the finished receipt before it resets
    // Start on the finished receipt (the server render), hold it, then begin printing.
    let beat = n;
    let timer: number | undefined;
    let stampTimer: number | undefined;
    let visible = false;
    let userPaused = false; // the visitor's pause always wins (WCAG 2.2.2)

    /** i = index of the row being read (-1 = fresh receipt, n = done). */
    const show = (i: number) => {
      window.clearTimeout(stampTimer);
      rows.forEach((r, k) => {
        r.classList.toggle('is-on', k < i || i >= n);
        r.classList.toggle('is-reading', k === i);
      });
      if (i >= n) rc.dataset.done = '';
      else delete rc.dataset.done;
      if (i >= 0 && i < n) {
        stampTimer = window.setTimeout(() => rows[i]?.classList.add('is-on'), STAMP_DELAY);
      }
    };
    const tick = () => {
      beat = beat + 1 > n + HOLD ? -1 : beat + 1;
      show(Math.min(beat, n));
    };
    const play = () => {
      if (timer !== undefined || !visible || document.hidden || userPaused) return;
      timer = window.setInterval(tick, BEAT_MS);
    };
    const pause = () => {
      window.clearInterval(timer);
      timer = undefined;
    };
    const pp = rc.querySelector<HTMLButtonElement>('[data-rc-pp]');
    if (pp) {
      pp.hidden = false;
      pp.addEventListener('click', () => {
        userPaused = !userPaused;
        // Fixed label, state in aria-pressed only ("Pause the receipt animation, pressed").
        pp.setAttribute('aria-pressed', String(userPaused));
        if (userPaused) {
          pause();
          // Paused means finished: every verdict stamped, nothing half-printed.
          beat = n;
          show(n);
        } else play();
      });
    }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        visible = Boolean(e?.isIntersecting);
        if (visible) play();
        else pause();
      }).observe(rc);
    } else {
      visible = true;
      play();
    }
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
  }
</script>
