---
/**
 * The problem. Left: the fear list from the brief. Right: an EXAMPLE store's apps as boxes on
 * an overloaded shelf; four of them carry a warning swing tag that says why they slow the
 * store down. Labelled as an example. The tags sway gently (paused off screen, off under
 * reduced motion).
 */
import { PROBLEM } from '../../data/shopify/content';
---

<section class="section problem" id="problem" aria-labelledby="problem-title">
  <div class="container problem__grid">
    <div class="problem__copy">
      <p class="eyebrow">The problem</p>
      <h2 id="problem-title">{PROBLEM.title}</h2>
      <p class="lede">{PROBLEM.body}</p>
      <ul class="problem__fears" role="list">
        {PROBLEM.fears.map((f) => <li>{f}</li>)}
      </ul>
      <p class="problem__fix">{PROBLEM.resolution}</p>
    </div>

    <figure class="stock" aria-labelledby="stock-cap" data-pause-offscreen>
      <div class="stock__top">
        <span class="tag tag--example">Example store</span>
        <span class="stock__title mono">Apps installed</span>
      </div>
      <ul class="stock__boxes" role="list" data-reveal-stagger>
        {
          PROBLEM.shelf.map((b, i) => (
            <li class:list={['box', { 'box--warn': b.tag }]} style={`--i:${i}`}>
              <span class="box__lid" aria-hidden="true" />
              <span class="box__name">{b.name}</span>
              {b.tag ? (
                <span class="box__hang">
                  <span class="box__string" aria-hidden="true" />
                  <span class="tag tag--warn box__tag">{b.tag}</span>
                </span>
              ) : (
                <span class="box__ok mono">Earns its place</span>
              )}
            </li>
          ))
        }
      </ul>
      <div class="shelf" aria-hidden="true"></div>
      <figcaption id="stock-cap" class="stock__cap text-3">
        An example store’s apps, not a client’s. The tags are the problems I find most often.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .problem__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 1100px) {
    .problem__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
  }
  .problem__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .problem__copy h2 {
    max-width: 16ch;
  }
  .problem__fears {
    display: grid;
    gap: 0;
    width: 100%;
    max-width: 34rem;
    margin: 0;
  }
  .problem__fears li {
    position: relative;
    padding: 12px 0 12px 30px;
    border-bottom: 1.5px dotted var(--line-strong);
    font-weight: 500;
  }
  .problem__fears li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 50%;
    width: 12px;
    height: 2px;
    background: var(--warn-dot);
  }
  .problem__fix {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
    letter-spacing: -0.015em;
    color: var(--accent-text);
  }

  /* ---------- the shelf of apps ---------- */
  .stock {
    margin: 0;
    padding: var(--space-5);
    border-radius: var(--radius-xl);
    background: var(--surface-1);
  }
  .stock__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .stock__title {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .stock__boxes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    align-items: end;
    margin: 0;
  }
  @media (max-width: 559px) {
    .stock__boxes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* A product box: a lid line, a name, and either a warning tag on a string or a quiet "ok". */
  .box {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: var(--space-3);
    min-height: 9.5rem;
    padding: var(--space-4) var(--space-3) var(--space-3);
    border-radius: var(--radius-s) var(--radius-s) 3px 3px;
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      0 1px 0 var(--line);
  }
  .box:nth-child(3n + 2) {
    min-height: 10.5rem;
  }
  .box__lid {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 9px;
    height: 0;
    border-top: 1.5px dashed var(--line);
  }
  .box__name {
    margin-top: 6px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .box__ok {
    color: var(--text-3);
    font-size: 0.6875rem;
    text-transform: uppercase;
  }
  .box__hang {
    display: grid;
    justify-items: start;
    transform-origin: 14px 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .box__hang {
      animation: sway 4.6s var(--ease-in-out-sine) infinite alternate;
      animation-delay: calc(var(--i) * -0.9s);
    }
  }
  @keyframes sway {
    from {
      rotate: -3deg;
    }
    to {
      rotate: 2.5deg;
    }
  }
  .box__string {
    width: 1.5px;
    height: 12px;
    margin-left: 13px;
    background: var(--line-strong);
  }
  .box__tag {
    max-width: 100%;
    white-space: normal;
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.71875rem;
    line-height: 1.3;
    padding-block: 5px;
  }
  .stock .shelf {
    margin-top: 4px;
  }
  .stock__cap {
    margin-top: var(--space-4);
    font-size: 0.8125rem;
  }
</style>
