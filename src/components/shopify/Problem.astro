---
/**
 * The problem. Left: the fear list. Right: an EXAMPLE store's check as tiles on a tidy admin
 * panel; four of them carry a warning badge that says what is holding the store back (not live,
 * not found, not selling). Labelled as an example.
 */
import { FIX_LABEL, PROBLEM } from '../../data/shopify/content';

/** One small line icon per tile (24px grid, stroked in the tile's status colour). */
const ICONS: Record<(typeof PROBLEM.shelf)[number]['icon'], string> = {
  box: 'M4 8l8-4 8 4v8l-8 4-8-4zM4 8l8 4 8-4M12 12v8',
  card: 'M3 6.5h18v11H3zM3 10h18M7 14.5h4',
  search: 'M10.5 4.5a6 6 0 1 1 0 12 6 6 0 0 1 0-12zM15 15l5 5',
  page: 'M6 3.5h8l4 4v13H6zM14 3.5v4h4M9 12h6M9 15.5h6',
  coin: 'M12 3.5a8.5 8.5 0 1 1 0 17 8.5 8.5 0 0 1 0-17zM14.5 9.5c-.5-1-1.4-1.5-2.5-1.5-1.4 0-2.5.8-2.5 2s1.1 1.6 2.5 2 2.5.8 2.5 2-1.1 2-2.5 2c-1.1 0-2-.5-2.5-1.5M12 6.5v1.5M12 16v1.5',
  cart: 'M3.5 4.5h2.5l2.2 10h9.3l2-7H7M10 19a1 1 0 1 1 0 .01M17 19a1 1 0 1 1 0 .01',
};
---

<section class="section problem" id="problem" aria-labelledby="problem-title">
  <div class="container problem__grid">
    <div class="problem__copy">
      <p class="eyebrow">The problem</p>
      <h2 id="problem-title">{PROBLEM.title}</h2>
      <p class="lede">{PROBLEM.body}</p>
      <ul class="problem__fears" role="list">
        {PROBLEM.fears.map((f) => <li>{f}</li>)}
      </ul>
      <p class="problem__fix">{PROBLEM.resolution}</p>
    </div>

    <figure class="stock" aria-labelledby="stock-cap" data-pause-offscreen>
      <div class="stock__top">
        <span class="tag tag--example">Example store</span>
        <span class="stock__title mono">{PROBLEM.panelTitle}</span>
      </div>
      <ul class="stock__boxes" role="list" data-reveal-stagger>
        {
          PROBLEM.shelf.map((b, i) => (
            <li class:list={['box', { 'box--warn': b.tag }]} style={`--i:${i}`}>
              <span class="box__head">
                <span class="box__lid" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18"><path d={ICONS[b.icon]} /></svg>
                </span>
                <span class:list={['box__status mono', { 'box__status--warn': b.tag }]}>
                  {b.tag ? PROBLEM.needsLabel : PROBLEM.okLabel}
                </span>
              </span>
              <span class="box__name">{b.name}</span>
              {b.tag && (
                <>
                  <span class="box__issue">{b.tag}</span>
                  {b.fix && (
                    <a class="box__fix" href={`#offer-${b.fix}`}>
                      Fix: {FIX_LABEL[b.fix]} <span aria-hidden="true">→</span>
                    </a>
                  )}
                </>
              )}
            </li>
          ))
        }
      </ul>
      <div class="shelf" aria-hidden="true"></div>
      <figcaption id="stock-cap" class="stock__cap text-3">
        {PROBLEM.caption}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .problem__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 1100px) {
    .problem__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
  }
  .problem__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .problem__copy h2 {
    max-width: 16ch;
  }
  .problem__fears {
    display: grid;
    gap: 0;
    width: 100%;
    max-width: 34rem;
    margin: 0;
  }
  .problem__fears li {
    position: relative;
    padding: 12px 0 12px 30px;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
  }
  .problem__fears li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 50%;
    width: 12px;
    height: 2px;
    background: var(--warn-dot);
  }
  .problem__fix {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
    letter-spacing: -0.015em;
    color: var(--accent-text);
  }

  /* ---------- the Apps installed panel ---------- */
  .stock {
    margin: 0;
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
  }
  .stock__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .stock__title {
    order: -1;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .stock__boxes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
  }
  @media (max-width: 559px) {
    .stock__boxes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* An app tile: an icon square, a name, and a warning badge or a quiet "ok". */
  .box {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-height: 8.5rem;
    padding: var(--space-4);
    border-radius: var(--radius-m);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .box--warn {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--warn-dot) 45%, var(--line));
  }
  .box__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .box__lid {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-s);
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .box--warn .box__lid {
    background: var(--warn-bg);
    color: var(--warn);
  }
  .box__lid path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Status: a small dot and a word, so the tile reads before the details do. */
  .box__status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-text);
    font-size: 0.6875rem;
    white-space: nowrap;
  }
  .box__status::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .box__status--warn {
    color: var(--warn);
  }
  .box__status--warn::before {
    background: var(--warn-dot);
  }
  .box__name {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.2;
  }
  .box__issue {
    color: var(--text-2);
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .box__fix {
    align-self: end;
    margin-top: auto;
    padding-top: var(--space-1);
    color: var(--accent-text);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
  }
  @media (hover: hover) {
    .box__fix:hover {
      text-decoration: underline;
    }
  }
  .stock__cap {
    margin-top: var(--space-4);
    font-size: 0.8125rem;
  }
</style>
