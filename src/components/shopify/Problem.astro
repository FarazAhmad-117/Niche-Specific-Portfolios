---
/**
 * The problem. Left: the fear list from the brief. Right: an EXAMPLE store's apps as boxes on
 * a tidy admin "Apps installed" panel; four of them carry a warning badge that says why they slow the
 * store down. Labelled as an example.

 */
import { PROBLEM } from '../../data/shopify/content';
---

<section class="section problem" id="problem" aria-labelledby="problem-title">
  <div class="container problem__grid">
    <div class="problem__copy">
      <p class="eyebrow">The problem</p>
      <h2 id="problem-title">{PROBLEM.title}</h2>
      <p class="lede">{PROBLEM.body}</p>
      <ul class="problem__fears" role="list">
        {PROBLEM.fears.map((f) => <li>{f}</li>)}
      </ul>
      <p class="problem__fix">{PROBLEM.resolution}</p>
    </div>

    <figure class="stock" aria-labelledby="stock-cap" data-pause-offscreen>
      <div class="stock__top">
        <span class="tag tag--example">Example store</span>
        <span class="stock__title mono">Apps installed</span>
      </div>
      <ul class="stock__boxes" role="list" data-reveal-stagger>
        {
          PROBLEM.shelf.map((b, i) => (
            <li class:list={['box', { 'box--warn': b.tag }]} style={`--i:${i}`}>
              <span class="box__lid" aria-hidden="true" />
              <span class="box__name">{b.name}</span>
              {b.tag ? (
                <span class="box__hang">
                  <span class="box__string" aria-hidden="true" />
                  <span class="tag tag--warn box__tag">{b.tag}</span>
                </span>
              ) : (
                <span class="box__ok mono">Earns its place</span>
              )}
            </li>
          ))
        }
      </ul>
      <div class="shelf" aria-hidden="true"></div>
      <figcaption id="stock-cap" class="stock__cap text-3">
        An example store’s apps, not a client’s. The tags are the problems I find most often.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .problem__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 1100px) {
    .problem__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
  }
  .problem__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .problem__copy h2 {
    max-width: 16ch;
  }
  .problem__fears {
    display: grid;
    gap: 0;
    width: 100%;
    max-width: 34rem;
    margin: 0;
  }
  .problem__fears li {
    position: relative;
    padding: 12px 0 12px 30px;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
  }
  .problem__fears li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 50%;
    width: 12px;
    height: 2px;
    background: var(--warn-dot);
  }
  .problem__fix {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
    letter-spacing: -0.015em;
    color: var(--accent-text);
  }

  /* ---------- the Apps installed panel ---------- */
  .stock {
    margin: 0;
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
  }
  .stock__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .stock__title {
    order: -1;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .stock__boxes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
  }
  @media (max-width: 559px) {
    .stock__boxes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* An app tile: an icon square, a name, and a warning badge or a quiet "ok". */
  .box {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-height: 8.5rem;
    padding: var(--space-4);
    border-radius: var(--radius-m);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .box__lid {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-s);
    background: var(--surface-1);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .box--warn .box__lid {
    background: var(--warn-bg);
    box-shadow: none;
  }
  .box__name {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.2;
  }
  .box__ok {
    color: var(--text-3);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    letter-spacing: 0;
  }
  .box__hang {
    display: grid;
    justify-items: start;
  }
  .box__string {
    display: none;
  }
  .box__tag {
    max-width: 100%;
    white-space: normal;
    font-size: 0.75rem;
    line-height: 1.3;
    padding-block: 3px;
  }
  .stock__cap {
    margin-top: var(--space-4);
    font-size: 0.8125rem;
  }
</style>
