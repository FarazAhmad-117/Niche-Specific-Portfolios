<script>
  import { prefersReduced } from '../../lib/shopify/base';

  const td = document.querySelector<HTMLElement>('[data-td]');
  if (td) {
    const list = td.querySelector<HTMLElement>('[data-td-steps]')!;
    const steps = [...td.querySelectorAll<HTMLElement>('[data-st]')];
    const segs = [...td.querySelectorAll<HTMLElement>('[data-seg]')];
    const dots = [...td.querySelectorAll<HTMLElement>('[data-dot]')];
    const spots = [...td.querySelectorAll<HTMLElement>('[data-hs]')];
    const playBtn = td.querySelector<HTMLButtonElement>('[data-play]')!;
    const count = td.querySelector<HTMLElement>('[data-td-count]');
    const fixesNum = td.querySelector<HTMLElement>('[data-td-fixes]');
    const barTrack = td.querySelector<HTMLElement>('.meter__bar-track');
    const n = steps.length;
    // Per-step state comes from the markup, so no page copy is bundled into this script.
    const STEPS = steps.map((st) => ({
      fix: st.dataset.fix ?? null,
      meter: Number(st.dataset.meter ?? 0),
      title: st.dataset.title ?? '',
    }));
    const reduced = prefersReduced();
    const stacked = window.matchMedia('(max-width: 1099px)');

    let active = n - 1;
    let playing = false;
    let wantsPlay = !reduced; // the visitor's intent; visibility only gates it
    let started = false;
    let programmatic = 0; // timestamp until which list scrolls are ours, not the visitor's

    /** Restart the current segment's CSS animation from zero. */
    const restartFill = () => {
      const fill = segs[active]?.querySelector<HTMLElement>('[data-seg-fill]');
      if (!fill) return;
      fill.style.animation = 'none';
      void fill.offsetWidth; // flush, so the next rule starts a fresh animation
      fill.style.animation = '';
    };

    /** Keep the current card in view in the phone stack, scrolling only the list. */
    const scrollCard = (smooth: boolean) => {
      if (!stacked.matches) return;
      const card = steps[active];
      if (!card) return;
      const pad = parseFloat(getComputedStyle(list).scrollPaddingLeft) || 0;
      const left = card.offsetLeft - pad; // the list is the cards' offsetParent
      if (Math.abs(list.scrollLeft - left) < 2) return;
      programmatic = performance.now() + 900;
      list.scrollTo({ left, behavior: smooth && !reduced ? 'smooth' : 'auto' });
    };

    const syncBar = () => {
      if (barTrack) td.style.setProperty('--track-w', `${barTrack.clientWidth}px`);
    };

    const render = (i: number, smooth = true) => {
      active = (i + n) % n;
      const s = STEPS[active]!;
      const fixes = STEPS.slice(0, active + 1)
        .map((x) => x.fix)
        .filter(Boolean);
      td.dataset.step = String(active);
      td.dataset.fixes = fixes.join(' ');
      td.style.setProperty('--meter', String(s.meter));
      if (fixesNum) fixesNum.textContent = String(fixes.length);
      steps.forEach((st, k) => {
        if (k === active) st.setAttribute('aria-current', 'step');
        else st.removeAttribute('aria-current');
      });
      segs.forEach((g, k) => {
        g.classList.toggle('is-past', k < active);
        g.classList.toggle('is-current', k === active);
      });
      dots.forEach((d, k) => {
        d.classList.toggle('is-on', k <= active);
        d.classList.toggle('is-current', k === active);
      });
      spots.forEach((h) => {
        const k = Number(h.dataset.hs);
        h.classList.toggle('is-current', k === active);
        h.classList.toggle('is-pending', k > active);
      });
      if (count) count.textContent = String(active + 1);
      // The last step rests longer so the finished page is seen before the loop.
      td.style.setProperty('--dur', active === n - 1 ? 'calc(var(--step-ms) * 1.5)' : 'var(--step-ms)');
      restartFill();
      scrollCard(smooth);
    };

    const setPlaying = (on: boolean) => {
      playing = on;
      td.classList.toggle('is-playing', on);
      playBtn.dataset.state = wantsPlay ? 'playing' : 'paused';
      playBtn.setAttribute('aria-label', wantsPlay ? 'Pause the walkthrough' : 'Play the walkthrough');
    };

    // The segment finishing is the clock: advance, loop after the last step.
    td.addEventListener('animationend', (e) => {
      if (!playing || reduced) return;
      if (!(e.target instanceof HTMLElement) || !e.target.matches('[data-seg-fill]')) return;
      render(active + 1);
    });

    // Announce only what the visitor asked for (never autoplay), once, after it settles.
    const live = td.querySelector<HTMLElement>('[data-td-live]');
    let liveTimer: number | undefined;
    const announce = () => {
      window.clearTimeout(liveTimer);
      liveTimer = window.setTimeout(() => {
        const s = STEPS[active]!;
        if (live) live.textContent = `Step ${active + 1} of ${n}: ${s.title}`;
      }, 250);
    };
    const takeControl = (i: number) => {
      wantsPlay = false;
      setPlaying(false);
      render(i);
      announce();
    };
    steps.forEach((st, i) => st.querySelector('[data-st-btn]')?.addEventListener('click', () => takeControl(i)));
    spots.forEach((h) => h.addEventListener('click', () => takeControl(Number(h.dataset.hs))));
    td.querySelector('[data-prev]')?.addEventListener('click', () => takeControl(active - 1));
    td.querySelector('[data-next]')?.addEventListener('click', () => takeControl(active + 1));
    playBtn.addEventListener('click', () => {
      wantsPlay = !wantsPlay;
      if (wantsPlay && active === n - 1) render(0);
      setPlaying(wantsPlay);
    });
    if (reduced) playBtn.hidden = true;

    // Swiping the card stack is a step choice too: whichever card snaps in becomes current.
    let swipeTimer: number | undefined;
    /** Keyboard focus inside the stack: Tab scrolls the list, and that is not a swipe. */
    const keyboardInList = (): boolean => {
      try {
        return list.querySelector(':focus-visible') !== null;
      } catch {
        return false;
      }
    };
    const onSwipe = () => {
      if (!stacked.matches || performance.now() < programmatic || keyboardInList()) return;
      window.clearTimeout(swipeTimer);
      swipeTimer = window.setTimeout(() => {
        const pad = parseFloat(getComputedStyle(list).scrollPaddingLeft) || 0;
        const x = list.scrollLeft + pad;
        let best = active;
        let dist = Infinity;
        steps.forEach((st, k) => {
          const d = Math.abs(st.offsetLeft - x);
          if (d < dist) {
            dist = d;
            best = k;
          }
        });
        if (best !== active) takeControl(best);
      }, 120);
    };
    list.addEventListener('scroll', onSwipe, { passive: true });
    // Tabbing to a card makes it the current step (clicks are handled by the click listener).
    steps.forEach((st, i) =>
      st.addEventListener('focusin', (e) => {
        if (i === active) return;
        let kbd = false;
        try {
          kbd = e.target instanceof Element && e.target.matches(':focus-visible');
        } catch {
          kbd = false;
        }
        if (kbd) takeControl(i);
      }),
    );

    // Go live without animating the first frame from the server's "after" state.
    td.classList.add('is-live', 'is-instant');
    td.querySelectorAll<HTMLElement>('[data-td-controls], [data-td-segs]').forEach((el) => (el.hidden = false));
    document.querySelectorAll<HTMLElement>('[data-td-js-only]').forEach((el) => (el.hidden = false));
    steps.forEach((st) => st.querySelector<HTMLButtonElement>('[data-st-btn]')?.removeAttribute('disabled'));
    // Under reduced motion it never plays, so it rests on the finished page.
    const first = reduced ? n - 1 : 0;
    syncBar();
    render(first, false);
    setPlaying(false);
    requestAnimationFrame(() => requestAnimationFrame(() => td.classList.remove('is-instant')));
    if ('ResizeObserver' in window && barTrack) new ResizeObserver(syncBar).observe(barTrack);
    stacked.addEventListener('change', () => scrollCard(false));

    // Play only while a third of the player is visible, or, when the player is taller than
    // the screen (a landscape phone), while it covers a third of the viewport. The visitor's
    // pause always wins.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => {
          if (!e) return;
          const visible =
            e.isIntersecting && (e.intersectionRatio >= 0.33 || e.intersectionRect.height >= window.innerHeight / 3);
          if (visible && !started) {
            started = true;
            render(first, false);
          }
          setPlaying(visible && wantsPlay);
        },
        { threshold: Array.from({ length: 21 }, (_, i) => i / 20) },
      ).observe(td);
    }
  }
</script>
