---
/**
 * ★ Signature: the Store teardown, as an in-place player, not a scroll-jack.
 * An EXAMPLE product page (store, product and signals are illustrative and labelled) with a
 * numbered hotspot on each problem. Six steps walk from "as found" through five fixes: one
 * search fix (what Google can read, shown in the "What Google sees" strip) and four sales fixes
 * on the page. Each applies on the page and an illustrative "Ready to sell" meter climbs (a
 * position on Not yet → Ready, never a score, a conversion rate or a ranking).
 *
 * Playback: starts when a third of the player is on screen. The current story segment's fill
 * is a CSS animation and its `animationend` advances the story, so pausing (button, off
 * screen, hidden tab) just pauses the fill and nothing drifts out of sync. Clicking a step, a
 * hotspot, prev or next hands control to the visitor (playback pauses; play resumes). Under
 * reduced motion it never autoplays and there is no play button.
 *
 * Below 1100px the steps become a swipeable card stack (scroll-snap), and the meter turns into
 * a slim bar that sticks under the nav while the player is on screen, so the result stays in
 * view while you swipe.
 *
 * Without JS: the page shows the fixed "after" state, the meter its final position, every step
 * is a plain list, and the controls are hidden. The product page is a visual duplicate
 * (aria-hidden); the steps list and a visually hidden description are the accessible content.
 */
import { SIGNALS, STEPS, STORE, type FixId } from '../../data/shopify/teardown';

const n = STEPS.length;
const STEP_MS = 4800;
const last = STEPS[n - 1]!;
const allFixes = STEPS.map((s) => s.fix).filter((f): f is FixId => f !== null);
const totalFixes = allFixes.length;
/** Step index of each fix, for the hotspot numbers. */
const stepOf = (fix: FixId) => STEPS.findIndex((s) => s.fix === fix);
/** Hotspots carry the visible step number (01-based, the same as the list and the counter). */
const hsNum = (fix: FixId) => String(stepOf(fix) + 1);
const kindLabel = { start: 'Before', search: 'Search fix', conversion: 'Sales fix' } as const;
/** The first signal a fix changes carries that fix's hotspot. */
const firstSignal = SIGNALS.findIndex((s) => s.fix === 'schema');
---

<section class="section tds" id="teardown" aria-labelledby="teardown-title">
  <div class="container head head--split">
    <p class="eyebrow">Store teardown</p>
    <h2 id="teardown-title">Watch a product page get ready to sell.</h2>
    <p class="lede">
      An example store, one fix at a time.
      <span data-td-js-only hidden
        >{' '}It plays on its own; step through it, or tap a numbered spot on the page to jump to that fix.</span
      >
    </p>
  </div>

  <div class="container">
    <div
      class="td"
      data-td
      data-step={n - 1}
      data-fixes={allFixes.join(' ')}
      style={`--step-ms:${STEP_MS}ms;--meter:${last.meter}`}
      data-pause-offscreen
    >
      <!-- The meter: one compact card, a bar with a pin (it sticks under the nav below 1100px). -->
      <div class="meter" aria-hidden="true">
        <div class="meter__bar">
          <span class="meter__bar-end mono">Not yet</span>
          <span class="meter__bar-track"><span class="meter__bar-fill"></span><span class="meter__bar-pin"></span></span>
          <span class="meter__bar-end mono">Ready</span>
        </div>
        <div class="meter__read">
          <span class="meter__title">Ready to sell</span>
          <span class="meter__fixes mono"
            >Fixes applied <span class="num" data-td-fixes>{totalFixes}</span>/{totalFixes}</span
          >
          <span class="meter__note mono">Illustrative · not a measurement</span>
        </div>
      </div>

      <div class="td__stage">
        <div class="td__segs" aria-hidden="true" data-td-segs hidden>
          {STEPS.map((_, i) => <span class="seg" data-seg={i}><span class="seg__fill" data-seg-fill /></span>)}
        </div>

        <figure class="pp" aria-labelledby="pp-cap">
          <div class="pp__frame" aria-hidden="true">
            <div class="pp__bar">
              <span class="pp__dots"><span></span><span></span><span></span></span>
              <span class="pp__url mono">{STORE.url}</span>
              <span class="tag tag--example pp__ex">Example</span>
            </div>
            <div class="pp__page" data-td-page>
              <div class="pp__announce" data-anchor="ship">
                <span class="pp__announce-text pp__announce-text--before">Welcome to our store</span>
                <span class="pp__announce-text pp__announce-text--after">Free shipping over $50</span>
                <span class="pp__badge pp__badge--app">Says nothing</span>
                <span class="pp__badge pp__badge--ok">Theme section</span>
                <span class="hs" data-hs={stepOf('ship')}>{hsNum('ship')}</span>
              </div>
              <div class="pp__header">
                <span class="pp__logo">{STORE.name}</span>
                <span class="pp__links"><span></span><span></span></span>
                <span class="pp__cart"></span>
              </div>
              <div class="pp__main">
                <div class="pp__gallery">
                  <div class="pp__photo" data-anchor="img">
                    <svg class="pp__mug" viewBox="0 0 120 120">
                      <ellipse cx="58" cy="100" rx="34" ry="6" class="mug__shadow"></ellipse>
                      <path class="mug__handle" d="M84 46c14 0 20 8 20 18s-7 18-21 18" fill="none" stroke-width="8" stroke-linecap="round"></path>
                      <path class="mug__body" d="M30 34h56v52c0 8-6 14-14 14H44c-8 0-14-6-14-14z"></path>
                      <ellipse class="mug__rim" cx="58" cy="34" rx="28" ry="5"></ellipse>
                      <g class="mug__specks">
                        <circle cx="40" cy="50" r="1.3"></circle><circle cx="52" cy="62" r="1"></circle><circle cx="70" cy="48" r="1.4"></circle>
                        <circle cx="62" cy="78" r="1.1"></circle><circle cx="44" cy="84" r="1.3"></circle><circle cx="76" cy="70" r="1"></circle>
                        <circle cx="56" cy="44" r="0.9"></circle><circle cx="38" cy="70" r="1"></circle>
                      </g>
                    </svg>
                    <span class="pp__badge pp__badge--app pp__photo-badge">One blurry photo</span>
                    <span class="pp__badge pp__badge--ok pp__photo-badge">Sharp · 4 angles</span>
                    <span class="hs" data-hs={stepOf('img')}>{hsNum('img')}</span>
                  </div>
                  <div class="pp__thumbs">
                    <span></span><span></span><span></span><span></span>
                  </div>
                </div>
                <div class="pp__info">
                  <span class="pp__title">{STORE.product}</span>
                  <span class="pp__stars"><span>★★★★★</span><span class="pp__stars-n">reviews</span></span>
                  <span class="pp__price"></span>
                  <span class="pp__swatches">
                    {STORE.variants.map((v, i) => <span class={`pp__sw pp__sw--${i}`} title={v} />)}
                  </span>
                  <span class="pp__atc" data-anchor="sticky">
                    Add to cart
                    <span class="hs" data-hs={stepOf('sticky')}>{hsNum('sticky')}</span>
                  </span>
                  <span class="pp__trust" data-anchor="trust">
                    <span class="pp__trust-q">Delivery? Returns?</span>
                    <span class="pp__trust-ok">Ships tomorrow · Free 30-day returns</span>
                    <span class="hs" data-hs={stepOf('trust')}>{hsNum('trust')}</span>
                  </span>
                </div>
              </div>
              <div class="pp__sticky">
                <span class="pp__sticky-name">{STORE.product}</span>
                <span class="pp__sticky-btn">Add to cart</span>
              </div>
            </div>
            <div class="pp__scripts">
              <span class="pp__scripts-label mono">What Google sees</span>
              <span class="pp__chips">
                {
                  SIGNALS.map((s, i) => (
                    <span class:list={['chipjs mono', { 'chipjs--fix': s.fix }]} data-fix={s.fix ?? undefined}>
                      <span class="chipjs__name">{s.name}</span>
                      {s.after && <span class="chipjs__after">{s.after}</span>}
                      {i === firstSignal && <span class="hs" data-hs={stepOf('schema')}>{hsNum('schema')}</span>}
                    </span>
                  ))
                }
              </span>
            </div>
          </div>
          <figcaption id="pp-cap" class="visually-hidden">
            An example product page from an illustrative store, {STORE.name}, selling a {STORE.product.toLowerCase()}. Below it, what
            Google can read from the page: {SIGNALS.map((s) => s.name).join(', ')}. The steps below apply one fix each.
          </figcaption>
        </figure>
      </div>

      <div class="td__side">
        <ol class="td__steps" role="list" data-td-steps>
          {
            STEPS.map((s, i) => (
              <li
                class="st"
                data-st={i}
                data-fix={s.fix ?? undefined}
                data-meter={s.meter}
                data-title={s.title}
                aria-current={i === n - 1 ? 'step' : undefined}
              >
                {/* Disabled until the player is live: without JS these buttons would do nothing. */}
                <button class="st__btn" type="button" data-st-btn={i} disabled>
                  <span class="st__num mono" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="st__title">{s.title}</span>
                  <span class:list={['st__kind mono', `st__kind--${s.kind}`]}>{kindLabel[s.kind]}</span>
                  <span class="visually-hidden">
                    , step {i + 1} of {n}
                  </span>
                </button>
                <div class="st__body">
                  <div class="st__body-inner">
                    <p class="st__text">{s.text}</p>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="td__controls" data-td-controls hidden>
          <button class="ctl" type="button" data-prev aria-label="Previous step">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
          </button>
          <button class="ctl ctl--play" type="button" data-play aria-label="Pause the walkthrough">
            <svg class="ctl__pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6v12M15 6v12"></path></svg>
            <svg class="ctl__play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
          </button>
          <button class="ctl" type="button" data-next aria-label="Next step">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
          </button>
          <span class="td__count mono" aria-hidden="true"><span data-td-count>{n}</span> / {n}</span>
          <span class="td__dots" aria-hidden="true">
            {STEPS.map((_, i) => <span class="td__dot" data-dot={i} />)}
          </span>
        </div>
        <p class="visually-hidden" aria-live="polite" data-td-live></p>
        <p class="td__note text-3">
          Illustrative store, not a client’s. The meter shows direction, not a score: real reviews measure sales and search
          before and after the same way.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* The heading lines up with the 1180px player, not the wider page container. */
  .tds .head {
    width: min(100% - 2 * var(--margin), 1180px);
  }
  /* =========================================================
     Layout: compact. Desktop: the page mock and a narrow step column (meter on top), the
     whole player inside ~80% of a 1440×900 screen, max 1180px wide.
     ========================================================= */
  .td {
    display: grid;
    gap: var(--space-4);
    grid-template-areas: 'meter' 'stage' 'side';
    max-width: 1180px;
    margin-inline: auto;
  }
  @media (min-width: 1100px) {
    .td {
      grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
      grid-template-areas: 'stage meter' 'stage side';
      grid-template-rows: auto 1fr;
      gap: var(--space-3) var(--space-5);
      align-items: start;
    }
  }
  .meter {
    grid-area: meter;
  }
  .td__stage {
    grid-area: stage;
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }
  .td__side {
    grid-area: side;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }

  /* =========================================================
     Meter: one small card. Title + count on a row, the bar, the honesty note.
     ========================================================= */
  .meter {
    display: grid;
    gap: 6px;
    padding: 10px var(--space-4) 10px;
    border-radius: var(--radius-l);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
  }
  .meter__read {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-3);
    order: -1;
  }
  .meter__title {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .meter__fixes {
    color: var(--text);
    font-size: 0.75rem;
  }
  .meter__note {
    flex-basis: 100%;
    color: var(--text-3);
    font-size: 0.6875rem;
  }
  .meter__bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
  }
  .meter__bar-end {
    color: var(--text-3);
    font-size: 0.6875rem;
  }
  .meter__bar-track {
    position: relative;
    height: 8px;
    border-radius: 4px;
    background: var(--surface-1);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .meter__bar-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(var(--meter));
    transition: transform 1100ms var(--ease-in-out-quart);
  }
  .meter__bar-pin {
    position: absolute;
    top: -4px;
    left: 0;
    width: 4px;
    height: 16px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--text);
    translate: calc(var(--meter) * var(--track-w, 0px)) 0;
    transition: translate 1200ms var(--ease-spring);
  }
  @media (max-width: 1099px) {
    /* Stays in view under the nav while you swipe through the fixes. */
    .meter {
      position: sticky;
      top: calc(var(--nav-h) + env(safe-area-inset-top, 0px) + 8px);
      z-index: 3;
      background: color-mix(in srgb, var(--surface-2) 94%, transparent);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }
  }

  /* Story segments: the current one fills; its animationend advances the story. */
  .td__segs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 4px;
  }
  .seg {
    height: 3px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .seg__fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }
  .seg.is-past .seg__fill {
    transform: scaleX(1);
  }
  /* Always attached to the current fill and only paused/resumed, so a pause continues where
     it stopped instead of restarting the step. */
  .seg.is-current .seg__fill {
    animation: seg-fill var(--dur, var(--step-ms)) linear forwards;
  }
  .td:not(.is-playing) .seg.is-current .seg__fill {
    animation-play-state: paused;
  }
  @keyframes seg-fill {
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .seg.is-current .seg__fill {
      animation: none;
      transform: scaleX(1);
    }
  }

  /* =========================================================
     The example product page. Sized in container units so it keeps its layout from a phone
     to a desktop (it is a picture of a page, not a page). Kept short on purpose.
     ========================================================= */
  .pp {
    margin: 0;
    container-type: inline-size;
  }
  .pp__frame {
    --u: 1cqi;
    border-radius: var(--radius-l);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
    overflow: hidden;
  }
  .pp__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 6px 12px;
    border-bottom: 1px solid var(--line);
    background: var(--surface-1);
  }
  .pp__dots {
    display: flex;
    gap: 5px;
  }
  .pp__dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .pp__url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    padding: 2px 10px;
    border-radius: var(--radius-s);
    background: var(--surface-2);
    color: var(--text-3);
    font-size: 0.6875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pp__ex {
    font-size: 0.6875rem;
    padding: 1px 8px;
  }
  .pp__page {
    position: relative;
    /* Room for the sticky Add to cart bar under the columns, so it never covers the delivery line. */
    padding-bottom: max(40px, calc(var(--u) * 6));
    background: var(--surface-2);
    overflow: hidden;
  }
  /* Badges: an "app" badge before the fix, an "ok" badge after. Only one shows. */
  .pp__badge {
    display: inline-flex;
    align-items: center;
    padding: 1px 8px;
    border-radius: var(--radius-s);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .pp__badge--app {
    background: var(--warn-bg);
    color: var(--warn);
  }
  .pp__badge--ok {
    display: none;
    background: var(--accent-soft);
    color: var(--accent-text);
  }

  .pp__announce {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: 32px;
    padding: 4px 44px 4px 12px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .pp__announce .pp__badge--ok {
    background: var(--accent-fill);
    color: var(--on-accent);
  }
  .pp__announce-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pp__announce-text--before {
    opacity: 0.7;
  }
  .pp__announce-text--after {
    display: none;
  }
  /* Phones: the bar's text is the point of the fix; the badge would squeeze it to an ellipsis. */
  @media (max-width: 479px) {
    .pp__announce .pp__badge {
      display: none !important;
    }
  }
  /* The signals strip: the hotspot sits on the first fixed chip's own edge, not on its neighbour. */
  .chipjs .hs {
    top: 50%;
    right: 2px;
    width: 20px;
    height: 20px;
    margin-top: -10px;
    font-size: 0.625rem;
    box-shadow: 0 0 0 2px var(--surface-2);
  }
  .pp__header {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 3);
    padding: 8px calc(var(--u) * 4);
    border-bottom: 1px solid var(--line);
  }
  .pp__logo {
    font-family: var(--font-store);
    font-weight: 700;
    font-size: clamp(0.875rem, 2.2cqi, 1.125rem);
    white-space: nowrap;
  }
  .pp__links {
    display: flex;
    gap: calc(var(--u) * 2);
    margin-inline: auto;
  }
  .pp__links span,
  .pp__price {
    display: block;
    height: 6px;
    border-radius: 3px;
    background: var(--line);
  }
  .pp__links span {
    width: calc(var(--u) * 6);
  }
  .pp__cart {
    width: 14px;
    height: 14px;
    border: 2px solid var(--text-2);
    border-radius: 3px 3px 5px 5px;
  }
  .pp__main {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    gap: calc(var(--u) * 4);
    padding: calc(var(--u) * 3) calc(var(--u) * 4) 0;
  }
  .pp__gallery {
    display: grid;
    gap: calc(var(--u) * 1.2);
  }
  .pp__photo {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-s);
    background:
      radial-gradient(70% 60% at 50% 40%, #f6ece2, transparent 70%),
      linear-gradient(160deg, #eadfd3, #d8c6b4);
  }
  .pp__mug {
    position: absolute;
    inset: 8% 22%;
    width: 56%;
    height: 84%;
    filter: blur(5px) saturate(0.7);
    opacity: 0.75;
    transition:
      filter 900ms var(--ease-out-quint),
      opacity 900ms var(--ease-out-quint);
  }
  .mug__shadow {
    fill: rgb(60 40 30 / 0.22);
  }
  .mug__body {
    fill: #c25a35;
  }
  .mug__rim {
    fill: #8f3d20;
  }
  .mug__handle {
    stroke: #b24f2d;
  }
  .mug__specks circle {
    fill: #f4e2d0;
    opacity: 0.85;
  }
  .pp__photo-badge {
    position: absolute;
    left: 6px;
    bottom: 6px;
  }
  .pp__thumbs {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: calc(var(--u) * 1.2);
  }
  /* Before: the extra angles are missing (faint placeholders); the photo fix fills them in. */
  .pp__thumbs > span {
    aspect-ratio: 1.4;
    border-radius: 4px;
    background: linear-gradient(160deg, #eadfd3, #d8c6b4);
    opacity: 0.2;
    transition: opacity 700ms var(--ease-out-quint);
  }
  .pp__info {
    display: grid;
    align-content: start;
    gap: calc(var(--u) * 1.8);
    min-width: 0;
  }
  /* The storefront's own type: the one place a serif appears. */
  .pp__title {
    font-family: var(--font-store);
    font-weight: 700;
    font-size: clamp(0.9375rem, 3cqi, 1.5rem);
    line-height: 1.1;
  }
  .pp__stars {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    color: var(--accent-text);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }
  .pp__stars-n {
    color: var(--text-3);
    letter-spacing: 0;
  }
  .pp__price {
    width: 30%;
    height: 9px;
    background: var(--text-2);
    opacity: 0.5;
  }
  .pp__swatches {
    display: flex;
    gap: 8px;
  }
  .pp__sw {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    box-shadow:
      0 0 0 2px var(--surface-2),
      0 0 0 3px var(--line-strong);
  }
  .pp__sw--0 {
    background: #c25a35;
    box-shadow:
      0 0 0 2px var(--surface-2),
      0 0 0 3.5px var(--text);
  }
  .pp__sw--1 {
