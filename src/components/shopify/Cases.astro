---
/**
 * Case studies on the home page. Yard Terminal leads (the one real case). The example speed
 * teardown and a visible placeholder slot for real store work (speed / conversion, open in
 * decisions) sit beside it in one row, so the row is full and nothing pretends to be what it
 * isn't.
 *
 * Page transition: each linked card carries view-transition-name `case-<id>`; the case page
 * hero box uses the same name, so on navigation the card morphs into the hero while the rest
 * of the page slides in behind it (base.css). Only the box morphs, never the title.
 */
import { CASES } from '../../data/shopify/cases';
import { STEPS } from '../../data/shopify/teardown';
import { caseHref } from '../../lib/shopify/paths';

const [main, teardown] = CASES;
if (!main || !teardown) throw new Error('[shopify] expected two cases');
const vt = (id: string) => `view-transition-name: case-${id}`;
const fixes = STEPS.filter((s) => s.fix);
---

<section class="section cases" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="head head--split">
      <p class="eyebrow">Case studies</p>
      <h2 id="work-title">Proof I can show you today.</h2>
      <p class="lede">
        The marketplace sync I built and run as my own product, a teardown of the store I’m usually asked to speed up, and a
        slot for client store work once it’s cleared to publish.
      </p>
    </div>

    {/* Cards are never reveal-armed: a page transition may morph into one at load, and an
        armed card is invisible at that moment. */}
    <article class="case case--main" id={`card-${main.id}`} style={vt(main.id)}>
      <div class="case__copy">
        <div class="case__top">
          <span class="tag tag--accent">{main.kicker}</span>
          {main.status && <span class="chip chip--live">{main.status}</span>}
        </div>
        <h3 class="case__name">
          <a class="case__link" href={caseHref(main.id)}>{main.name}</a>
        </h3>
        <p class="case__title">{main.title}</p>
        <ul class="case__facts" role="list">
          {main.facts.map((f) => <li>{f}</li>)}
        </ul>
        <span class="case__more" aria-hidden="true">Read the case study <span class="case__arrow">→</span></span>
        <div class="case__todos">
          {main.pending.map((p) => <span class="todo">{p}</span>)}
        </div>
      </div>
      <div class="case__visual" aria-hidden="true">
        <div class="receipt flowr">
          <p class="flowr__head">The flow</p>
          <ol class="flowr__rows" role="list">
            {
              main.flow.map((s, i) => (
                <li class="leader">
                  <span>{s}</span>
                  <span class="flowr__n">{String(i + 1).padStart(2, '0')}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </article>

    <div class="cases__pair">
      <article class="case case--small" id={`card-${teardown.id}`} style={vt(teardown.id)}>
        <div class="case__top">
          <span class="tag tag--example">Example</span>
          <span class="case__kicker mono">{teardown.kicker}</span>
        </div>
        <h3 class="case__name">
          <a class="case__link" href={caseHref(teardown.id)}>{teardown.name}</a>
        </h3>
        <p class="case__title">{teardown.title}</p>
        <ul class="mini" role="list" aria-hidden="true">
          {
            fixes.map((s, i) => (
              <li>
                <span class="mini__n mono">{String(i + 1).padStart(2, '0')}</span>
                {s.short}
              </li>
            ))
          }
        </ul>
        <span class="case__more" aria-hidden="true">
          Read the teardown <span class="case__arrow">→</span>
        </span>
      </article>

      <aside class="case case--slot" aria-label="Store case study placeholder">
        <span class="case__kicker mono">Store work · speed or conversion</span>
        <p class="slot__title">A real store, before and after.</p>
        <p class="slot__text">
          This slot stays empty until a client clears their store and numbers for publishing. No made-up results in the
          meantime.
        </p>
        <span class="todo">TODO · Store case: Lighthouse and load time before / after, conversion change</span>
      </aside>
    </div>
    <div class="shelf cases__shelf" aria-hidden="true"></div>
  </div>
</section>

<style>
  .case {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.75rem);
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
    transition:
      transform 700ms var(--ease-out-expo),
      box-shadow 700ms var(--ease-out-expo);
    /* "All case studies" on a case page lands on its own card: give it air under the nav. */
    scroll-margin-top: var(--space-4);
  }
  /* The title link stretches over the card: the whole card is the target, one tab stop. */
  .case__link {
    color: inherit;
    text-decoration: none;
  }
  .case__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-xl);
  }
  .case__link:focus-visible {
    outline: none;
  }
  .case:has(.case__link:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }
  @media (hover: hover) {
    /* Picked up off the shelf: a small lift. */
    .case:has(.case__link):hover {
      transform: translateY(-6px);
      box-shadow:
        inset 0 0 0 1px var(--line-strong),
        var(--shadow-lift);
    }
    .case:hover .case__arrow {
      transform: translateX(5px);
    }
  }
  .case--main {
    gap: var(--space-6);
    margin-bottom: var(--space-4);
  }
  @media (min-width: 1024px) {
    .case--main {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: center;
    }
  }
  .case__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .case__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .case__kicker {
    color: var(--text-3);
  }
  .case__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.025em;
    width: fit-content;
    max-width: 100%;
  }
  .case--small .case__name {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2.125rem);
  }
  .case__title {
    font-size: var(--fs-lede);
    font-weight: 500;
    line-height: 1.35;
    max-width: 36ch;
  }
  .case--small .case__title {
    font-size: 1.0625rem;
    color: var(--text-2);
  }
  .case__facts {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--fs-small);
  }
  .case__facts li {
    position: relative;
    padding-left: 22px;
  }
  .case__facts li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .case__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }
  .case__arrow {
    display: inline-block;
    color: var(--accent-text);
    transition: transform 620ms var(--ease-out-expo);
  }
  .case__todos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  @media (max-width: 719px) {
    .case--main .case__facts {
      display: none;
    }
  }
  .case__visual {
    filter: drop-shadow(0 18px 24px rgb(64 40 24 / 0.16));
  }
  .flowr {
    background: var(--bg);
  }
  .flowr__head {
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-2);
    border-bottom: 1px solid var(--line);
    color: var(--text-3);
    letter-spacing: 0.08em;
  }
  .flowr__rows {
    display: grid;
    gap: 2px;
    margin: 0;
  }
  .flowr__rows li {
    padding: 7px 0;
    color: var(--text);
  }
  .flowr__n {
    color: var(--accent-text);
  }
  .cases__pair {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 900px) {
    .cases__pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .case--small {
    gap: var(--space-3);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }
  .mini {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: var(--space-2) 0;
  }
  .mini li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 6px;
    border-radius: var(--radius-s);
    background: var(--surface-1);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .mini__n {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--accent-fill);
    color: var(--on-accent);
    font-size: 0.625rem;
  }

  /* The store-work slot: a dashed, empty placeholder. Not a link. */
  .case--slot {
    gap: var(--space-3);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    background: transparent;
    box-shadow: none;
    border: 1.5px dashed var(--line-strong);
  }
  .slot__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.875rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .slot__text {
    color: var(--text-2);
    font-size: var(--fs-small);
    max-width: 44ch;
  }
  .cases__shelf {
    margin-top: 6px;
  }
</style>
