---
/**
 * Proof strip (brief §4 item 2): four admin-style metric cards. Three are facts
 * (the registry project's channels and its sold-once rule, Plus in scope); the fourth, storefront
 * results, is a visible TODO slot until the owner has before/after numbers. Without the project
 * (Example mode) its two cells become TODO cells (PROOF_TODO_EXTRA), so the row stays at four.
 */
import { PROOF, PROOF_TODO, PROOF_TODO_EXTRA } from '../../data/shopify/content';
---

<section class="proof" id="proof" aria-labelledby="proof-title">
  <div class="container">
    <h2 id="proof-title" class="visually-hidden">Proof at a glance</h2>
    <ul class="proof__labels" role="list" data-reveal-stagger>
      {
        PROOF.map((p) => (
          <li class="pl">
            <span class="pl__value">{p.value}</span>
            <span class="pl__label">{p.label}</span>
          </li>
        ))
      }
      <li class="pl pl--todo">
        <span class="pl__value pl__value--todo">{PROOF_TODO.title}</span>
        <span class="todo">{PROOF_TODO.chip}</span>
      </li>
      {
        PROOF_TODO_EXTRA.map((t) => (
          <li class="pl pl--todo">
            <span class="pl__value pl__value--todo">{t.title}</span>
            <span class="todo">{t.chip}</span>
          </li>
        ))
      }
    </ul>
    <div class="shelf proof__shelf" aria-hidden="true"></div>
  </div>
</section>

<style>
  .proof {
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem) 0;
  }
  .proof__labels {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 640px) {
    .proof__labels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .proof__labels {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* An admin metric card: a small clay marker, a big value, small print under it. */
  .pl {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
  }
  .pl::before {
    content: '';
    width: 24px;
    height: 3px;
    border-radius: 2px;
    background: var(--accent);
  }
  .pl__value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.625rem, 1.4rem + 0.9vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .pl__label {
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.45;
  }
  .pl--todo {
    background: transparent;
    box-shadow: none;
    border: 1.5px dashed var(--line-strong);
  }
  .pl--todo::before {
    background: var(--line);
  }
  .pl__value--todo {
    color: var(--text-3);
  }
  .proof__shelf {
    margin-top: 6px;
  }
</style>
