---
/**
 * Process (brief §4 item 9): Audit → Plan → Build → Launch → Care, as a clean stepper: five
 * numbered dots on one rail with a card under each. Desktop: one row. Phone: a vertical rail.
 *
 */
import { PROCESS } from '../../data/shopify/content';
---

<section class="section process" id="process" aria-labelledby="process-title">
  <div class="container">
    <div class="head head--split">
      <p class="eyebrow">Process</p>
      <h2 id="process-title">From the first call to the next month.</h2>
      <p class="lede">Every step leaves you with something you can see, so you always know where the work is.</p>
    </div>
    <ol class="steps" role="list" data-reveal-stagger>
      {
        PROCESS.map((p, i) => (
          <li class="step" style={`--i:${i}`}>
            <span class="step__knot" aria-hidden="true" />
            <div class="step__tag">
              <span class="step__num mono">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="step__title">{p.title}</h3>
              <p class="step__text">{p.text}</p>
              <p class="step__leaves leader">
                <span class="mono">Leaves you</span>
                <span>{p.leaves}</span>
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* A clean stepper: numbered dots on one rail, a card under each. */
  .steps {
    position: relative;
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding-left: 40px;
  }
  /* The rail. */
  .steps::before {
    content: '';
    position: absolute;
    left: 13px;
    top: 14px;
    bottom: 14px;
    width: 2px;
    background: var(--line);
  }
  @media (min-width: 1100px) {
    .steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-4);
      padding: 44px 0 0;
    }
    .steps::before {
      left: 14px;
      right: 14px;
      top: 13px;
      bottom: auto;
      width: auto;
      height: 2px;
    }
  }
  .step {
    position: relative;
  }
  .step__knot {
    position: absolute;
    left: -40px;
    top: 16px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 2px var(--accent),
      0 0 0 4px var(--bg);
  }
  .step:first-child .step__knot {
    background: var(--accent);
  }
  @media (min-width: 1100px) {
    .step__knot {
      left: 0;
      top: -44px;
    }
  }
  .step__tag {
    position: relative;
    display: grid;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
    align-content: start;
  }
  .step__num {
    color: var(--accent-text);
  }
  .step__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .step__text {
    color: var(--text-2);
    font-size: var(--fs-small);
  }
  .step__leaves {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    font-weight: 600;
    flex-wrap: wrap;
  }
  .step__leaves::after {
    display: none;
  }
  .step__leaves .mono {
    color: var(--text-3);
    font-weight: 400;
    font-size: 0.75rem;
  }
</style>
