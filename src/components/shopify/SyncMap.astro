---
/**
 * Sync map (brief §4 item 5; decisions: include, Yard Terminal). Drawn as Yard Terminal really
 * works: the Part record is the hub and owns the count; each channel connects to it directly
 * and only holds a listing. Shopify is the emphasised spoke (the brief asked for Shopify in the
 * centre; accuracy wins, see docs/todo/shopify.md). Spokes: Shopify and eBay Motors (live), the
 * counter (Yard Terminal's own point of sale, live), and Facebook Marketplace dashed as
 * "coming soon, not live". Amazon and Google Shopping are not supported, so they are not drawn.
 *
 * Motion: one event per beat (2.8s). A "packet" slides along a spoke between the record and a
 * channel (in-out-quart), then the tile it reaches changes state (listed → sold → ended →
 * checked; the record goes qty 1 → qty 0). Two short stories
 * loop: a part sells on eBay Motors, then a second part sells at the counter. The part is an
 * example; the steps are the real flow. Pausable; paused off screen and in hidden tabs.
 * Without JS or under reduced motion the map shows its finished state with every wire drawn.
 */
import { BEATS, EXAMPLE_PART, LISTING_LABEL, NODES, RECORD_LABEL, SYNC_TODOS, type NodeId } from '../../data/shopify/sync';
import { caseHref } from '../../lib/shopify/paths';

const lastBeat = BEATS[BEATS.length - 1]!;
const order: NodeId[] = ['facebook', 'shopify', 'record', 'ebay', 'counter'];
const stateOf = (id: NodeId): { key: string; label: string } | null =>
  id === 'shopify'
    ? { key: lastBeat.shopify, label: LISTING_LABEL[lastBeat.shopify] }
    : id === 'ebay'
      ? { key: lastBeat.ebay, label: LISTING_LABEL[lastBeat.ebay] }
      : id === 'record'
        ? { key: lastBeat.record, label: RECORD_LABEL[lastBeat.record] }
        : null;
const facts = [
  'The record owns the count; Shopify and eBay Motors only hold listings',
  'Each ended listing is checked against its channel; a failed write is retried',
  'A sale at the counter ends the online listings too',
];
---

<section class="section sync" id="sync" aria-labelledby="sync-title">
  <div class="container sync__grid">
    <div class="sync__copy">
      <p class="eyebrow">Sync map · Yard Terminal</p>
      <h2 id="sync-title">Sold once. Ended everywhere.</h2>
      <p class="lede">
        Yard Terminal, the product I built, keeps one record per part and lists it on the yard’s own Shopify storefront and on
        eBay Motors. When it sells on one, the other listing is ended. The same thinking keeps your stock, orders and channels in
        step.
      </p>
      <ul class="sync__facts" role="list">
        {facts.map((f) => <li>{f}</li>)}
      </ul>
      <div class="sync__todos">
        {SYNC_TODOS.map((t) => <span class="todo">{t}</span>)}
      </div>
      <a class="btn btn--ghost btn--side" href={caseHref('yard-terminal')}>
        <span>Read the Yard Terminal case</span>
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <figure
      class="map"
      data-map
      data-labels={JSON.stringify({ listing: LISTING_LABEL, record: RECORD_LABEL })}
      data-beats={JSON.stringify(BEATS.map((b) => [b.packet, b.record, b.shopify, b.ebay, b.log]))}
      aria-labelledby="map-cap"
      data-pause-offscreen
    >
      <div class="map__top">
        <span class="tag tag--example">Example part</span>
        <span class="map__part mono">{EXAMPLE_PART}</span>
        <button class="map__pp" type="button" data-map-pp aria-label="Pause the sync animation" aria-pressed="false" hidden>
          {/* Fixed label + aria-pressed: "Pause the sync animation, pressed" = paused. */}
          <svg class="map__pp-pause" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M9 6v12M15 6v12"></path></svg>
          <svg class="map__pp-play" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
        </button>
      </div>

      <div class="map__board" aria-hidden="true" data-map-board>
        {
          order.map((id) => {
            const nd = NODES[id];
            const state = stateOf(id);
            return (
              <div class:list={['nd', `nd--${id}`]} data-node={id} data-listing={state?.key}>
                <span class="nd__name">{nd.name}</span>
                <span class="nd__sub">{nd.sub}</span>
                {state ? (
                  <span class="nd__state mono" data-state-label>
                    {state.label}
                  </span>
                ) : (
                  <span class:list={['nd__state mono', { 'nd__state--soon': id === 'facebook' }]}>{nd.status}</span>
                )}
              </div>
            );
          })
        }
        <span class="packet" data-packet></span>
      </div>

      <p class="map__log mono" aria-hidden="true">
        <span class="map__log-mark">›</span>
        <span data-map-log>{lastBeat.log}</span>
      </p>
      <figcaption id="map-cap" class="map__cap text-3">
        Yard Terminal’s channels, each connected to the part record, which owns the count. The part is an example; the steps
        are the real flow. Facebook Marketplace is listed as coming soon and is not live.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .sync {
    background: var(--surface-1);
  }
  .sync__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 1100px) {
    .sync__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
  .sync__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .sync__copy h2 {
    max-width: 14ch;
  }
  .sync__facts {
    display: grid;
    gap: 0;
    width: 100%;
    margin: 0;
  }
  .sync__facts li {
    position: relative;
    padding: 11px 0 11px 28px;
    border-bottom: 1.5px dotted var(--line-strong);
    font-weight: 500;
  }
  .sync__facts li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .sync__todos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* ---------- the map ---------- */
  .map {
    margin: 0;
    padding: clamp(1rem, 0.6rem + 1.6vw, 1.75rem);
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-lift);
  }
  .map__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-5);
  }
  .map__part {
    color: var(--text-3);
  }
  .map__pp {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-left: auto;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--surface-1);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .map__pp svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .map__pp-play path {
    fill: currentColor;
    stroke: none;
  }
  .map__pp-play,
  .map__pp[aria-pressed='true'] .map__pp-pause {
    display: none;
  }
  .map__pp[aria-pressed='true'] .map__pp-play {
    display: block;
  }

  .map__board {
    --gx: clamp(22px, 1rem + 2vw, 52px);
    --gy: clamp(28px, 1.2rem + 1.6vw, 44px);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr);
    grid-template-areas:
      '. facebook .'
      'shopify record ebay'
      '. counter .';
    gap: var(--gy) var(--gx);
    padding: var(--space-2);
    border-radius: var(--radius-l);
    background:
      radial-gradient(circle, color-mix(in srgb, var(--line-strong) 38%, transparent) 1px, transparent 1.4px) 0 0 / 16px 16px,
      var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .nd {
    position: relative;
    display: grid;
    align-content: center;
    gap: 3px;
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-m);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      var(--shadow-soft);
  }
  .nd--facebook {
    grid-area: facebook;
  }
  /* The hub: an ink tile, because it is the source of truth. */
  .nd--record {
    grid-area: record;
    padding-block: var(--space-5);
    background: var(--btn-bg);
    color: var(--btn-fg);
    box-shadow: var(--shadow-lift);
  }
  .nd--record .nd__sub {
    color: inherit;
    opacity: 0.82;
  }
  .nd--record .nd__name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    letter-spacing: -0.015em;
  }
  .nd.nd--record[data-listing='available'] .nd__state {
    background: var(--accent-fill);
    color: var(--on-accent);
  }
  .nd.nd--record[data-listing='sold'] .nd__state {
    background: var(--bg);
    color: var(--text);
  }
  /* Shopify: the emphasised spoke. */
  .nd--shopify {
    grid-area: shopify;
    box-shadow:
      inset 0 0 0 2px var(--accent),
      var(--shadow-soft);
  }
  .nd--ebay {
    grid-area: ebay;
  }
  .nd--counter {
    grid-area: counter;
  }
  .nd--facebook {
    background: transparent;
    box-shadow: none;
    border: 1.5px dashed var(--line-strong);
  }
  .nd__name {
    font-weight: 600;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .nd--shopify .nd__name {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    letter-spacing: -0.015em;
  }
  .nd__sub {
    color: var(--text-3);
    font-size: 0.8125rem;
    line-height: 1.3;
  }
  .nd__state {
    justify-self: start;
    margin-top: 4px;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--surface-1);
    color: var(--text-2);
    font-size: 0.6875rem;
    white-space: nowrap;
    transition:
      background-color 420ms var(--ease-out-quint),
      color 420ms var(--ease-out-quint);
  }
  .nd__state--soon {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--text-3);
  }
  .nd[data-listing='listed'] .nd__state {
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .nd[data-listing='sold'] .nd__state {
    background: var(--btn-bg);
    color: var(--btn-fg);
  }
  .nd[data-listing='ended'] .nd__state {
    background: var(--warn-bg);
    color: var(--warn);
  }
  .nd[data-listing='verified'] .nd__state {
    background: var(--accent-fill);
    color: var(--on-accent);
  }
  .nd.is-hit {
    animation: hit 640ms var(--ease-spring);
  }
  @keyframes hit {
    40% {
      transform: scale(1.04);
    }
  }

  /* Spokes: stubs across the gaps from each channel to the record, so they meet whatever size
     the tiles reflow to. */
  .nd--shopify::after,
  .nd--ebay::before,
  .nd--facebook::after,
  .nd--counter::before {
    content: '';
    position: absolute;
    background: var(--accent);
  }
  .nd--shopify::after {
    left: 100%;
    top: 50%;
    width: var(--gx);
    height: 2px;
    margin-top: -1px;
  }
  .nd--ebay::before {
    right: 100%;
    top: 50%;
    width: var(--gx);
    height: 2px;
    margin-top: -1px;
  }
  .nd--counter::before {
    bottom: 100%;
    left: 50%;
    width: 2px;
    height: var(--gy);
    margin-left: -1px;
  }
  /* Coming soon: a dashed wire that never carries anything. */
  .nd--facebook::after {
    top: 100%;
    left: 50%;
    width: 0;
    height: var(--gy);
    margin-left: -1px;
    margin-top: 1.5px;
    background: none;
    border-left: 2px dashed var(--line-strong);
  }

  .packet {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 3px;
    background: var(--accent);
    box-shadow:
      0 0 0 3px var(--surface-2),
      0 0 0 6px color-mix(in srgb, var(--accent) 25%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  .map__log {
    display: flex;
    gap: 8px;
    min-height: 2.6em;
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-s);
    background: var(--surface-1);
    color: var(--text);
  }
  .map__log-mark {
    color: var(--accent-text);
  }
  .map__cap {
    margin-top: var(--space-4);
    font-size: 0.8125rem;
  }
  @media (max-width: 639px) {
    .map__board {
      --gx: 12px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding: 6px;
    }
    .nd {
      padding: var(--space-3) 8px;
    }
    .nd__sub {
      display: none;
    }
    /* Whole words only: a name never breaks mid-word on a narrow tile. */
    .nd__name {
      font-size: 0.8125rem;
      overflow-wrap: normal;
      hyphens: none;
    }
    .nd--shopify .nd__name,
    .nd--record .nd__name {
      font-size: 1rem;
    }
    .nd__state {
      font-size: 0.625rem;
      padding-inline: 6px;
      white-space: normal;
    }
    .nd--record {
      padding-block: var(--space-4);
    }
  }
</style>

<script>
  import { prefersReduced } from '../../lib/shopify/base';

  type Beat = [[string, string] | null, string, string, string, string];
  const map = document.querySelector<HTMLElement>('[data-map]');
  if (map && !prefersReduced()) {
    const board = map.querySelector<HTMLElement>('[data-map-board]')!;
    const packet = map.querySelector<HTMLElement>('[data-packet]')!;
    const log = map.querySelector<HTMLElement>('[data-map-log]');
    const labels = JSON.parse(map.dataset.labels ?? '{}') as {
      listing?: Record<string, string>;
      record?: Record<string, string>;
    };
    const beats = JSON.parse(map.dataset.beats ?? '[]') as Beat[];
    const node = (id: string) => board.querySelector<HTMLElement>(`[data-node="${id}"]`);
    const BEAT_MS = 2800;
    let beat = beats.length - 1;
    let timer: number | undefined;
    let visible = false;
    let userPaused = false; // the visitor's pause always wins (WCAG 2.2.2)

    const center = (el: HTMLElement) => {
      const b = board.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      return { x: r.left - b.left + r.width / 2, y: r.top - b.top + r.height / 2 };
    };
    const setListing = (id: string, state: string) => {
      const el = node(id);
      if (!el || el.dataset.listing === state) return;
      el.dataset.listing = state;
      const label = el.querySelector<HTMLElement>('[data-state-label]');
      const set = id === 'record' ? labels.record : labels.listing;
      if (label) label.textContent = set?.[state] ?? state;
      el.classList.remove('is-hit');
      void el.offsetWidth;
      el.classList.add('is-hit');
    };

    const show = (i: number) => {
      const b = beats[i];
      if (!b) return;
      const [route, record, shop, ebay, text] = b;
      if (log) log.textContent = text;
      const apply = () => {
        setListing('record', record);
        setListing('shopify', shop);
        setListing('ebay', ebay);
      };
      const from = route ? node(route[0]) : null;
      const to = route ? node(route[1]) : null;
      if (!from || !to || typeof packet.animate !== 'function') {
        apply();
        return;
      }
      const a = center(from);
      const z = center(to);
      const anim = packet.animate(
        [
          { transform: `translate(${a.x}px, ${a.y}px)`, opacity: 0 },
          { transform: `translate(${a.x}px, ${a.y}px)`, opacity: 1, offset: 0.12 },
          { transform: `translate(${z.x}px, ${z.y}px)`, opacity: 1, offset: 0.88 },
          { transform: `translate(${z.x}px, ${z.y}px)`, opacity: 0 },
        ],
        { duration: 1300, easing: 'cubic-bezier(0.76, 0, 0.24, 1)', fill: 'forwards' },
      );
      anim.finished.then(apply).catch(apply);
    };
    const tick = () => {
      beat = (beat + 1) % beats.length;
      show(beat);
    };
    const play = () => {
      if (timer !== undefined || !visible || document.hidden || userPaused) return;
      timer = window.setInterval(tick, BEAT_MS);
    };
    const pause = () => {
      window.clearInterval(timer);
      timer = undefined;
    };
    const pp = map.querySelector<HTMLButtonElement>('[data-map-pp]');
    if (pp) {
      pp.hidden = false;
      pp.addEventListener('click', () => {
        userPaused = !userPaused;
        // Fixed label, state in aria-pressed only ("Pause the sync animation, pressed").
        pp.setAttribute('aria-pressed', String(userPaused));
        if (userPaused) pause();
        else play();
      });
    }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        visible = Boolean(e?.isIntersecting);
        if (visible) play();
        else pause();
      }).observe(map);
    }
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
  }
</script>
