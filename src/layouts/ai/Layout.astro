---
/**
 * ai niche layout (spec §3, §4, §7.1).
 *
 * Props
 *   title: string, description: string       -> <SEO>
 *   path?: string                             canonical path on the subdomain (default: current page)
 *   image?: string | ImageMetadata            og:image
 *   noindex?: boolean                         per-page noindex (niche-wide switch is src/niches.ts)
 *   jsonLd?: Record<string, unknown>[]        each emitted as <script type="application/ld+json">
 *   bodyClass?: string
 *   heroSentinel?: boolean                    true when the page renders its own [data-cta-sentinel]
 *                                             (the Hero does); otherwise the Layout adds one ~1 viewport
 *                                             down so the sticky CTA still appears after a scroll
 */
import '../../styles/ai/tokens.css';
import '../../styles/ai/base.css';
import '../../styles/ai/components.css';
import clashUrl from '../../assets/fonts/ClashDisplay-Semibold.woff2?url';
import SEO from '../../components/shared/SEO.astro';
import Motion from '../../components/shared/Motion.astro';
import Nav from '../../components/ai/Nav.astro';
import Footer from '../../components/ai/Footer.astro';
import StickyCta from '../../components/ai/StickyCta.astro';
import { createLink } from '../../lib/link';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string | ImageMetadata;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  bodyClass?: string;
  heroSentinel?: boolean;
}

const { title, description, path, image, noindex, jsonLd = [], bodyClass, heroSentinel = false } = Astro.props;

const niche = 'ai' as const;
const link = createLink(niche);

// Runs before first paint; must stay tiny (< 600 bytes). CSS follows the system when nothing is stored.
const themeScript =
  "try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}document.documentElement.classList.add('js')";
const ld = (obj: Record<string, unknown>) => JSON.stringify(obj).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={themeScript} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f2f1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={clashUrl} />
    <link rel="icon" href={link('/icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={link('/apple-touch-icon.png')} />
    <SEO niche={niche} title={title} description={description} path={path} image={image} noindex={noindex} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={ld(obj)} />)}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1">
      {!heroSentinel && <div class="cta-sentinel" data-cta-sentinel aria-hidden="true" />}
      <slot />
    </main>
    <Footer />
    <StickyCta />
    <Motion />
  </body>
</html>

<style>
  main {
    position: relative;
    display: block;
  }
  .cta-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 90vh;
    height: 90svh;
    pointer-events: none;
  }
</style>

<script>
  import '../../lib/ai/base';
</script>
