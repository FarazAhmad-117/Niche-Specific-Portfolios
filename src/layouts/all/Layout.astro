---
/**
 * all niche layout: the hub that links every niche site (all.<rootDomain>).
 *
 * Props
 *   title: string, description: string   -> <SEO> (lengths asserted: ≤ 60 / ≤ 155)
 *   path?: string                         canonical path on the subdomain (default: current page)
 *   noindex?: boolean                     per-page noindex (niche-wide switch is src/niches.ts)
 */
import '../../styles/all/tokens.css';
import displayFontUrl from '../../assets/fonts/ClashDisplay-Semibold.woff2?url';
import SEO from '../../components/shared/SEO.astro';
import ThemeToggle from '../../components/all/ThemeToggle.astro';
import Footer from '../../components/all/Footer.astro';
import { TILES, TILE, TILE_R, INK, PAPER, MUTED } from '../../lib/all/brand-mark';
import { createLink } from '../../lib/link';
import { nicheHost } from '../../niches';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, path, noindex } = Astro.props;

if (title.length > 60) throw new Error(`[all] title is ${title.length} chars (max 60): ${title}`);
if (description.length > 155)
  throw new Error(`[all] description is ${description.length} chars (max 155): ${description}`);

const niche = 'all' as const;
const link = createLink(niche);

// Runs before first paint; must stay tiny. CSS follows the system when nothing is stored.
const themeScript =
  "try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}document.documentElement.classList.add('js')";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={themeScript} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f4f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f12" media="(prefers-color-scheme: dark)" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={displayFontUrl} />
    <link rel="icon" href={link('/icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={link('/apple-touch-icon.png')} />
    <SEO niche={niche} title={title} description={description} path={path} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="bar container">
      <a
        class="bar__brand"
        href={link('/')}
        style={`--mark-ink:${INK};--mark-paper:${PAPER};--mark-lit:${MUTED}`}
      >
        <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
          <rect width="32" height="32" rx="7" class="bar__tile-bg"></rect>
          {
            TILES.map((t) => (
              <rect x={t.x} y={t.y} width={TILE} height={TILE} rx={TILE_R} class={t.lit ? 'bar__tile-lit' : 'bar__tile'} />
            ))
          }
        </svg>
        <span class="bar__host">{nicheHost(niche)}</span>
      </a>
      <ThemeToggle />
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 16px;
  }
  .bar__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    min-width: 0;
    text-decoration: none;
    color: var(--text);
  }
  .bar__brand svg {
    flex: none;
  }
  /* The mark keeps its favicon colours in both themes; a hairline separates it from dark bg. */
  .bar__tile-bg {
    fill: var(--mark-ink);
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .bar__tile {
    fill: var(--mark-paper);
  }
  .bar__tile-lit {
    fill: var(--mark-lit);
  }
  .bar__host {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  main {
    display: block;
    outline: none;
  }
</style>
