---
/**
 * seo niche layout. Concept "SERP" (docs/brief/seo.md §6).
 *
 * Props
 *   title: string, description: string       -> <SEO>
 *   path?: string                             canonical path on the subdomain (default: current page)
 *   image?: string | ImageMetadata            og:image
 *   noindex?: boolean                         per-page noindex (niche-wide switch is src/niches.ts)
 *   jsonLd?: Record<string, unknown>[]        each emitted as <script type="application/ld+json">
 *   home?: boolean                            home page: nav/footer links are #hash
 */
import '../../styles/seo/tokens.css';
import '../../styles/seo/base.css';
import displayFontUrl from '../../assets/fonts/SchibstedGrotesk-Variable-latin.woff2?url';
import SEO from '../../components/shared/SEO.astro';
import Motion from '../../components/shared/Motion.astro';
import Nav from '../../components/seo/Nav.astro';
import Footer from '../../components/seo/Footer.astro';
import StickyCta from '../../components/seo/StickyCta.astro';
import { createLink } from '../../lib/link';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string | ImageMetadata;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  home?: boolean;
}

const { title, description, path, image, noindex, jsonLd = [], home = false } = Astro.props;

const niche = 'seo' as const;
const link = createLink(niche);

// Runs before first paint; must stay tiny. CSS follows the system when nothing is stored.
const themeScript =
  "try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}document.documentElement.classList.add('js')";
const ld = (obj: Record<string, unknown>) => JSON.stringify(obj).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={themeScript} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1012" media="(prefers-color-scheme: dark)" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={displayFontUrl} />
    <link rel="icon" href={link('/icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={link('/apple-touch-icon.png')} />
    <SEO niche={niche} title={title} description={description} path={path} image={image} noindex={noindex} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={ld(obj)} />)}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav home={home} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer home={home} />
    <StickyCta />
    <Motion />
  </body>
</html>

<style>
  main {
    position: relative;
    display: block;
  }
</style>

<script>
  import '../../lib/seo/base';
</script>
