---
/**
 * Case study page: /work/<slug>/.
 *
 * Reading order: what it is (the hero panel, which the home card morphs into) → the brief →
 * what it guarantees → the architecture → the metrics (all baseline TODOs) → where it is now →
 * the next case (which morphs too) → contact. Pages exist only for the cases present (see
 * data/cloud/cases.ts); with a single case there is no "next case" card (no self-link).
 */
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/cloud/Layout.astro';
import FinalCta from '../../../components/cloud/FinalCta.astro';
import Todo from '../../../components/cloud/Todo.astro';
import { Image } from 'astro:assets';
import { ALL_CASES, nextCase, relatedCases, type CloudCase } from '../../../data/cloud/cases';
import { projectShot } from '../../../person/shots';
import { assertMeta } from '../../../data/cloud/seo';
import { isTodo } from '../../../data/cloud/todo';
import { abs, caseLdGraph } from '../../../lib/cloud/jsonld';
import { caseHref, link } from '../../../lib/cloud/paths';
import { bookingUrl } from '../../../data/cloud/site';

export const getStaticPaths = (() => ALL_CASES.map((c) => ({ params: { slug: c.slug }, props: { study: c } }))) satisfies GetStaticPaths;

interface Props {
  study: CloudCase;
}
const { study: c } = Astro.props;
assertMeta(`case ${c.slug}`, c.seo);
const next = nextCase(c.slug);
/** Generated cases (registry, no hand-written angle): their shared screenshot and sibling builds. */
const shot = c.project ? projectShot(c.project) : undefined;
const related = c.generated ? relatedCases(c.slug).filter((r) => r.slug !== next?.slug) : [];
---

<Layout
  title={c.seo.title}
  description={c.seo.description}
  path={`/work/${c.slug}/`}
  image={abs(`og/${c.slug}.png`)}
  jsonLd={caseLdGraph(c)}
  expect={next ? 'next-title' : undefined}
>
  <section class="chero" id="top" data-hero aria-labelledby="case-title">
    <div class="container">
      <a class="chero__back" href={`${link('/')}#card-${c.slug}`}>
        <span class="chero__back-arrow" aria-hidden="true">←</span> All case studies
      </a>
      <div class="chero__panel panel panel--ticks" data-vt-case={c.slug}>
        <div class="chero__main">
          <div class="chero__top">
            <span class="chero__kicker mono">{c.kicker}</span>
            <span class:list={['status', `status--${c.status.tone}`]}>{c.status.label}</span>
            {c.confidential && <span class="stamp chero__conf">Confidential client</span>}
          </div>
          <h1 id="case-title" class="chero__name">{c.name}</h1>
          <p class="chero__title">{c.title}</p>
          <p class="lede chero__text">{c.summary}</p>
          <p class="chero__client">
            <span class="mono">{c.generated ? 'Built for' : 'Client'}</span>
            <Todo value={c.client} />
          </p>
          {
            c.confidential && (
              <p class="chero__conf-note text-3">The client’s name, systems and data stay private. What is described here is the build.</p>
            )
          }
        </div>
        <ul class="chero__facts" role="list">
          {
            c.facts.map((f) => (
              <li class:list={{ 'is-todo': isTodo(f) }}>
                <span class="chero__fact-led" aria-hidden="true" />
                <Todo value={f} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {
    shot && (
      <section class="cshot" aria-label={`${c.name}: screenshot`}>
        <div class="container">
          <figure class="cshot__frame panel" data-reveal>
            <div class="cshot__bar mono" aria-hidden="true">
              <span class="cshot__led" />
              <span>{c.name} · screenshot</span>
            </div>
            <Image
              src={shot.src}
              alt={shot.alt}
              widths={[480, 800, 1200, 1440]}
              sizes="(min-width: 1440px) 1300px, calc(100vw - 2 * var(--margin, 1rem))"
              loading="lazy"
              decoding="async"
              class="cshot__img"
            />
            <figcaption class="cshot__cap mono">
              A real screenshot of the app{c.confidential ? ', with anything that names the client blurred' : ''}. Figures on screen are not results.
            </figcaption>
          </figure>
        </div>
      </section>
    )
  }

  <section class="section cblock" aria-labelledby="brief-title">
    <div class="container cblock__grid">
      <p class="eyebrow">The brief</p>
      <div>
        <h2 id="brief-title" class="cblock__h2"><Todo value={c.brief.title} /></h2>
        <p class="lede">{c.brief.text}</p>
      </div>
    </div>
  </section>

  <section class="section cblock" aria-labelledby="guarantees-title">
    <div class="container cblock__grid">
      <p class="eyebrow">{c.generated ? 'What I built' : 'What it guarantees'}</p>
      <div>
        <h2 id="guarantees-title" class="cblock__h2">{c.generated ? 'The parts that keep it running.' : 'The promises the system keeps.'}</h2>
        <ul class:list={['guar', { 'guar--odd': c.guarantees.length % 2 === 1 }]} role="list" data-reveal-stagger>
          {
            c.guarantees.map((g) => (
              <li class="guar__item panel">
                <span class:list={['status', isTodo(g.text) ? '' : 'status--ok', 'guar__state']}>
                  {isTodo(g.text) ? 'Pending' : c.generated ? 'Built' : 'Holds'}
                </span>
                <h3 class="guar__title">{g.title}</h3>
                <p class="guar__text">
                  <Todo value={g.text} />
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section cblock cblock--tint" aria-labelledby="arch-title">
    <div class="container cblock__grid">
      <p class="eyebrow">Architecture</p>
      <div>
        <h2 id="arch-title" class="cblock__h2">How it fits together.</h2>
        {
          c.generated ? (
            <p class="text-2 arch__note">
              <span class="stamp">Illustrative</span> A diagram of the flow, drawn from the build. Not a screenshot.
            </p>
          ) : (
            <p class="text-2 arch__note">Only what is confirmed is drawn. Dashed boxes are still to be confirmed.</p>
          )
        }
        <div class="lanes">
          {
            c.arch.map((lane) => (
              <div class="lane">
                <p class="lane__title mono">{lane.title}</p>
                <ol class="lane__nodes" role="list">
                  {lane.nodes.map((nd) => (
                    <li class:list={['anode', { 'anode--todo': isTodo(nd.label) }]}>
                      <span class="anode__label">
                        <Todo value={nd.label} />
                      </span>
                      {nd.note && (
                        <span class="anode__note">
                          <Todo value={nd.note} />
                        </span>
                      )}
                    </li>
                  ))}
                </ol>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {
    c.generated && (
      <section class="section cblock" aria-labelledby="stack-title">
        <div class="container cblock__grid">
          <p class="eyebrow">Stack</p>
          <div>
            <h2 id="stack-title" class="cblock__h2">What it runs on.</h2>
            <ul class="gstack" role="list" aria-label={`${c.name} stack`}>
              {(c.stack ?? []).map((s) => (
                <li class="gstack__item mono">{s}</li>
              ))}
            </ul>
            <p class="text-3 gstack__src">Read from the code, not from a slide.</p>
            {(c.notes?.length || c.link) && (
              <div class="now inverse">
                <p class="now__label mono">Good to know</p>
                {(c.notes ?? []).map((n) => (
                  <p class="now__text">{n}</p>
                ))}
                {c.link && (
                  <a class="btn btn--inv now__link" href={c.link.href} target="_blank" rel="noopener">
                    <span>{c.link.label}</span>
                    <span aria-hidden="true">↗</span>
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  {!c.generated && (
  <section class="section cblock" aria-labelledby="metrics-title">
    <div class="container cblock__grid">
      <p class="eyebrow">Metrics</p>
      <div>
        <h2 id="metrics-title" class="cblock__h2">The numbers this write-up will carry.</h2>
        <p class="lede">
          Each one is measured before and after, on the real system. Until then it stays a gap: no estimates stand in for
          them.
        </p>
        <div class="mtable panel">
          <table>
            <caption class="visually-hidden">{c.name}: metrics, before and after</caption>
            <thead>
              <tr>
                <th scope="col">Metric</th>
                <th scope="col">Before</th>
                <th scope="col">After</th>
              </tr>
            </thead>
            <tbody>
              {
                c.metrics.map((m) => (
                  <tr>
                    <th scope="row">{m.name}</th>
                    <td>
                      <Todo value={m.before} />
                    </td>
                    <td>
                      <Todo value={m.after} />
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div class="now inverse">
          <p class="now__label mono">Where it is now</p>
          <p class="now__text">{c.runsNow}</p>
          {
            c.link && (
              <a class="btn btn--inv now__link" href={c.link.href} target="_blank" rel="noopener">
                <span>{c.link.label}</span>
                <span aria-hidden="true">↗</span>
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>
  )}

  <section class="section cnext" aria-labelledby={next ? 'next-title' : undefined}>
    <div class="container">
      {next && <h2 id="next-title" class="eyebrow cnext__h">Next case</h2>}
      {next && (
      <a class="cnext__card panel" href={caseHref(next.slug)} data-vt-case={next.slug}>
        <span class="cnext__kicker mono">{next.kicker}</span>
        <span class="cnext__name">{next.name}</span>
        <span class="cnext__title">{next.title}</span>
        <span class="cnext__go" aria-hidden="true">→</span>
      </a>
      )}
      {
        related.length > 0 && (
          <nav class="crel" aria-label="Related builds">
            <p class="crel__k mono">Related builds</p>
            <ul class="crel__list" role="list">
              {related.map((r) => (
                <li>
                  <a class="crel__link" href={caseHref(r.slug)}>
                    <span class="crel__led" aria-hidden="true" />
                    <span class="crel__name">{r.name}</span>
                    <span class="crel__line text-2">{r.line ?? r.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <p class="cnext__or">
        Want this for your stack? <a class="link" href={bookingUrl(`case-${c.slug}`)}>Book a scoping call</a>.
      </p>
    </div>
  </section>

  <FinalCta />
</Layout>

<style>
  /* ---------- hero ---------- */
  .chero {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(2rem, 1.5rem + 3vw, 4.5rem));
    padding-bottom: var(--space-6);
    background-image: radial-gradient(circle, var(--grid-dot) 1px, transparent 1.2px);
    background-size: 24px 24px;
  }
  .chero__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap);
    margin-bottom: var(--space-4);
    color: var(--text-2);
    font-weight: 600;
    text-decoration: none;
  }
  .chero__back-arrow {
    display: inline-block;
    transition: transform 520ms var(--ease-out-expo);
  }
  @media (hover: hover) {
    .chero__back:hover {
      color: var(--text);
    }
    .chero__back:hover .chero__back-arrow {
      transform: translateX(-4px);
    }
  }
  .chero__panel {
    display: grid;
    gap: var(--space-6);
    padding: clamp(1.5rem, 1rem + 3vw, 4rem);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-lift);
  }
  @media (min-width: 1024px) {
    .chero__panel {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: center;
    }
  }
  .chero__main {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    align-content: start;
  }
  .chero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .chero__kicker {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .chero__name {
    font-size: clamp(2.5rem, 1.5rem + 4.4vw, 6rem);
    line-height: 0.96;
  }
  .chero__title {
    font-family: var(--font-display);
    font-stretch: 104%;
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.75rem);
    font-weight: 650;
    line-height: 1.25;
    max-width: 30ch;
  }
  .chero__text {
    max-width: 60ch;
  }
  .chero__client {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    font-weight: 600;
  }
  .chero__client .mono {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .chero__facts {
    display: grid;
    gap: 2px;
    align-content: center;
    margin: 0;
    padding: 6px;
    border-radius: var(--radius-s);
    background: var(--surface-1);
  }
  .chero__facts li {
    position: relative;
    padding: 12px 14px 12px 34px;
    border-radius: var(--radius-xs);
    background: var(--surface-2);
    font-weight: 600;
    line-height: 1.4;
  }
  .chero__fact-led {
    position: absolute;
    left: 14px;
    top: calc(12px + 0.45em);
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--ok);
  }
  .chero__facts li.is-todo {
    background: transparent;
  }
  .chero__facts li.is-todo .chero__fact-led {
    background: var(--line-strong);
  }

  /* ---------- content blocks ---------- */
  .cblock__grid {
    display: grid;
    gap: var(--space-4) var(--space-8);
  }
  @media (min-width: 1024px) {
    .cblock__grid {
      grid-template-columns: minmax(0, 0.3fr) minmax(0, 1fr);
      align-items: start;
    }
    .cblock__grid > .eyebrow {
      position: sticky;
      top: calc(var(--nav-h) + 48px);
      margin-top: 0.6rem;
    }
  }
  .cblock__grid > div {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }
  .cblock__h2 {
    font-size: clamp(1.875rem, 1.4rem + 1.9vw, 3.25rem);
    max-width: 20ch;
  }
  .cblock__h2 :global(.todo) {
    font-size: 1rem;
    letter-spacing: 0;
  }
  .cblock--tint {
    background: var(--surface-1);
    border-block: 1px solid var(--line);
  }

  /* ---------- guarantees: 2×2 ---------- */
  .guar {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  @media (min-width: 720px) {
    .guar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .guar__item {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-2);
    padding: var(--space-5);
  }
  .guar__state {
    margin-bottom: var(--space-2);
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .guar__title {
    font-size: 1.25rem;
  }
  .guar__text {
    color: var(--text-2);
  }

  /* ---------- architecture lanes ---------- */
  .arch__note {
    font-size: var(--fs-small);
  }
  .lanes {
    display: grid;
    gap: var(--space-5);
  }
  .lane {
    display: grid;
    gap: var(--space-3);
  }
  .lane__title {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .lane__nodes {
    display: grid;
    gap: 18px;
    margin: 0;
  }
  @media (min-width: 900px) {
    .lane__nodes {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
  .anode {
    position: relative;
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 14px 16px;
    border-radius: var(--radius-s);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .anode:last-child:not(.anode--todo) {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 55%, transparent);
    background: var(--accent-soft);
  }
  /* Connectors: down on phones, right on desktop. */
  .anode:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 24px;
    top: 100%;
    width: 1px;
    height: 18px;
    background: var(--line-strong);
  }
  @media (min-width: 900px) {
    .anode:not(:last-child)::after {
      left: 100%;
      top: 50%;
      width: 28px;
      height: 1px;
    }
  }
  .anode--todo {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
    border-radius: var(--radius-s);
  }
  .anode__label {
    font-weight: 700;
    line-height: 1.3;
  }
  .anode__note {
    color: var(--text-3);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  /* ---------- metrics ---------- */
  .mtable {
    overflow-x: auto;
  }
  .mtable table {
    width: 100%;
    border-collapse: collapse;
  }
  .mtable th,
  .mtable td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: middle;
  }
  .mtable tbody tr:last-child th,
  .mtable tbody tr:last-child td {
    border-bottom: 0;
  }
  .mtable thead th {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .mtable tbody th {
    font-weight: 700;
  }
  @media (max-width: 520px) {
    .mtable th,
    .mtable td {
      padding: 12px 10px;
    }
  }
  .now {
    display: grid;
    gap: 6px;
    justify-items: start;
    padding: var(--space-5);
    border-radius: var(--radius-m);
    background: var(--btn-bg);
    color: var(--btn-fg);
  }
  .now__label {
    opacity: 0.75;
    text-transform: uppercase;
  }
  .now__text {
    font-size: var(--fs-lede);
    font-weight: 600;
    line-height: 1.4;
  }
  .now__link {
    margin-top: var(--space-3);
  }

  /* ---------- next ---------- */
  .cnext .eyebrow {
    margin-bottom: var(--space-4);
  }
  .cnext__card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    padding-right: clamp(4.5rem, 3rem + 4vw, 8rem);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition: box-shadow 700ms var(--ease-out-expo);
  }
  /* A mint deploy bar sweeps the card from the left on hover, slowly. */
  .cnext__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent-soft);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1100ms var(--ease-out-quint);
  }
  .cnext__kicker {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .cnext__name {
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 700;
    font-size: clamp(1.875rem, 1.3rem + 2.4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .cnext__title {
    color: var(--text-2);
    font-size: var(--fs-lede);
    max-width: 40ch;
  }
  .cnext__go {
    position: absolute;
    right: clamp(1.25rem, 1rem + 2vw, 3rem);
    top: 50%;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-top: -26px;
    border-radius: var(--radius-s);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: 1.25rem;
    transition: transform 620ms var(--ease-out-expo);
  }
  @media (hover: hover) {
    .cnext__card:hover {
      box-shadow:
        inset 0 0 0 1px var(--line-strong),
        var(--shadow-lift);
    }
    .cnext__card:hover::after {
      transform: scaleX(1);
    }
    .cnext__card:hover .cnext__go {
      transform: translateX(6px);
    }
  }
  .cnext__card:focus-visible::after {
    transform: scaleX(1);
  }
  .cnext__or {
    margin-top: var(--space-5);
    color: var(--text-2);
  }

  /* ---------- generated cases: confidential note, screenshot, stack, related ---------- */
  .chero__conf {
    color: var(--text-2);
  }
  .chero__conf-note {
    max-width: 52ch;
    font-size: var(--fs-small);
  }
  /* An odd count of parts: the last card spans the row so the 2-up grid stays complete. */
  @media (min-width: 720px) {
    .guar--odd > :last-child {
      grid-column: 1 / -1;
    }
  }
  .cshot {
    padding-bottom: var(--space-6);
  }
  .cshot__frame {
    margin: 0;
    overflow: hidden;
  }
  .cshot__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--text-3);
    text-transform: uppercase;
  }
  .cshot__led {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
  }
  .cshot__frame :global(.cshot__img) {
    display: block;
    width: 100%;
    height: auto;
    background: #fff;
  }
  .cshot__cap {
    padding: 12px 16px;
    border-top: 1px solid var(--line);
    color: var(--text-3);
    line-height: 1.5;
  }
  .gstack {
    display: flex;
    flex-wrap: wrap;
