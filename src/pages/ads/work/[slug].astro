---
/**
 * Case study page: /work/<slug>/.
 *
 * Reading order: what it is (hero box, which the home card morphs into) → the problem → what
 * I built (or, for the example teardown, the rules one by one) → how it runs (the lead record in
 * order, or the rule sheet) → the next case (which morphs too) → contact.
 */
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/ads/Layout.astro';
import FinalCta from '../../../components/ads/FinalCta.astro';
import { CASES, LEAD_RECORD, nextCase, type AdsCase } from '../../../data/ads/cases';
import { assertMeta } from '../../../data/ads/seo';
import { abs, caseLdGraph } from '../../../lib/ads/jsonld';
import { caseHref, link } from '../../../lib/ads/paths';
import { bookingUrl } from '../../../data/ads/site';

export const getStaticPaths = (() => CASES.map((c) => ({ params: { slug: c.id }, props: { study: c } }))) satisfies GetStaticPaths;

interface Props {
  study: AdsCase;
}
const { study: c } = Astro.props;
assertMeta(`case ${c.id}`, c.seo);
const next = nextCase(c.id);
const rules = c.built.filter((b) => b.rule);
---

<Layout
  title={c.seo.title}
  description={c.seo.description}
  path={`/work/${c.id}/`}
  image={abs(`og/${c.id}.png`)}
  jsonLd={caseLdGraph(c)}
  expect="next-title"
>
  <section class="chero" id="top" data-hero aria-labelledby="case-title">
    <div class="container">
      <a class="chero__back" href={`${link('/')}#card-${c.id}`}>
        <span class="chero__back-arrow" aria-hidden="true">←</span> All case studies
      </a>
      <div class="chero__panel" style={`view-transition-name: case-${c.id}`}>
        <div class="chero__main">
          <div class="chero__top">
            {c.example && <span class="ex">Example · illustrative</span>}
            <span class="chero__kicker mono">{c.kicker}</span>
            {
              c.status && (
                <span class="chip">
                  <span class="pip pip--saved" aria-hidden="true" />
                  {c.status}
                </span>
              )
            }
          </div>
          <h1 id="case-title" class="chero__name">{c.name}</h1>
          <p class="chero__title">{c.title}</p>
          <p class="lede chero__text">{c.text}</p>
          <div class="chero__todos">
            {c.pending.map((p) => <span class="todo">{p}</span>)}
          </div>
        </div>
        <ul class="chero__facts" role="list">
          {
            c.facts.map((f) => (
              <li>
                <span class="chero__tick" aria-hidden="true" />
                {f}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section cblock" aria-labelledby="problem-title">
    <div class="container cblock__grid">
      <p class="eyebrow">The problem</p>
      <div>
        <h2 id="problem-title" class="cblock__h2">{c.problem.title}</h2>
        <p class="lede">{c.problem.text}</p>
      </div>
    </div>
  </section>

  <section class="section cblock" aria-labelledby="built-title">
    <div class="container cblock__grid">
      <p class="eyebrow">{c.example ? 'The six rules' : 'What I built'}</p>
      <div>
        <h2 id="built-title" class="cblock__h2">{c.example ? 'One sentence each, and what it catches.' : 'The record, step by step.'}</h2>
        <ol class="built" role="list" data-reveal-stagger>
          {
            c.built.map((b, i) => (
              <li class:list={['built__item', { 'is-todo': b.todo }]}>
                <span class="built__num mono" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="built__title">{b.title}</h3>
                {b.rule && (
                  <p class="built__rule">
                    <span class="kw">IF</span>
                    <span class="cond">{b.rule.if}</span>
                    {b.rule.for && (
                      <>
                        <span class="kw">FOR</span>
                        <span class="cond">{b.rule.for}</span>
                      </>
                    )}
                    <span class="kw">THEN</span>
                    <span class="cond cond--act">{b.rule.then}</span>
                  </p>
                )}
                <p class="built__text">{b.text}</p>
                {b.todo && <span class="todo built__todo">{b.todo}</span>}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section cblock cblock--tint" aria-labelledby="runs-title">
    <div class="container cblock__grid">
      <p class="eyebrow">{c.example ? 'The rule sheet' : 'How it runs'}</p>
      <div class="runs">
        <h2 id="runs-title" class="cblock__h2">{c.example ? 'Every rule, on one page.' : 'From first visit to the CRM.'}</h2>
        <div class="runs__visual">
          {
            c.example ? (
              <div class="panel panel--wide">
                <p class="panel__label mono">Rule sheet · illustrative thresholds</p>
                <table class="sheet">
                  <thead>
                    <tr>
                      <th scope="col">Rule</th>
                      <th scope="col">If</th>
                      <th scope="col">For</th>
                      <th scope="col">Then</th>
                    </tr>
                  </thead>
                  <tbody>
                    {rules.map((b) => (
                      <tr>
                        <th scope="row">{b.title}</th>
                        <td>{b.rule!.if}</td>
                        <td>{b.rule!.for ?? '—'}</td>
                        <td>
                          <span class="cond cond--act">{b.rule!.then}</span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p class="panel__foot text-3">
                  Thresholds are starting points, not results. On a real account they are set from its own targets and caps.
                </p>
              </div>
            ) : (
              <>
                <div class="panel">
                  <p class="panel__label mono">The pipeline, in order</p>
                  <ol class="rail" role="list">
                    {c.flow.map((s, i) => (
                      <li class:list={['rail__step', { 'is-todo': s.todo }]}>
                        <span class="rail__node mono" aria-hidden="true">
                          {String(i + 1).padStart(2, '0')}
                        </span>
                        <span>{s.label}</span>
                        {s.todo && <span class="todo">TODO · not documented as built</span>}
                      </li>
                    ))}
                  </ol>
                </div>
                <div class="panel">
                  <p class="panel__label mono">What the lead record holds · example lead</p>
                  <dl class="record">
                    {LEAD_RECORD.map(([k, v]) => (
                      <div>
                        <dt class="mono">{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                  </dl>
                  <p class="panel__foot text-3">The field names are the ones the form sends; the values are an example.</p>
                </div>
              </>
            )
          }
        </div>
        <div class="now inverse">
          <p class="now__label mono">{c.runsNow.label}</p>
          <p class="now__text">{c.runsNow.text}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section cnext" aria-labelledby="next-title">
    <div class="container">
      <p class="eyebrow">Next case</p>
      <a class="cnext__card" href={caseHref(next.id)} style={`view-transition-name: case-${next.id}`}>
        <span class="cnext__kicker mono">{next.example ? `Example · ${next.kicker}` : next.kicker}</span>
        <span id="next-title" class="cnext__name">{next.name}</span>
        <span class="cnext__title">{next.title}</span>
        <span class="cnext__go" aria-hidden="true">→</span>
      </a>
      <p class="cnext__or">
        Want this on your account? <a class="link" href={bookingUrl(`case-${c.id}`)}>Book a scoping call</a>.
      </p>
    </div>
  </section>

  <FinalCta />
</Layout>

<style>
  /* ---------- hero ---------- */
  .chero {
    padding-top: calc(var(--nav-h) + clamp(2.5rem, 2rem + 3vw, 5rem));
    padding-bottom: var(--space-6);
    background: radial-gradient(56rem 34rem at 92% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%);
  }
  .chero__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap);
    margin-bottom: var(--space-4);
    color: var(--text-2);
    font-weight: 650;
    text-decoration: none;
  }
  .chero__back-arrow {
    display: inline-block;
    transition: transform 520ms var(--ease-out-expo);
  }
  @media (hover: hover) {
    .chero__back:hover {
      color: var(--text);
    }
    .chero__back:hover .chero__back-arrow {
      transform: translateX(-4px);
    }
  }
  .chero__panel {
    display: grid;
    gap: var(--space-6);
    padding: clamp(1.5rem, 1rem + 3vw, 4rem);
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-lift);
  }
  @media (min-width: 1024px) {
    .chero__panel {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: center;
    }
  }
  .chero__main {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    align-content: start;
  }
  .chero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .chero__kicker {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .chero__name {
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4.75rem);
    line-height: 0.98;
    width: fit-content;
    max-width: 100%;
  }
  .chero__title {
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.75rem);
    font-weight: 650;
    line-height: 1.3;
    max-width: 32ch;
  }
  .chero__text {
    max-width: 60ch;
  }
  .chero__todos {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chero__facts {
    display: grid;
    gap: var(--space-2);
    align-content: center;
    margin: 0;
  }
  .chero__facts li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-s);
    background: var(--surface-1);
    font-weight: 550;
    line-height: 1.4;
  }
  .chero__tick {
    flex: none;
    width: 14px;
    height: 0;
    border-top: 2px dashed var(--accent-line);
    transform: translateY(-0.3em);
  }

  /* ---------- content blocks ---------- */
  .cblock__grid {
    display: grid;
    gap: var(--space-4) var(--space-8);
  }
  @media (min-width: 1024px) {
    .cblock__grid {
      grid-template-columns: minmax(0, 0.3fr) minmax(0, 1fr);
      align-items: start;
    }
    .cblock__grid > .eyebrow {
      position: sticky;
      top: calc(var(--nav-h) + 48px);
      margin-top: 0.6rem;
    }
  }
  .cblock__grid > div {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }
  .cblock__h2 {
    font-size: clamp(1.875rem, 1.35rem + 2vw, 3.25rem);
    max-width: 20ch;
  }
  .cblock--tint {
    background: var(--surface-1);
  }

  /* ---------- built ---------- */
  .built {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .built__item {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .built__item > :not(.built__num) {
    grid-column: 2;
  }
  .built__item.is-todo {
    background: transparent;
    box-shadow: none;
    border: 1.5px dashed var(--line-strong);
  }
  .built__num {
    grid-row: span 4;
    padding-top: 4px;
    color: var(--accent-text);
  }
  .built__title {
    font-size: 1.25rem;
  }
  .built__rule {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .built__text {
    color: var(--text-2);
  }
  .built__todo {
    margin-top: var(--space-2);
  }

  /* ---------- runs ---------- */
  .runs__visual {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }
  @media (min-width: 900px) {
    .runs__visual {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .panel {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .panel--wide {
    grid-column: 1 / -1;
    overflow-x: auto;
  }
  .panel__label {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .panel__foot {
    font-size: 0.8125rem;
  }
  .rail {
    display: grid;
    margin: 0;
  }
  .rail__step {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px var(--space-3);
    min-height: 48px;
    padding-left: 44px;
    font-weight: 550;
  }
  .rail__step::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent-line);
  }
  .rail__step:first-child::before {
    top: 50%;
  }
  .rail__step:last-child::before {
    bottom: 50%;
  }
  .rail__node {
    position: absolute;
    left: 0;
    top: 50%;
    display: grid;
    place-items: center;
    width: 32px;
    height: 24px;
    margin-top: -12px;
    border-radius: var(--radius-xs);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.6875rem;
    font-weight: 600;
  }
  .rail__step.is-todo {
    color: var(--text-3);
  }
  .rail__step.is-todo::before {
    background: none;
    border-left: 2px dashed var(--line-strong);
  }
  .rail__step.is-todo .rail__node {
    background: var(--bg);
    color: var(--text-3);
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
  }
  .record {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .record div {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
  }
  .record dt {
    color: var(--accent-text);
    overflow-wrap: anywhere;
  }
  .record dd {
    margin: 0;
    font-weight: 550;
    overflow-wrap: anywhere;
  }
  @media (max-width: 420px) {
    .record div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
  .sheet {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }
  .sheet th,
  .sheet td {
    padding: 10px var(--space-3) 10px 0;
    border-top: 1px solid var(--line);
    text-align: left;
    vertical-align: middle;
  }
  .sheet thead th {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-top: 0;
  }
  .sheet tbody th {
    font-weight: 650;
  }
  .sheet td {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .now {
    display: grid;
    gap: 4px;
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--inv-bg);
    color: var(--inv-fg);
  }
  .now__label {
    color: var(--accent-inv);
    text-transform: uppercase;
  }
  .now__text {
    font-size: var(--fs-lede);
    font-weight: 550;
    line-height: 1.45;
  }

  /* ---------- next ---------- */
  .cnext .eyebrow {
    margin-bottom: var(--space-4);
  }
  .cnext__card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    padding-right: clamp(4.5rem, 3rem + 4vw, 8rem);
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition: box-shadow 700ms var(--ease-out-expo);
  }
  /* An amber tint rises through the card from the bottom on hover, slowly: a bar filling. */
  .cnext__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--accent) 10%, var(--surface-2));
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 1100ms var(--ease-out-quint);
  }
  .cnext__kicker {
    color: var(--text-3);
    text-transform: uppercase;
  }
  .cnext__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 1.3rem + 2vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.03em;
    width: fit-content;
    max-width: 100%;
  }
  .cnext__title {
    color: var(--text-2);
    font-size: var(--fs-lede);
    max-width: 40ch;
  }
  .cnext__go {
    position: absolute;
    right: clamp(1.25rem, 1rem + 2vw, 3rem);
    top: 50%;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-top: -26px;
    border-radius: var(--radius-s);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: 1.25rem;
    transition: transform 620ms var(--ease-out-expo);
  }
  @media (hover: hover) {
    .cnext__card:hover {
      box-shadow:
        inset 0 0 0 1px var(--line-strong),
        var(--shadow-lift);
    }
    .cnext__card:hover::before {
      transform: scaleY(1);
    }
    .cnext__card:hover .cnext__go {
      transform: translateX(6px);
    }
  }
  .cnext__card:focus-visible::before {
    transform: scaleY(1);
  }
  .cnext__or {
    margin-top: var(--space-5);
    color: var(--text-2);
  }
</style>
