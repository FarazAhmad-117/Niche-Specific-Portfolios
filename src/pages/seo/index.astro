---
import Layout from '../../layouts/seo/Layout.astro';
import Hero from '../../components/seo/Hero.astro';
import Proof from '../../components/seo/Proof.astro';
import Problem from '../../components/seo/Problem.astro';
import GrowthChart from '../../components/seo/GrowthChart.astro';
import Engine from '../../components/seo/Engine.astro';
import Cases from '../../components/seo/Cases.astro';
import MoreBuilds from '../../components/seo/MoreBuilds.astro';
import Backlinks from '../../components/seo/Backlinks.astro';
import Offers from '../../components/seo/Offers.astro';
import Safe from '../../components/seo/Safe.astro';
import Process from '../../components/seo/Process.astro';
import About from '../../components/seo/About.astro';
import Faq from '../../components/seo/Faq.astro';
import FinalCta from '../../components/seo/FinalCta.astro';
import { HOME_SEO, assertMeta } from '../../data/seo/seo';
import { abs, homeLd } from '../../lib/seo/jsonld';

assertMeta('home', HOME_SEO);

/*
 * Reading order (brief §4, no testimonials): what this is → facts → the problem → how growth
 * looks (signature) → the engine → proof → backlinks (audited and earned, never bought) → how
 * to buy → why it is safe → how it runs → who does it → questions → contact.
 */
---

<Layout title={HOME_SEO.title} description={HOME_SEO.description} path="/" image={abs('og/home.png')} jsonLd={homeLd()} home>
  <Hero />
  <Proof />
  <Problem />
  <GrowthChart />
  <Engine />
  <Cases />
  <MoreBuilds />
  <Backlinks />
  <Offers />
  <Safe />
  <Process />
  <About />
  <Faq />
  <FinalCta />
</Layout>