---
/**
 * Case study page: /work/<slug>/.
 *
 * Reading order: what it is (hero box, which the home card morphs into) → the problem → what
 * I built (numbered steps on a receipt) → how it runs (the flow and the channels, or the
 * example page's fixes) → the next case (which morphs too) → contact.
 */
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/shopify/Layout.astro';
import FinalCta from '../../../components/shopify/FinalCta.astro';
import { CASES, nextCase, type ShopifyCase } from '../../../data/shopify/cases';
import { NODES } from '../../../data/shopify/sync';
import { STEPS } from '../../../data/shopify/teardown';
import { HERO_RECEIPT, VERDICT_LABEL } from '../../../data/shopify/content';
import { assertMeta } from '../../../data/shopify/seo';
import { abs, caseLdGraph } from '../../../lib/shopify/jsonld';
import { caseHref, link } from '../../../lib/shopify/paths';
import { bookingUrl } from '../../../data/shopify/site';

export const getStaticPaths = (() => CASES.map((c) => ({ params: { slug: c.id }, props: { study: c } }))) satisfies GetStaticPaths;

interface Props {
  study: ShopifyCase;
}
const { study: c } = Astro.props;
assertMeta(`case ${c.id}`, c.seo);
const next = nextCase(c.id);
const channels = (['shopify', 'ebay', 'counter', 'facebook'] as const).map((id) => ({ id, ...NODES[id] }));
const fixes = STEPS.filter((s) => s.fix);
---

<Layout
  title={c.seo.title}
  description={c.seo.description}
  path={`/work/${c.id}/`}
  image={abs(`og/${c.id}.png`)}
  jsonLd={caseLdGraph(c)}
  expect="next-title"
>
  <section class="chero" id="top" data-hero aria-labelledby="case-title">
    <div class="container">
      <a class="chero__back" href={`${link('/')}#card-${c.id}`}>
        <span class="chero__back-arrow" aria-hidden="true">←</span> All case studies
      </a>
      <div class="chero__panel" style={`view-transition-name: case-${c.id}`}>
        <div class="chero__main">
          <div class="chero__top">
            {c.example ? <span class="tag tag--example">Example</span> : <span class="tag tag--accent">Case study</span>}
            <span class="chero__kicker mono">{c.kicker}</span>
            {c.status && <span class="chip chip--live">{c.status}</span>}
          </div>
          <h1 id="case-title" class="chero__name">{c.name}</h1>
          <p class="chero__title">{c.title}</p>
          <p class="lede chero__text">{c.text}</p>
          <div class="chero__todos">
            {c.pending.map((p) => <span class="todo">{p}</span>)}
          </div>
        </div>
        {/* Not reveal-armed: it sits inside the box that page transitions morph. */}
        <ul class="chero__facts" role="list">
          {c.facts.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section cblock" aria-labelledby="problem-title">
    <div class="container cblock__grid">
      <p class="eyebrow">The problem</p>
      <div>
        <h2 id="problem-title" class="cblock__h2">{c.problem.title}</h2>
        <p class="lede">{c.problem.text}</p>
      </div>
    </div>
  </section>

  <section class="section cblock" aria-labelledby="built-title">
    <div class="container cblock__grid">
      <p class="eyebrow">{c.example ? 'How I’d run it' : 'What I built'}</p>
      <div>
        <h2 id="built-title" class="cblock__h2">{c.example ? 'The method, step by step.' : 'The build, step by step.'}</h2>
        <ol class="built" role="list" data-reveal-stagger>
          {
            c.built.map((b, i) => (
              <li class="built__item">
                <span class="built__num mono" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="built__title">{b.title}</h3>
                <p class="built__text">{b.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section cblock cblock--tint" aria-labelledby="runs-title">
    <div class="container cblock__grid">
      <p class="eyebrow">{c.example ? 'Before and after' : 'How it runs'}</p>
      <div class="runs">
        <h2 id="runs-title" class="cblock__h2">{c.example ? 'Six apps, one verdict each.' : 'One record, every channel.'}</h2>
        <div class="runs__visual">
          {
            c.example ? (
              <>
                <div class="receipt panel">
                  <p class="panel__label mono">Example app audit · verdicts</p>
                  <ul class="panel__list" role="list">
                    {HERO_RECEIPT.map((r) => (
                      <li class="leader">
                        <span>
                          <span class="panel__name">{r.app}</span>
                          <span class="panel__info">{r.note}</span>
                        </span>
                        <span class={`verdict verdict--${r.verdict} mono`}>{VERDICT_LABEL[r.verdict]}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="receipt panel">
                  <p class="panel__label mono">Example product page · fixes</p>
                  <ol class="panel__list" role="list">
                    {fixes.map((s, i) => (
                      <li>
                        <span class="panel__name">
                          <span class="panel__n mono">{String(i + 1).padStart(2, '0')}</span> {s.title}
                        </span>
                        <span class="panel__info">{s.kind === 'conversion' ? 'Buying fix' : 'Speed fix'}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              </>
            ) : (
              <>
                <div class="receipt panel">
                  <p class="panel__label mono">The flow</p>
                  <ol class="panel__list" role="list">
                    {c.flow.map((s, i) => (
                      <li class="leader">
                        <span class="panel__name">{s}</span>
                        <span class="panel__n mono">{String(i + 1).padStart(2, '0')}</span>
                      </li>
                    ))}
                  </ol>
                </div>
                <div class="receipt panel">
                  <p class="panel__label mono">Channels</p>
                  <ul class="panel__list" role="list">
                    {channels.map((ch) => (
                      <li class="leader">
                        <span>
                          <span class="panel__name">{ch.name}</span>
                          <span class="panel__info">{ch.sub}</span>
                        </span>
                        <span class:list={['verdict mono', ch.id === 'facebook' ? 'verdict--soon' : 'verdict--live']}>
                          {ch.id === 'facebook' ? 'Coming soon' : 'Live'}
                        </span>
                      </li>
                    ))}
                  </ul>
                  <p class="panel__foot text-3">Amazon and Google Shopping are not connected in Yard Terminal.</p>
                </div>
              </>
            )
          }
        </div>
        <div class="now inverse">
          <p class="now__label mono">{c.runsNow.label}</p>
          <p class="now__text">{c.runsNow.text}</p>
          {
            c.link && (
              <a class="now__link link" href={c.link.href} target="_blank" rel="noopener">
                {c.link.label}
                <span aria-hidden="true"> ↗</span>
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section cnext" aria-labelledby="next-title">
    <div class="container">
      <p class="eyebrow">Next case</p>
      <a class="cnext__card" href={caseHref(next.id)} style={`view-transition-name: case-${next.id}`}>
        <span class="cnext__kicker mono">{next.example ? `Example · ${next.kicker}` : next.kicker}</span>
        <span id="next-title" class="cnext__name">{next.name}</span>
        <span class="cnext__title">{next.title}</span>
        <span class="cnext__go" aria-hidden="true">→</span>
      </a>
      <p class="cnext__or">
        Want this for your store? <a class="link" href={bookingUrl(`case-${c.id}`)}>Book a scoping call</a>.
      </p>
    </div>
  </section>

  <FinalCta />
</Layout>

<style>
  /* ---------- hero ---------- */
  .chero {
    padding-top: calc(var(--nav-h) + clamp(2.5rem, 2rem + 3vw, 5rem));
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--line);
  }
  .chero__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap);
    margin-bottom: var(--space-4);
    color: var(--text-2);
    font-weight: 600;
    text-decoration: none;
  }
  .chero__back-arrow {
    display: inline-block;
    transition: transform 520ms var(--ease-out-expo);
  }
  @media (hover: hover) {
    .chero__back:hover {
      color: var(--text);
    }
    .chero__back:hover .chero__back-arrow {
      transform: translateX(-4px);
    }
  }
  .chero__panel {
    display: grid;
    gap: var(--space-6);
    padding: clamp(1.5rem, 1rem + 3vw, 4rem);
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-lift);
  }
  @media (min-width: 1024px) {
    .chero__panel {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: center;
    }
  }
  .chero__main {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    align-content: start;
  }
  .chero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .chero__kicker {
    color: var(--text-3);
  }
  .chero__name {
    font-size: clamp(2.5rem, 1.5rem + 4vw, 5.25rem);
    line-height: 0.98;
    width: fit-content;
    max-width: 100%;
  }
  .chero__title {
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    max-width: 32ch;
  }
  .chero__text {
    max-width: 60ch;
  }
  .chero__todos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .chero__facts {
    display: grid;
    gap: 0;
    align-content: center;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .chero__facts li {
    position: relative;
    padding: var(--space-4) 0 var(--space-4) 26px;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
    line-height: 1.4;
  }
  .chero__facts li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: calc(var(--space-4) + 0.45em);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* ---------- content blocks ---------- */
  .cblock__grid {
    display: grid;
    gap: var(--space-4) var(--space-8);
  }
  @media (min-width: 1024px) {
    .cblock__grid {
      grid-template-columns: minmax(0, 0.3fr) minmax(0, 1fr);
      align-items: start;
    }
    .cblock__grid > .eyebrow {
      position: sticky;
      top: calc(var(--nav-h) + 48px);
      margin-top: 0.8rem;
    }
  }
  .cblock__grid > div {
    display: grid;
    gap: var(--space-5);
  }
  .cblock__h2 {
    font-size: clamp(2rem, 1.4rem + 2vw, 3.25rem);
    max-width: 20ch;
  }
  .cblock--tint {
    background: var(--surface-1);
  }

  /* ---------- built: numbered steps ---------- */
  .built {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .built__item {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .built__num {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent-fill);
    color: var(--on-accent);
  }
  .built__title {
    font-size: 1.25rem;
    padding-top: 3px;
  }
  .built__text {
    color: var(--text-2);
  }

  /* ---------- runs ---------- */
  .runs__visual {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 900px) {
    .runs__visual {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .panel {
    display: grid;
    gap: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    letter-spacing: 0;
  }
  .panel__label {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    color: var(--text-3);
  }
  .panel__list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .panel__list li {
    align-items: center;
  }
  .panel__list li > span:first-child {
    display: grid;
    gap: 2px;
  }
  .panel__name {
    font-weight: 600;
  }
  .panel__info {
    color: var(--text-2);
    font-size: var(--fs-small);
    font-weight: 400;
  }
  .panel__n {
    color: var(--accent-text);
  }
  .panel__foot {
    font-size: 0.8125rem;
  }
  .verdict {
    flex: none;
    padding: 3px 9px;
    border-radius: 3px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .verdict--keep,
  .verdict--soon {
    color: var(--text-2);
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
  }
  .verdict--replace,
  .verdict--live {
    background: var(--accent-fill);
    color: var(--on-accent);
  }
  .verdict--remove {
    background: var(--btn-bg);
    color: var(--btn-fg);
  }
  .verdict--defer {
    background: var(--warn-bg);
    color: var(--warn);
  }
  .now {
    display: grid;
    gap: 6px;
    justify-items: start;
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--btn-bg);
    color: var(--btn-fg);
  }
  .now__label {
    color: var(--accent-inv);
  }
  .now__text {
    font-size: var(--fs-lede);
    font-weight: 500;
    line-height: 1.45;
  }
  .now__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 600;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  /* ---------- next ---------- */
  .cnext .eyebrow {
    margin-bottom: var(--space-4);
  }
  .cnext__card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    padding-right: clamp(4.5rem, 3rem + 4vw, 8rem);
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition: box-shadow 700ms var(--ease-out-expo);
  }
  /* A clay wash rises from the bottom on hover, slowly, like a shelf being lit. */
  .cnext__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--accent) 10%, var(--surface-2));
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 1100ms var(--ease-out-quint);
  }
  .cnext__kicker {
    color: var(--text-3);
  }
  .cnext__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.875rem, 1.3rem + 2.4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.025em;
    width: fit-content;
    max-width: 100%;
  }
  .cnext__title {
    color: var(--text-2);
    font-size: var(--fs-lede);
    max-width: 40ch;
  }
  .cnext__go {
    position: absolute;
    right: clamp(1.25rem, 1rem + 2vw, 3rem);
    top: 50%;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin-top: -27px;
    border-radius: 50%;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: 1.25rem;
    transition: transform 620ms var(--ease-out-expo);
  }
  @media (hover: hover) {
    .cnext__card:hover {
      box-shadow:
        inset 0 0 0 1px var(--line-strong),
        var(--shadow-lift);
    }
    .cnext__card:hover::before {
      transform: scaleY(1);
    }
    .cnext__card:hover .cnext__go {
      transform: translateX(6px);
    }
  }
  .cnext__card:focus-visible::before {
    transform: scaleY(1);
  }
  .cnext__or {
    margin-top: var(--space-5);
    color: var(--text-2);
  }
</style>
