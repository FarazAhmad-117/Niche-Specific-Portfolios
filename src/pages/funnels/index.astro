---
import Layout from '../../layouts/funnels/Layout.astro';
import Hero from '../../components/funnels/Hero.astro';
import Proof from '../../components/funnels/Proof.astro';
import Problem from '../../components/funnels/Problem.astro';
import Journey from '../../components/funnels/Journey.astro';
import LeakCalc from '../../components/funnels/LeakCalc.astro';
import Cases from '../../components/funnels/Cases.astro';
import Offers from '../../components/funnels/Offers.astro';
import Included from '../../components/funnels/Included.astro';
import Process from '../../components/funnels/Process.astro';
import About from '../../components/funnels/About.astro';
import Faq from '../../components/funnels/Faq.astro';
import FinalCta from '../../components/funnels/FinalCta.astro';
import { HOME_SEO, assertMeta } from '../../data/funnels/seo';
import { abs, homeLd } from '../../lib/funnels/jsonld';

assertMeta('home', HOME_SEO);

/*
 * Reading order (brief §4): what this is → facts → the problem → watch it work (signature)
 * → what it costs you → proof → how to buy → what's always included → how it runs → who
 * builds it → questions → contact.
 */
---

{/* expect "services": the section after the case cards, so all three cards are parsed. */}
<Layout
  title={HOME_SEO.title}
  description={HOME_SEO.description}
  path="/"
  image={abs('og/home.png')}
  jsonLd={homeLd()}
  expect="services"
>
  <Hero />
  <Proof />
  <Problem />
  <Journey />
  <LeakCalc />
  <Cases />
  <Offers />
  <Included />
  <Process />
  <About />
  <Faq />
  <FinalCta />
</Layout>
