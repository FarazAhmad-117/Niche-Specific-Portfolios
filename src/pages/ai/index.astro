---
import Layout from '../../layouts/ai/Layout.astro';
import Hero from '../../components/ai/Hero.astro';
import ProofStrip from '../../components/ai/ProofStrip.astro';
import Problem from '../../components/ai/Problem.astro';
import Capabilities from '../../components/ai/Capabilities.astro';
import CaseCards from '../../components/ai/CaseCards.astro';
import MoreBuilds from '../../components/ai/MoreBuilds.astro';
import Offers from '../../components/ai/Offers.astro';
import Checklist from '../../components/ai/Checklist.astro';
import Process from '../../components/ai/Process.astro';
import Comparison from '../../components/ai/Comparison.astro';
import About from '../../components/ai/About.astro';
import Faq from '../../components/ai/Faq.astro';
import FinalCta from '../../components/ai/FinalCta.astro';
import { HOME_SEO, assertMeta } from '../../data/ai/seo';
import { abs, homeLd } from '../../lib/ai/jsonld';

assertMeta('home', HOME_SEO);

/*
 * Reading order: who I am and what I do (hero, facts) → the problem → what I build and for
 * whom → the proof (case studies) → what "production" means → how to buy → how it runs →
 * how I compare → who I am → questions → contact.
 */
---

<Layout
  title={HOME_SEO.title}
  description={HOME_SEO.description}
  path="/"
  image={abs('og/home.png')}
  jsonLd={homeLd()}
  heroSentinel
>
  <Hero />
  <ProofStrip />
  <Problem />
  <Capabilities />
  <CaseCards />
  <MoreBuilds />
  <Checklist />
  <Offers />
  <Process />
  <Comparison />
  <About />
  <Faq />
  <FinalCta />
</Layout>
