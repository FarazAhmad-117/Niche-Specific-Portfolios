---
/**
 * Case-study page (/work/<slug>/), one per entry in src/data/ai/cases.ts.
 *
 * Reads as a story: hero (what it is, for whom, the headline figure) → the product itself
 * (a real screenshot, when one exists) → the problem and how it worked before → what I built
 * → how it runs, step by step (the real flow, on a console) → what changed → what runs it
 * now → next case → call.
 *
 * Honesty rules: values render through <Field> (sample = plain text, todo = chip). Any block
 * that prints a sample carries <SampleNote>, which appears only while a sample is present.
 * Meta, OG and JSON-LD never see a sample (they use seo/og strings and textOf()).
 * No testimonial slot.
 */
import type { GetStaticPaths } from 'astro';
import { Image, Picture } from 'astro:assets';
import leadrift from '../../../assets/ai/leadrift.png';
import Layout from '../../../layouts/ai/Layout.astro';
import Button from '../../../components/ai/Button.astro';
import CaseSection from '../../../components/ai/CaseSection.astro';
import Field from '../../../components/ai/Field.astro';
import FinalCta from '../../../components/ai/FinalCta.astro';
import GridLines from '../../../components/ai/GridLines.astro';
import SampleNote from '../../../components/ai/SampleNote.astro';
import StackMarks from '../../../components/ai/StackMarks.astro';
import WorkflowDiagram from '../../../components/ai/WorkflowDiagram.astro';
import { ALL_CASES, nextCase, relatedCases, type AnyCase } from '../../../data/ai/cases';
import { fanOutOf } from '../../../data/ai/content';
import { hasSample, textOf } from '../../../data/ai/todo';
import { assertMeta } from '../../../data/ai/seo';
import { abs, caseLdGraph } from '../../../lib/ai/jsonld';
import { createLink } from '../../../lib/link';

/*
 * Hand-written cases (src/data/ai/cases.ts › CASES) tell the full story below. Generated cases
 * (MORE_CASES: registry projects with no hand-written angle here) render the chapters their
 * registry facts support: the problem (when the angle has one), what I built, the flow and stack,
 * the project's caveats ("Good to know") and links to the other builds. No figures, no samples.
 */
export const getStaticPaths = (() =>
  ALL_CASES.map((study) => ({ params: { slug: study.slug }, props: { study } }))) satisfies GetStaticPaths;

interface Props {
  study: AnyCase;
}

/**
 * Internal-tool screenshots, keyed by `hw.tool.shot`. Imported here (not in cases.ts) so the
 * built files stay the Picture outputs only. Rendered only for a case whose project has one.
 */
const TOOL_SHOTS = { leadrift } as const;

const { study } = Astro.props;
const next = nextCase(study.slug);
const link = createLink('ai');
assertMeta(study.slug, study.seo);

const hw = study.generated ? undefined : study;
const gen = study.generated ? study : undefined;
/** A year that is still an illustrative sample is not worth a note in the hero: leave it out. */
const year = hw ? textOf(hw.year) : undefined;
const storyBody = hw ? hw.baseline.story.replace(/^Before:\s*/i, '') : '';
const baselineStory = storyBody.charAt(0).toUpperCase() + storyBody.slice(1);
const linkHost = study.link ? study.link.label : undefined;
/** Pre-launch with only verified product facts: say plainly why there are no figures. */
const preLaunchNote = hw ? !hasSample(hw.results) && !hw.inProduction && hw.status?.tone === 'building' : false;
/** Screenshot caption: the case's own (hand-written override), else an honest default. */
const shotCaption = study.screenshot
  ? 'caption' in study.screenshot && study.screenshot.caption
    ? study.screenshot.caption
    : gen
      ? `${study.name}${linkHost ? `, ${linkHost}` : ''}. A screenshot of the real app${gen.confidential ? '; client details are blurred' : ''}.`
      : `${study.name}'s own product site${linkHost ? `, ${linkHost}` : ''}. A screenshot of the live page.`
  : '';
/** The exhibit frame keeps the image's own proportions (the default suits the 1443×877 shots). */
const shotRatio = study.screenshot ? study.screenshot.src.width / study.screenshot.src.height : 0;
const shotStyle = study.screenshot && Math.abs(shotRatio - 1443 / 877) > 0.01 ? `aspect-ratio: ${study.screenshot.src.width} / ${study.screenshot.src.height}` : undefined;
const related = gen ? relatedCases(gen.slug) : [];
---

<Layout
  title={study.seo.title}
  description={study.seo.description}
  path={`/work/${study.slug}/`}
  image={abs(`og/${study.slug}.png`)}
  jsonLd={caseLdGraph(study)}
>
  <!-- ============ hero ============ -->
  <header class="chero">
    <GridLines />
    <div class="chero__inner container grid">
      <nav class="chero__crumbs mono-label" aria-label="Breadcrumb">
        <ol class="plain-list">
          <li>{gen ? <a class="link" href={link(`/#card-${gen.slug}`)}>More builds</a> : <a class="link" href={link('/#work')}>Case studies</a>}</li>
          <li aria-current="page">{study.name}</li>
        </ol>
      </nav>

      <div class="chero__copy">
        <p class="chero__eyebrow mono-label">Case study · {hw ? hw.role : gen?.kicker}</p>
        {
          hw ? (
            <h1 class="chero__title case-vt" style={`--vt: case-${study.slug}`}>{study.h1}</h1>
          ) : (
            <h1 class="chero__title chero__title--gen">{study.h1}</h1>
          )
        }
        <p class="chero__lede lede">{study.summary}</p>
        <div class="chero__actions">
          <Button variant="secondary" href="#how" arrow="↓">See how it runs</Button>
          {
            study.link && (
              <Button variant="ghost" href={study.link.href} target="_blank" rel="noopener" arrow="↗">
                Visit {linkHost}
                <span class="visually-hidden"> (opens in a new tab)</span>
              </Button>
            )
          }
          {
            gen?.repo && (
              <Button variant="ghost" href={gen.repo.href} target="_blank" rel="noopener" arrow="↗">
                Source on GitHub
                <span class="visually-hidden"> (opens in a new tab)</span>
              </Button>
            )
          }
        </div>
      </div>

      {
        gen && (
          <aside class="plate plate--gen theme-ink case-box" style={`--vt: case-${gen.slug}`} aria-label={`${gen.name} at a glance`}>
            <p class="plate__top">
              <span class="plate__k">At a glance</span>
              {gen.status ? (
                <span class:list={['pill', gen.status.tone !== 'live' && 'pill--idle']}>{gen.status.label}</span>
              ) : gen.confidential ? (
                <span class="plate__seal">Confidential client</span>
              ) : null}
            </p>
            <div class="plate__metric">
              <p class="plate__kind">{gen.kind}</p>
              <p class="plate__label">Type of work</p>
            </div>
            <dl class="plate__facts">
              {gen.client && (
                <div>
                  <dt>Built for</dt>
                  <dd>{gen.client}</dd>
                </div>
              )}
              <div>
                <dt>Built with</dt>
                <dd>{gen.stack.join(' · ')}</dd>
              </div>
            </dl>
          </aside>
        )
      }
      {hw && (
      <aside class="plate theme-ink" aria-label={`${hw.name} at a glance`}>
        <p class="plate__top">
          <span class="plate__k">At a glance</span>
          {
            hw.status && (
              <span class:list={['pill', hw.status.tone !== 'live' && 'pill--idle']}>{hw.status.label}</span>
            )
          }
        </p>
        <div class="plate__metric">
          <p class="plate__value"><Field value={hw.headlineMetric.value} variant="metric" size="m" /></p>
          <p class="plate__label">{hw.headlineMetric.label}</p>
        </div>
        <dl class="plate__facts">
          <div>
            <dt>Built for</dt>
            <dd>{hw.client}</dd>
          </div>
          <div>
            <dt>My role</dt>
            <dd>{hw.role}</dd>
          </div>
          {
            year && (
              <div>
                <dt>Year</dt>
                <dd>{year}</dd>
              </div>
            )
          }
          <div>
            <dt>Built with</dt>
            <dd>{hw.stack.join(' · ')}</dd>
          </div>
        </dl>
        <SampleNote data={hw.headlineMetric} class="plate__note" />
      </aside>
      )}
    </div>
  </header>

  <!-- ============ the product itself (real screenshot) ============ -->
  {
    study.screenshot && (
      <div class="exhibit container">
        <figure class="exhibit__frame theme-ink" data-reveal>
          <div class="exhibit__bar mono" aria-hidden="true">
            <span class="exhibit__url">{linkHost ?? study.name}</span>
          </div>
          <Image
            src={study.screenshot.src}
            alt={study.screenshot.alt}
            widths={[480, 800, 1200, 1443]}
            sizes="(min-width: 1600px) 1440px, calc(100vw - 2 * clamp(1rem, 0.3077rem + 3.0769vw, 4rem))"
            loading="lazy"
            decoding="async"
            class="exhibit__img"
            style={shotStyle}
          />
          <figcaption class="exhibit__cap mono">{shotCaption}</figcaption>
        </figure>
      </div>
    )
  }

  <!-- ============ the project's own internal tool, when it has one (real screenshot) ============ -->
  {
    hw?.tool && (
      <div class="own container">
        <figure class="own__frame theme-ink" data-reveal>
          <div class="own__bar mono" aria-hidden="true">
            <span>{hw.tool.bar}</span>
          </div>
          <Picture
            src={TOOL_SHOTS[hw.tool.shot]}
            formats={['avif', 'webp']}
            fallbackFormat="png"
            quality={85}
            widths={[480, 768, 1024, 1352]}
            sizes="min(1024px, calc(100vw - 2rem))"
            width={1352}
            height={888}
            alt={hw.tool.alt}
            loading="lazy"
            decoding="async"
          />
          <figcaption class="own__cap mono">
            {hw.tool.name}, the internal tool {hw.tool.team}'s sales team works in: {hw.tool.does}
          </figcaption>
        </figure>
      </div>
    )
  }

  <!-- ============ the problem + before ============ -->
  {hw && (
  <CaseSection id="problem" label="The problem">
    <h2 id="problem-title" class="c-h2">{hw.problem.title}</h2>
    <div class="pb">
      <p class="pb__text lede">{hw.problem.text}</p>
      <div class="before">
        <h3 class="before__title"><span class="before__k">Before:</span> How it worked</h3>
        <p class="before__story">{baselineStory}</p>
        <dl class="before__facts">
          {
            hw.baseline.facts.map((f) => (
              <div class="before__fact">
                <dt>{f.label}</dt>
                <dd>
                  <Field value={f.value} />
                </dd>
              </div>
            ))
          }
        </dl>
        <SampleNote data={hw.baseline.facts} />
      </div>
    </div>
  </CaseSection>
  )}
  {
    gen?.problem && (
      <CaseSection id="problem" label="The problem">
        <h2 id="problem-title" class="c-h2">{gen.problem.title}</h2>
        <p class="pb__text lede">{gen.problem.text}</p>
      </CaseSection>
    )
  }

  <!-- ============ what I built ============ -->
  <CaseSection id="built" label="What I built" tone="sunk">
    <h2 id="built-title" class="c-h2">What I built.</h2>
    <ul class="built plain-list" data-reveal-stagger>
      {
        study.built.map((b) => (
          <li class="built__item">
            <span class="built__mark" aria-hidden="true" />
            <h3 class="built__title">{b.title}</h3>
            <p class="built__text">{b.text}</p>
          </li>
        ))
      }
    </ul>
  </CaseSection>

  <!-- ============ how it runs ============ -->
  <CaseSection id="how" label="How it works">
    <div class="how__head">
      <h2 id="how-title" class="c-h2">How it runs, step by step.</h2>
      <p class="lede">Follow the wire: what comes in, what happens to it, and what comes out.</p>
    </div>
    <WorkflowDiagram
      nodes={study.diagram.nodes}
      fanOut={fanOutOf(study)}
      live={study.inProduction}
      title={`How ${study.name} runs`}
      caption={`${study.slug} / flow`}
    />
    {gen && <p class="how__note mono">Diagram of the flow, drawn from what the build does. Not a screenshot.</p>}
    <div class="how__stack">
      <p class="mono-label">Built with</p>
      <StackMarks tools={study.stack} label={`${study.name} stack`} provisional={study.stackProvisional} />
    </div>
  </CaseSection>

  {hw && (
  <>
  <!-- ============ result ============ -->
  <CaseSection id="result" label="The result">
    <h2 id="result-title" class="c-h2">What changed.</h2>
    <ul class="results plain-list" data-reveal-stagger>
      {
        hw.results.map((r) => (
          <li class="result">
            <h3 class="result__label">{r.label}</h3>
            <div class="result__pair">
              <p class="result__before">
                <span class="result__k">Before</span>
                <span class="result__v">
                  <Field value={r.before} />
                </span>
              </p>
              <span class="result__arrow" aria-hidden="true">
                →
              </span>
              <p class="result__after">
                <span class="result__k">After</span>
                <span class="result__v">
                  <Field value={r.after} />
                </span>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
    <SampleNote data={hw.results} />
    {
      preLaunchNote && (
        <p class="result__note">
          Pre-launch, so there are no customer or time-saved figures yet. These are what the product does today.
        </p>
      )
    }
  </CaseSection>

  <!-- ============ what runs it now ============ -->
  <CaseSection id="now" label="Running now">
    <h2 id="now-title" class="c-h2">What runs it now.</h2>
    <div class="now">
      <p class="now__statement">
        {hw.status && <span class:list={['pill', hw.status.tone !== 'live' && 'pill--idle']}>{hw.status.label}</span>}
        <span>{hw.runsNow.statement}</span>
      </p>
      <ul class="now__points plain-list">
        {hw.runsNow.points.map((p) => <li>{p}</li>)}
      </ul>
      {
        hw.link && (
          <p class="now__link">
            <a class="link ext" href={hw.link.href} target="_blank" rel="noopener">
              {hw.link.label}
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </p>
        )
      }
    </div>
  </CaseSection>
  </>
  )}

  <!-- ============ caveats from the registry (`notes`) ============ -->
  {
    study.notes && study.notes.length > 0 && (
      <CaseSection id="notes" label="Good to know">
        <h2 id="notes-title" class="c-h2">Good to know.</h2>
        <ul class="notes plain-list">
          {study.notes.map((n) => <li>{n}</li>)}
        </ul>
      </CaseSection>
    )
  }

  <!-- ============ the other generated builds ============ -->
  {
    related.length > 0 && (
      <CaseSection id="more" label="More builds" tone="sunk">
        <h2 id="more-title" class="c-h2">More builds.</h2>
        <ul class="rel plain-list">
          {related.map((r) => (
            <li>
              <a class="rel__link" href={link(`/work/${r.slug}/`)}>
                <span class="rel__k mono-label">{r.kicker}</span>
                <span class="rel__name">{r.name}</span>
                <span class="rel__line">{r.angle}</span>
                <span class="rel__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </CaseSection>
    )
  }

  <!-- ============ next case (only when there is another one) ============ -->
  {
    next && (
      <section class="next" aria-labelledby="next-title">
        <div class="container">
          <a class="next__link" href={link(`/work/${next.slug}/`)}>
            <span class="next__k mono-label">Next case study</span>
            <h2 id="next-title" class:list={['next__title', !next.generated && 'case-vt']} style={next.generated ? undefined : `--vt: case-${next.slug}`}>{next.name}</h2>
            <span class="next__angle">{next.angle}</span>
            <span class="next__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  <FinalCta form={false} />
</Layout>

<style>
  /* ---------- hero ---------- */
  .chero {
    position: relative;
    padding-block: var(--space-6) var(--space-8);
    border-bottom: 1px solid var(--line);
  }
  .chero__inner {
    position: relative;
    z-index: 1;
    row-gap: var(--space-6);
  }
  .chero__crumbs,
  .chero__copy,
  .plate {
    grid-column: 1 / -1;
  }
  .chero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .chero__crumbs li {
    display: inline-flex;
    align-items: center;
  }
  .chero__crumbs li + li::before {
    content: "/";
    margin-inline-end: var(--space-2);
    color: var(--text-3);
  }
  .chero__crumbs a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
  }
  .chero__crumbs [aria-current] {
    color: var(--text);
  }
  .chero__copy {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .chero__copy > * {
    margin: 0;
  }
  .chero__title {
    font-size: var(--fs-display-l);
    line-height: 0.98;
    letter-spacing: var(--tr-display);
    max-inline-size: 20ch;
    view-transition-name: var(--vt);
  }
  .chero__lede {
    max-inline-size: 58ch;
  }
  .chero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  /* The fact plate: a console set into the page, in both themes. */
  .plate {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    padding: var(--space-5);
    border: 1px solid var(--line-strong);
  }
  .plate p {
    margin: 0;
  }
  .plate__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }
  .plate__k,
  .plate__label,
  .plate__facts dt {
    font: 500 var(--fs-mono-label) / 1.4 var(--font-mono);
    letter-spacing: var(--tr-mono-label);
    text-transform: uppercase;
    color: var(--text-3);
  }
  .plate__metric {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-2) var(--space-4);
    border-block-end: 1px solid var(--line);
  }
  .plate__value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-metric);
    line-height: 0.9;
    letter-spacing: var(--tr-metric);
  }
  .plate__facts {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  .plate__facts > div {
    display: grid;
    gap: 4px;
  }
  .plate__facts dd {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--text);
  }

  /* ---------- exhibit: the real product screenshot ---------- */
  .exhibit {
    padding-block: var(--space-7) 0;
  }
  .exhibit__frame {
    margin: 0;
    padding: 0 0 0;
    border: 1px solid var(--line-strong);
  }
  .exhibit__bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: 10px 14px;
    font-size: var(--fs-mono-label);
    color: var(--text-3);
    border-block-end: 1px solid var(--line);
  }
  .exhibit__url {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* The screenshot is white; a hairline inset keeps its edge crisp on ink in both themes. */
  .exhibit__frame :global(.exhibit__img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1443 / 877;
    background: #fff;
  }
  .exhibit__cap {
    padding: 12px 14px;
    font-size: var(--fs-mono-label);
    color: var(--text-3);
    border-block-start: 1px solid var(--line);
  }

  /* ---------- own: the project's internal tool (a sibling of the hero, outside every view-transition box) ---------- */
  .own {
    padding-block: var(--space-7) 0;
  }
  .own__frame {
    margin: 0;
    max-inline-size: 64rem;
    border: 1px solid var(--line-strong);
  }
  .own__bar {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    font-size: var(--fs-mono-label);
    color: var(--text-3);
    border-block-end: 1px solid var(--line);
  }
  /* The screenshot is a cream page; its own hairline-bordered frame keeps the edge crisp on ink in both themes. */
  .own__frame :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    background: #f1efe7;
  }
  .own__cap {
    padding: 12px 14px;
    font-size: var(--fs-mono-label);
    line-height: 1.5;
    color: var(--text-3);
    border-block-start: 1px solid var(--line);
  }

  /* ---------- chapters ---------- */
  .c-h2 {
    max-inline-size: 20ch;
  }
  .pb {
    display: grid;
    gap: var(--space-6);
  }
  .pb__text {
    margin: 0;
    max-inline-size: 46ch;
  }
  .before {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: var(--space-5);
    background: var(--surface-2);
    border: 1px solid var(--line);
  }
  .before > * {
    margin: 0;
  }
  .before__title {
    display: grid;
    gap: var(--space-2);
    font-size: var(--fs-h3);
  }
  .before__k {
    font: 500 var(--fs-mono-label) / 1.4 var(--font-mono);
    letter-spacing: var(--tr-mono-label);
    text-transform: uppercase;
    color: var(--text-3);
  }
  .before__story {
    color: var(--text-2);
  }
  .before__facts {
    display: grid;
    margin: 0;
    border-block-start: 1px solid var(--line);
  }
  .before__fact {
    display: grid;
    gap: 2px;
    padding-block: var(--space-3);
    border-block-end: 1px solid var(--line);
  }
  .before__fact dt {
    font: 400 var(--fs-mono-label) / 1.4 var(--font-mono);
    color: var(--text-3);
  }
  .before__fact dd {
    margin: 0;
    font-weight: 500;
  }

  .built {
    display: grid;
    gap: var(--space-5) var(--gutter);
  }
  .built__item {
    position: relative;
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--line-strong);
  }
  .built__item > * {
    margin: 0;
  }
  .built__mark {
    position: absolute;
    inset-block-start: -4px;
    inset-inline-start: 0;
    inline-size: 7px;
    block-size: 7px;
    background: var(--text);
  }
  .built__title {
    font-size: var(--fs-h3);
  }
  .built__text {
    color: var(--text-2);
    max-inline-size: 42ch;
  }

